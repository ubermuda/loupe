{#
  Every comment thread on the version, split by whether it has a passage to sit
  beside. Rendered both on initial page load and by the whole-list Turbo Stream
  (add / delete / resolve all replace #comment-threads), so everything that must
  refresh on a mutation lives inside this element.

  General comments — no anchor — lead the reading column, because there is no
  passage for them to be level with. Anchored comments go in the margin, where
  comment_anchor_controller measures each one's passage and sets its `top`. Below
  the margin's breakpoint the controller moves them into the prose instead, after
  the block each one points at.

  There is deliberately no status grouping any more: a card's position now says
  which passage it belongs to, and sorting the column by status would break that
  the moment a thread was resolved.

  Vars:  @comment-budget-ignore
    comments  list<Comment>   All comments for the version (roots and replies).
    readOnly  bool            Optional; true when rendering a version other than
                              the current one, where every write control acts on
                              the wrong version. Defaults to false so the Turbo
                              Stream re-renders — which only ever follow a
                              mutation on the current version — stay interactive.
#}
{% set readOnly = readOnly ?? false %}
{% set rootComments = comments|filter(c => c.parent is null)|map(c => c) %}
{# `is empty` would call a comment anchored to the literal text 0 general. #}
{% set generalComments = rootComments|filter(c => c.anchor.quote == '')|map(c => c) %}
{% set anchoredComments = rootComments|filter(c => c.anchor.quote != '')|map(c => c) %}
{% set resolvedCount = rootComments|filter(c => c.threadStatus.value == 'resolved')|length %}
<div id="comment-threads" class="lp-comment-threads" data-resolved-count="{{ resolvedCount }}">
    {% if generalComments|length > 0 %}
    {# Open by default: the disclosure controller reads that starting state off
       the .disclosure-open class, because a <section> has no native `open`. #}
    <section class="lp-general-comments disclosure-open" data-controller="disclosure">
        <button type="button" class="lp-general-comments__toggle"
                aria-controls="general-comments-list"
                data-action="click->disclosure#toggle">
            <twig:ux:icon name="lucide:chevron-right" class="lp-general-comments__caret" />
            {{ 'review.document.group.general'|trans }} · {{ generalComments|length }}
        </button>
        <div id="general-comments-list" class="lp-general-comments__list open" data-disclosure-target="content">
            {% for comment in generalComments %}
                {% set replies = comments|filter(c => c.parent is not null and c.parent.id == comment.id) %}
                <twig:CommentThread :comment="comment" :replies="replies|map(c => c)" :readOnly="readOnly" />
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <div class="lp-review-margin" data-comment-anchor-target="margin">
        {% for comment in anchoredComments %}
            {% set replies = comments|filter(c => c.parent is not null and c.parent.id == comment.id) %}
            <twig:CommentThread :comment="comment" :replies="replies|map(c => c)" :readOnly="readOnly" />
        {% endfor %}
    </div>
</div>
