{% if form.workLinkIds is defined %}
<twig:Ds:FormField as="fieldset">
    <twig:Ds:Label as="legend">{{ form.workLinkIds.vars.label|trans }}</twig:Ds:Label>
    <twig:Ds:Hint>{{ form.workLinkIds.vars.help|trans }}</twig:Ds:Hint>
    <div class="lp-document-work-links">
        {% for choice in form.workLinkIds %}
        <label class="lp-review-verdict-choice">
            {{ form_widget(choice, {attr: {'data-form-draft-target': 'option'}}) }}
            <span>{{ choice.vars.label }}</span>
        </label>
        {% else %}
        <twig:Ds:Hint>{{ 'review.work_links.empty'|trans }}</twig:Ds:Hint>
        {% endfor %}
    </div>
    <twig:Ds:FieldErrors :fieldView="form.workLinkIds" />
    {% do form.workLinkIds.setRendered %}
</twig:Ds:FormField>
{% endif %}
