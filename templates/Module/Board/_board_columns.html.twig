{# The board itself. Rendered by the page and again by the move endpoint's
   stream, so the two can never drift apart. Props: board (BoardView). #}
<div id="board" class="lp-board" data-controller="board-drag">
    {# A drop moves the card at once. This says so when the server refuses. #}
    <p class="lp-board__message"
       data-board-drag-target="message"
       data-message="{{ 'board.drag.failed'|trans }}"
       role="status"
       aria-live="polite"></p>
    <div class="lp-board__columns">
    {% for view in board.columns %}
    <section class="lp-board__column" aria-label="{{ view.column.label|trans }}" data-column-slug="{{ view.column.slug }}">
        <header class="lp-board__column-head">
            <h2 class="lp-board__column-title">{{ view.column.label|trans }}</h2>
            <span class="lp-board__column-count">{{ view.count }}</span>
        </header>

        {% for group in view.groups %}
        <div class="lp-board__group"
             data-board-drag-target="group"
             data-column="{{ view.column.id }}"
             data-priority="{{ group.priority ? group.priority.value : '' }}"
             data-rankable="{{ view.column.terminal ? '0' : '1' }}">
            {% if group.priority %}
            <h3 class="lp-board__group-title">{{ ('board.card.priority.' ~ group.priority.label())|trans }}</h3>
            {% endif %}
            {% for card in group.cards %}
                {# `~ ''` casts the Uuid, which cannot itself be an array key. #}
                {% include '@Board/_card.html.twig' with {card: card, pendingComments: board.pendingComments[card.id ~ '']|default(0)} only %}
            {% endfor %}
        </div>
        {% endfor %}

        {% if view.column.terminal %}
        <p class="lp-board__column-note">{{ 'board.terminal.window'|trans({'%days%': board.terminalWindowDays}) }}</p>
        <a class="lp-board__column-link" href="{{ path('app_project_board_terminal_column', {projectId: board.project.id, columnId: view.column.id}) }}">
            {{ 'board.terminal.history_link'|trans({'%count%': view.terminalTotal}) }}
        </a>
        {% endif %}
    </section>
    {% endfor %}
    </div>
</div>
