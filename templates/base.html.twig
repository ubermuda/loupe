{% extends 'layout_base.html.twig' %}

{% block page %}
        {% if app.user %}
        {% set project = current_project() %}
        {% set route = app.request.attributes.get('_route') %}
        <div class="lp-app">
            <aside class="lp-sidebar">
                <a href="{{ path('app_projects') }}" class="lp-sidebar__brand">{{ 'nav.brand'|trans }}</a>
                {% if project %}
                <div class="lp-switcher" data-controller="popover">
                    <button type="button" class="lp-sidebar__switcher"
                            data-popover-target="trigger"
                            data-action="click->popover#toggle"
                            aria-expanded="false"
                            aria-label="{{ 'nav.switcher.label'|trans }}">
                        <span class="lp-sidebar__switcher-avatar">{{ project.name|slice(0, 1)|upper }}</span>
                        <span class="lp-sidebar__switcher-text">
                            <span class="lp-sidebar__switcher-name">{{ project.name }}</span>
                            {% if project.domain %}<span class="lp-sidebar__switcher-domain">{{ project.domain }}</span>{% endif %}
                        </span>
                        <twig:ux:icon name="lucide:arrow-up-down" class="lp-sidebar__switcher-caret" />
                    </button>
                    {% set switcherProjects = switchable_projects() %}
                    {% set switcherCounts = project_document_counts(switcherProjects) %}
                    <div class="lp-switcher__panel" data-popover-target="panel" hidden>
                        {% for switcherProject in switcherProjects %}
                        <a href="{{ path('app_project_documents', {id: switcherProject.id}) }}" class="lp-switcher__item">
                            <span class="lp-switcher__item-avatar">{{ switcherProject.name|slice(0, 1)|upper }}</span>
                            <span class="lp-switcher__item-text">
                                <span class="lp-switcher__item-name">{{ switcherProject.name }}</span>
                                <span class="lp-switcher__item-count">{{ 'nav.switcher.document_count'|trans({'%count%': switcherCounts[switcherProject.id.toRfc4122()]|default(0)}) }}</span>
                            </span>
                        </a>
                        {% endfor %}
                        <a href="{{ path('app_projects') }}" class="lp-switcher__all">
                            <span class="lp-switcher__all-glyph"><twig:ux:icon name="lucide:plus" /></span>
                            {{ 'nav.switcher.all_projects'|trans }}
                        </a>
                    </div>
                </div>
                <nav class="lp-sidebar__nav">
                    {% set documentsActive = route == 'app_project_documents' or route starts with 'app_document' %}
                    <a href="{{ path('app_project_documents', {id: project.id}) }}"
                       class="lp-sidebar__link{% if documentsActive %} lp-sidebar__link--active{% endif %}"
                       {% if documentsActive %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:file-text" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.documents'|trans }}</span>
                        <span class="lp-sidebar__pill">{{ project_document_count(project) }}</span>
                    </a>
                    {# Opt-in: the flag ships off, so an instance nobody has told
                       otherwise shows no link to a page that answers 404. #}
                    {% if is_feature_enabled('board.enabled') %}
                    {% set boardActive = route starts with 'app_project_board' or route starts with 'app_board_card' %}
                    <a href="{{ path('app_project_board', {id: project.id}) }}"
                       class="lp-sidebar__link{% if boardActive %} lp-sidebar__link--active{% endif %}"
                       {% if boardActive %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:square-kanban" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.board'|trans }}</span>
                    </a>
                    {% endif %}
                    <a href="{{ path('app_project_site_review', {id: project.id}) }}"
                       class="lp-sidebar__link{% if route == 'app_project_site_review' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_project_site_review' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:globe" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.site_review'|trans }}</span>
                        {# The pill counts every comment; it only turns amber while some
                           of them are still waiting on the agent. Both figures come from
                           one call, so the badge costs one query. #}
                        {% set reviewCounts = project_site_review_counts(project) %}
                        <span class="lp-sidebar__pill{% if reviewCounts.pending > 0 %} lp-sidebar__pill--amber{% endif %}">{{ reviewCounts.total }}</span>
                    </a>
                    <a href="{{ path('app_project_connect', {id: project.id}) }}"
                       class="lp-sidebar__link{% if route == 'app_project_connect' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_project_connect' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:code-xml" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.connect'|trans }}</span>
                    </a>
                </nav>
                {% endif %}
                <div class="lp-sidebar__spacer"></div>
                <nav class="lp-sidebar__nav lp-sidebar__nav--secondary">
                    {% if project %}
                    <a href="{{ path('app_project_edit', {id: project.id}) }}"
                       class="lp-sidebar__link{% if route == 'app_project_edit' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_project_edit' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:settings" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.project_settings'|trans }}</span>
                    </a>
                    {% endif %}
                    {% if is_feature_enabled('billing.enabled') %}
                    <a href="{{ path('app_billing_subscribe') }}"
                       class="lp-sidebar__link{% if route == 'app_billing_subscribe' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_billing_subscribe' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:credit-card" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.billing'|trans }}</span>
                    </a>
                    {% endif %}
                    <a href="{{ path('app_account_settings') }}"
                       class="lp-sidebar__link{% if route == 'app_account_settings' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_account_settings' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:user" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.account'|trans }}</span>
                    </a>
                    {# The admin shell links back to the app; without this the app
                       never links forward to it and an admin has to type /admin. #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="lp-sidebar__link">
                        <twig:ux:icon name="lucide:shield" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.admin'|trans }}</span>
                    </a>
                    {% endif %}
                    <a href="{{ path('app_about') }}"
                       class="lp-sidebar__link{% if route == 'app_about' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_about' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:info" />
                        <span class="lp-sidebar__link-label">{{ 'about.page.title'|trans }}</span>
                    </a>
                </nav>
                <div class="lp-sidebar__account">
                    <span class="lp-sidebar__account-avatar">{{ app.user.userIdentifier|slice(0, 1)|upper }}</span>
                    <span class="lp-sidebar__account-text">
                        <span class="lp-sidebar__account-name">{{ app.user.userIdentifier }}</span>
                    </span>
                    <form method="post" action="{{ path('app_logout') }}" class="lp-sidebar__account-logout-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="lp-sidebar__account-logout"
                                aria-label="{{ 'nav.link.logout'|trans }}">
                            <twig:ux:icon name="lucide:log-out" />
                        </button>
                    </form>
                </div>
            </aside>
            <div class="lp-shell">
                <header class="lp-topbar">
                    {% block topbar %}
                        {# Crumbs and meta share one baseline row: they are set at
                           different sizes, so centring each against the bar
                           independently leaves their text sitting off each other. #}
                        <div class="lp-topbar__lead">
                            <nav class="lp-topbar__trail">{% block topbar_crumbs %}{% endblock %}</nav>
                            {% block topbar_meta %}{% endblock %}
                        </div>
                        {% block topbar_actions %}{% endblock %}
                    {% endblock %}
                </header>
                <main class="lp-main">
                    {# Rendered once, here, rather than per page: reading app.flashes
                       consumes them, so a page-level loop below this point would
                       always find the bag empty.

                       Whitelisted, and failing closed on anything else, because
                       the flash bag is not only used for messages: the Connect
                       page passes a freshly created token through it, and that
                       value must never be printed as a notification. A new flash
                       type has to be added here to appear, which is the safe way
                       round. #}
                    {% for label, messages in app.flashes(['success', 'error', 'warning', 'info']) %}
                        {% for message in messages %}
                        <div class="lp-flash lp-flash--{{ label }}" data-controller="flash">
                            <span class="lp-flash__dot"></span>
                            <span class="lp-flash__message">{{ message }}</span>
                            <button type="button" class="lp-flash__dismiss"
                                    data-action="click->flash#dismiss">{{ 'flash.dismiss'|trans }}</button>
                        </div>
                        {% endfor %}
                    {% endfor %}
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
        {% else %}
        {# The shell above has its own <main>; this branch skips the shell, so
           without one here an unauthenticated page offers no main landmark. #}
        <main>{% block body_unauthenticated %}{{ block('body') }}{% endblock %}</main>
        {% endif %}
{% endblock %}
