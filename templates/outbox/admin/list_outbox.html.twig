{% extends '@UbermudaAdmin/base.html.twig' %}

{% block title %}{{ 'outbox.admin.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <twig:UbermudaAdmin:AdminList
        title="{{ 'outbox.admin.title'|trans }}"
        :total="total"
        unitLabel="{{ 'outbox.admin.unit'|trans }}"
        unitLabelPlural="{{ 'outbox.admin.unit_plural'|trans }}"
        frameId="outbox-table"
        :filters="filters"
        route="app_admin_outbox_list"
        :page="page"
        :totalPages="totalPages"
        :pageList="pageList"
        sort="{{ sort }}"
        dir="{{ dir }}"
        tableClass="admin-table"
        emptyLabel="{{ 'outbox.admin.empty'|trans }}"
    >
        <twig:block name="filter_bar">
            {# Hand-rolled rather than <AdminListFilterBar>: that component always
               renders a free-text search box, and an outbox row has no text field
               worth searching. Same wiring otherwise, so sort survives a filter
               change and the table updates inside its frame. #}
            <form method="get" action="{{ path('app_admin_outbox_list') }}"
                  data-controller="autosearch"
                  data-turbo-frame="outbox-table"
                  data-turbo-action="replace"
                  class="admin-card flex items-center gap-3 mb-6 p-4">
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
                <label class="text-sm text-slate-500" for="outbox-project">{{ 'outbox.admin.filter.project'|trans }}</label>
                <select id="outbox-project" name="project" class="admin-field-input"
                        data-action="change->autosearch#search">
                    <option value="">{{ 'outbox.admin.filter.all_projects'|trans }}</option>
                    {% for candidate in projects %}
                        {% set candidateId = candidate.id ~ '' %}
                        <option value="{{ candidateId }}"{{ candidateId == selectedProjectId ? ' selected' : '' }}>{{ candidate.name }}</option>
                    {% endfor %}
                </select>
                <a href="{{ path('app_admin_outbox_list', {sort: sort, dir: dir}) }}"
                   data-autosearch-target="clearButton"
                   data-turbo-frame="_top"
                   class="admin-button-secondary admin-button-small">{{ 'outbox.admin.filter.clear'|trans }}</a>
            </form>
        </twig:block>

        <twig:block name="thead">
            <tr>
                <th>{{ 'outbox.admin.column.project'|trans }}</th>
                <th>{{ 'outbox.admin.column.type'|trans }}</th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_outbox_list" column="createdAt" label="{{ 'outbox.admin.column.created'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_outbox_list" column="publishAttempts" label="{{ 'outbox.admin.column.attempts'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_outbox_list" column="nextAttemptAt" label="{{ 'outbox.admin.column.next_attempt'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th>{{ 'outbox.admin.column.last_error'|trans }}</th>
            </tr>
        </twig:block>

        <twig:block name="tbody">
            {% for event in events %}
                <tr data-outbox-event-id="{{ event.id }}">
                    <td>{{ event.project.name }}</td>
                    <td data-outbox-event-type>{{ event.type }}</td>
                    <td>{{ event.createdAt|date('Y-m-d H:i') }}</td>
                    <td>{{ event.publishAttempts }}</td>
                    <td>{{ event.nextAttemptAt ? event.nextAttemptAt|date('Y-m-d H:i') : 'outbox.admin.due_now'|trans }}</td>
                    <td class="break-all">{{ event.lastPublishError ?? '—' }}</td>
                </tr>
            {% endfor %}
        </twig:block>
    </twig:UbermudaAdmin:AdminList>
{% endblock %}
