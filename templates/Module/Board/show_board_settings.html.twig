{% extends 'base.html.twig' %}

{% block title %}{{ 'board.settings.heading'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ board.project.name }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.project_settings'|trans }}</span>
{% endblock %}

{% block body %}
{% set canManage = is_granted(constant('App\\Module\\Board\\Security\\BoardColumnVoter::MANAGE'), board.project) %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'project.edit.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.edit.page.description'|trans }}</p>
        </div>
    </header>
    <div class="lp-settings-layout lp-settings-layout--columns">
        <nav class="lp-settings-nav" aria-label="{{ 'project.edit.nav.label'|trans }}">
            <a class="lp-settings-nav__item" href="{{ path('app_project_edit', {id: board.project.id}) }}">
                <twig:ux:icon name="lucide:settings" />{{ 'project.edit.nav.general'|trans }}
            </a>
            <a class="lp-settings-nav__item lp-settings-nav__item--active" href="{{ path('app_board_settings', {id: board.project.id}) }}" aria-current="page">
                <twig:ux:icon name="lucide:square-kanban" />{{ 'project.edit.nav.columns'|trans }}
            </a>
            <a class="lp-settings-nav__item" href="{{ path('app_project_connect', {id: board.project.id}) }}">
                <twig:ux:icon name="lucide:code-xml" />{{ 'project.edit.nav.connections'|trans }}
            </a>
        </nav>
        <section class="lp-settings-content lp-settings-panel-card" data-board-column-settings>
            <h2 class="lp-section-title">{{ 'board.settings.heading'|trans }}</h2>
            <p class="lp-connect-hint">{{ 'board.settings.description'|trans }}</p>
            <ol class="lp-settings-columns">
            {% for view in board.columns %}
                <li class="lp-settings-column" data-column-id="{{ view.column.id }}">
                    <div class="lp-settings-column__name">
                        <h3>{{ view.column.label|trans }}</h3>
                        <code>{{ view.column.slug }}</code>
                    </div>
                    {% if view.column.isDefault %}<span class="lp-board__column-flag">{{ 'board.column.flag.default'|trans }}</span>{% endif %}
                    {% if view.column.terminal %}<span class="lp-board__column-flag">{{ 'board.column.flag.terminal'|trans }}</span>{% endif %}
                    {% if canManage %}
                        {% if not loop.first %}
                            {% set moveForm = board_columns_reorder_form(board_column_order(board.columns, loop.index0, -1), board_column_order(board.columns, 0, 0)) %}
                            <form method="post" action="{{ path('app_board_columns_reorder', {id: board.project.id, view: 'settings'}) }}">
                                {{ form_widget(moveForm._token, {id: 'settings-move-token-' ~ view.column.id}) }}
                                {{ form_widget(moveForm.expectedOrder, {id: 'settings-move-expected-order-' ~ view.column.id}) }}
                                {{ form_widget(moveForm.order, {id: 'settings-move-order-' ~ view.column.id}) }}
                                <button class="lp-btn lp-btn--ghost lp-btn--icon" type="submit" aria-label="{{ 'board.column.move.left'|trans }}">
                                    <twig:ux:icon name="lucide:arrow-left" />
                                </button>
                            </form>
                        {% endif %}
                        {% include '@Board/_board_column_menu.html.twig' with {board: board, view: view, index: loop.index0, renameColumnForm: renameColumnForm, returnView: 'settings'} only %}
                    {% endif %}
                </li>
            {% endfor %}
            </ol>
            {% if canManage %}
                {% set addForm = board_column_add_form(addColumnForm) %}
                <div data-controller="modal"{% if addForm.vars.submitted %} data-modal-reopen-value="true"{% endif %}>
                    <button class="lp-btn lp-btn--primary" type="button" data-action="click->modal#open">
                        <twig:ux:icon name="lucide:plus" />{{ 'board.column.add.title'|trans }}
                    </button>
                    <dialog class="lp-dialog" data-modal-target="dialog">
                        <h3 class="lp-dialog-title">{{ 'board.column.add.title'|trans }}</h3>
                        {{ form_start(addForm, {action: path('app_board_column_add', {id: board.project.id, view: 'settings'}), attr: {class: 'lp-form'}}) }}
                            <div class="lp-form-field">
                                {{ form_label(addForm.label, null, {label_attr: {class: 'lp-label'}}) }}
                                {{ form_widget(addForm.label, {attr: {class: 'lp-input'}}) }}
                                <div class="lp-field-errors">{{ form_errors(addForm.label) }}</div>
                            </div>
                            <div class="lp-settings-form-actions">
                                <button class="lp-btn" type="button" data-action="click->modal#close">{{ 'board.column.rename.cancel'|trans }}</button>
                                <button class="lp-btn lp-btn--primary" type="submit">{{ 'board.column.add.submit'|trans }}</button>
                            </div>
                        {{ form_end(addForm) }}
                    </dialog>
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
