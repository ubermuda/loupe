            <trans-unit id="account.reset_password.reset.form.submit">
                <source>account.reset_password.reset.form.submit</source>
                <target>Reset password</target>
            </trans-unit>

            <!-- Reset password flash messages -->
            <trans-unit id="account.reset_password.flash.success">
                <source>account.reset_password.flash.success</source>
                <target>Your password has been reset. You can now sign in.</target>
            </trans-unit>
            <trans-unit id="account.reset_password.flash.invalid_token">
                <source>account.reset_password.flash.invalid_token</source>
                <target>This reset link is invalid or has expired. Please request a new one.</target>
            </trans-unit>

            <!-- Change password form labels -->
            <trans-unit id="account.form.change_password_form.new_password.label">
