
###> symfony/framework-bundle ###
APP_SECRET=619b4f5d000fb7c870f9e4c35b6782c3
###< symfony/framework-bundle ###

###> symfony/mailer ###
# worktree-bootstrap.sh writes WORKTREE_MAILPIT_HOST into a worktree's
# .env.local, naming that worktree's own Mailpit sidecar; unset, this is the
# shared `mailer` container. Here rather than in compose.yaml because container
# environment beats dotenv and would pin every worktree to the shared instance.
MAILER_DSN=smtp://${WORKTREE_MAILPIT_HOST:-mailer}:1025
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# Dev-only shared secret. Matches the hub's publisher/subscriber key fallback in
# compose.yaml so the app and the Mercure hub agree in local development. Dev
# only — production sets its own MERCURE_JWT_SECRET via real env vars.
MERCURE_JWT_SECRET=ChangeThisMercureDevSecretChangeThisMercureDev
###< symfony/mercure-bundle ###

###> app/site-review-bridge ###
# Dev value for the Mercure subscribe URL — the hub behind Traefik. Lives here
# rather than in .env so the production image does not ship it.
MERCURE_PUBLIC_URL=https://mercure.loupe.dev.localhost/.well-known/mercure
###< app/site-review-bridge ###

###> app/site-review ###
# Dev serves the widget to everyone, including signed-out pages. Here rather
# than in .env so the production image does not ship it.
SITE_REVIEW_WIDGET_PUBLIC=1
###< app/site-review ###

###> league/oauth2-server-bundle ###
# Dev-only OAuth keys. The key pair is generated into var/oauth/ by
# `bin/console league:oauth2-server:generate-keypair --skip-if-exists`, which
# worktree provisioning and `just e2e-up` run. Nothing here reaches production.
OAUTH_PRIVATE_KEY=%kernel.project_dir%/var/oauth/private.pem
OAUTH_PRIVATE_KEY_PASSPHRASE=
OAUTH_PUBLIC_KEY=%kernel.project_dir%/var/oauth/public.pem
OAUTH_ENCRYPTION_KEY=dev-only-oauth-encryption-key-change-me
###< league/oauth2-server-bundle ###
