{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'billing.beta_invite.invalid.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col items-center gap-3 py-4 text-center" data-beta-invite-invalid>
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:link-2-off" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-fg">{{ 'billing.beta_invite.invalid.heading'|trans }}</h1>
        <p class="text-fg-mute text-sm mt-1.5 leading-normal">{{ 'billing.beta_invite.invalid.body'|trans }}</p>
    </div>

    <a href="{{ path('app_home') }}" class="auth-link text-sm font-medium mt-1">{{ 'billing.beta_invite.invalid.back'|trans }}</a>
</div>
{% endblock %}
