{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    {% include 'activity/_crumbs.html.twig' with {project: project} only %}
{% endblock %}

{% block topbar_meta %}
    <turbo-frame id="worker-runs-shown" class="lp-live-frame"><span class="lp-topbar__meta">{{ 'bridge.worker_runs.meta.shown'|trans({'%count%': items|length}) }}</span></turbo-frame>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-runs">
    {% include 'activity/_header.html.twig' with {} only %}

    {% include 'activity/_tabs.html.twig' with {project: project, active: 'runs'} only %}

    {# Required on every render, empty list included: without it the page reads
       as a complete history, and a report lost with its bridge would read as a
       worker that never ran. #}
    {% if items|length > 0 or listQuery.isNarrowed %}
    <div class="lp-list-filters">
        {# A GET form, so every control lands in the URL and the view stays
           shareable. `page` is not a field: a changed filter starts at page one. #}
        <form method="get"
              action="{{ path('app_project_worker_runs', {id: project.id}) }}"
              data-controller="autosearch"
              class="lp-filter-form">
            <div class="lp-filter-primary" data-action="focusin->autosearch#revealField">
                <div class="lp-filter-search">
                    <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                    <label class="sr-only" for="worker-run-search">{{ 'bridge.worker_runs.filter.search_label'|trans }}</label>
                    <input type="search"
                           id="worker-run-search"
                           name="search"
                           class="lp-input lp-filter-input"
                           value="{{ listQuery.search }}"
                           placeholder="{{ 'bridge.worker_runs.filter.search_placeholder'|trans }}"
                           data-autosearch-target="field"
                           data-action="input->autosearch#search">
                </div>

                <label class="sr-only" for="worker-run-outcome">{{ 'bridge.worker_runs.filter.outcome_label'|trans }}</label>
                <select id="worker-run-outcome"
                        name="outcome"
                        class="lp-input lp-select lp-filter-select"
                        data-action="change->autosearch#search">
                    <option value="">{{ 'bridge.worker_runs.filter.all_outcomes'|trans }}</option>
                    <option value="open"{{ listQuery.open ? ' selected' : '' }}>{{ 'bridge.worker_runs.filter.open_runs'|trans }}</option>
                    {% for state in states %}
                        <option value="{{ state.value }}"{{ listQuery.state == state ? ' selected' : '' }}>{{ state.translationKey()|trans }}</option>
                    {% endfor %}
                </select>
            </div>

            {# One bridge reports many runs, so the control waits until a second
               bridge makes it a choice rather than a label. #}
            {% if bridgeIds|length > 1 %}
                <label class="sr-only" for="worker-run-bridge">{{ 'bridge.worker_runs.filter.bridge_label'|trans }}</label>
                <select id="worker-run-bridge"
                        name="bridge"
                        class="lp-input lp-select lp-filter-select"
                        data-action="change->autosearch#search">
                    <option value="">{{ 'bridge.worker_runs.filter.all_bridges'|trans }}</option>
                    {% for bridgeId in bridgeIds %}
                        <option value="{{ bridgeId }}"{{ listQuery.bridgeId == bridgeId ? ' selected' : '' }}>{{ bridgeLabels[bridgeId.toRfc4122()] }}</option>
                    {% endfor %}
                </select>
            {% endif %}

            {# Each select waits for a second value, as the bridge select does. A set filter keeps its select, so the reader can clear it. #}
            {% for filter in [
                {name: 'harness', values: harnesses, current: listQuery.harness, label: 'bridge.worker_runs.filter.harness_label', all: 'bridge.worker_runs.filter.all_harnesses'},
                {name: 'account', values: accounts, current: listQuery.account, label: 'bridge.worker_runs.filter.account_label', all: 'bridge.worker_runs.filter.all_accounts'},
                {name: 'model', values: models, current: listQuery.model, label: 'bridge.worker_runs.filter.model_label', all: 'bridge.worker_runs.filter.all_models'},
            ] %}
                {% if filter.values|length > 1 or filter.current is not null %}
                    {% set values = filter.current is null or filter.current in filter.values ? filter.values : filter.values|merge([filter.current]) %}
                    <label class="sr-only" for="worker-run-{{ filter.name }}">{{ filter.label|trans }}</label>
                    <select id="worker-run-{{ filter.name }}"
                            name="{{ filter.name }}"
                            class="lp-input lp-select lp-filter-select"
                            data-action="change->autosearch#search">
                        <option value="">{{ filter.all|trans }}</option>
                        {% for value in values %}
                            <option value="{{ value }}"{{ filter.current == value ? ' selected' : '' }}>{{ value }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
            {% endfor %}

            <a href="{{ path('app_project_worker_runs', {id: project.id}) }}"
               data-autosearch-target="clearButton"
               class="lp-filter-clear">{{ 'bridge.worker_runs.filter.clear'|trans }}</a>
        </form>

        <turbo-frame id="worker-runs-count" class="lp-live-frame"><span class="lp-filter-count">{{ 'bridge.worker_runs.filter.count'|trans({'%count%': filteredTotal}) }}</span></turbo-frame>
    </div>
    {% endif %}

    {% do mercure_subscribe(worker_runs_topic(project)) %}
    {% set frameRequest = app.request.headers.get('Turbo-Frame') is not null %}
    {# The filters stay outside the frame, so a reload never takes the search field from under the reader.
       A page with no filters yet has no field to keep, so it reloads whole and gains them. #}
    <div class="lp-live-frame" data-controller="worker-run-refresh"
         data-worker-run-refresh-frames-value="{{ ['worker-runs-shown', 'worker-runs-count']|json_encode }}"
         data-worker-run-refresh-whole-value="{{ items|length > 0 or listQuery.isNarrowed ? 'false' : 'true' }}">
    <turbo-frame id="worker-runs-frame" class="lp-live-frame" target="_top" data-worker-run-refresh-target="frame">
    {% set commandFlashes = app.flashes('worker-run-command') %}
    {% if commandFlashes is not empty %}
    <div class="lp-worker-run-flashes lp-worker-run-flashes--page" data-worker-run-command-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: commandFlashes}} only %}
    </div>
    {% endif %}
    {% if items|length > 0 %}
    <twig:DataTable modifier="runs" :columns="[
        {label: 'bridge.worker_runs.column.work'|trans},
        {label: 'bridge.worker_runs.column.outcome'|trans},
        {label: 'bridge.worker_runs.column.work_kind'|trans},
        {label: 'bridge.worker_runs.column.duration'|trans, align: 'end'},
        {label: 'bridge.worker_runs.column.started'|trans},
    ]">
        {% for item in items %}
        {% set run = item.run %}
        {% set shownAt = run.startedAt ?? run.receivedAt %}
        {# A search by this run's id is a link to it, so its drawer opens on arrival, and not on each live reload.
           The drawer stays inside the row and the frame, so a live reload sees it open and waits. #}
        <div class="lp-data-table__row" data-worker-run-id="{{ run.id }}" data-controller="modal" data-modal-drawer-value="true"{% if not frameRequest and listQuery.search|lower == (run.id ~ '')|lower %} data-modal-reopen-value="true"{% endif %}>
            <div class="lp-data-table__cell lp-data-table__primary">
                <button type="button" class="lp-data-table__target" data-action="modal#open">
                    {% if run.cardNumber is not null %}<span class="lp-data-table__number">{{ 'bridge.worker_runs.card_number'|trans({'%number%': run.cardNumber}) }}</span>{% else %}<span class="lp-data-table__number" data-worker-run-subject>{{ run.subjectType }}</span>{% endif %}
                    {% if item.cardTitle is not null %}<span class="lp-data-table__title">{{ item.cardTitle }}</span>{% endif %}
                    <span class="sr-only">{{ 'bridge.worker_runs.details.open'|trans }}</span>
                </button>
                {% if item.interactive %}<span class="lp-tag lp-tag--neutral">{{ 'bridge.worker_runs.interactive'|trans }}</span>{% endif %}
                {% if item.command %}<span class="lp-tag lp-tag--neutral" data-worker-run-command>{{ 'bridge.worker_runs.command'|trans }}</span>{% endif %}
            </div>
            <div class="lp-worker-run-outcome">
                <twig:StatusChip :modifier="item.state.chipModifier()" :label="item.state.translationKey()|trans" :reason="run.failureReason" :id="'worker-run-reason-' ~ run.id" />
                {% if item.control and item.control.label %}{% set controlLabel = item.control.label|trans(item.control.labelParameters) %}<span class="lp-worker-run-control-label{{ item.control.labelWarns ? ' lp-worker-run-control-label--warns' : '' }}" title="{{ controlLabel }}" data-worker-run-control-label>{{ controlLabel }}</span>{% endif %}
            </div>
            <span class="lp-data-table__cell">{{ run.workKind ?? 'bridge.worker_runs.no_work_kind'|trans }}{% if run.workerPool is not null %} <span class="lp-tag lp-tag--neutral" data-worker-pool>{{ 'bridge.worker_runs.worker_pool_label'|trans({'%pool%': run.workerPool}) }}</span>{% endif %}{% if run.harness is not null %} <span class="lp-tag lp-tag--neutral" title="{{ 'bridge.worker_runs.details.harness'|trans }}" data-worker-run-harness>{{ run.harness }}</span>{% endif %}{% if run.account is not null %} <span class="lp-tag lp-tag--neutral" title="{{ 'bridge.worker_runs.details.account'|trans }}" data-worker-run-account>{{ run.account }}</span>{% endif %}{% if run.model is not null %} <span class="lp-tag lp-tag--neutral" title="{{ 'bridge.worker_runs.details.model'|trans }}" data-worker-run-model>{{ run.model }}</span>{% endif %}</span>
            <span class="lp-data-table__cell lp-data-table__cell--end">{% if item.interactive and item.state.isOpen() and item.duration() is not null %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}</span>
            <span class="lp-data-table__cell"><time datetime="{{ shownAt|date('c') }}" title="{{ shownAt|date('Y-m-d H:i:s T') }}">{{ shownAt|relative_time }}</time></span>
            {% include '@Bridge/_worker_run_drawer.html.twig' with {item: item, project: project, bridgeLabels: bridgeLabels} only %}
        </div>
        {% endfor %}
    </twig:DataTable>

    <twig:Pagination route="app_project_worker_runs" :page="page" :totalPages="totalPages" :pageList="pageList" :routeParams="{id: project.id}|merge(listQuery.routeParams)" />
    {% else %}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:bot" class="lp-empty-state__icon text-accent w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ (listQuery.isNarrowed ? 'bridge.worker_runs.empty_filtered' : 'bridge.worker_runs.empty')|trans }}</h2>
    </div>
    {% endif %}
    </turbo-frame>
    </div>
</div>
{% endblock %}
