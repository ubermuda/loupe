{% extends 'base.html.twig' %}

{% block title %}{{ 'review.dashboard.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.documents'|trans }}</span>
{% endblock %}

{% block topbar_meta %}
    <span class="lp-topbar__meta">{{ 'review.dashboard.meta.shown'|trans({'%count%': items|length}) }}</span>
{% endblock %}

{% block body %}
{# Unfiltered and archive-free, so it can tell "this project has nothing" from
   "the filters matched nothing". Same number the shell's nav pill shows. #}
{% set totalDocuments = project_document_count(project) %}
<div class="lp-workspace">
    <h1 class="lp-workspace-title lp-workspace-title--doc">{{ 'review.dashboard.page.title'|trans }}</h1>
    {# The default line promises newest-first, which a ranked search and a series
       both make untrue. The series wins, because its order wins in the query. #}
    {% if listQuery.seriesName %}
        {% set descriptionKey = 'review.dashboard.description_series' %}
    {% elseif listQuery.search %}
        {% set descriptionKey = 'review.dashboard.description_ranked' %}
    {% else %}
        {% set descriptionKey = 'review.dashboard.description' %}
    {% endif %}
    <p class="lp-workspace-desc">{{ descriptionKey|trans }}</p>

    {# Six controls in front of a project that has nothing to filter are six dead
       controls, so the bar waits for a first document — but it stays once a
       filter or the archived view is on, whatever the counts say: a filter that
       disappears the moment it matches nothing is a dead end. #}
    {% if totalDocuments > 0 or listQuery.isNarrowed or listQuery.includeArchived %}
    <div class="lp-list-filters">
        {# A GET form, so every control lands in the URL and the whole view stays
           shareable and back-button-able. `page` is deliberately not a field: a
           changed filter starts again at page one. #}
        <form method="get"
              action="{{ path('app_project_documents', {id: project.id}) }}"
              data-controller="autosearch"
              class="lp-filter-form">
            {% if listQuery.includeArchived %}
                <input type="hidden" name="archived" value="1">
            {% endif %}

            <div class="lp-filter-search">
                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                <label class="sr-only" for="document-search">{{ 'review.dashboard.filter.search_label'|trans }}</label>
                {# The field target lets the controller restore focus and caret
                   after a debounced submit: this is a full Turbo visit, so the
                   field being typed into is replaced mid-word. A full visit rather
                   than a frame, so the query lands in the address bar. #}
                <input type="search"
                       id="document-search"
                       name="search"
                       class="lp-input lp-filter-input"
                       value="{{ listQuery.search }}"
                       placeholder="{{ 'review.dashboard.filter.search_placeholder'|trans }}"
                       data-autosearch-target="field"
                       data-action="input->autosearch#search">
            </div>

            <label class="sr-only" for="document-status">{{ 'review.dashboard.filter.status_label'|trans }}</label>
            <select id="document-status"
                    name="status"
                    class="lp-input lp-select lp-filter-select"
                    data-action="change->autosearch#search">
                <option value="">{{ 'review.dashboard.filter.all_statuses'|trans }}</option>
                {% for status in statuses %}
                    <option value="{{ status.value }}"{{ listQuery.status == status ? ' selected' : '' }}>{{ status.translationKey()|trans }}</option>
                {% endfor %}
            </select>

            {% if projectTags|length > 0 %}
                <label class="sr-only" for="document-tag">{{ 'review.dashboard.filter.tag_label'|trans }}</label>
                <select id="document-tag"
                        name="tag"
                        class="lp-input lp-select lp-filter-select"
                        data-action="change->autosearch#search">
                    <option value="">{{ 'review.dashboard.filter.all_tags'|trans }}</option>
                    {% for tag in projectTags %}
                        <option value="{{ tag.name }}"{{ listQuery.tagName == tag.name ? ' selected' : '' }}>{{ tag.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}

            {# Filtering by series is also what puts the list in the series's own
               order, so the control stays out of the way until a series exists. #}
            {% if projectSeries|length > 0 %}
                <label class="sr-only" for="document-series">{{ 'review.dashboard.filter.series_label'|trans }}</label>
                <select id="document-series"
                        name="series"
                        class="lp-input lp-select lp-filter-select"
                        data-action="change->autosearch#search">
                    <option value="">{{ 'review.dashboard.filter.all_series'|trans }}</option>
                    {# The option carries the spelling and the comparison uses the
                       key, because listQuery.seriesName is already folded. #}
                    {% for series in projectSeries %}
                        <option value="{{ series.name }}"{{ listQuery.seriesName == series.normalizedName ? ' selected' : '' }}>{{ series.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}

            <a href="{{ path('app_project_documents', {id: project.id}) }}"
               data-autosearch-target="clearButton"
               class="lp-filter-clear">{{ 'review.dashboard.filter.clear'|trans }}</a>
        </form>

        {# Labelled with what following the link does, rather than one label plus
           aria-pressed: that attribute is defined for role="button" and is
           dropped on an anchor, so both states would announce identically while
           doing opposite things. #}
        {% if listQuery.includeArchived %}
            <a class="lp-filter-chip lp-filter-chip--on"
               href="{{ path('app_project_documents', {id: project.id}|merge(listQuery.withIncludeArchived(false).routeParams)) }}">
                <twig:ux:icon name="lucide:check" class="w-3.5 h-3.5 shrink-0" />
                {{ 'review.dashboard.filter.hide_archived'|trans }}
            </a>
        {% else %}
            <a class="lp-filter-chip"
               href="{{ path('app_project_documents', {id: project.id}|merge(listQuery.withIncludeArchived(true).routeParams)) }}">
                <twig:ux:icon name="lucide:archive" class="w-3.5 h-3.5 shrink-0" />
                {{ 'review.dashboard.filter.show_archived'|trans }}
            </a>
        {% endif %}

        {# The total counts live documents only, so it is omitted while archived
           ones are on screen rather than reporting more rows than documents. #}
        {% if totalDocuments > 0 and not listQuery.includeArchived %}
        <span class="lp-filter-count">{{ 'review.dashboard.filter.count'|trans({'%matching%': filteredTotal, '%total%': totalDocuments}) }}</span>
        {% endif %}
    </div>
    {% endif %}

    {% if items|length > 0 %}
    <div class="lp-document-list">
        {% for item in items %}
        {% set document = item.document %}
        {% set archived = document.archivedAt is not null %}
        <div class="lp-document-row{% if archived %} lp-document-row--archived{% endif %}" data-document-id="{{ document.id }}">
            <a href="{{ path('app_document_review', {projectId: project.id, documentId: document.id}) }}"
               class="lp-document-row__link" aria-label="{{ document.title }}"></a>
            <div class="lp-document-row__main">
                <div class="lp-document-row__head">
                    <span class="lp-document-row__title">{{ document.title }}</span>
                    <span class="lp-document-row__version">{{ 'v' ~ item.versionNumber }}</span>
                    {% if document.series is not null %}
                    <span class="lp-series">{{ 'review.dashboard.series.item'|trans({
                        '%series%': document.series.name,
                        '%ordinal%': document.seriesOrdinal,
                    }) }}</span>
                    {% endif %}
                    {% if archived %}
                    <span class="lp-document-row__archived">{{ 'review.dashboard.archived_tag'|trans }}</span>
                    {% endif %}
                </div>
                <div class="lp-document-row__meta">
                    <span>{{ 'review.dashboard.meta.updated'|trans({'%time%': item.updatedAt|relative_time}) }}</span>
                </div>
                {# Only the MCP tool requires a reason, so most archived rows have
                   none — which is the ordinary case, not a gap. Nothing is
                   rendered then: a label with an empty value beside it, or a
                   dash, reads as a document whose reason went missing. #}
                {% if archived and document.archiveReason %}
                <p class="lp-document-row__archive-reason">{{ 'review.dashboard.archive_reason'|trans({'%reason%': document.archiveReason}) }}</p>
                {% endif %}
                {# A list, not a run of spans: without the semantics a screen
                   reader reads the chips as a continuation of the meta line above
                   them, with no boundary and no count. #}
                {% if document.tags|length > 0 %}
                <ul class="lp-document-row__tags" aria-label="{{ 'review.dashboard.tags.label'|trans }}">
                    {% for tag in document.tags %}
                    <li class="lp-tag">{{ tag.name }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
            {# One indicator, and only when the reader owes the row something. A
               row with nothing waiting shows nothing, because the absence is
               what makes the waiting rows findable. The full breakdown lives on
               the document page. #}
            {% if item.signals.hasWaitingThreads %}
            <span class="lp-document-row__waiting">{{ 'review.dashboard.meta.waiting_count'|trans({'%count%': item.signals.waitingThreadCount}) }}</span>
            {% endif %}
            <span class="lp-badge lp-badge--{{ document.status.value }}">
                {{ document.status.translationKey()|trans }}
            </span>
            <div class="lp-document-row__actions">
                <a href="{{ path('app_document_rename', {projectId: project.id, documentId: document.id}|merge(listQuery.routeParams)) }}"
                   class="lp-document-row__action"
                   aria-label="{{ 'review.dashboard.rename'|trans({'%title%': document.title}) }}">
                    <twig:ux:icon name="lucide:pencil" class="w-4 h-4" />
                </a>
                {# Both states are written out rather than interpolated: the icon
                   importer sees only names it can read as literals, and an icon it
                   never imported renders as nothing in production. #}
                {% set archiveForm = document_archive_form(document, listQuery.routeParams) %}
                {{ form_start(archiveForm, {attr: {class: 'lp-document-row__action-form'}}) }}
                    <button type="submit"
                            class="lp-document-row__action"
                            aria-label="{{ (archived ? 'review.dashboard.unarchive' : 'review.dashboard.archive')|trans({'%title%': document.title}) }}">
                        {% if archived %}
                        <twig:ux:icon name="lucide:archive-restore" class="w-4 h-4" />
                        {% else %}
                        <twig:ux:icon name="lucide:archive" class="w-4 h-4" />
                        {% endif %}
                    </button>
                {{ form_end(archiveForm) }}
            </div>
        </div>
        {% endfor %}
    </div>

    <twig:Pagination route="app_project_documents" :page="page" :totalPages="totalPages" :pageList="pageList" :routeParams="{id: project.id}|merge(listQuery.routeParams)" />
    {% elseif listQuery.isNarrowed %}
    {# "No documents yet" is wrong once a filter is on — the project may be full
       of documents that simply did not match. #}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:search-x" class="lp-empty-state__icon w-8 h-8" />
        <h2 class="lp-empty-state__title">{{ 'review.dashboard.empty_filtered.title'|trans }}</h2>
        <a class="lp-btn" href="{{ path('app_project_documents', {id: project.id}) }}">{{ 'review.dashboard.filter.clear_filters'|trans }}</a>
    </div>
    {% else %}
    {# Telling someone to connect an agent when one is already connected reads as
       the page not knowing its own state; with a token bound the only thing left
       to say is that the agent has not written anything yet. Revoking clears the
       binding, so the relation answers the question on its own. #}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:file-text" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'review.dashboard.empty.title'|trans }}</h2>
        {% if project.mcpToken %}
        <p class="lp-empty-state__body">{{ 'review.dashboard.empty.connected_body'|trans }}</p>
        <a class="lp-btn" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'review.dashboard.empty.tools'|trans }}</a>
        {# The connect page renders its skills section only alongside a token, so
           with none bound this would point at a page that never mentions them. #}
        <p class="lp-empty-state__body">
            {{ 'review.dashboard.empty.skills.hint'|trans }}
            <a class="lp-empty-state__link" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'review.dashboard.empty.skills.action'|trans }}</a>
        </p>
        {% else %}
        <p class="lp-empty-state__body">{{ 'review.dashboard.empty.body'|trans }}</p>
        <a class="lp-btn" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'review.dashboard.empty.connect'|trans }}</a>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
