{% extends 'base.html.twig' %}

{% block title %}{{ 'account.api_token.page.title'|trans }}{% endblock %}

{% block body %}
{%- set mcpUrl = url('app_mcp_endpoint') -%}
{%- set mcpAuthHeader = "Authorization: Bearer YOUR_TOKEN" -%}
{%- set mcpClaudeCmd = "claude mcp add betterplans " ~ mcpUrl ~ " \\\n  --transport http \\\n  --header \"" ~ mcpAuthHeader ~ "\"" -%}
{%- set mcpJson = [
    "{",
    "  \"mcpServers\": {",
    "    \"betterplans\": {",
    "      \"type\": \"http\",",
    "      \"url\": \"" ~ mcpUrl ~ "\",",
    "      \"headers\": {",
    "        \"Authorization\": \"Bearer YOUR_TOKEN\"",
    "      }",
    "    }",
    "  }",
    "}"
]|join("\n") -%}
<div class="bp-page">
    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ 'account.api_token.page.title'|trans }}</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="bp-card mb-6">
        {{ form_start(form, {'action': path('app_api_token_create'), 'method': 'POST', 'attr': {'class': 'bp-form'}}) }}
            <div class="bp-form-field">
                {{ form_label(form.label, null, {'label_attr': {'class': 'bp-label'}}) }}
                {{ form_widget(form.label, {'attr': {'class': 'bp-input'}}) }}
                <div class="bp-field-errors">{{ form_errors(form.label) }}</div>
            </div>
            <div class="bp-form-field">
                {{ form_label(form.scope, null, {'label_attr': {'class': 'bp-label'}}) }}
                {{ form_widget(form.scope, {'attr': {'class': 'bp-input bp-select'}}) }}
                <div class="bp-field-errors">{{ form_errors(form.scope) }}</div>
                <p class="bp-form-hint">{{ 'account.api_token.scope.site_review_warning'|trans }}</p>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="submit" class="bp-btn bp-btn--primary">{{ 'account.api_token.form.submit'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>

    {% if tokens|length > 0 %}
    <div class="bp-doc-list mb-6">
        {% for token in tokens %}
        <div class="bp-doc-row">
            <div class="bp-doc-row__main">
                <span class="bp-doc-row__title">{{ token.label }}</span>
                <div class="bp-doc-row__meta">
                    <span>{{ ('account.api_token.scope.' ~ token.scope.value)|trans }}</span>
                    <span>&middot;</span>
                    <span>{{ token.createdAt|date('M j, Y') }}</span>
                    <span>&middot;</span>
                    {% if token.lastUsedAt %}
                    <span>{{ 'account.api_token.last_used'|trans }} {{ token.lastUsedAt|date('M j, Y') }}</span>
                    {% else %}
                    <span class="text-fg-dim">{{ 'account.api_token.never_used'|trans }}</span>
                    {% endif %}
                </div>
            </div>
            <form method="POST" action="{{ path('app_api_token_revoke', {tokenId: token.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-api-token') }}">
                <button type="submit" class="bp-btn bp-btn--danger">{{ 'account.api_token.action.revoke'|trans }}</button>
            </form>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="bp-card flex flex-col items-center text-center gap-3 py-12 mb-6">
        <twig:ux:icon name="lucide:key-round" class="w-8 h-8 text-fg-dim" />
        <p class="bp-empty not-italic">{{ 'account.api_token.empty'|trans }}</p>
    </div>
    {% endif %}

    <div class="bp-card" id="mcp-connection">
        <h2 class="bp-section-title">{{ 'account.mcp.card.heading'|trans }}</h2>

        <dl class="bp-key-values">
            <div class="bp-key-values__row">
                <dt>{{ 'account.mcp.card.endpoint_label'|trans }}</dt>
                <dd class="bp-copy-row" data-controller="clipboard" data-clipboard-text-value="{{ mcpUrl }}"
                    data-clipboard-copied-label-value="{{ 'account.mcp.card.copied'|trans }}">
                    <code class="bp-code">{{ mcpUrl }}</code>
                    <button type="button" class="bp-btn bp-btn--ghost bp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.mcp.card.copy'|trans }}</button>
                </dd>
            </div>
            <div class="bp-key-values__row">
                <dt>{{ 'account.mcp.card.auth_label'|trans }}</dt>
                <dd class="bp-copy-row" data-controller="clipboard" data-clipboard-text-value="{{ mcpAuthHeader }}"
                    data-clipboard-copied-label-value="{{ 'account.mcp.card.copied'|trans }}">
                    <code class="bp-code">{{ mcpAuthHeader }}</code>
                    <button type="button" class="bp-btn bp-btn--ghost bp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.mcp.card.copy'|trans }}</button>
                </dd>
            </div>
        </dl>

        <div class="bp-code-block" data-controller="clipboard" data-clipboard-text-value="{{ mcpClaudeCmd }}"
             data-clipboard-copied-label-value="{{ 'account.mcp.card.copied'|trans }}">
            <div class="bp-code-block__header">
                <span class="bp-code-block__label">{{ 'account.mcp.card.claude_code_heading'|trans }}</span>
                <button type="button" class="bp-btn bp-btn--ghost bp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.mcp.card.copy'|trans }}</button>
            </div>
            <pre class="bp-pre"><code>{{ mcpClaudeCmd }}</code></pre>
        </div>

        <div class="bp-code-block" data-controller="clipboard" data-clipboard-text-value="{{ mcpJson }}"
             data-clipboard-copied-label-value="{{ 'account.mcp.card.copied'|trans }}">
            <div class="bp-code-block__header">
                <span class="bp-code-block__label">{{ 'account.mcp.card.json_heading'|trans }}</span>
                <button type="button" class="bp-btn bp-btn--ghost bp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.mcp.card.copy'|trans }}</button>
            </div>
            <pre class="bp-pre"><code>{{ mcpJson }}</code></pre>
        </div>

        <p class="bp-form-hint">{{ 'account.mcp.card.tls_note'|trans }}</p>
    </div>
</div>
{% endblock %}
