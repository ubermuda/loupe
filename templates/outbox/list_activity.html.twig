{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_workshop', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'activity.page.title'|trans }}</span>
{% endblock %}

{% block topbar_meta %}<span class="lp-topbar__meta">{{ 'activity.count'|trans({'%count%': events|length}) }}</span>{% endblock %}

{% block body %}
<div class="lp-workspace lp-orchestration-page">
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'activity.heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'activity.description'|trans }}</p>
        </div>
        <span class="lp-status-chip lp-status-chip--ok"><span class="lp-status-chip__dot"></span>{{ 'activity.status.recorded'|trans }}</span>
    </header>
    <p class="lp-page-note">{{ 'activity.durable_notice'|trans }}</p>

    {% if events is not empty %}
    <div class="lp-activity-feed">
        {% for event in events %}
        {% set family = event.type|split('.')|first %}
        <article class="lp-activity-row" data-activity-event-id="{{ event.id }}" data-event-family="{{ family }}">
            <div class="lp-activity-row__icon"><twig:ux:icon name="lucide:activity" /></div>
            <div class="lp-activity-row__body">
                <div class="lp-activity-row__heading">
                    <h2>{{ event.type }}</h2>
                    <time datetime="{{ event.createdAt|date('c') }}">{{ event.createdAt|date('Y-m-d H:i:s') }}</time>
                </div>
                <p>{{ 'activity.event_detail'|trans({'%sequence%': event.sequence ?? '—', '%family%': family}) }}</p>
                <div class="lp-activity-row__meta">
                    <span class="lp-status-chip {{ event.publishedAt ? 'lp-status-chip--ok' : (event.lastPublishError ? 'lp-status-chip--failed' : 'lp-status-chip--pending') }}">
                        <span class="lp-status-chip__dot"></span>
                        {{ (event.publishedAt ? 'activity.delivery.delivered' : (event.lastPublishError ? 'activity.delivery.failed' : 'activity.delivery.pending'))|trans }}
                    </span>
                    {% if event.publishAttempts > 0 %}<span>{{ 'activity.attempts'|trans({'%count%': event.publishAttempts}) }}</span>{% endif %}
                </div>
                {% if event.lastPublishError %}<p class="lp-activity-row__error">{{ event.lastPublishError }}</p>{% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="lp-empty-state" data-activity-empty>
        <twig:ux:icon name="lucide:activity" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'activity.empty.title'|trans }}</h2>
        <p>{{ 'activity.empty.description'|trans }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
