<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% if app.user %}
        {% set project = current_project() %}
        {% set route = app.request.attributes.get('_route') %}
        <div class="lp-app">
            <aside class="lp-sidebar">
                <a href="{{ path('app_projects') }}" class="lp-sidebar__brand">
                    <span class="lp-sidebar__brand-mark"><twig:ux:icon name="lucide:clipboard-check" /></span>
                    <span class="lp-sidebar__brand-text">
                        <span class="lp-sidebar__brand-name">{{ 'nav.brand'|trans }}</span>
                    </span>
                </a>
                {% if project %}
                {#
                  Static identity block, not a control: it used to be a bordered
                  row with an up/down chevron, which reads as a project picker the
                  app does not have. The brand link above is the way back to the
                  projects index.
                #}
                <div class="lp-sidebar__switcher">
                    <span class="lp-sidebar__switcher-avatar">{{ project.name|slice(0, 1)|upper }}</span>
                    <span class="lp-sidebar__switcher-text">
                        <span class="lp-sidebar__switcher-name">{{ project.name }}</span>
                        {% if project.domain %}<span class="lp-sidebar__switcher-domain">{{ project.domain }}</span>{% endif %}
                    </span>
                </div>
                <nav class="lp-sidebar__nav">
                    {% set documentsActive = route == 'app_project_documents' or route starts with 'app_document' %}
                    <a href="{{ path('app_project_documents', {id: project.id}) }}"
                       class="lp-sidebar__link{% if documentsActive %} lp-sidebar__link--active{% endif %}"
                       {% if documentsActive %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:file-text" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.documents'|trans }}</span>
                        <span class="lp-sidebar__pill">{{ project_document_count(project) }}</span>
                    </a>
                    <a href="{{ path('app_project_site_review', {id: project.id}) }}"
                       class="lp-sidebar__link{% if route == 'app_project_site_review' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_project_site_review' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:globe" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.site_review'|trans }}</span>
                        {# The pill counts every submitted comment; it only turns amber
                           while some of them are still waiting on the agent. Both
                           figures come from one call, so the badge costs one query. #}
                        {% set reviewCounts = project_site_review_counts(project) %}
                        <span class="lp-sidebar__pill{% if reviewCounts.pending > 0 %} lp-sidebar__pill--amber{% endif %}">{{ reviewCounts.total }}</span>
                    </a>
                    <a href="{{ path('app_project_connect', {id: project.id}) }}"
                       class="lp-sidebar__link{% if route == 'app_project_connect' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_project_connect' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:code" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.connect'|trans }}</span>
                    </a>
                </nav>
                {% endif %}
                <div class="lp-sidebar__spacer"></div>
                <nav class="lp-sidebar__nav">
                    {% if is_feature_enabled('billing.enabled') %}
                    <a href="{{ path('app_billing_subscribe') }}"
                       class="lp-sidebar__link{% if route == 'app_billing_subscribe' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_billing_subscribe' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:credit-card" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.billing'|trans }}</span>
                    </a>
                    {% endif %}
                    <a href="{{ path('app_account_settings') }}"
                       class="lp-sidebar__link{% if route == 'app_account_settings' %} lp-sidebar__link--active{% endif %}"
                       {% if route == 'app_account_settings' %}aria-current="page"{% endif %}>
                        <twig:ux:icon name="lucide:settings" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.settings'|trans }}</span>
                    </a>
                    {# The admin shell links back to the app; without this the app
                       never links forward to it and an admin has to type /admin. #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="lp-sidebar__link">
                        <twig:ux:icon name="lucide:shield" />
                        <span class="lp-sidebar__link-label">{{ 'nav.link.admin'|trans }}</span>
                    </a>
                    {% endif %}
                </nav>
                {% include '_source_link.html.twig' with {class: 'lp-sidebar__source'} only %}
                <div class="lp-sidebar__account">
                    <twig:ux:icon name="lucide:user" class="lp-sidebar__account-icon" />
                    <span class="lp-sidebar__account-text">
                        <span class="lp-sidebar__account-name">{{ app.user.userIdentifier }}</span>
                    </span>
                    <form method="post" action="{{ path('app_logout') }}" class="lp-sidebar__account-logout-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="lp-sidebar__account-logout"
                                aria-label="{{ 'nav.link.logout'|trans }}">
                            <twig:ux:icon name="lucide:log-out" />
                        </button>
                    </form>
                </div>
            </aside>
            <main class="lp-main">
                {% block body %}{% endblock %}
            </main>
        </div>
        {% else %}
        {% block body_unauthenticated %}{{ block('body') }}{% endblock %}
        {% endif %}
        {% if app.user and site_review_widget_token %}
        <script src="/site-review/widget.js" data-token="{{ site_review_widget_token }}"></script>
        {% endif %}
    </body>
</html>
