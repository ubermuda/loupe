{# The board with epic lanes: one row per lane, then "Other cards".
   Props: board (BoardView, with lanes), runWarnings (CardRunWarning by card id). #}
<div class="lp-board__columns lp-board__columns--lanes" data-board-view-target="board">
    <div class="lp-board-lanes">
        {% for lane in board.lanes %}
            {% include '@Board/_board_lane.html.twig' with {board: board, lane: lane, runWarnings: runWarnings} only %}
        {% endfor %}
        {% include '@Board/_board_lane.html.twig' with {board: board, lane: board.otherCards, runWarnings: runWarnings} only %}
    </div>
</div>
