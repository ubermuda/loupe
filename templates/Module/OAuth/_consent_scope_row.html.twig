{# One consent card row: what the scope allows, and the bounds it keeps. Needs `scope`, an ApiScope. #}
<div class="lp-consent__row">
    <twig:UX:Icon name="lucide:lock" class="lp-consent__row-icon" aria-hidden="true" />
    <div class="lp-consent__row-body">
        <p class="lp-consent__row-primary" data-testid="oauth-consent-scope">{{ ('oauth.consent.row.scope.' ~ scope.value|replace({'-': '_'}))|trans }}</p>
        <p class="lp-consent__row-second">{{ ('oauth.consent.row.scope_bounds.' ~ scope.value|replace({'-': '_'}))|trans }}</p>
    </div>
</div>
