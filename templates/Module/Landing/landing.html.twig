{% extends 'base.html.twig' %}

{% block title %}{{ 'landing.meta.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block meta_description %}<meta name="description" content="{{ 'landing.meta.description'|trans }}">{% endblock %}

{# The visitor reviews this page with the real widget, backed by nothing. #}
{% block site_review_widget %}
<script src="/site-review/widget.js" data-demo></script>
{% endblock %}

{% block body_unauthenticated %}
{# The try-it demo runs the review screen's own comment-anchor controller over
   this page, with a transport that keeps nothing. `doc` is what a visitor may
   annotate, `block` is the offset parent the toolbar and composers position
   against, and `margin` is the overlay the cards land in. #}
<div class="lp-landing" data-controller="comment-anchor" data-comment-anchor-demo-value="true">
<div class="lp-demo-frame" data-comment-anchor-target="block"
     data-action="mouseup->comment-anchor#onDocMouseup mousemove->comment-anchor#onDocMousemove">
<div class="lp-demo-page" data-comment-anchor-target="doc">

    <header class="lp-landing-nav">
        <a href="#top" class="lp-landing-nav__brand">
            <span class="lp-landing-nav__mark"></span>
            {{ 'nav.brand'|trans }}
        </a>
        <nav class="lp-landing-nav__links">
            <a href="#how" class="lp-landing-nav__link">{{ 'landing.nav.how'|trans }}</a>
            <a href="#features" class="lp-landing-nav__link">{{ 'landing.nav.features'|trans }}</a>
            <a href="#selfhost" class="lp-landing-nav__link">{{ 'landing.nav.selfhost'|trans }}</a>
            <a href="#pricing" class="lp-landing-nav__link">{{ 'landing.nav.pricing'|trans }}</a>
            <a href="#faq" class="lp-landing-nav__link">{{ 'landing.nav.faq'|trans }}</a>
            <a href="{{ path('app_login') }}" class="lp-landing-nav__link lp-landing-nav__link--wide">{{ 'landing.nav.login'|trans }}</a>
            <a href="{{ path('app_register') }}" class="lp-btn lp-btn--primary lp-btn--sm">{{ 'landing.cta.signup'|trans }}</a>
        </nav>
    </header>

    <section id="top" class="lp-landing-hero">
        <div class="lp-landing-hero__inner">
            <h1 class="lp-landing-hero__title">
                {{ 'landing.hero.title_before'|trans }}
                <span class="lp-landing-hero__accent">{{ 'landing.hero.title_accent'|trans }}</span>{{ 'landing.hero.title_after'|trans }}
            </h1>
            <p class="lp-landing-hero__lead">{{ 'landing.hero.lead'|trans }}</p>
            <div class="lp-landing-hero__actions">
                <a href="{{ path('app_register') }}" class="lp-btn lp-btn--primary lp-btn--lg">{{ 'landing.cta.signup'|trans }}</a>
                <a href="#selfhost" class="lp-btn lp-btn--outline lp-btn--lg">{{ 'landing.cta.selfhost'|trans }}</a>
            </div>
            <p class="lp-landing-hero__note">{{ 'landing.hero.note'|trans }}</p>
        </div>

        {% include '@Landing/landing/_mock.html.twig' only %}
    </section>

    <p class="lp-demo-hint">
        <span class="lp-demo-hint__lead">{{ 'landing.demo.select_hint_lead'|trans }}</span>
        <span class="lp-demo-hint__body">{{ 'landing.demo.select_hint'|trans }}</span>
    </p>

    <section id="how" class="lp-landing-section">
        <div class="lp-landing-inner">
            <h2 class="lp-landing-title lp-landing-title--spaced">{{ 'landing.how.title'|trans }}</h2>

            <div class="lp-landing-steps">
                {% for step in 1..3 %}
                <div class="lp-landing-step">
                    <span class="lp-landing-step__number">{{ step }}</span>
                    <h3 class="lp-landing-step__title">{{ ('landing.how.step' ~ step ~ '.title')|trans }}</h3>
                    <p class="lp-landing-step__text">{{ ('landing.how.step' ~ step ~ '.text')|trans }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="features" class="lp-landing-section lp-landing-section--tight">
        <div class="lp-landing-inner">
            <div class="lp-landing-features">
                {% for feature in ['anchors', 'suggest', 'versions', 'tokens', 'decisions', 'site_review'] %}
                <div class="lp-landing-feature">
                    <h3 class="lp-landing-feature__title">{{ ('landing.feature.' ~ feature ~ '.title')|trans }}</h3>
                    <p class="lp-landing-feature__text">{{ ('landing.feature.' ~ feature ~ '.text')|trans }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="tech" class="lp-landing-section lp-landing-section--dark">
        <div class="lp-landing-inner">
            <h2 class="lp-landing-title lp-landing-title--on-chrome">{{ 'landing.tech.title'|trans }}</h2>
            <p class="lp-landing-lead lp-landing-lead--on-chrome lp-landing-lead--flush">{{ 'landing.tech.lead'|trans }}</p>
            <p class="lp-landing-doc-links">
                <a href="{{ app_docs_url }}/using/mcp/" class="lp-landing-link--on-chrome">{{ 'landing.tech.docs_link'|trans }}</a>
                <a href="{{ app_docs_url }}/using/site-review/" class="lp-landing-link--on-chrome">{{ 'landing.tech.widget_docs_link'|trans }}</a>
            </p>

            <div class="lp-landing-tabs" data-controller="landing-tabs">
                <div class="lp-landing-tabs__controls" role="tablist" aria-orientation="vertical"
                     aria-label="{{ 'landing.tech.tablist'|trans }}">
                    {% for panel in ['tools', 'markdown', 'widget'] %}
                    <button type="button" class="lp-landing-tab" role="tab"
                            id="tech-tab-{{ panel }}" aria-controls="tech-panel-{{ panel }}"
                            aria-selected="{{ loop.first ? 'true' : 'false' }}"
                            data-landing-tabs-target="tab"
                            data-action="landing-tabs#select">
                        <span class="lp-landing-tab__title">{{ ('landing.tech.' ~ panel ~ '.title')|trans }}</span>
                        <span class="lp-landing-tab__text">{{ ('landing.tech.' ~ panel ~ '.text')|trans }}</span>
                    </button>
                    {% endfor %}
                </div>

                <div class="lp-landing-tabs__stage">
                    <div class="lp-landing-tabs__panel" role="tabpanel" id="tech-panel-tools"
                         aria-labelledby="tech-tab-tools" data-landing-tabs-target="panel">
                        {% include '@Landing/landing/_tech_tools.html.twig' with {tools: mcpToolNames} only %}
                    </div>
                    <div class="lp-landing-tabs__panel" role="tabpanel" id="tech-panel-markdown"
                         aria-labelledby="tech-tab-markdown" data-landing-tabs-target="panel" hidden>
                        {% include '@Landing/landing/_tech_markdown.html.twig' only %}
                    </div>
                    <div class="lp-landing-tabs__panel" role="tabpanel" id="tech-panel-widget"
                         aria-labelledby="tech-tab-widget" data-landing-tabs-target="panel" hidden>
                        {% include '@Landing/landing/_tech_widget.html.twig' only %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="selfhost" class="lp-landing-section">
        <div class="lp-landing-inner lp-landing-stack">
            <h2 class="lp-landing-title lp-landing-title--sm">{{ 'landing.selfhost.title'|trans }}</h2>
            <p class="lp-landing-lead lp-landing-lead--flush">{{ 'landing.selfhost.lead'|trans }}</p>

            <div class="lp-landing-paths">
                <div class="lp-landing-path lp-landing-path--wide">
                    <div class="lp-landing-path__head">
                        <h3 class="lp-landing-path__title">{{ 'landing.selfhost.run.title'|trans }}</h3>
                        <p class="lp-landing-path__text">{{ 'landing.selfhost.run.text'|trans }}</p>
                    </div>

                    <div class="lp-code-dark">
                        <div class="lp-code-dark__header">
                            <span class="lp-code-dark__label">{{ 'landing.selfhost.compose_file'|trans }}</span>
                        </div>
                        <pre class="lp-code-dark__body"><code>{{ composeExcerpt }}</code></pre>
                    </div>

                    <p class="lp-landing-note">
                        {{ 'landing.selfhost.run.note'|trans }}
                        <a href="{{ app_docs_url }}/getting-started/docker-compose/" class="lp-landing-link">{{ 'landing.selfhost.docs_link'|trans }}</a>
                    </p>

                    <div class="lp-landing-actions">
                        {% include '_source_link.html.twig' with {class: 'lp-btn'} only %}
                        <a href="{{ app_docs_url }}/getting-started/docker-compose/" class="lp-btn lp-btn--ghost">{{ 'landing.selfhost.install_action'|trans }}</a>
                    </div>
                </div>

                <div class="lp-landing-path lp-landing-path--sunken">
                    <div class="lp-landing-path__head">
                        <h3 class="lp-landing-path__title">{{ 'landing.selfhost.demo.title'|trans }}</h3>
                        <p class="lp-landing-path__text">{{ 'landing.selfhost.demo.text'|trans }}</p>
                    </div>

                    <div class="lp-code-plain" data-controller="clipboard"
                         data-clipboard-text-value="{{ demoCommand }}"
                         data-clipboard-copied-label-value="{{ 'landing.selfhost.copied'|trans }}">
                        <pre class="lp-code-plain__body"><code>{{ demoCommand }}</code></pre>
                        <button type="button" class="lp-btn lp-btn--sm" data-clipboard-target="button"
                                data-action="clipboard#copy">{{ 'landing.selfhost.copy'|trans }}</button>
                    </div>

                    <p class="lp-landing-note">
                        {{ 'landing.selfhost.demo.note'|trans }}
                        <a href="{{ app_docs_url }}/getting-started/demo/" class="lp-landing-link">{{ 'landing.selfhost.demo_docs_link'|trans }}</a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section id="pricing" class="lp-landing-section lp-landing-section--sunken">
        <div class="lp-landing-inner">
            <h2 class="lp-landing-title lp-landing-title--spaced">{{ 'landing.pricing.title'|trans }}</h2>

            <div class="lp-landing-plans">
                <div class="lp-landing-plan">
                    <div class="lp-landing-plan__head">
                        <h3 class="lp-landing-plan__name">{{ 'landing.pricing.self_host.name'|trans }}</h3>
                        <p class="lp-landing-plan__desc">{{ 'landing.pricing.self_host.desc'|trans }}</p>
                    </div>
                    <p class="lp-landing-plan__price">
                        {{ 'landing.pricing.self_host.price'|trans }}
                        <span class="lp-landing-plan__period">{{ 'landing.pricing.self_host.period'|trans }}</span>
                    </p>
                    <ul class="lp-landing-plan__list">
                        {% for item in 1..3 %}
                        <li class="lp-landing-plan__item">
                            <twig:ux:icon name="lucide:check" class="lp-landing-plan__check" />
                            {{ ('landing.pricing.self_host.item' ~ item)|trans }}
                        </li>
                        {% endfor %}
                    </ul>
                    <a href="{{ app_docs_url }}/getting-started/" class="lp-btn lp-landing-plan__action">{{ 'landing.pricing.self_host.action'|trans }}</a>
                </div>

                <div class="lp-landing-plan lp-landing-plan--hosted">
                    <div class="lp-landing-plan__head">
                        <div class="lp-landing-plan__title-row">
                            <h3 class="lp-landing-plan__name lp-landing-plan__name--on-chrome">{{ 'landing.pricing.hosted.name'|trans }}</h3>
                            <span class="lp-landing-plan__badge">{{ 'landing.pricing.hosted.badge'|trans }}</span>
                        </div>
                        <p class="lp-landing-plan__desc lp-landing-plan__desc--on-chrome">{{ 'landing.pricing.hosted.desc'|trans }}</p>
                    </div>
                    <p class="lp-landing-plan__price lp-landing-plan__price--accent">
                        {{ 'landing.pricing.hosted.price'|trans({'%price%': hostedPrice}) }}
                        <span class="lp-landing-plan__period lp-landing-plan__period--on-chrome">{{ 'landing.pricing.hosted.period'|trans }}</span>
                    </p>
                    <ul class="lp-landing-plan__list">
                        {% for item in 1..3 %}
                        <li class="lp-landing-plan__item lp-landing-plan__item--on-chrome">
                            <twig:ux:icon name="lucide:check" class="lp-landing-plan__check lp-landing-plan__check--accent" />
                            {{ ('landing.pricing.hosted.item' ~ item)|trans }}
                        </li>
                        {% endfor %}
                    </ul>
                    <a href="{{ path('app_register') }}" class="lp-btn lp-btn--primary lp-landing-plan__action">{{ 'landing.cta.signup'|trans }}</a>
                </div>
            </div>
        </div>
    </section>

    <section id="opensource" class="lp-landing-section">
        <div class="lp-landing-inner lp-landing-centered">
            <h2 class="lp-landing-title lp-landing-title--sm">{{ 'landing.opensource.title'|trans }}</h2>
            <p class="lp-landing-lead lp-landing-lead--flush">{{ 'landing.opensource.lead'|trans }}</p>
            <div class="lp-landing-centered__actions">
                {% include '_source_link.html.twig' with {class: 'lp-btn'} only %}
                <a href="{{ app_docs_url }}/" class="lp-btn lp-btn--ghost">{{ 'landing.opensource.docs'|trans }}</a>
            </div>
        </div>
    </section>

    <section id="faq" class="lp-landing-section lp-landing-section--sunken">
        <div class="lp-landing-inner lp-landing-faq">
            <h2 class="lp-landing-title lp-landing-title--sm">{{ 'landing.faq.title'|trans }}</h2>
            <div class="lp-landing-faq__list">
                <div class="lp-landing-faq__item">
                    <h3 class="lp-landing-faq__question">{{ 'landing.faq.agents.question'|trans }}</h3>
                    <p class="lp-landing-faq__answer">
                        {{ 'landing.faq.agents.answer_before'|trans }} <code>{{ 'landing.tech.tools.tool_create'|trans }}</code> {{ 'landing.faq.agents.answer_or'|trans }} <code>{{ 'landing.tech.tools.tool_revise'|trans }}</code>{{ 'landing.faq.agents.answer_after'|trans }}
                    </p>
                </div>
                {% for question in ['technical', 'anchors', 'migrate'] %}
                <div class="lp-landing-faq__item">
                    <h3 class="lp-landing-faq__question">{{ ('landing.faq.' ~ question ~ '.question')|trans }}</h3>
                    <p class="lp-landing-faq__answer">{{ ('landing.faq.' ~ question ~ '.answer')|trans }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="lp-landing-section lp-landing-section--dark lp-landing-cta">
        <div class="lp-landing-cta__inner">
            <h2 class="lp-landing-cta__title">{{ 'landing.closing.title'|trans }}</h2>
            <p class="lp-landing-lead lp-landing-lead--on-chrome lp-landing-lead--flush">{{ 'landing.closing.lead'|trans }}</p>
            <a href="{{ path('app_register') }}" class="lp-btn lp-btn--primary lp-btn--lg">{{ 'landing.cta.signup'|trans }}</a>
            <p class="lp-landing-hero__note">{{ 'landing.closing.note'|trans({'%price%': hostedPrice}) }}</p>
        </div>
    </section>

    {% include '_marketing_footer.html.twig' only %}

</div>
<div class="lp-demo-margin" data-comment-anchor-target="margin"></div>
{% include '@Landing/landing/_demo_layer.html.twig' only %}
</div>

{# Sits in the slot above the site-review widget's launcher, which is fixed
   bottom-right at every width. The widget's panel opens over the same slot. #}
<p class="lp-demo-widget-hint">
    <span class="lp-demo-widget-hint__lead">{{ 'landing.demo.widget_hint_lead'|trans }}</span>
    {{ 'landing.demo.widget_hint'|trans }}
</p>

</div>
{% endblock %}
