                <target>Docs</target>
            </trans-unit>
            <trans-unit id="account.auth.footer.privacy">
                <source>account.auth.footer.privacy</source>
                <target>Privacy</target>
            </trans-unit>
            <trans-unit id="account.auth.footer.terms">
                <source>account.auth.footer.terms</source>
                <target>Terms</target>
            </trans-unit>

            <!-- Login page -->
