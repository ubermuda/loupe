# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Deterministic test key for App\Doctrine\Type\EncryptedStringType (test-only,
# safe to commit) so encrypted_string columns round-trip in the test env.
APP_ENCRYPTION_KEY='hhaLfbxeqGYisAeDbyk8roBc3Do3IlUCFPOaPD61wCc='

# Test-only Mercure secret so subscriber-JWT minting works in the test env.
MERCURE_JWT_SECRET='ChangeThisMercureDevSecretChangeThisMercureDev'
# A column change publishes inline. This port refuses at once, so no test
# reaches the shared dev hub or waits on a missing one.
MERCURE_URL='http://127.0.0.1:9/.well-known/mercure'

# Stripe test-env credentials. No request ever leaves the process in tests: the
# gateway tests inject a recording HTTP client, and the webhook tests sign their
# own payloads with this secret.
STRIPE_SECRET_KEY='sk_test_dummy'
STRIPE_WEBHOOK_SECRET='whsec_test'

# Test value for the Mercure subscribe URL; ShowEventsControllerTest
# asserts the credentials endpoint hands it back verbatim.
MERCURE_PUBLIC_URL='https://mercure.loupe.dev.localhost/.well-known/mercure'

# The widget is rendered only where a token is configured; these let
# SiteReviewWidgetVisibilityTest exercise the audience rule. PUBLIC is left
# empty deliberately — that is production's setting, and the admin-only
# behaviour is the half worth testing.
SITE_REVIEW_WIDGET_TOKEN='widget-token-for-tests'
SITE_REVIEW_WIDGET_PUBLIC=

# Test-only OAuth key pair, committed under tests/Support/oauth/ so the suite
# needs no generation step. Never use these keys anywhere else.
OAUTH_PRIVATE_KEY='%kernel.project_dir%/tests/Support/oauth/private.pem'
OAUTH_PRIVATE_KEY_PASSPHRASE=
OAUTH_PUBLIC_KEY='%kernel.project_dir%/tests/Support/oauth/public.pem'
OAUTH_ENCRYPTION_KEY='test-only-oauth-encryption-key'
