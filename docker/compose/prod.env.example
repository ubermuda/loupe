# Configuration for the reference production stack. Copy to `docker/compose/prod.env`
# (gitignored, and excluded from the production image) and fill it in:
#
#     cp docker/compose/prod.env.example docker/compose/prod.env
#     docker compose -f docker/compose/prod.yaml --env-file docker/compose/prod.env up -d
#
# Always pass --env-file. Docker Compose otherwise reads the repository's `.env`,
# which holds development defaults, and would start production containers with
# them. Every variable in the first section has no usable default, so compose
# aborts rather than starting a half-configured instance.
#
# Everything Loupe reads is documented in `.env`; this file covers what a
# production instance must decide for itself. Anything omitted here falls back to
# the committed default in `.env`.

# --- Required ---------------------------------------------------------------

# openssl rand -hex 16
APP_SECRET=

# The instance's public URL, scheme included, no trailing slash.
DEFAULT_URI=https://loupe.example.com

# Hostnames allowed past the /mcp DNS-rebinding guard (comma-separated, no port).
MCP_ALLOWED_HOSTS=loupe.example.com

# Password for the bundled Postgres container. It is also half of DATABASE_URL,
# which docker/compose/prod.yaml assembles from these three.
POSTGRES_PASSWORD=
# POSTGRES_USER=loupe
# POSTGRES_DB=loupe
# POSTGRES_VERSION=16

# Where transactional mail is sent, and who it comes from. Email verification is
# mandatory, so nobody can register until this works. The address must be on a
# domain you control and have published SPF, DKIM and DMARC records for.
MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM_ADDRESS=noreply@loupe.example.com
# MAILER_FROM_NAME=Loupe

# Gates the first-run install wizard, which fails closed in production: with no
# token /install returns 404 and the first administrator cannot be created.
# Append it once as ?token=<value>. Generate a long random string.
INSTALL_TOKEN=

# Send as an X-Probe-Token header to read the build version from /healthz.
# Empty means /healthz never reports it.
HEALTH_PROBE_TOKEN=

# Optional. Widget token of the project site-review comments should file into.
# Empty serves no widget; when set it is shown to administrators only.
SITE_REVIEW_WIDGET_TOKEN=

# Empty shows the widget to administrators only. "1" offers it to every visitor.
SITE_REVIEW_WIDGET_PUBLIC=

# Empty serves the widget from this instance, which is nearly always right.
SITE_REVIEW_WIDGET_BACKEND=
# Umami. The first two, plus the analytics.enabled flag, before a tag is
# emitted. ANALYTICS_ORIGIN is the script's origin and ANALYTICS_COLLECT_ORIGIN
# the one events post to — the same host self-hosted, two on Umami Cloud.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
ANALYTICS_ORIGIN=
ANALYTICS_COLLECT_ORIGIN=

# Optional: site-review push. Leave both empty and the hub never starts, the
# feature stays off, and the stack is three services. To turn it on, fill both
# in and run every compose command with `--profile mercure`.
#
# Signs the Mercure publisher and subscriber tokens — at least 32 characters,
# and identical for the app and the hub (docker/compose/prod.yaml passes it to both).
MERCURE_JWT_SECRET=
# The hostname your reverse proxy routes to the mercure service. It is a
# separate host from the app: the bridge CLI subscribes here directly.
MERCURE_PUBLIC_URL=

# --- Database backups -------------------------------------------------------

# Optional, and off unless you ask for it: the backup job only runs when every
# compose command for this stack carries `--profile backup`. Leave the profile
# off and the stack makes no outbound connection of its own, exactly as before.
#
# With the profile on, the job dumps the database with `pg_dump --format=custom`
# on an interval, uploads each dump to the bucket below, then deletes its own
# dumps older than the retention window. It validates everything here at start
# and exits with a named error if something is missing, so a misconfigured job
# is a restarting container with a reason in `docker compose logs backup` — not
# a silent one you would go on trusting.
#
# The bucket must be private: a dump holds every account, document and token in
# the instance, and is not encrypted at rest by this job. It is also only half
# of a restore — keep APP_ENCRYPTION_KEY somewhere else. See
# docs/operating/restoring.md.
#
# Any S3-compatible provider works, including the bucket EXPORT_STORAGE_* points
# at, with a prefix of its own. One caveat if you reuse the bucket Terraform
# creates for exports: its lifecycle rule expires every object after 30 days,
# bucket-wide and with no prefix filter, so it silently caps your retention at
# 30 days no matter what BACKUP_RETENTION_DAYS says.

# Bucket name only, no scheme and no path. Unset aborts the job at start.
BACKUP_S3_BUCKET=
# Key prefix inside the bucket. Give each instance its own: dumps under the same
# prefix are pruned together. Empty stores them at the bucket root.
BACKUP_S3_PREFIX=database-backups

# A key allowed to list, put and delete under that prefix. Nothing else is
# needed, and nothing else should be granted.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# The provider's S3 endpoint, e.g. https://fra1.digitaloceanspaces.com. Required
# unless BACKUP_S3_PROVIDER=AWS, which is the only one whose endpoint can be
# inferred from the region.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=

# `Other` suits most providers. Set `AWS`, `DigitalOcean`, `Minio`, `Cloudflare`
# or another name rclone recognises to pick up that provider's quirks.
# BACKUP_S3_PROVIDER=Other
# `true` addresses the bucket as https://host/bucket/key, which is what MinIO and
# most non-AWS providers expect. AWS S3 wants `false`.
# BACKUP_S3_USE_PATH_STYLE=true

# How often a dump is taken. A number with an s, m, h or d suffix. The first dump
# runs as soon as the container starts, so a mistake surfaces immediately rather
# than a day later.
# BACKUP_INTERVAL=24h
# How long dumps are kept. Anything older is deleted from the bucket on the next
# run, so this is the real window — there is no separate archive.
# BACKUP_RETENTION_DAYS=14

# --- Reverse proxy ----------------------------------------------------------

# The proxy in front of this stack, as an IP or CIDR list. Leave empty when it is
# a container or sits on a private network; set it when the proxy reaches the app
# from a public address, or Symfony ignores X-Forwarded-Proto and
# X-Forwarded-For — generated URLs get the wrong scheme and all traffic is
# rate-limited as a single IP.
# TRUSTED_PROXIES=

# Names the containers, volumes and network. Change it to run two stacks on one
# host; they otherwise share a database volume.
# COMPOSE_PROJECT_NAME=loupe

# Published ports. Both bind to loopback so only the proxy can reach them; widen
# them only if this host is itself the edge.
# LOUPE_HTTP_BIND=127.0.0.1:8080
# LOUPE_MERCURE_BIND=127.0.0.1:8081

# --- Image ------------------------------------------------------------------

# The image the stack runs. Override it to deploy from your own registry; it must
# match `prod_image` in the justfile, which is overridden the same way.
# LOUPE_PROD_IMAGE=ghcr.io/ubermuda/loupe:prod

# The backup job's image. Nothing publishes it, so compose builds it locally from
# docker/backup/ the first time you start the profile. Override it only if you
# build and push it yourself.
# LOUPE_BACKUP_IMAGE=loupe-backup:16

# --- Optional ---------------------------------------------------------------

# Where the source of THIS instance can be obtained, linked in the footer of
# every page. Leave it commented out and the committed default applies, which
# points at the upstream repository — true only while you run upstream's code
# unmodified. REQUIRED IF YOU MODIFY LOUPE: the AGPL obliges you to offer your
# own modified source to everyone using the instance over the network, and a
# link to upstream hands them code they are not running.
# APP_SOURCE_URL=https://github.com/you/loupe

# The user with this address is promoted to ROLE_ADMIN on login.
# ADMIN_EMAIL=you@example.com

# base64-encoded 32-byte libsodium key, needed only once an encrypted column is
# in use: php -r 'echo base64_encode(sodium_crypto_secretbox_keygen()), PHP_EOL;'
# APP_ENCRYPTION_KEY=

# Data-export archives default to the `exports` volume shared by the web and
# worker containers, which is what a single-host install wants. Point them at an
# S3-compatible bucket instead if you would rather not keep them on the host.
# EXPORT_STORAGE=s3
# EXPORT_STORAGE_BUCKET=loupe-exports
# Key prefix inside the bucket; empty stores archives at its root.
# EXPORT_STORAGE_PREFIX=
# EXPORT_STORAGE_REGION=
# EXPORT_STORAGE_ENDPOINT=
# EXPORT_STORAGE_KEY=
# EXPORT_STORAGE_SECRET=
# `true` for MinIO and most non-AWS providers, which address buckets as
# https://host/bucket/key rather than https://bucket.host/key.
# EXPORT_STORAGE_USE_PATH_STYLE=false
# The default `private` is what MinIO and DigitalOcean Spaces accept. An AWS S3
# bucket left at "Bucket owner enforced" ownership rejects it and needs
# bucket-owner-full-control instead.
# EXPORT_STORAGE_ACL=private

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# OAUTH_GOOGLE_ID=
# OAUTH_GOOGLE_SECRET=
# OAUTH_GITHUB_ID=
# OAUTH_GITHUB_SECRET=
