                <source>account.login.page.title</source>
                <target>Sign in — App</target>
            </trans-unit>
            <trans-unit id="account.login.topbar.prompt">
                <source>account.login.topbar.prompt</source>
                <target>New to App?</target>
            </trans-unit>
            <trans-unit id="account.login.topbar.link">
                <source>account.login.topbar.link</source>
                <target>Sign up</target>
            </trans-unit>
            <trans-unit id="account.login.heading">
                <source>account.login.heading</source>
                <target>Welcome back</target>
            </trans-unit>
            <trans-unit id="account.login.subheading">
                <source>account.login.subheading</source>
                <target>Sign in to continue to your account.</target>
            </trans-unit>
            <trans-unit id="account.login.form.email.label">
                <source>account.login.form.email.label</source>
                <target>Email</target>
            </trans-unit>
            <trans-unit id="account.login.form.email.placeholder">
                <source>account.login.form.email.placeholder</source>
                <target>you@company.com</target>
            </trans-unit>
            <trans-unit id="account.login.form.password.label">
                <source>account.login.form.password.label</source>
                <target>Password</target>
            </trans-unit>
            <trans-unit id="account.login.form.password.placeholder">
                <source>account.login.form.password.placeholder</source>
                <target>••••••••</target>
            </trans-unit>
            <trans-unit id="account.login.form.forgot_password">
                <source>account.login.form.forgot_password</source>
