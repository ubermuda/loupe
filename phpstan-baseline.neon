# Two controllers whose template names the outcome rather than the action.
# Renaming either would make it worse — `account_deletion/invalid.html.twig`
# says what the page is, and `confirm_account_deletion.html.twig` would not.
# These stay baselined; they are not debt.
parameters:
	ignoreErrors:
		-
			message: '#^Controller ConfirmAccountDeletionController renders a template but none under templates/Module/Account matches its name \(expected "confirm_account_deletion\.html\.twig"; matching ignores case, underscores, and directories\)\.$#'
			identifier: controller.templateName
			count: 1
			path: src/Module/Account/Controller/ConfirmAccountDeletionController.php

		-
			message: '#^Controller JoinWaitlistController renders a template but none under templates/Module/Account matches its name \(expected "join_waitlist\.html\.twig"; matching ignores case, underscores, and directories\)\.$#'
			identifier: controller.templateName
			count: 1
			path: src/Module/Account/Controller/JoinWaitlistController.php

		# The next two are POST-only endpoints that own no template: an invalid
		# submit re-renders the sibling GET page (the project list, the wizard's
		# welcome step) so the errors appear where the form was. A template named
		# after either controller would be a duplicate of that page.
		-
			message: '#^Controller CreateProjectController renders a template but none under templates/Module/Project matches its name \(expected "create_project\.html\.twig"; matching ignores case, underscores, and directories\)\.$#'
			identifier: controller.templateName
			count: 1
			path: src/Module/Project/Controller/CreateProjectController.php

		-
			message: '#^Controller CreateFirstProjectController renders a template but none under templates/Module/Project matches its name \(expected "create_first_project\.html\.twig"; matching ignores case, underscores, and directories\)\.$#'
			identifier: controller.templateName
			count: 1
			path: src/Module/Project/Controller/Wizard/CreateFirstProjectController.php
