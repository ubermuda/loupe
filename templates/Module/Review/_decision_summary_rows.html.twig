{# Rows of the Decisions panel. Rendered by the page and again by the stream
   that follows an answer, so both must be given `rows` in the same shape. Both
   jump actions are listed, as in `_contents_rows.html.twig`. #}
{% for row in rows %}
<li class="lp-decision-summary__item">
    <span class="lp-decision-summary__tag{{ row.answered ? ' lp-decision-summary__tag--answered' }}">{{ row.tag }}</span>
    <a class="lp-decision-summary__link" href="#{{ row.elementId }}"
       data-action="click->metadata-tabs#jump click->contents-rail#jump">{{ row.label }}</a>
    {% if not row.answered %}
    <span class="lp-decision-summary__pending">{{ 'review.document.decisions.pending'|trans }}</span>
    {% else %}
    {% if row.selected is not empty %}<span class="lp-decision-summary__answer">{{ row.selected|join(', ') }}</span>{% endif %}
    {% if row.note is not null %}<span class="lp-decision-summary__note">{{ 'review.document.decisions.note'|trans({'%note%': row.note}) }}</span>{% endif %}
    {% endif %}
</li>
{% endfor %}
