{% extends 'base.html.twig' %}

{% block title %}{{ 'project.workshop.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ workshop.project.name }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'project.workshop.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-workshop" data-workshop data-controller="card-drawer">
    {% set readiness = is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), workshop.project) ? workshop.readiness : null %}
    {% if readiness is not null and workshop.quiet %}
    {% do mercure_subscribe(worker_runs_topic(workshop.project)) %}
    {% do mercure_subscribe(board_topic(workshop.project)) %}
    {#- A run, a card change or an inbox item can end the quiet state, so the whole page reloads. -#}
    <div class="lp-readiness-guide" data-readiness-guide data-readiness-layout="full"
         data-controller="worker-run-refresh"
         data-worker-run-refresh-target="frame"
         data-worker-run-refresh-whole-value="true"
         data-worker-run-refresh-project-value="{{ workshop.project.id }}"
         data-worker-run-refresh-events-value="{{ ['worker_run.changed', 'board.card_changed', 'inbox.open_count_changed']|json_encode }}">
        <header class="lp-page-header">
            <div>
                <h1 class="lp-workshop-title">{{ 'readiness.guide.heading'|trans({'%project%': workshop.project.name}) }}</h1>
                <p class="lp-workspace-desc">{{ 'readiness.guide.description'|trans }}</p>
            </div>
        </header>
        <section class="lp-readiness-discovery" aria-labelledby="readiness-discovery-title">
            <h2 class="lp-workshop-section__title" id="readiness-discovery-title">{{ 'readiness.discovery.title'|trans }}</h2>
            <p>{{ 'readiness.discovery.body'|trans }}</p>
            {% set discovery = readiness.row('repository') %}
            {% if discovery is not null %}<span class="lp-readiness-discovery__status">{{ discovery.status|trans(discovery.statusParameters) }}</span>{% endif %}
        </section>
        {% include '@Project/_readiness_checklist.html.twig' with {project: workshop.project, readiness: readiness, layout: 'full'} only %}
        <form class="lp-readiness-guide__hide" method="post" action="{{ path('app_readiness_guide_hide', {id: workshop.project.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('readiness-guide-hide') }}">
            <button type="submit" class="lp-btn lp-btn--ghost" data-readiness-hide>{{ 'readiness.guide.hide'|trans }}</button>
        </form>
    </div>
    {% else %}
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workshop-title">{{ 'project.workshop.page.heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.workshop.page.description'|trans({'%project%': workshop.project.name}) }}</p>
        </div>
    </header>

    <div class="lp-workshop-summary" aria-label="{{ 'project.workshop.summary.label'|trans }}">
        {% if is_feature_enabled('inbox.enabled') %}<a class="lp-workshop-stat" data-workshop-stat="requests" href="{{ path('app_project_inbox', {id: workshop.project.id}) }}">{% else %}<div class="lp-workshop-stat" data-workshop-stat="requests">{% endif %}
            {% if is_feature_enabled('inbox.enabled') %}<span class="lp-workshop-stat__value">{{ workshop.stats.openInboxItemCount }}</span>{% endif %}
            <span class="lp-workshop-stat__copy"><strong>{{ 'project.workshop.summary.requests'|trans }}</strong>{{ is_feature_enabled('inbox.enabled') ? 'project.workshop.summary.requests_detail'|trans : 'project.workshop.needs_you.disabled'|trans }}</span>
        {% if is_feature_enabled('inbox.enabled') %}</a>{% else %}</div>{% endif %}
        <a class="lp-workshop-stat" data-workshop-stat="open-cards" href="{{ path('app_project_board', {id: workshop.project.id}) }}">
            <span class="lp-workshop-stat__value">{{ workshop.stats.openCardCount }}</span>
            <span class="lp-workshop-stat__copy"><strong>{{ 'project.workshop.summary.cards'|trans }}</strong>{{ 'project.workshop.summary.cards_detail'|trans }}</span>
        </a>
        <a class="lp-workshop-stat" data-workshop-stat="completed-cards" href="{{ path('app_project_board', {id: workshop.project.id}) }}">
            <span class="lp-workshop-stat__value">{{ workshop.stats.completedCardCount }}</span>
            <span class="lp-workshop-stat__copy"><strong>{{ 'project.workshop.summary.completed'|trans }}</strong>{{ 'project.workshop.summary.completed_detail'|trans }}</span>
        </a>
        <a class="lp-btn lp-workshop-summary__action" href="{{ path('app_project_board', {id: workshop.project.id}) }}">
            <twig:ux:icon name="lucide:square-kanban" />
            {{ 'project.workshop.in_motion.action'|trans }}
        </a>
    </div>

    <div class="lp-workshop-layout">
        <div class="lp-workshop-primary">
        <section class="lp-workshop-section">
            <div class="lp-section-heading">
                <h2 class="lp-workshop-section__title">{{ 'project.workshop.needs_you.title'|trans }}{% if is_feature_enabled('inbox.enabled') %} <span>{{ workshop.stats.openInboxItemCount }}</span>{% endif %}</h2>
                {% if is_feature_enabled('inbox.enabled') %}<a class="lp-workshop-text-link" href="{{ path('app_project_inbox', {id: workshop.project.id}) }}">{{ 'project.workshop.needs_you.action'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>{% endif %}
            </div>
            {% if workshop.attention is not empty %}
            <div class="lp-workshop-attention-list">
                {% for item in workshop.attention %}
                <a class="lp-workshop-attention" href="{{ item.url }}" data-workshop-attention>
                    <span class="lp-workshop-attention__icon" data-subject="{{ item.subject }}">{% include '_attention_subject_icon.html.twig' with {subject: item.subject} only %}</span>
                    <span><strong>{{ item.title }}</strong></span>
                    <span class="lp-workshop-attention__badge">{{ ('inbox.item.kind.' ~ item.kind)|trans }}{% if item.blocking %} · {{ 'inbox.item.blocking'|trans }}{% endif %}</span>
                    <twig:ux:icon name="lucide:chevron-right" class="lp-workshop-attention__chevron" />
                </a>
                {% endfor %}
            </div>
            {% else %}
            <p class="lp-workspace-desc">{{ is_feature_enabled('inbox.enabled') ? 'project.workshop.needs_you.clear'|trans : 'project.workshop.needs_you.disabled'|trans }}</p>
            {% endif %}
        </section>

        <section class="lp-workshop-section">
            <div class="lp-section-heading">
                <h2 class="lp-workshop-section__title">{{ 'project.workshop.in_motion.title'|trans }}</h2>
                <a class="lp-workshop-text-link" href="{{ path('app_project_board', {id: workshop.project.id}) }}">{{ 'project.workshop.in_motion.action'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>
            </div>
            {% do mercure_subscribe(board_topic(workshop.project)) %}
            <div class="lp-live-frame"
                 data-controller="worker-run-refresh"
                 data-worker-run-refresh-url-value="{{ path('app_project_workshop_in_motion', {id: workshop.project.id}) }}"
                 data-worker-run-refresh-events-value="{{ ['worker_run.changed', 'board.card_changed', 'board.columns_changed']|json_encode }}">
                {% include '@Project/_workshop_in_motion.html.twig' with {project: workshop.project, inMotion: workshop.inMotion} only %}
            </div>
        </section>
        </div>

        <aside class="lp-workshop-supporting">
            {% if readiness is not null %}
            {% include '@Project/_readiness_checklist.html.twig' with {project: workshop.project, readiness: readiness, layout: 'sidebar'} only %}
            {% endif %}
            <section class="lp-workshop-crew">
                <div class="lp-section-heading">
                    <h2 class="lp-workshop-section__title">{{ 'bridge.agents.heading'|trans }}</h2>
                    <a class="lp-workshop-icon-link" href="{{ path('app_project_agents', {id: workshop.project.id}) }}" aria-label="{{ 'nav.link.agents'|trans }}"><twig:ux:icon name="lucide:chevron-right" /></a>
                </div>
                {% for connection in workshop.connections %}
                <a class="lp-workshop-crew__row" href="{{ connection.url }}" data-workshop-connection="{{ connection.id }}">
                    <span class="lp-workshop-crew__avatar"><twig:ux:icon name="lucide:bot" /></span>
                    <span><strong><span title="{{ connection.id }}" data-bridge-label>{{ connection.label }}</span></strong><small>{{ connection.cliVersion|short_sha }}</small></span>
                    <span class="lp-workshop-crew__status">{{ (connection.quiet ? 'bridge.agents.status.stale' : 'bridge.agents.status.healthy')|trans }}</span>
                </a>
                {% else %}
                <a class="lp-workshop-crew__row" href="{{ path('app_project_connect', {id: workshop.project.id}) }}" data-workshop-crew-empty>
                    <span class="lp-workshop-crew__avatar"><twig:ux:icon name="lucide:bot" /></span>
                    <span><strong>{{ 'project.workshop.connection.title'|trans }}</strong><small>{{ 'project.workshop.connection.eyebrow'|trans }}</small></span>
                    <span class="lp-workshop-crew__status">{{ 'project.workshop.connection.action'|trans }}</span>
                </a>
                {% endfor %}
            </section>

            <section class="lp-workshop-note">
                <div>
                    <h2>{{ 'project.workshop.connection.title'|trans }}</h2>
                    <p>{{ 'project.workshop.connection.body'|trans }}</p>
                    <a class="lp-workshop-text-link" href="{{ path('app_project_connect', {id: workshop.project.id}) }}">{{ 'project.workshop.connection.action'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>
                </div>
                <img class="lp-workshop-note__mascot" src="{{ asset('images/mascots/planner.png') }}" alt="">
            </section>

            <section class="lp-workshop-recent">
                <div class="lp-section-heading">
                    <h2 class="lp-workshop-section__title">{{ 'nav.link.activity'|trans }}</h2>
                    <a class="lp-workshop-text-link" href="{{ path('app_project_activity', {id: workshop.project.id}) }}">{{ 'project.workshop.activity.view_all'|trans }}</a>
                </div>
                {% for entry in workshop.activity %}
                <a class="lp-workshop-recent__row" href="{{ entry.link ? entry.link.url : path('app_project_activity', {id: workshop.project.id}) }}" data-workshop-event="{{ entry.event.id }}">
                    <span><twig:ux:icon name="lucide:activity" /></span>
                    <span><strong>{% include 'outbox/_event_type_label.html.twig' with {type: entry.event.type} only %}</strong><small>{% if entry.link %}{{ entry.link.label }} · {% endif %}<time datetime="{{ entry.event.createdAt|date('c') }}">{{ entry.event.createdAt|relative_time }}</time></small></span>
                </a>
                {% else %}
                <p class="lp-workspace-desc">{{ 'project.workshop.activity.empty'|trans }}</p>
                {% endfor %}
            </section>
        </aside>
    </div>
    {% endif %}
    {% include '@Board/_card_drawer.html.twig' with {project: workshop.project} only %}
</div>
{% endblock %}
