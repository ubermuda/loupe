{% if visible %}
<section class="lp-settings-section lp-settings-panel-card" id="repositories" data-testid="github-repositories">
    <h2 class="lp-section-title">{{ 'github.repositories.title'|trans }}</h2>

    {% if not appConfigured and not hookAvailable %}
    <p class="lp-connect-hint" data-testid="forge-connections-disabled">{{ 'github.repositories.disabled'|trans }}</p>
    {% else %}
        {% if repositories is empty %}
        <p class="lp-connect-hint" data-testid="forge-repositories-empty">{{ 'github.repositories.empty'|trans }}</p>
        {% else %}
        <p class="lp-connect-hint">{{ 'github.repositories.purpose'|trans }}</p>
        {% for repository in repositories %}
        {% set health = repository.health(now).value %}
        <div class="lp-identity-row" data-forge-repository="{{ repository.id }}">
            <twig:ux:icon name="lucide:git-pull-request" class="lp-identity-row__glyph w-4 h-4" />
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name lp-identity-row__name--mono" data-testid="forge-repository-path">{{ repository.path }}</span>
                <span class="lp-identity-row__meta lp-identity-row__meta--plain" data-testid="forge-repository-health">
                    {%- if health == 'working' -%}
                        {{ 'github.repositories.health.working'|trans({'%time%': repository.lastAcceptedAt|date('Y-m-d H:i')}) }}
                    {%- elseif health == 'quiet' -%}
                        {{ 'github.repositories.health.quiet'|trans({'%time%': repository.lastAcceptedAt|date('Y-m-d H:i')}) }}
                    {%- else -%}
                        {{ 'github.repositories.health.waiting'|trans }}
                    {%- endif -%}
                </span>
            </span>
            <div data-controller="modal">
                <button type="button" class="lp-btn lp-btn--danger-ghost lp-btn--sm" data-action="click->modal#open">{{ 'github.repositories.remove.action'|trans }}</button>
                <dialog class="lp-dialog" data-modal-target="dialog" aria-labelledby="remove-repository-title-{{ loop.index }}" data-action="cancel->modal#close">
                    <h2 class="lp-dialog-title" id="remove-repository-title-{{ loop.index }}">{{ 'github.repositories.remove.title'|trans }}</h2>
                    <p class="lp-dialog-desc">{{ 'github.repositories.remove.description'|trans({'%path%': repository.path}) }}</p>
                    <form method="post" action="{{ path('app_forge_repository_remove', {id: project.id, repositoryId: repository.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forge-repository-remove') }}">
                        <div class="lp-dialog-actions">
                            <button type="button" class="lp-btn lp-btn--ghost" data-action="click->modal#close">{{ 'github.repositories.cancel'|trans }}</button>
                            <button type="submit" class="lp-btn lp-btn--danger">{{ 'github.repositories.remove.confirm'|trans }}</button>
                        </div>
                    </form>
                </dialog>
            </div>
        </div>
        {% endfor %}
        {% endif %}

        {# The GitHub App block goes here, shown when appConfigured is true. #}

        <div class="lp-connect-block" id="github-hook">
            <p class="lp-eyebrow">{{ 'github.repositories.hook.eyebrow'|trans }}</p>
            {% if not hookAvailable %}
            <p class="lp-connect-hint" data-testid="github-hook-disabled">{{ 'github.repositories.hook.unavailable'|trans }}</p>
            {% elseif hook is null %}
            <p class="lp-connect-hint">{{ 'github.repositories.hook.purpose'|trans }}</p>
            <form method="post" action="{{ path('app_github_hook_create', {id: project.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('github-hook-create') }}">
                <button type="submit" class="lp-btn lp-btn--primary" data-testid="github-hook-create">
                    <twig:ux:icon name="lucide:plug" />{{ 'github.repositories.hook.create'|trans }}
                </button>
            </form>
            {% else %}
            {% set hookHealth = hook.health().value %}
            <p class="lp-connect-hint" data-testid="github-hook-health">
                {%- if hookHealth == 'failing' -%}
                    {{ 'github.repositories.hook.health.failing'|trans({
                        '%time%': hook.lastRefusedAt|date('Y-m-d H:i'),
                        '%reason%': (hook.lastRefusedReason in ['bad_signature', 'bad_payload']
                            ? 'github.repositories.hook.reason.' ~ hook.lastRefusedReason
                            : 'github.repositories.hook.reason.unknown')|trans,
                    }) }}
                {%- elseif hookHealth == 'working' -%}
                    {{ 'github.repositories.hook.health.working'|trans({'%time%': hook.lastAcceptedAt|date('Y-m-d H:i')}) }}
                {%- else -%}
                    {{ 'github.repositories.hook.health.waiting'|trans }}
                {%- endif -%}
            </p>

            <p class="lp-connect-hint">{{ 'github.repositories.hook.instructions'|trans }}</p>

            {% set hookUrl = url('webhook_forge_github_hook', {hookKey: hook.hookKey}) %}
            <div class="lp-code-dark" data-controller="clipboard" data-clipboard-text-value="{{ hookUrl }}"
                 data-clipboard-copied-label-value="{{ 'project.connect.copied'|trans }}">
                <div class="lp-code-dark__header">
                    <span class="lp-code-dark__label">{{ 'github.repositories.hook.url'|trans }}</span>
                    <button type="button" class="lp-code-dark__copy" data-clipboard-target="button" data-action="clipboard#copy">{{ 'project.connect.copy'|trans }}</button>
                </div>
                <pre class="lp-code-dark__body"><code data-testid="github-hook-url">{{ hookUrl }}</code></pre>
            </div>
            <p class="lp-connect-hint">{{ 'github.repositories.hook.content_type'|trans({'%type%': 'application/json'}) }}</p>

            {% if newSecret %}
            <div class="lp-connect-secret">
                <div class="lp-connect-alert">
                    <twig:ux:icon name="lucide:triangle-alert" class="lp-connect-alert__icon w-4 h-4" />
                    <p class="lp-connect-alert__text">{{ 'github.repositories.hook.secret_once'|trans }}</p>
                </div>
                <div class="lp-code-dark" data-controller="clipboard" data-clipboard-text-value="{{ newSecret }}"
                     data-clipboard-copied-label-value="{{ 'project.connect.copied'|trans }}">
                    <div class="lp-code-dark__header">
                        <span class="lp-code-dark__label">{{ 'github.repositories.hook.secret'|trans }}</span>
                        <button type="button" class="lp-code-dark__copy" data-clipboard-target="button" data-action="clipboard#copy">{{ 'project.connect.copy'|trans }}</button>
                    </div>
                    <pre class="lp-code-dark__body"><code data-testid="github-hook-secret">{{ newSecret }}</code></pre>
                </div>
            </div>
            {% endif %}

            <p class="lp-connect-hint">{{ 'github.repositories.hook.events'|trans }}</p>

            <div data-controller="modal">
                <button type="button" class="lp-btn lp-btn--sm" data-action="click->modal#open" data-testid="github-hook-rotate">
                    <twig:ux:icon name="lucide:rotate-cw" />{{ 'github.repositories.hook.rotate.action'|trans }}
                </button>
                <dialog class="lp-dialog" data-modal-target="dialog" aria-labelledby="rotate-hook-secret-title" data-action="cancel->modal#close">
                    <h2 class="lp-dialog-title" id="rotate-hook-secret-title">{{ 'github.repositories.hook.rotate.title'|trans }}</h2>
                    <p class="lp-dialog-desc">{{ 'github.repositories.hook.rotate.description'|trans }}</p>
                    <form method="post" action="{{ path('app_github_hook_secret_rotate', {id: project.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('github-hook-secret-rotate') }}">
                        <div class="lp-dialog-actions">
                            <button type="button" class="lp-btn lp-btn--ghost" data-action="click->modal#close">{{ 'github.repositories.cancel'|trans }}</button>
                            <button type="submit" class="lp-btn lp-btn--primary">{{ 'github.repositories.hook.rotate.confirm'|trans }}</button>
                        </div>
                    </form>
                </dialog>
            </div>
            {% endif %}
        </div>
    {% endif %}
</section>
{% endif %}
