<div class="lp-review-doc__head">
    <div class="lp-review-doc__heading">
    <div class="lp-review-doc__identity">
        <a class="lp-review-doc__back" href="{{ path('app_project_documents', {id: document.project.id}) }}"
           aria-label="{{ 'review.document.navigation.back'|trans }}"
           title="{{ 'review.document.navigation.back'|trans }}">
            <twig:ux:icon name="lucide:arrow-left" />
        </a>
        <div class="lp-review-doc__identity-text">
            <h1 class="lp-review-doc__title" id="review-document-title">{{ document.title }}</h1>
            <div class="lp-review-doc__byline">
                <span class="lp-review-doc__author">
                    <span class="lp-review-doc__avatar" aria-hidden="true">{{ document.owner.fullName|first|upper }}</span>
                    {{ document.owner.fullName }}
                </span>
                <span class="lp-review-doc__middot" aria-hidden="true">·</span>
                <span>{{ 'review.document.byline_updated'|trans({'%updated%': version.createdAt|relative_time}) }}</span>
                <span class="lp-review-doc__middot" aria-hidden="true">·</span>
                <span class="lp-review-doc__version">{{ 'v' ~ version.versionNumber }}</span>
                {% set lastSeen = lastSeenVersionNumber|default(null) %}
                {% if lastSeen is not null and lastSeen < version.versionNumber %}
                <a class="lp-btn lp-btn--ghost lp-btn--sm lp-doc-meta__unread"
                   href="{{ path('app_document_review_diff', {projectId: document.project.id, documentId: document.id, fromVersionNumber: lastSeen, toVersionNumber: version.versionNumber}) }}">
                    {{ 'review.document.since_last_visit.chip'|trans({'%from%': lastSeen, '%to%': version.versionNumber}) }}
                </a>
                {% endif %}
                {% if returnToDocument %}
                <a class="lp-btn lp-btn--ghost lp-btn--sm" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">
                    <twig:ux:icon name="lucide:file-text" />
                    {{ 'review.document.diff.return'|trans }}
                </a>
                {% endif %}
                {% if showDocumentActions %}
                {% include '@Review/_revise_document.html.twig' with {form: reviseDocumentForm, document: document} only %}
                {% if document.status.value == 'draft' and is_granted(constant('App\\Module\\Review\\Security\\DocumentVoter::MANAGE'), document) %}
                <form method="post" action="{{ path('app_document_publish', {projectId: document.project.id, documentId: document.id}) }}" data-document-publish>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('document-publish') }}">
                    <button type="submit" class="lp-btn lp-btn--ghost lp-btn--sm">
                        <twig:ux:icon name="lucide:send" />
                        {{ 'review.publish.submit'|trans }}
                    </button>
                </form>
                {% endif %}
                {% endif %}
                {% if showPageMenu %}
                {% include '@Review/_page_menu.html.twig' with {document: document, version: version, versionCount: versionCount} only %}
                {% endif %}
            </div>
            {% if showWaitLine|default(false) %}{{ inbox_document_wait_line(document) }}{% endif %}
        </div>
    </div>
    </div>
    <div class="lp-review-workspace-nav">
    <nav class="lp-tabs" aria-label="{{ 'review.document.navigation.label'|trans }}">
        <a class="lp-tabs__tab" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}"
           {% if activeView == 'document' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:file-text" />{{ 'review.document.navigation.document'|trans }}</a>
        {% if versionCount > 1 %}
        <a class="lp-tabs__tab" href="{{ path('app_document_review_diff', {
            projectId: document.project.id,
            documentId: document.id,
            fromVersionNumber: version.versionNumber > 1 ? version.versionNumber - 1 : 1,
            toVersionNumber: version.versionNumber > 1 ? version.versionNumber : 2,
        }) }}" {% if activeView == 'diff' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:git-compare" />{{ 'review.document.navigation.diff'|trans }}</a>
        {% endif %}
        <a class="lp-tabs__tab" href="{{ path('app_document_review_history', {projectId: document.project.id, documentId: document.id}) }}" {% if activeView == 'history' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:history" />{{ 'review.document.navigation.history'|trans }}</a>
    </nav>
    </div>
</div>
