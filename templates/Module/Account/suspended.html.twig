{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.suspended.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col items-center gap-3 py-4 text-center">
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:ban" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-fg">{{ 'account.suspended.heading'|trans }}</h1>
        <p class="text-fg-mute text-sm mt-1.5 leading-normal">{{ 'account.suspended.body'|trans }}</p>
    </div>

    {% if reason %}
        <div class="auth-error w-full text-left">
            <twig:UX:Icon name="lucide:message-square" class="w-3.5 h-3.5 shrink-0 mt-px" aria-hidden="true" />
            <span><span class="font-medium">{{ 'account.suspended.reason_label'|trans }}</span> {{ reason }}</span>
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_logout') }}" class="mt-1.5">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="btn primary sm w-full justify-center">{{ 'account.suspended.logout'|trans }}</button>
    </form>
</div>
{% endblock %}
