{#
  Turbo Stream returned after a comment is added: re-render the whole thread
  list in place (preserving offset order and clearing the empty state).

  Vars:  @comment-budget-ignore
    comments  list<Comment>   All comments for the version.
#}
<turbo-stream action="replace" target="comment-threads">
    <template>
        {% include '@Review/_comment_threads.html.twig' with {comments: comments} only %}
    </template>
</turbo-stream>
