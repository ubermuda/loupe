{# twig-cs-fixer-disable #}
{# Dev-only specimen of the Dialog for the styleguide, so it is intentionally untranslated. #}
<twig:Ds:Dialog :size="variant" open>
    <h3 class="lp-dialog-title">Dialog title</h3>
    <p class="lp-dialog-desc">What the dialog asks, in one or two sentences.</p>
    <div class="lp-dialog-actions">
        <twig:Ds:Button type="button">Cancel</twig:Ds:Button>
        <twig:Ds:Button variant="primary" type="button">Confirm</twig:Ds:Button>
    </div>
</twig:Ds:Dialog>
