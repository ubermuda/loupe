{# One board row: an epic lane, or "Other cards" when lane.epic is null. Each cell shows its column's head and is a drop target.
   Props: board (BoardView), lane (BoardLaneView), runWarnings (CardRunWarning by card id),
   withCards (bool, optional, default true): false draws the cells empty and keeps their counts. #}
{% set epic = lane.epic %}
{% set laneKey = epic ? epic.id ~ '' : 'other' %}
<section class="lp-board-lane{{ epic ? ' lp-board-lane--epic' : ' lp-board-lane--other' }}"
         {% if epic %}id="board-lane-{{ epic.id }}"{% endif %}
         data-lane="{{ laneKey }}"
         {% if epic %}data-controller="board-lane"
         data-board-lane-project-value="{{ board.project.id }}"
         data-board-lane-epic-value="{{ epic.id }}"
         aria-label="#{{ epic.number }} {{ epic.title }}"{% else %}aria-label="{{ 'board.lane.other'|trans }}"{% endif %}>
    {% if epic %}
    {% include '@Board/_board_lane_head.html.twig' with {epic: epic, progress: board.progress[epic.id ~ ''], deck: board.decks[epic.id ~ '']|default(null)} only %}
    {% else %}
    <header class="lp-board-lane__head">
        <h2 class="lp-board-lane__title">{{ 'board.lane.other'|trans }}</h2>
    </header>
    {% endif %}
    <div class="lp-board-lane__body">
    <div class="lp-board-lane__cells">
        {% for view in board.columns %}
        {% set cards = lane.cells[view.column.id ~ '']|default([]) %}
        <section class="lp-board__column lp-board-lane__column"
                 aria-label="{{ view.column.label|trans }}"
                 data-column-slug="{{ view.column.slug }}"
                 data-column-id="{{ view.column.id }}">
            {% include '@Board/_board_column_head.html.twig' with {board: board, view: view, count: cards|length} only %}
            <div class="lp-board-lane__cell"
                 id="board-cell-{{ laneKey }}-{{ view.column.id }}"
                 data-board-drag-target="group"
                 data-column="{{ view.column.id }}"
                 data-lane="{{ laneKey }}"
                 data-rankable="{{ view.column.terminal ? '0' : '1' }}">
                {% if withCards ?? true %}
                {% for card in cards %}
                    {% include '@Board/_card.html.twig' with {card: card, pendingComments: board.pendingComments[card.id ~ '']|default(0), documentCount: board.documentCounts[card.id ~ '']|default(0), progress: board.progress[card.id ~ '']|default(null), inLane: epic is not null, runWarning: runWarnings[card.id ~ '']|default(null), badges: board.badges[card.id ~ '']|default([]), state: board.states[card.id ~ '']|default(null)} only %}
                {% endfor %}
                {% endif %}
            </div>
            {% if not epic %}
                {% include '@Board/_board_column_foot.html.twig' with {board: board, view: view, placeable: true} only %}
            {% endif %}
        </section>
        {% endfor %}
    </div>
    </div>
</section>
