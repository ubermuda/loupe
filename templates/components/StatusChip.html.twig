{#
  Props:  @comment-budget-ignore
    modifier   string   The lp-status-chip--{modifier} colour.
    label      string   Translated state name.
    reason     string   Why the state holds. Shown in a tooltip on hover and focus. Optional.
    id         string   The tooltip id. Optional, generated when absent.
#}
{% props modifier, label, reason = null, id = null %}
{% if reason %}
    {% set tooltipId = id ?? ('status-chip-' ~ random()) %}
    <span class="lp-status-chip lp-status-chip--{{ modifier }} lp-status-chip--reason" tabindex="0" aria-describedby="{{ tooltipId }}">
        <span class="lp-status-chip__dot"></span>
        {{ label }}
        <twig:ux:icon name="lucide:circle-help" class="lp-status-chip__help" aria-hidden="true" />
        <twig:Ds:Tooltip id="{{ tooltipId }}">{{ reason }}</twig:Ds:Tooltip>
    </span>
{% else %}
    <span class="lp-status-chip lp-status-chip--{{ modifier }}">
        <span class="lp-status-chip__dot"></span>
        {{ label }}
    </span>
{% endif %}
