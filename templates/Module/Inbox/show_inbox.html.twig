{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: inbox.project.id}) }}">{{ inbox.project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'inbox.page.title'|trans }}</span>
{% endblock %}

{% block body %}
{% set completed = inbox.completed and not inbox.isSearch %}
<div class="lp-workspace lp-needs-you lp-core-prototype-page lp-core-inbox"{% if not completed and not inbox.isSearch %} data-controller="inbox-anchor" data-inbox-anchor-url-value="{{ path('app_project_inbox', {id: inbox.project.id, queue: 'completed'}) }}"{% endif %}>
    <header class="lp-page-header">
        <div class="lp-page-header__copy">
            <h1 class="lp-workspace-title">{{ 'inbox.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'inbox.page.description'|trans }}</p>
        </div>
        <div class="lp-needs-you__header-actions">
            <a class="lp-btn" href="{{ path('app_project_activity', {id: inbox.project.id}) }}">
                <twig:ux:icon name="lucide:activity" class="w-4 h-4" />
                {{ 'inbox.activity'|trans }}
            </a>
        </div>
    </header>

    {% if not inbox.isEmpty and not inbox.isSearch %}
    <nav class="lp-section-tabs" aria-label="{{ 'inbox.tabs.label'|trans }}">
        <a class="lp-section-tabs__item{{ completed ? '' : ' lp-section-tabs__item--active' }}"
           href="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
           {% if not completed %}aria-current="page"{% endif %}>{{ 'inbox.tabs.open'|trans }}</a>
        <a class="lp-section-tabs__item{{ completed ? ' lp-section-tabs__item--active' : '' }}"
           href="{{ path('app_project_inbox', {id: inbox.project.id, queue: 'completed'}) }}"
           {% if completed %}aria-current="page"{% endif %}>{{ 'inbox.tabs.completed'|trans }}</a>
    </nav>
    {% endif %}

    {% if not inbox.isEmpty %}
    <div class="lp-list-filters">
        {# A GET form, so the search lands in the URL. A new search starts at page one. #}
        <form method="get"
              action="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
              data-controller="autosearch"
              class="lp-filter-form">
            <div class="lp-filter-search">
                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                <label class="sr-only" for="inbox-search">{{ 'inbox.search.label'|trans }}</label>
                <input type="search"
                       id="inbox-search"
                       name="q"
                       class="lp-input lp-filter-input"
                       value="{{ inbox.query }}"
                       placeholder="{{ 'inbox.search.placeholder'|trans }}"
                       data-autosearch-target="field"
                       data-action="input->autosearch#search">
            </div>
            <a href="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
               data-autosearch-target="clearButton"
               class="lp-filter-clear">{{ 'inbox.search.clear'|trans }}</a>
        </form>
        <span class="lp-filter-count">
            {%- if inbox.isSearch -%}
                {{ 'inbox.search.count'|trans({'%count%': inbox.searchTotal}) }}
            {%- elseif completed -%}
                {{ 'inbox.page.completed_count'|trans({'%count%': inbox.closedAskTotal}) }}
            {%- else -%}
                {{ 'inbox.page.waiting_count'|trans({'%count%': inbox.openItemCount}) }}
            {%- endif -%}
        </span>
    </div>
    {% endif %}

    {% if inbox.isEmpty %}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:inbox" class="lp-empty-state__icon text-accent w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'inbox.page.empty'|trans }}</h2>
    </div>
    {% else %}
        {# One queue at a time, as a list of requests beside the selected request. #}
        {% set entries = [] %}
        {% if inbox.isSearch %}
            {% for item in inbox.searchResults %}
                {% set entries = entries|merge([{key: item.id, panelId: 'inbox-panel-' ~ item.id, ask: null, item: item}]) %}
            {% endfor %}
        {% elseif completed %}
            {% for ask in inbox.closedAsks %}
                {% set entries = entries|merge([{key: ask.id, panelId: 'inbox-ask-' ~ ask.id, ask: ask, item: null}]) %}
            {% endfor %}
        {% else %}
            {% for ask in inbox.openAsks %}
                {% set entries = entries|merge([{key: ask.id, panelId: 'inbox-ask-' ~ ask.id, ask: ask, item: null}]) %}
            {% endfor %}
            {% for item in inbox.looseItems %}
                {% set entries = entries|merge([{key: item.id, panelId: 'inbox-panel-' ~ item.id, ask: null, item: item}]) %}
            {% endfor %}
        {% endif %}

        {% set section = inbox.isSearch ? 'search-results' : (completed ? 'closed-asks' : 'open-asks') %}
        {% if entries|length > 0 %}
        <section class="lp-inbox-section lp-inbox-section--queue" data-inbox-section="{{ section }}">
            <div class="lp-inbox-split" data-controller="panel-tabs" data-panel-tabs-active-value="{{ entries|first.key }}">
                <div class="lp-inbox-request-list" role="tablist" aria-label="{{ (completed ? 'inbox.tabs.completed' : 'inbox.tabs.open')|trans }}">
                    {% for entry in entries %}
                        {% include '@Inbox/_inbox_request.html.twig' with {entry: entry} only %}
                    {% endfor %}
                </div>
                <div class="lp-inbox-request-detail">
                    {% for entry in entries %}
                        {% include '@Inbox/_inbox_detail.html.twig' with {entry: entry, inbox: inbox, refusedForm: refusedForm, hidden: not loop.first} only %}
                    {% endfor %}
                </div>
            </div>
        </section>
        {# The open queue is whole, so only the completed asks and the search results page. #}
        {% if completed or inbox.isSearch %}
            {% set pageParams = {id: inbox.project.id}|merge(inbox.isSearch ? {q: inbox.query} : {queue: 'completed'}) %}
            <twig:Pagination route="app_project_inbox" :page="inbox.page" :totalPages="inbox.totalPages" :pageList="inbox.pageList" :routeParams="pageParams" />
        {% endif %}
        {% elseif inbox.isSearch %}
        <div class="lp-empty-state" data-inbox-search-empty>
            <twig:ux:icon name="lucide:search" class="lp-empty-state__icon text-accent w-12 h-12" />
            <h2 class="lp-empty-state__title">{{ 'inbox.search.empty'|trans }}</h2>
        </div>
        {% else %}
        <div class="lp-empty-state" data-inbox-queue-empty="{{ section }}">
            <twig:ux:icon name="lucide:inbox" class="lp-empty-state__icon text-accent w-12 h-12" />
            <h2 class="lp-empty-state__title">{{ (completed ? 'inbox.page.completed_empty' : 'inbox.page.open_empty')|trans }}</h2>
        </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
