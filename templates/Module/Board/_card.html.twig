{# One card face. The whole card is the drag handle.
   Props: card (Card), pendingComments (int), documentCount (int), static (bool, optional): a card shown outside the board,
   which does not drag, skips the prefetch and names its column. progress (CardProgress, optional) shows on an epic.
   inLane (bool, optional) hides the parent tag its lane gives. state (?CardState, optional) draws the one state mark.
   runWarning and badges feed the digest. The tile draws only the Unmanaged badge. #}
{% set static = static ?? false %}
{% set badges = badges ?? [] %}
{% set state = state ?? null %}
{% set progress = progress ?? null %}
{% set inLane = inLane ?? false %}
{% set runWarning = runWarning ?? null %}
{% set tileBadges = badges|filter(badge => 'unmanaged' == badge.value) %}
<article class="lp-board-card{{ static ? ' lp-board-card--static' }}"
         {% if not static %}data-controller="card-prefetch"
         data-board-drag-target="card"
         data-board-filter-target="card"
         data-action="pointerdown->board-drag#press mouseenter->card-prefetch#enter mouseleave->card-prefetch#leave focusin->card-prefetch#enter"
         id="board-card-{{ card.id }}"
         data-card-digest="{{ card_digest(card, pendingComments, documentCount, progress, runWarning, badges, state) }}"{% endif %}
         data-card-id="{{ card.id }}"
         data-card-type="{{ card.type }}"
         data-card-lane="{{ card_type(card).lane ? 'true' : 'false' }}"
         data-card-title="{{ card.title }}">
    {# The identifier and the card's type lead the card face, as the design draws
       them. The number is the handle a person quotes. #}
    <div class="lp-board-card__identity">
        <span class="lp-board-card__number">#{{ card.number }}</span>
        {% include '@Board/_card_type_tag.html.twig' with {card: card} only %}
        {% if state is not null %}
        <twig:Ds:StateMark :kind="state.kind.value" :label="state.kind.translationKey|trans">
            <span class="lp-tooltip__title">{{ state.kind.translationKey|trans }}</span>
            <span>{{ state.reason.translationKey|trans(state.reason.params) }}</span>
            {% if state.reason.since is not null %}
            <span class="lp-tooltip__line--quiet">{{ 'board.card_state.since'|trans({'%time%': state.reason.since|date('Y-m-d H:i')}) }}</span>
            {% endif %}
            <a class="lp-tooltip__link"
               draggable="false"
               href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}"
               data-turbo-frame="card-drawer-frame"
               data-action="click->card-drawer#prepare">{{ 'board.card_state.open_card'|trans }}</a>
        </twig:Ds:StateMark>
        {% endif %}
        {% include '@Board/_card_source_tag.html.twig' with {card: card} only %}
        {% if card.parent and not inLane %}
        <span class="lp-board-card__parent" data-card-parent-tag title="{{ card.parent.title }}">
            <twig:ux:icon name="lucide:arrow-up" class="w-3 h-3 shrink-0" aria-hidden="true" />
            #{{ card.parent.number }}
        </span>
        {% endif %}
        {% if progress %}
        <span class="lp-board-card__progress" data-card-progress>{{ 'board.card.children.progress'|trans({'%done%': progress.done, '%total%': progress.total}) }}</span>
        {% endif %}
    </div>
    {# draggable="false" stops the browser's own link drag taking the gesture. #}
    <a class="lp-board-card__title"
       data-card-prefetch-target="link"
       draggable="false"
       href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}"
       data-turbo-frame="card-drawer-frame"
       data-action="click->card-drawer#prepare">
        {{ card.title }}
    </a>
    {% if static %}
    <twig:Ds:StatusChip :dot="false" class="lp-board-card__status">{{ card.column.label|trans }}</twig:Ds:StatusChip>
    {% endif %}
    {% if tileBadges is not empty %}
    {% include '@Board/_card_badges.html.twig' with {badges: tileBadges} only %}
    {% endif %}
    {% if pendingComments > 0 or card.pullRequests|length > 0 or documentCount > 0 %}
    <div class="lp-board-card__meta">
        {% if pendingComments > 0 %}
        <span class="lp-board-card__reviews" title="{{ 'board.card.site_review.count'|trans({'%count%': pendingComments}) }}">
            <twig:ux:icon name="lucide:message-square" class="w-3.5 h-3.5 shrink-0" />
            {{ pendingComments }}
        </span>
        {% endif %}
        {% if card.pullRequests|length > 0 %}
        <span class="lp-board-card__pulls" title="{{ 'board.card.pull_requests.count'|trans({'%count%': card.pullRequests|length}) }}">
            <twig:ux:icon name="lucide:git-pull-request" class="w-3.5 h-3.5 shrink-0" />
            {{ card.pullRequests|length }}
        </span>
        {% endif %}
        {% if documentCount > 0 %}
        <span class="lp-board-card__documents" title="{{ 'board.card.documents.count'|trans({'%count%': documentCount}) }}">
            <twig:ux:icon name="lucide:file-text" class="w-3.5 h-3.5 shrink-0" />
            {{ documentCount }}
        </span>
        {% endif %}
    </div>
    {% endif %}
</article>
