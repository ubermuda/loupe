{% set form = inbox_document_review_form(review, refusedForm) %}
{{ form_start(form, {action: path('app_inbox_item_review_document', actionParams), attr: {class: 'lp-form', 'data-turbo-frame': responseFrame}}) }}
    <a class="lp-inbox-item__jump" href="{{ path('app_document_review', {projectId: review.item.project.id, documentId: review.document.id}) }}" data-turbo-frame="_top">{{ review.document.title }} · {{ 'inbox.review.version'|trans({'%version%': form.versionNumber.vars.value}) }}</a>
    <div class="lp-field-errors">{{ form_errors(form) }}</div>
    {{ form_widget(form.versionNumber, {type: 'hidden'}) }}
    <div class="lp-field-errors">{{ form_errors(form.versionNumber) }}</div>
    {{ form_widget(form.expectedReviewId) }}
    <div class="lp-field-errors">{{ form_errors(form.expectedReviewId) }}</div>
    <fieldset class="lp-form-field">
        <legend class="lp-label">{{ form.verdict.vars.label|trans }}</legend>
        {% for choice in form.verdict %}
            <label class="lp-review-verdict-choice">{{ form_widget(choice) }}<span>{{ choice.vars.label|trans }}</span></label>
        {% endfor %}
        <div class="lp-field-errors">{{ form_errors(form.verdict) }}</div>
    </fieldset>
    <div class="lp-form-field">
        {{ form_label(form.note, null, {label_attr: {class: 'lp-label'}}) }}
        {{ form_widget(form.note, {attr: {class: 'lp-input', rows: 3}}) }}
        <div class="lp-field-errors">{{ form_errors(form.note) }}</div>
    </div>
    <div class="lp-inbox-item__buttons"><button type="submit" class="lp-btn lp-btn--primary">{{ 'inbox.review.submit'|trans }}</button></div>
{{ form_end(form) }}
