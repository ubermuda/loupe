{#
  Props:  @comment-budget-ignore
    field   FormView   The field whose errors it lists. Without it, the body is the content.
    as      string     div or p. Defaults to div.
  Any other attribute, class included, is passed to the element. A null attribute is left out.
#}
{%- props field = null, as = 'div' -%}
{%- for name, value in attributes.all -%}
    {%- if value is null -%}
        {%- set attributes = attributes.remove(name) -%}
    {%- endif -%}
{%- endfor -%}
<{{ as }}{{ attributes.defaults({class: 'lp-field-errors'}) }}>{% if field %}{{ form_errors(field) }}{% else %}{% block content %}{% endblock %}{% endif %}</{{ as }}>
