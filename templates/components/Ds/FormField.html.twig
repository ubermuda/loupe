{#
  Props:  @comment-budget-ignore
    field   FormView   Renders its label, widget, hint and errors. Without it, the body is the content.
    label   string     Replaces the label text. Optional.
    kind    string     select or textarea, for the widget classes. Optional.
    mono    bool       Draws the widget in the mono font. Optional.
    attr    object     Attributes of the widget. A class is added to the widget classes.
    hint    string     A line of help under the widget. Optional.
    as      string     div or fieldset. Defaults to div.
  Any other attribute, class included, is passed to the wrapper. A null attribute is left out.
#}
{%- props field = null, label = null, kind = null, mono = false, attr = {}, hint = null, as = 'div' -%}
{%- for name, value in attributes.all -%}
    {%- if value is null -%}
        {%- set attributes = attributes.remove(name) -%}
    {%- endif -%}
{%- endfor -%}
<{{ as }}{{ attributes.defaults({class: 'lp-form-field'}) }}>
    {%- if field -%}
        {{ form_label(field, label, {label_attr: {class: ds_label_class()}}) }}
        {{ form_widget(field, {attr: attr|merge({class: (ds_input_class(kind, mono) ~ ' ' ~ (attr.class ?? ''))|trim})}) }}
        {%- if hint %}<twig:Ds:Hint>{{ hint }}</twig:Ds:Hint>{% endif -%}
        <twig:Ds:FieldErrors :field="field" />
    {%- else -%}
        {% block content %}{% endblock %}
    {%- endif -%}
</{{ as }}>
