{% extends 'base.html.twig' %}

{% block title %}{{ 'board.automation.heading'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ project.name }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.project_settings'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'project.edit.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.edit.page.description'|trans }}</p>
        </div>
    </header>
    <div class="lp-settings-layout">
        {% include '@Project/_settings_nav.html.twig' with {project: project, active: 'automation'} only %}
        <section class="lp-settings-content lp-settings-panel-card" data-board-automation-settings>
            <h2 class="lp-section-title">{{ 'board.automation.heading'|trans }}</h2>
            <p class="lp-connect-hint">{{ 'board.automation.description'|trans }}</p>
            {{ form_start(form, {attr: {class: 'lp-form'}}) }}
                <twig:Ds:FormField>
                    <label class="lp-choice">
                        {{ form_widget(form.enabled) }}
                        {{ form.enabled.vars.label|trans }}
                    </label>
                    <twig:Ds:Hint :id="form.enabled.vars.id ~ '_help'">{{ form.enabled.vars.help|trans }}</twig:Ds:Hint>
                    <twig:Ds:FieldErrors :fieldView="form.enabled" data-field-errors="enabled" />
                </twig:Ds:FormField>
                <twig:Ds:FormField>
                    <label class="lp-choice">
                        {{ form_widget(form.commentOnFixQueued) }}
                        {{ form.commentOnFixQueued.vars.label|trans }}
                    </label>
                    <twig:Ds:Hint :id="form.commentOnFixQueued.vars.id ~ '_help'">{{ form.commentOnFixQueued.vars.help|trans }}</twig:Ds:Hint>
                    <twig:Ds:FieldErrors :fieldView="form.commentOnFixQueued" data-field-errors="commentOnFixQueued" />
                    {% if failedComment %}
                        {% set cause = failedComment.cause ?? '' %}
                        <div class="lp-connect-alert" data-fix-run-comment-failure>
                            <twig:ux:icon name="lucide:triangle-alert" class="lp-connect-alert__icon w-4 h-4" />
                            <p class="lp-connect-alert__text">
                                {{ 'board.automation.comment_failure.summary'|trans({'%pull_request%': failedComment.repository ~ '#' ~ failedComment.number}) -}}
                                {% if failedComment.failedAt %} (<time datetime="{{ failedComment.failedAt|date('c') }}" title="{{ failedComment.failedAt|date('Y-m-d H:i:s T') }}">{{ failedComment.failedAt|relative_time }}</time>){% endif %}.
                                {% if cause in ['permission', 'no_installation', 'installation_suspended', 'unknown_pull_request', 'no_commenter', 'lookup_incomplete'] %}
                                    {{ ('board.automation.comment_failure.cause.' ~ cause)|trans }}
                                {% else %}
                                    {{ 'board.automation.comment_failure.cause.other'|trans({'%cause%': cause}) }}
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                </twig:Ds:FormField>
                {% for field in [form.commentOnStaleApproval, form.syncBehind, form.mergePullRequests, form.changeBase, form.epicDraftSwitch, form.closeEpicPullRequests, form.openEpicPullRequests, form.postWidgetReviews, form.siteReviewCheck] %}
                <twig:Ds:FormField>
                    <label class="lp-choice">
                        {{ form_widget(field) }}
                        {{ field.vars.label|trans }}
                    </label>
                    <twig:Ds:Hint :id="field.vars.id ~ '_help'">{{ field.vars.help|trans }}</twig:Ds:Hint>
                    <twig:Ds:FieldErrors :fieldView="field" :data-field-errors="field.vars.name" />
                </twig:Ds:FormField>
                {% endfor %}
                <twig:Ds:FormField>
                    {{ form_label(form.epicBranchPattern, null, {label_attr: {class: ds_label_class()}}) }}
                    {{ form_widget(form.epicBranchPattern, {attr: {class: ds_input_class()}}) }}
                    <twig:Ds:Hint :id="form.epicBranchPattern.vars.id ~ '_help'">{{ form.epicBranchPattern.vars.help|trans }}</twig:Ds:Hint>
                    <twig:Ds:FieldErrors :fieldView="form.epicBranchPattern" data-field-errors="epicBranchPattern" />
                </twig:Ds:FormField>
                <twig:Ds:FormField>
                    {{ form_label(form.stuckDelayMinutes, null, {label_attr: {class: ds_label_class()}}) }}
                    {{ form_widget(form.stuckDelayMinutes, {attr: {class: ds_input_class()}}) }}
                    <twig:Ds:Hint :id="form.stuckDelayMinutes.vars.id ~ '_help'">{{ form.stuckDelayMinutes.vars.help|trans }}</twig:Ds:Hint>
                    <twig:Ds:FieldErrors :fieldView="form.stuckDelayMinutes" data-field-errors="stuckDelayMinutes" />
                </twig:Ds:FormField>
                <div class="lp-settings-form-actions">
                    <twig:Ds:Button variant="primary" type="submit">{{ 'board.automation.submit'|trans }}</twig:Ds:Button>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
</div>
{% endblock %}
