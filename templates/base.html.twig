{% extends 'layout_base.html.twig' %}

{% block page %}
        {% if app.user %}
        <script type="application/json" data-state-age-texts>{{ card_state_age_texts()|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
        {% set project = current_project() %}
        {% set route = app.request.attributes.get('_route') %}
        <div class="lp-app" data-controller="drawer">
            {% if project %}<div hidden data-controller="remember-project" data-remember-project-id-value="{{ project.id }}"></div>{% endif %}
            {# Off a project page the sidebar keeps the last project visited; the topbar does not. #}
            {% with {project: sidebar_project()} %}
            <aside class="lp-sidebar lp-sidebar--drawer" id="lp-sidebar" data-drawer-target="panel">
                <button type="button" class="lp-sidebar__close"
                        data-drawer-target="dismiss"
                        data-action="click->drawer#close"
                        aria-label="{{ 'nav.drawer.close'|trans }}">
                    <twig:ux:icon name="lucide:x" />
                </button>
                <a href="{{ path('app_projects') }}" class="lp-sidebar__brand">
                    <twig:Ds:BrandMark />
                </a>
                {% if project %}
                {% set switcherProjects = switchable_projects() %}
                {% set switcherCounts = project_document_counts(switcherProjects) %}
                <twig:Ds:Menu id="project-switcher-panel" tone="chrome" align="stretch">
                    <twig:block name="trigger">
                        <button type="button" class="lp-sidebar__switcher"
                                data-popover-target="trigger"
                                data-action="click->popover#toggle"
                                aria-expanded="false"
                                aria-controls="project-switcher-panel"
                                aria-label="{{ 'nav.switcher.label'|trans }}">
                            <twig:Ds:Avatar :name="project.name" size="sm" shape="square" tone="danger" />
                            <span class="lp-sidebar__switcher-text">
                                <span class="lp-sidebar__switcher-label">{{ 'nav.switcher.project_label'|trans }}</span>
                                <span class="lp-sidebar__switcher-name">{{ project.name }}</span>
                            </span>
                            <twig:ux:icon name="lucide:arrow-down" class="lp-sidebar__switcher-caret" />
                        </button>
                    </twig:block>
                    <twig:block name="content">
                        {% for switcherProject in switcherProjects %}
                        {% set currentProject = switcherProject.id.equals(project.id) %}
                        <twig:Ds:MenuItem :href="path('app_project_workshop', {id: switcherProject.id})" :current="currentProject">
                            <twig:Ds:Avatar :name="switcherProject.name" size="xs" shape="square" tone="chrome" />
                            <span class="lp-switcher__item-text">
                                <span class="lp-switcher__item-name">{{ switcherProject.name }}</span>
                                <span class="lp-switcher__item-count">{{ 'nav.switcher.document_count'|trans({'%count%': switcherCounts[switcherProject.id.toRfc4122()]|default(0)}) }}</span>
                            </span>
                            {% if currentProject %}<twig:ux:icon name="lucide:check" class="lp-switcher__item-check" />{% endif %}
                        </twig:Ds:MenuItem>
                        {% endfor %}
                        <twig:Ds:MenuItem :href="path('app_projects')" class="lp-switcher__all">
                            <span class="lp-switcher__all-glyph"><twig:ux:icon name="lucide:layout-dashboard" /></span>
                            {{ 'nav.switcher.all_projects'|trans }}
                        </twig:Ds:MenuItem>
                        <twig:Ds:MenuItem :href="path('app_projects', {new: 1})" class="lp-switcher__all">
                            <span class="lp-switcher__all-glyph"><twig:ux:icon name="lucide:plus" /></span>
                            {{ 'nav.switcher.new_project'|trans }}
                        </twig:Ds:MenuItem>
                    </twig:block>
                </twig:Ds:Menu>
                <nav class="lp-sidebar__nav">
                    <span class="lp-sidebar__nav-label">{{ 'nav.group.workspace'|trans }}</span>
                    <twig:Ds:NavItem :url="path('app_project_workshop', {id: project.id})" icon="lucide:layout-dashboard" :label="'nav.link.workshop'|trans" :active="route == 'app_project_workshop'" />
                    {% if is_feature_enabled('inbox.enabled') %}
                    {% do mercure_subscribe(inbox_topic(app.user)) %}
                    <twig:Ds:NavItem :url="path('app_project_inbox', {id: project.id})" icon="lucide:inbox" :label="'nav.link.inbox'|trans" :active="route == 'app_project_inbox'"
                        data-controller="live-pill" data-live-pill-project-value="{{ project.id }}"
                        data-action="turbo:frame-missing->live-pill#keepPill"
                        data-live-pill-events-value="{{ ['inbox.open_count_changed']|json_encode }}"
                        data-live-pill-url-value="{{ path('app_project_inbox_open_count', {id: project.id}) }}">
                        {# Shown only while something waits on the owner, and amber then. #}
                        {% include '@Inbox/_open_count.html.twig' with {project: project, openCount: project_inbox_open_count(project)} only %}
                    </twig:Ds:NavItem>
                    {% include '@Inbox/_live_open_total.html.twig' with {total: inbox_open_total(app.user)} only %}
                    {% endif %}
                    <twig:Ds:NavItem :url="path('app_project_board', {id: project.id})" icon="lucide:square-kanban" :label="'nav.link.board'|trans" :active="route starts with 'app_project_board' or route starts with 'app_board_card'" />
                    <twig:Ds:NavItem :url="path('app_project_documents', {id: project.id})" icon="lucide:file-text" :label="'nav.link.documents'|trans" :active="route == 'app_project_documents' or route starts with 'app_document'" />
                    {% if is_feature_enabled('artifacts.enabled') %}
                    <twig:Ds:NavItem :url="path('app_project_artifacts', {id: project.id})" icon="lucide:app-window" :label="'nav.link.artifacts'|trans" :active="route starts with 'app_project_artifact'" />
                    {% endif %}
                    <span class="lp-sidebar__nav-label lp-sidebar__nav-label--spaced">{{ 'bridge.agents.heading'|trans }}</span>
                    <twig:Ds:NavItem :url="path('app_project_agents', {id: project.id})" icon="lucide:bot" :label="'nav.link.agents'|trans" :active="route == 'app_project_agents'"
                        data-controller="live-pill" data-live-pill-project-value="{{ project.id }}"
                        data-action="turbo:frame-missing->live-pill#keepPill"
                        data-live-pill-events-value="{{ ['worker_run.changed']|json_encode }}"
                        data-live-pill-url-value="{{ path('app_project_agents_count', {id: project.id}) }}">
                        {% include '@Bridge/_agents_count.html.twig' with {project: project, figures: project_agents_figures(project)} only %}
                    </twig:Ds:NavItem>
                    <twig:Ds:NavItem :url="path('app_project_workflow', {id: project.id})" icon="lucide:workflow" :label="'nav.link.workflow'|trans" :active="route == 'app_project_workflow'" />
                    {# A frame response replaces the cookie of its host page, so only a full page subscribes. #}
                    {% if not app.request.headers.has('Turbo-Frame') %}{% do mercure_subscribe(worker_runs_topic(project)) %}{% endif %}
                    <twig:Ds:NavItem :url="path('app_project_worker_runs', {id: project.id, outcome: 'open'})" icon="lucide:activity" :label="'nav.link.activity'|trans" :active="route in ['app_project_worker_runs', 'app_project_activity']"
                        data-controller="live-pill" data-live-pill-project-value="{{ project.id }}"
                        data-action="turbo:frame-missing->live-pill#keepPill"
                        data-live-pill-events-value="{{ ['worker_run.changed']|json_encode }}"
                        data-live-pill-url-value="{{ path('app_project_activity_open_count', {id: project.id}) }}">
                        {% include '@Bridge/_activity_open_count.html.twig' with {project: project, openCount: project_open_run_count(project)} only %}
                    </twig:Ds:NavItem>
                    <twig:Ds:NavItem :url="path('app_project_analytics_metrics', {id: project.id})" icon="lucide:chart-column" :label="'nav.link.analytics'|trans" :active="route starts with 'app_project_analytics_'" />
                    <twig:Ds:NavItem :url="path('app_project_outbox', {id: project.id})" icon="lucide:send" :label="'nav.link.outbox'|trans" :active="route == 'app_project_outbox'" />
                </nav>
                {% endif %}
                <div class="lp-sidebar__spacer"></div>
                <nav class="lp-sidebar__nav lp-sidebar__nav--secondary">
                    {% if project %}
                    <twig:Ds:NavItem :url="path('app_project_edit', {id: project.id})" icon="lucide:settings" :label="'nav.link.project_settings'|trans" :active="route in ['app_project_edit', 'app_board_settings', 'app_board_automation_settings', 'app_project_connect']" />
                    {% endif %}
                    {% if is_feature_enabled('inbox.enabled') %}
                    <twig:Ds:NavItem :url="path('app_account_inbox')" icon="lucide:mails" :label="'inbox.account.nav'|trans" :active="route == 'app_account_inbox'" />
                    {% endif %}
                    <twig:Ds:NavItem :url="path('app_account_profile')" icon="lucide:user" :label="'nav.link.account'|trans" :active="route in ['app_account_profile', 'app_account_connected_apps', 'app_account_data', 'app_billing_subscribe']" />
                    {# The admin shell links back to the app; without this the app
                       never links forward to it and an admin has to type /admin. #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <twig:Ds:NavItem :url="path('app_admin_dashboard')" icon="lucide:shield" :label="'nav.link.admin'|trans" />
                    {% endif %}
                    <twig:Ds:NavItem :url="path('app_about')" icon="lucide:info" :label="'about.page.title'|trans" :active="route == 'app_about'" />
                </nav>
                <div class="lp-sidebar__account">
                    <twig:Ds:Avatar :name="app.user.userIdentifier" size="xs" tone="chrome" />
                    <span class="lp-sidebar__account-text">
                        <span class="lp-sidebar__account-name">{{ app.user.userIdentifier }}</span>
                    </span>
                    <twig:Ds:ActionForm :action="path('app_logout')" token="logout" class="lp-sidebar__account-logout-form">
                        <button type="submit" class="lp-sidebar__account-logout"
                                aria-label="{{ 'nav.link.logout'|trans }}">
                            <twig:ux:icon name="lucide:log-out" />
                        </button>
                    </twig:Ds:ActionForm>
                </div>
            </aside>
            {% endwith %}
            <div class="lp-scrim" data-drawer-target="scrim" data-action="click->drawer#close" hidden></div>
            <div class="lp-shell lp-shell--{% block shell_width 'default' %}" data-drawer-target="content">
                <header class="lp-topbar">
                    {# Outside `block topbar`, so a page that replaces the block
                       cannot take the only way back to the nav with it. #}
                    <button type="button" class="lp-topbar__menu"
                            data-drawer-target="trigger"
                            data-action="click->drawer#toggle"
                            aria-controls="lp-sidebar"
                            aria-expanded="false"
                            aria-label="{{ 'nav.drawer.open'|trans }}">
                        <twig:ux:icon name="lucide:menu" />
                    </button>
                    {% block topbar %}
                        {# Crumbs and meta share one baseline row: they are set at
                           different sizes, so centring each against the bar
                           independently leaves their text sitting off each other. #}
                        <div class="lp-topbar__lead">
                            {% block topbar_crumbs %}{% endblock %}
                            {% block topbar_meta %}{% endblock %}
                        </div>
                        {# Before the global actions, so the bell and New work stay right-most on every page. #}
                        {% block topbar_actions %}{% endblock %}
                        <div class="lp-topbar__global-actions" aria-label="{{ 'nav.global_actions.label'|trans }}">
                            {% if is_feature_enabled('search.topbar.enabled') %}
                            {% include 'search/_search_dialog.html.twig' with {project: project} only %}
                            {% endif %}
                            {% if project %}
                            {% include 'outbox/_activity_drawer.html.twig' with {project: project} only %}
                            {% endif %}
                            {% if project %}
                            <twig:Ds:Button variant="primary" class="lp-topbar__new-work" href="{{ path('app_board_card_create', {id: project.id}) }}" data-card-drawer-opener aria-label="{{ 'nav.new_work'|trans }}">
                                <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />
                                <span class="lp-topbar__new-work-label">{{ 'nav.new_work'|trans }}</span>
                            </twig:Ds:Button>
                            {% endif %}
                        </div>
                    {% endblock %}
                </header>
                <main id="main-content" class="lp-main lp-main--{% block main_surface 'app' %}" tabindex="-1">
                    {% block flash_messages %}
                        {# Read notification types only; other flash values can contain credentials. #}
                        {% include '_flash_messages.html.twig' with {flashes: app.flashes(['success', 'error', 'warning', 'info'])} only %}
                    {% endblock %}
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
        {% else %}
        {# Overrides must place main#main-content with tabindex="-1" after navigation. #}
        {% block body_unauthenticated %}<main id="main-content" tabindex="-1">{{ block('body') }}</main>{% endblock %}
        {% endif %}
        {% include '_mercure_subscriptions.html.twig' only %}
{% endblock %}
