{% extends 'base.html.twig' %}

{% block title %}{{ 'account.profile.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_account_settings') }}">{{ 'nav.link.account'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'account.profile.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-connect">
    <h1 class="lp-workspace-title lp-workspace-title--doc">{{ 'account.profile.page.title'|trans }}</h1>
    <p class="lp-connect-hint">{{ 'account.profile.page.intro'|trans }}</p>

    <section class="max-w-170" data-testid="edit-profile-section">
        {{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
            <div class="lp-form-field">
                {{ form_label(form.fullName, null, {'label_attr': {'class': 'lp-label'}}) }}
                {{ form_widget(form.fullName, {'attr': {'class': 'lp-input'}}) }}
                <div class="lp-field-errors">{{ form_errors(form.fullName) }}</div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{{ path('app_account_settings') }}" class="lp-btn">{{ 'account.profile.cancel_link'|trans }}</a>
                <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.profile.save_button'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
