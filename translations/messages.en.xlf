                <source>account.form.reset_password_request_form.email.placeholder</source>
                <target>you@company.com</target>
            </trans-unit>
            <trans-unit id="account.form.reset_password_request_form.submit">
                <source>account.form.reset_password_request_form.submit</source>
                <target>Send reset link</target>
            </trans-unit>
            <trans-unit id="account.reset_password.request.back">
                <source>account.reset_password.request.back</source>
                <target>← Back to sign in</target>
            </trans-unit>

