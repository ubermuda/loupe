{% set form = inbox_pull_request_review_form(review, refusedForm) %}
{{ form_start(form, {action: path('app_inbox_item_review_pull_request', actionParams), attr: {class: 'lp-form', 'data-turbo-frame': responseFrame, 'data-controller': 'form-draft', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': review.item.id ~ ':review', 'data-action': 'submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared'}}) }}
    <div class="lp-inbox-item__refusal" hidden data-form-draft-target="stale" role="status">
        <p>{{ 'inbox.review.stale_draft'|trans }}</p>
        <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="form-draft#discard">{{ 'inbox.answer.discard_draft'|trans }}</twig:Ds:Button>
    </div>
    <twig:Ds:Hint>{{ 'inbox.review.local_only'|trans }}</twig:Ds:Hint>
    <twig:Ds:FieldErrors :fieldView="form" />
    {{ form_widget(form.expectedUrl, {attr: {'data-form-draft-target': 'guard'}}) }}
    <twig:Ds:FieldErrors :fieldView="form.expectedUrl" />
    <twig:Ds:FormField as="fieldset">
        <twig:Ds:Label as="legend">{{ form.verdict.vars.label|trans }}</twig:Ds:Label>
        {% for choice in form.verdict %}
            <label class="lp-review-verdict-choice">{{ form_widget(choice, {attr: {'data-form-draft-target': 'option', 'data-action': 'change->form-draft#select'}}) }}<span>{{ choice.vars.label|trans }}</span></label>
        {% endfor %}
        <twig:Ds:FieldErrors :fieldView="form.verdict" />
    </twig:Ds:FormField>
    <twig:Ds:FormField :fieldView="form.note" widgetKind="textarea" :widgetAttr="{rows: 3, 'data-form-draft-target': 'text', 'data-inbox-decline-target': 'note', 'data-action': 'input->form-draft#remember'}" />
    <div class="lp-inbox-item__buttons">{% include '@Inbox/_decline_button.html.twig' with {formId: declineFormId, label: declineLabel} only %}<twig:Ds:Button variant="primary" type="submit">{{ 'inbox.review.submit'|trans }}</twig:Ds:Button></div>
{{ form_end(form) }}
