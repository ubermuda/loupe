{% set runs = card_worker_runs(project, cardId) %}
<turbo-frame id="card-worker-runs" class="lp-live-frame" target="_top" data-worker-run-refresh-target="frame">
<section class="lp-card-overview__section" data-card-runs>
    <div class="lp-section-heading">
        <h2 class="lp-card-panel__title">{{ 'board.card.runs.title'|trans }}</h2>
        {% if runs is not empty %}<a class="lp-workshop-text-link" href="{{ path('app_project_worker_runs', {id: project.id}) }}" data-turbo-frame="_top">{{ 'board.card.runs.all'|trans }}</a>{% endif %}
    </div>
    {% for item in runs %}
    <div class="lp-card-run-row" data-card-run-row="{{ item.run.id }}">
    <a class="lp-card-run" href="{{ path('app_project_worker_runs', {id: project.id, search: item.run.id}) }}" data-turbo-frame="_top" data-card-run="{{ item.run.id }}">
        <span class="lp-card-run__rule">{{ item.run.ruleName }}</span>
        {% if item.interactive %}<span class="lp-tag lp-tag--neutral lp-card-run__kind">{{ 'bridge.worker_runs.interactive'|trans }}</span>{% endif %}
        {% set shownAt = item.run.startedAt ?? item.run.receivedAt %}
        <span class="lp-card-run__meta"><time datetime="{{ shownAt|date('c') }}">{{ shownAt|relative_time }}</time>{% if item.duration() is not null %} · {% if item.interactive and item.state.isOpen() %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}{% endif %}{% if item.isResume %} · <span data-worker-run-resume>{{ 'bridge.worker_runs.resume'|trans({'%index%': item.run.resumeIndex, '%cap%': item.run.resumeCap}) }}</span>{% endif %}</span>
        <span class="lp-status-chip lp-status-chip--{{ item.state.chipModifier() }}">{{ item.state.translationKey()|trans }}</span>
        <twig:ux:icon name="lucide:chevron-right" class="lp-card-run__chevron" />
    </a>
    {% if item.closable and is_granted('project.manage', project) %}
    <form method="post" action="{{ path('app_project_worker_run_close', {id: project.id, runId: item.run.id}) }}" data-turbo-frame="card-worker-runs" data-card-run-close>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('worker-run-close') }}">
        <button type="submit" class="lp-btn lp-btn--icon" title="{{ 'bridge.worker_runs.close_session'|trans }}" aria-label="{{ 'bridge.worker_runs.close_session'|trans }}"><twig:ux:icon name="lucide:x" class="size-4" /></button>
    </form>
    {% endif %}
    </div>
    {% else %}
    <p class="lp-card-detail__empty">{{ 'board.card.runs.empty'|trans }}</p>
    {% endfor %}
    {% if runs is not empty %}
    {% set usage = card_usage_total(project, cardId) %}
    <p class="lp-card-usage-total" data-card-usage-total>
        <span class="lp-card-usage-total__label">{{ 'board.card.runs.usage.total'|trans }}</span>
        {% if usage.known %}
        {% if usage.costUsd is not null %}<span class="lp-card-usage-total__cost" data-card-usage-cost>{{ usage.costUsd|format_currency('USD') }}</span>{% endif %}
        <span data-card-usage-tokens>{{ 'board.card.runs.usage.tokens'|trans({'%input%': usage.compact(usage.inputTokens), '%output%': usage.compact(usage.outputTokens), '%cacheRead%': usage.compact(usage.cacheReadTokens), '%cacheWrite%': usage.compact(usage.cacheWriteTokens)}) }}</span>
        {% if usage.estimated %}<span class="lp-tag lp-tag--neutral" data-card-usage-estimated>{{ 'board.card.runs.usage.estimated'|trans }}</span>{% endif %}
        {% if usage.partialRuns > 0 %}<span class="lp-tag lp-tag--amber" data-card-usage-partial>{{ 'board.card.runs.usage.partial'|trans({'%count%': usage.partialRuns}) }}</span>{% endif %}
        {% else %}
        <span data-card-usage-unknown>{{ 'board.card.runs.usage.unknown'|trans }}</span>
        {% endif %}
    </p>
    {% endif %}
</section>
</turbo-frame>
