{# `update`, not `replace`: the status is an aria-live region and the running
   total sits in a tab whose open state the reviewer owns. Swapping either
   element out re-announces unpredictably and would close an open panel. #}
<turbo-stream action="update" target="decision-status">
    <template><span class="lp-decision-status__message{{ failed ? ' lp-decision-status__message--failed' }}">{{ message }}</span></template>
</turbo-stream>
<turbo-stream action="update" target="decision-summary-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream action="update" target="decision-summary-list">
    <template>{% include '@Review/_decision_summary_rows.html.twig' with {rows: rows} only %}</template>
</turbo-stream>
{# The review menu carries a second copy of the same three figures below lg.
   Left out, it reports the state the page was loaded with. #}
<turbo-stream action="update" target="review-menu-decisions-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream action="update" target="review-menu-decisions-head-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream action="update" target="review-menu-decisions-list">
    <template>{% include '@Review/_menu_decision_rows.html.twig' with {rows: rows} only %}</template>
</turbo-stream>
