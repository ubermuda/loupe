{# A refused submission leaves the clicked radio checked, so the page would go
   on showing an unsaved choice. Restoring the block from what is stored keeps it
   honest, including when nothing is stored — that must clear every radio. Only
   the block is replaced, never the pane, so comment anchors stay undisturbed. #}
{% if restoredBlockId %}
<turbo-stream action="replace" target="{{ restoredBlockId }}">
    <template>{{ restoredBlockHtml|raw }}</template>
</turbo-stream>
{% endif %}
<turbo-stream action="replace" target="decision-status">
    <template>
        <p id="decision-status" class="lp-decision-status{{ failed ? ' lp-decision-status--failed' }}" aria-live="polite">{{ message }}</p>
    </template>
</turbo-stream>
