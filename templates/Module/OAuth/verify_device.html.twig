{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'oauth.device.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{# One frame only: the shell's card holds the rows, which draw no frame. #}
{% block auth_shell_class 'auth-shell--wide' %}

{% block auth_body %}
{% if result is not null %}
<div class="lp-consent" data-testid="oauth-device-{{ result }}">
    <div class="auth-icon-badge">
        {% if result == 'approved' %}
        <twig:UX:Icon name="lucide:circle-check" class="w-5 h-5" aria-hidden="true" />
        {% else %}
        <twig:UX:Icon name="lucide:circle-x" class="w-5 h-5" aria-hidden="true" />
        {% endif %}
    </div>
    <div>
        <h1 class="lp-consent__title">{{ ('oauth.device.result.' ~ result ~ '.heading')|trans }}</h1>
        <p class="lp-consent__lead">{{ ('oauth.device.result.' ~ result ~ '.lead')|trans({'%client%': view.clientName}) }}</p>
    </div>
</div>
{% elseif view is not null %}
<div class="lp-consent lp-consent--rows" data-testid="oauth-device-consent">
    <h1 class="lp-consent__question">{{ 'oauth.device.question'|trans({'%client%': view.clientName}) }}</h1>

    <div class="lp-consent__rows">
        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:terminal" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary">{{ 'oauth.device.row.code'|trans({'%code%': '<span class="lp-consent__row-code" data-testid="oauth-device-user-code">' ~ view.displayUserCode|e ~ '</span>'})|raw }}</p>
                <p class="lp-consent__row-second">{{ 'oauth.device.warning'|trans }}</p>
            </div>
        </div>

        {% for scope in view.scopes %}
        {% include '@OAuth/_consent_scope_row.html.twig' with {scope: scope} only %}
        {% endfor %}

        {% if view.allProjects %}
        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:folder" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary" data-testid="oauth-consent-all-projects">{{ 'oauth.consent.row.all_projects'|trans }}</p>
                <p class="lp-consent__row-second">{{ 'oauth.consent.row.all_projects_hint'|trans }}</p>
            </div>
        </div>
        {% endif %}
    </div>

    {#- Turbo drops a 200 answer to a form submit, and the answer here is the
        result panel rather than a redirect. The browser consent form opts out
        for the same reason. -#}
    {{ form_start(form, {'attr': {'class': 'lp-form lp-consent__form', 'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
        {{ form_errors(form) }}
        <div class="lp-consent__actions">
            {{ form_widget(form.deny, {'attr': {'class': 'lp-btn lp-btn--ghost'}}) }}
            {{ form_widget(form.approve, {'attr': {'class': 'lp-btn lp-btn--primary'}}) }}
        </div>
    {{ form_end(form) }}

    <p class="lp-consent__footnote">
        {{ 'oauth.consent.footnote'|trans({'%email%': app.user.userIdentifier}) }}
        <a href="{{ path('app_account_connected_apps') }}" class="auth-link">{{ 'oauth.consent.footnote_link'|trans }}</a>
    </p>
</div>
{% else %}
<div class="lp-consent" data-testid="oauth-device-entry">
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:terminal" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="lp-consent__title">{{ 'oauth.device.entry.heading'|trans }}</h1>
        <p class="lp-consent__lead">{{ 'oauth.device.entry.lead'|trans }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="lp-form-field"
             data-controller="device-code-input"
             data-device-code-input-length-value="8"
             data-device-code-input-group-value="4"
             data-device-code-input-character-label-value="{{ 'oauth.form.device_code_entry_form.user_code.character'|trans }}">
            {{ form_label(form.userCode, null, {'label_attr': {'class': 'lp-label', 'id': 'device-code-label'}}) }}
            {{ form_widget(form.userCode, {'attr': {'class': 'lp-input lp-input--mono', 'data-device-code-input-target': 'field'}}) }}
            <div class="lp-code-field" role="group" aria-labelledby="device-code-label" data-device-code-input-target="boxes" hidden></div>
            <div class="lp-field-errors">{{ form_errors(form.userCode) }}</div>
        </div>
        {{ form_widget(form.submit, {'attr': {'class': 'lp-btn lp-btn--primary'}}) }}
    {{ form_end(form) }}
</div>
{% endif %}
{% endblock %}
