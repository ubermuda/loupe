{# The board itself, with the page's heading row. Props: board (BoardView).
   A structure update keeps the toolbar, so the filter and the view come back
   from it after each render. #}
{% set runWarnings = board.runWarnings %}
<div id="board" class="lp-board"
     data-board-structure-digest="{{ board.structureDigest }}"
     data-controller="board-drag board-filter board-view"
     data-board-view-list-url-value="{{ path('app_board_list', {projectId: board.project.id}) }}"
     data-action="turbo:frame-render@document->board-filter#filter board:placed@document->board-filter#filter board:structure-changed@document->board-filter#filter turbo:frame-render@document->board-view#restore turbo:frame-render@document->board-drag#markReady">
    {% set cardCount = 0 %}
    {% for view in board.columns %}{% set cardCount = cardCount + board.shownCounts[view.column.id ~ '']|default(view.count) %}{% endfor %}
    <div class="lp-board-header">
    <div class="lp-board-toolbar" id="board-toolbar-{{ board.project.id }}" data-turbo-permanent>
        <h1 class="lp-board-toolbar__title">{{ 'board.page.title'|trans }}</h1>
        <div class="lp-board-toolbar__filters" data-action="focusin->board-filter#revealField">
            <label class="lp-board-toolbar__search">
                <span class="sr-only">{{ 'board.filter.search.label'|trans }}</span>
                <twig:ux:icon name="lucide:search" class="lp-board-toolbar__search-icon" />
                <input type="search"
                       class="lp-board-toolbar__input"
                       placeholder="{{ 'board.filter.search.placeholder'|trans }}"
                       data-board-filter-target="query"
                       data-action="input->board-filter#filter">
            </label>
        </div>
        <span class="lp-board-toolbar__count"
              data-board-filter-target="count"
              data-one="{{ 'board.card.count'|trans({'%count%': 1}) }}"
              data-many="{{ 'board.card.count'|trans({'%count%': 2})|replace({'2': '%count%'}) }}">{{ 'board.card.count'|trans({'%count%': cardCount}) }}</span>
        <p class="lp-board-toolbar__paused" role="status" data-board-live-target="paused" data-message="{{ 'board.live.paused'|trans }}" data-failed-message="{{ 'board.live.catch_up_failed'|trans }}"></p>
        <div class="lp-board-toolbar__actions">
            <div class="lp-board-toolbar__mode" aria-label="{{ 'board.view.label'|trans }}">
                <button type="button"
                        class="lp-board-toolbar__mode-button"
                        aria-pressed="true"
                        data-board-view-target="boardButton"
                        data-action="board-view#showBoard">
                    <twig:ux:icon name="lucide:square-kanban" class="w-4 h-4 shrink-0" />
                    {{ 'board.view.board'|trans }}
                </button>
                <button type="button"
                        class="lp-board-toolbar__mode-button"
                        aria-pressed="false"
                        data-board-view-target="listButton"
                        data-action="board-view#showList">
                    <twig:ux:icon name="lucide:list" class="w-4 h-4 shrink-0" />
                    {{ 'board.view.list'|trans }}
                </button>
            </div>
            <a class="lp-btn lp-btn--ghost lp-btn--icon"
               href="{{ path('app_board_settings', {id: board.project.id}) }}"
               aria-label="{{ 'board.settings.action'|trans }}"
               title="{{ 'board.settings.action'|trans }}">
                <twig:ux:icon name="lucide:settings" class="w-4 h-4 shrink-0" />
            </a>
            <a class="lp-btn lp-btn--primary" href="{{ path('app_board_card_create', {id: board.project.id}) }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare">
                <twig:ux:icon name="lucide:plus" class="w-4 h-4 shrink-0" />
                {{ 'board.card.create.action'|trans }}
            </a>
        </div>
    </div>
    {# A drop here sends the card to the end of the Backlog. #}
    <a class="lp-btn lp-board-backlog"
       href="{{ path('app_project_board_backlog', {projectId: board.project.id}) }}"
       title="{{ 'board.backlog.button.hint'|trans }}"
       data-board-drag-target="group"
       data-board-bucket
       data-column="{{ board.backlog.id }}"
       data-rankable="0">
        <twig:ux:icon name="lucide:inbox" class="w-4 h-4 shrink-0" />
        {{ 'board.backlog.button'|trans }}
        <span class="lp-board-backlog__count" id="board-count-{{ board.backlog.id }}">{{ board.backlogCount }}</span>
    </a>
    </div>
    <p class="lp-board-filter-empty" data-board-filter-target="empty" hidden>{{ 'board.filter.empty'|trans }}</p>
    {# A drop moves the card at once. This says so when the server refuses. #}
    <p class="lp-board__message"
       data-board-drag-target="message"
       data-message="{{ 'board.drag.failed'|trans }}"
       role="status"
       aria-live="polite"></p>
    {# Dragging is the only interaction a card face offers, so this form has no
       controls. A drop names it after the card, fills it and submits it. The
       card page carries the same form with its labels, for a keyboard. #}
    {% set movePlaceholder = constant('App\\Module\\Board\\Form\\MoveCardFormType::PLACEHOLDER_CARD_ID') %}
    {% set moveForm = board_move_form(board.project) %}
    <form hidden
          method="post"
          action="{{ path('app_board_card_move', {projectId: board.project.id, cardId: movePlaceholder}) }}"
          data-board-drag-target="moveForm"
          data-move-card-id="{{ movePlaceholder }}">
        {% for field in moveForm %}{{ form_widget(field) }}{% endfor %}
    </form>
    {% if board.lanes is empty %}
    {% include '@Board/_board_plain_columns.html.twig' with {board: board, runWarnings: runWarnings} only %}
    {% else %}
    {% include '@Board/_board_lanes.html.twig' with {board: board, runWarnings: runWarnings} only %}
    {% endif %}
    {# The list loads into this frame when a person picks List, and empties when they leave it. #}
    <turbo-frame id="board-list" data-board-view-target="list" hidden></turbo-frame>
</div>
