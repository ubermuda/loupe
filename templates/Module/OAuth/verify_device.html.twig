{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'oauth.device.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
{% if result is not null %}
<div class="lp-consent" data-testid="oauth-device-{{ result }}">
    <div class="auth-icon-badge">
        {% if result == 'approved' %}
        <twig:UX:Icon name="lucide:circle-check" class="w-5 h-5" aria-hidden="true" />
        {% else %}
        <twig:UX:Icon name="lucide:circle-x" class="w-5 h-5" aria-hidden="true" />
        {% endif %}
    </div>
    <div>
        <h1 class="lp-consent__title">{{ ('oauth.device.result.' ~ result ~ '.heading')|trans }}</h1>
        <p class="lp-consent__lead">{{ ('oauth.device.result.' ~ result ~ '.lead')|trans({'%client%': view.clientName}) }}</p>
    </div>
</div>
{% elseif view is not null %}
<div class="lp-consent" data-testid="oauth-device-consent">
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:terminal" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="lp-consent__title">{{ 'oauth.consent.heading'|trans({'%client%': view.clientName}) }}</h1>
        <p class="lp-consent__lead">{{ 'oauth.consent.signed_in_as'|trans({'%email%': app.user.userIdentifier}) }}</p>
    </div>

    <dl class="lp-consent__facts">
        <div class="lp-consent__fact">
            <dt class="lp-eyebrow">{{ 'oauth.device.code.label'|trans }}</dt>
            <dd class="lp-consent__value lp-consent__value--mono" data-testid="oauth-device-user-code">{{ view.displayUserCode }}</dd>
        </div>
        <div class="lp-consent__fact">
            <dt class="lp-eyebrow">{{ 'oauth.consent.scope.label'|trans }}</dt>
            <dd class="lp-consent__value">{{ ('oauth.consent.scope.' ~ view.scope.value|replace({'-': '_'}))|trans }}</dd>
        </div>
    </dl>

    <div class="lp-connect-alert lp-consent__alert">
        <twig:UX:Icon name="lucide:triangle-alert" class="lp-connect-alert__icon w-4 h-4" />
        <p class="lp-connect-alert__text">{{ 'oauth.device.warning'|trans }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'lp-form lp-consent__form', 'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="lp-consent__actions">
            {{ form_widget(form.deny, {'attr': {'class': 'lp-btn lp-btn--ghost'}}) }}
            {{ form_widget(form.approve, {'attr': {'class': 'lp-btn lp-btn--primary'}}) }}
        </div>
    {{ form_end(form) }}
</div>
{% else %}
<div class="lp-consent" data-testid="oauth-device-entry">
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:terminal" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="lp-consent__title">{{ 'oauth.device.entry.heading'|trans }}</h1>
        <p class="lp-consent__lead">{{ 'oauth.device.entry.lead'|trans }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="lp-form-field">
            {{ form_label(form.userCode, null, {'label_attr': {'class': 'lp-label'}}) }}
            {{ form_widget(form.userCode, {'attr': {'class': 'lp-input lp-consent__value--mono'}}) }}
            <div class="lp-field-errors">{{ form_errors(form.userCode) }}</div>
        </div>
        {{ form_widget(form.submit, {'attr': {'class': 'lp-btn lp-btn--primary'}}) }}
    {{ form_end(form) }}
</div>
{% endif %}
{% endblock %}
