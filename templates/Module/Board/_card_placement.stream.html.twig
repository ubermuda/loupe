{# One card placed on the board page, read by the board-place stream action.
   Props: cardId (string), placement (CardPlacementView). #}
{% set card = placement.card %}
{% set history = {} %}
{% for columnId, total in placement.terminalTotals %}
    {% set history = history|merge({(columnId): 'board.terminal.history_link'|trans({'%count%': total})}) %}
{% endfor %}
<turbo-stream action="board-place" target="board-card-{{ cardId }}"
              data-counts="{{ placement.counts|json_encode }}"
              data-history="{{ history|json_encode }}"
              data-history-totals="{{ placement.terminalTotals|json_encode }}"
              {% if card is null %}data-removed="1"{% if placement.deckEpic %}
              data-deck-epic="{{ placement.deckEpic }}"{% endif %}{% else %}data-column-id="{{ placement.column.id }}"
              data-after="{{ placement.after }}"
              data-row-after="{{ placement.rowAfter }}"{% if placement.lane is not null %}
              data-lane="{{ placement.lane }}"{% endif %}{% if placement.laneHead %}
              data-lane-head
              data-lane-after="{{ placement.laneAfter }}"{% endif %}{% endif %}>
    <template>
        {% if card is not null %}
            {% set runWarning = card_run_warning(card.project, card.id) %}
            {% if placement.laneHead %}
                {% include '@Board/_board_lane_head.html.twig' with {epic: card, progress: placement.progress, deck: placement.deck} only %}
            {% else %}
                {% include '@Board/_card.html.twig' with {card: card, pendingComments: placement.pendingComments, documentCount: placement.documentCount, progress: placement.progress, inLane: placement.lane not in [null, 'other'], runWarning: runWarning, badges: placement.badges, state: placement.state} only %}
            {% endif %}
            {# The list view draws no Backlog row, so a lane epic there sends none. #}
            {% if not placement.column.backlog %}
                {% include '@Board/_card_row.html.twig' with {card: card, column: placement.column, feedbackCount: placement.pendingComments, documentCount: placement.documentCount, progress: placement.progress, runWarning: runWarning, badges: placement.badges, state: placement.state} only %}
            {% endif %}
        {% endif %}
    </template>
</turbo-stream>
