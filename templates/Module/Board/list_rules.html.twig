{% extends 'base.html.twig' %}

{% block title %}{{ 'board.rules.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_board', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'board.rules.nav'|trans }}</span>
{% endblock %}

{% block topbar_meta %}<span class="lp-topbar__meta">{{ 'board.rules.live_count'|trans({'%count%': liveCount}) }}</span>{% endblock %}

{% block body %}
<div class="lp-workspace lp-orchestration-page lp-redesign-secondary lp-redesign-rules">
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'board.rules.heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'board.rules.description'|trans }}</p>
        </div>
    </header>

    <div class="lp-list-filters">
        {{ form_start(searchForm, {'action': path('app_project_rules', {id: project.id}), 'attr': {'class': 'lp-filter-form', 'data-controller': 'autosearch'}}) }}
            <div class="lp-filter-primary" data-action="focusin->autosearch#revealField">
                <div class="lp-filter-search">
                    <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                    {{ form_label(searchForm.search, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(searchForm.search, {'attr': {'class': 'lp-input lp-filter-input', 'data-autosearch-target': 'field', 'data-action': 'input->autosearch#search'}}) }}
                </div>
            </div>
            <a href="{{ path('app_project_rules', {id: project.id}) }}"
               data-autosearch-target="clearButton"
               class="lp-filter-clear">{{ 'board.rules.search.clear'|trans }}</a>
            <div class="lp-field-errors">{{ form_errors(searchForm.search) }}{{ form_errors(searchForm) }}</div>
        {{ form_end(searchForm) }}
        <span class="lp-status-chip lp-status-chip--ok" data-rule-live-count><span class="lp-status-chip__dot"></span>{{ 'board.rules.live_count'|trans({'%count%': liveCount}) }}</span>
    </div>

    {% if rules is not empty %}
    <div class="lp-rule-list">
        {% for rule in rules %}
        <article class="lp-rule-row" data-rule-name="{{ rule.name }}">
            <twig:ux:icon name="lucide:zap" class="lp-rule-row__glyph" />
            {% set eventLabel %}{% include 'outbox/_event_type_label.html.twig' with {type: rule.event} only %}{% endset %}
            <div class="lp-rule-row__title">
                <h2>{{ rule.name }}</h2>
                <p>{{ 'board.rules.event_description'|trans({'%event%': eventLabel|trim}) }}</p>
            </div>
            <div class="lp-rule-flow" aria-label="{{ 'board.rules.flow_label'|trans }}">
                <span data-rule-event="{{ rule.event }}">
                    {%- if rule.event starts with 'board.' %}<twig:ux:icon name="lucide:square-kanban" />{% else %}<twig:ux:icon name="lucide:radio" />{% endif -%}
                    {%- if rule.columns is not empty %}{% for slug in rule.columns %}{{ (columnLabels[slug] ?? slug)|trans }}{{ not loop.last ? ', ' }}{% endfor %}{% else %}{{ eventLabel|trim }}{% endif -%}
                </span>
                <twig:ux:icon name="lucide:chevron-right" class="lp-rule-flow__arrow" />
                <span title="{{ rule.bridgeId }}"><twig:ux:icon name="lucide:cable" />{{ rule.bridgeId|slice(-12) }}</span>
            </div>
            <span class="lp-status-chip lp-rule-row__state {{ rule.state == 'live' ? 'lp-status-chip--ok' : 'lp-status-chip--failed' }}">
                <span class="lp-status-chip__dot"></span>
                {{ (rule.state == 'live' ? 'board.rules.status.live' : 'board.rules.status.dead')|trans }}
            </span>
            <time class="lp-rule-row__report" datetime="{{ rule.reportedAt|date('c') }}">{{ 'board.rules.reported_at'|trans({'%time%': rule.reportedAt|date('M j, H:i')}) }}</time>
            {% if rule.reason %}<p class="lp-rule-row__reason">{{ rule.reason }}</p>{% endif %}
        </article>
        {% endfor %}
    </div>
    <p class="lp-rule-explanation"><twig:ux:icon name="lucide:shield" />{{ 'board.rules.explanation'|trans }}</p>
    {% elseif search is not empty %}
    <div class="lp-empty-state" data-rules-no-match>
        <twig:ux:icon name="lucide:search" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'board.rules.search.empty'|trans }}</h2>
        <p>{{ 'board.rules.search.try_again'|trans }}</p>
    </div>
    {% else %}
    <div class="lp-empty-state" data-rules-empty>
        <twig:ux:icon name="lucide:workflow" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'board.rules.empty.title'|trans }}</h2>
        <p>{{ 'board.rules.empty.description'|trans }}</p>
    </div>
    {% endif %}

    <section class="lp-rule-list" data-hooks-section>
        <div>
            <h2 class="lp-section-title">{{ 'board.rules.hooks.heading'|trans }}</h2>
            <p class="lp-workspace-desc">{{ 'board.rules.hooks.description'|trans }}</p>
        </div>
        {% set outcomeChips = {ok: 'lp-status-chip--ok', failed: 'lp-status-chip--failed', timeout: 'lp-status-chip--failed'} %}
        {% for bridge in bridge_hooks(project) %}
        <article class="lp-rule-row" data-bridge-hooks="{{ bridge.id }}">
            <div class="lp-rule-row__main">
                <div class="lp-rule-row__heading">
                    <h2 title="{{ bridge.id }}">{{ bridge.id|slice(-12) }}</h2>
                    <time datetime="{{ bridge.lastSeenAt|date('c') }}">{{ 'board.rules.hooks.last_seen'|trans({'%time%': bridge.lastSeenAt|date('M j, H:i')}) }}</time>
                </div>
                {% for hook in bridge.hooks %}
                <div data-hook-row data-hook-event="{{ hook.event }}">
                    <div class="lp-rule-row__heading">
                        <div class="lp-rule-flow">
                            <span>{{ hook.package }}</span>
                            <span>{{ hook.ref }}</span>
                            <span>{{ ('board.rules.hooks.event.' ~ hook.event)|trans }}</span>
                            {% if hook.lastRunAt %}<span><time datetime="{{ hook.lastRunAt }}">{{ 'board.rules.hooks.last_run'|trans({'%time%': hook.lastRunAt|date('M j, H:i')}) }}</time></span>{% endif %}
                        </div>
                        <span class="lp-status-chip {{ outcomeChips[hook.outcome] ?? 'lp-status-chip--neutral' }}">
                            <span class="lp-status-chip__dot"></span>
                            {{ ('board.rules.hooks.outcome.' ~ hook.outcome)|trans }}
                        </span>
                    </div>
                    {% if hook.error %}<p class="lp-rule-row__reason">{{ hook.error }}</p>{% endif %}
                </div>
                {% else %}
                <p data-hooks-none>{{ 'board.rules.hooks.none'|trans }}</p>
                {% endfor %}
            </div>
        </article>
        {% else %}
        <p class="lp-workspace-desc" data-hooks-none>{{ 'board.rules.hooks.none'|trans }}</p>
        {% endfor %}
    </section>
</div>
{% endblock %}
