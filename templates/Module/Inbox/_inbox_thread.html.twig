{#- A wait item as a thread: what stopped, the owner's reply with its split button, and the actions the owner already took.
   Params: item, watch (InboxCardWatch), inbox, refusedForm, actionParams, responseFrame, hostCardId, cardDrawer,
   reply (whether this page takes the owner's reply), todoButtons (optional: declineFormId, declineLabel, doneFormId of a to-do),
   withNote (optional, default true: whether the reply card takes a note for the action). -#}
{% set linkedDocumentIds = item.documents|map(link => link.document.id.toRfc4122) %}
{% set todoButtons = todoButtons ?? null %}
{% set withNote = (withNote ?? true) and not todoButtons %}
{% set shownWaits = watch is null ? [] : watch.waits|filter(wait => wait.endedAt is null)|merge(watch.waits|filter(wait => wait.endedAt is not null))|filter(wait => not inbox_wait_folded(wait)) %}
{% set statuses = reply ? inbox_action_statuses(item) : [] %}
{% set lastStatus = statuses|last %}
{# Another open wait, or an expired or cancelled action, brings the reply card back. #}
{% set answering = lastStatus and lastStatus.answers(watch ? watch.waits : []) %}
{% set actions = reply ? inbox_actions(item, hostCardId) : null %}
{# The one run-command row of the item, whether it is the main button or in the menu. #}
{% set commandRow = actions ? ([actions.main]|merge(actions.menu))|filter(row => row and row.action.runCommand)|first : null %}
{% set runCommand = commandRow ? commandRow.action.runCommand : null %}
{% set actionForm = reply ? inbox_action_form(item, refusedForm) : null %}
{# The start-session row that carries a prompt of the asking agent. The owner reads and edits it before the click. #}
{% set sessionRow = actions ? ([actions.main]|merge(actions.menu))|filter(row => row and row.action.sessionPrompt is not null)|first : null %}
{# The dialog posts the reply form, so it needs the reply card on the page. #}
{% set commandDialog = runCommand and runCommand.canOpenDialog and not answering %}
{# The add dialog offers a missing entry to a bridge that opted in. The run dialog never exists beside it. #}
{% set addEntryDialog = runCommand and runCommand.canAddEntry and not answering %}
{% set chips = {queued: 'pending', resumed: 'active', preparing: 'active', running: 'active', retried: 'ok', added: 'ok', expired: 'failed', refused: 'failed', cancelled: 'neutral'} %}
<div class="lp-inbox-thread" data-inbox-thread{% if commandDialog %} data-controller="modal run-command" data-run-command-template-value="{{ runCommand.argvTemplate|json_encode }}" data-run-command-label-value="{{ 'inbox.run_command.dialog.command'|trans }}" data-run-command-label-in-value="{{ 'inbox.run_command.dialog.command_in'|trans }}"{% elseif addEntryDialog %} data-controller="modal"{% endif %}>
    <ul class="lp-inbox-thread__messages" data-inbox-waits>
        {% for wait in shownWaits %}
            {%- set line = inbox_wait_line(wait, wait.documentId and wait.documentId.toRfc4122 in linkedDocumentIds) -%}
            {%- set runWait = wait.type.value == 'worker-run' -%}
            <li class="lp-inbox-thread__message{{ wait.endedAt ? ' lp-inbox-thread__message--ended' }}" data-inbox-wait="{{ wait.endedAt ? 'ended' : 'current' }}">
                <div class="lp-comment-thread__header lp-inbox-thread__head">
                    <twig:Ds:Avatar :icon="runWait ? 'lucide:bot' : 'lucide:search'" size="xs" tone="tint" aria-hidden="true" />
                    <span class="lp-comment-author">{{ runWait ? line.params['%Worker%'] : 'inbox.thread.loupe'|trans }}</span>
                    <twig:Ds:Hint as="span">{{ (runWait ? 'inbox.thread.stopped' : 'inbox.thread.waiting')|trans({'%time%': wait.startedAt|relative_time}) }}</twig:Ds:Hint>{# @design-system-ignore #}
                </div>
                <div class="lp-comment-thread">
                    {%- if runWait and line.detail %}
                        {# Worker Markdown, rendered and sanitized the way a card body is. #}
                        <div class="prose lp-prose lp-review-doc__prose">{{ line.detail|inbox_markdown }}</div>
                    {%- else %}
                        <p class="lp-comment-body">{{ line.pageKey|trans(line.params) }}</p>
                    {%- endif %}
                    {%- if wait.endedAt %}
                        <twig:Ds:Hint>{{ ('inbox.wait.ended.' ~ wait.endReason.value|replace({'-': '_'}))|trans }}</twig:Ds:Hint>
                    {%- endif %}
                </div>
            </li>
        {% endfor %}
    </ul>

    {% for status in statuses %}
        {% set requestedTime = status.action.requestedAt|date('H:i') %}
        <div class="lp-readiness-discovery lp-inbox-thread__you" data-inbox-action-status="{{ status.state.value }}">
            <div class="lp-comment-thread__header lp-inbox-thread__head">
                <twig:Ds:Avatar :name="app.user.fullName" size="xs" aria-hidden="true" />
                <span class="lp-comment-author">{{ 'inbox.thread.you'|trans }}</span>
                <twig:Ds:Hint as="span">{{ ('inbox.thread.you_verb.' ~ status.action.kind.value)|trans({'%time%': requestedTime}) }}</twig:Ds:Hint>
                <twig:Ds:StatusChip class="lp-inbox-thread__chip" :modifier="chips[status.state.value]" :label="status.labelKey|trans(status.labelParameters|merge(status.at ? {'%time%': status.at|date('H:i')} : {}))" />
            </div>
            {% if status.action.note|trim is not empty %}
                <div class="lp-comment-body lp-inbox-thread__note">{{ status.action.note }}</div>
            {% endif %}
            {% if status.offline or status.cancellable %}
                <div class="lp-inbox-thread__status">
                    {% if status.offline %}<twig:Ds:Hint as="span" data-inbox-action-offline>{{ 'inbox.action.status.offline'|trans }}</twig:Ds:Hint>{% endif %}
                    {% if status.cancellable %}
                        {% set cancelForm = inbox_action_cancel_form(status.action, refusedForm) %}
                        {{ form_start(cancelForm, {action: path('app_inbox_item_action_cancel', actionParams|merge({actionId: status.action.id})), attr: {class: 'lp-inbox-thread__cancel', 'data-turbo-frame': responseFrame}}) }}
                            <twig:Ds:FieldErrors :fieldView="cancelForm" />
                            <twig:Ds:Button variant="ghost" size="sm" type="submit">{{ 'inbox.thread.cancel'|trans }}</twig:Ds:Button>
                        {{ form_end(cancelForm) }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endfor %}

    {% if runCommand and runCommand.run %}
        {% include '@Inbox/_inbox_run_command_run.html.twig' with {item: item, command: runCommand, actionParams: actionParams, responseFrame: responseFrame, refusedForm: refusedForm ?? null, rerun: commandDialog, doneFormId: todoButtons ? todoButtons.doneFormId : null} only %}
    {% endif %}

    {% if reply and not answering %}
        {% set declineForm = inbox_decline_form(item, refusedForm) %}
        {% set noteLabel = 'inbox.thread.note_placeholder'|trans %}
        <div class="lp-inbox-item__actions">
            {{ form_start(actionForm, {action: path('app_inbox_item_action', actionParams|merge({kind: 'resume-run'})), attr: {id: actionForm.vars.id, class: 'lp-comment-composer lp-comment-composer--untargeted lp-inbox-thread__reply', 'data-turbo-frame': responseFrame}}) }}
                {% if actions.main %}
                    <h3 class="lp-status-box__title" data-inbox-reply-heading>{{ actions.main.action.reason ?? actions.main.action.labelKey|trans }}</h3>
                {% endif %}
                {% set entryProposed = runCommand and runCommand.entryYaml and runCommand.disabledReasonKey == 'inbox.action.run-command.disabled.entry_missing' %}
                {% if runCommand and not runCommand.canOpenDialog and not (runCommand.run and runCommand.run.state.isLive) %}
                    {% if entryProposed %}
                        <p class="lp-run-command__why-off" data-inbox-run-command-off>{{ (runCommand.addEntryLive ? 'inbox.run_command.missing.adding' : (runCommand.acceptsEntries ? 'inbox.run_command.missing.reason_proposed' : 'inbox.run_command.missing.reason_no_opt_in'))|trans({'%entry%': runCommand.entry, '%bridge%': runCommand.bridgeName}) }}</p>
                    {% else %}
                        <p class="lp-run-command__why-off" data-inbox-run-command-off>{{ runCommand.disabledReasonKey|trans }}</p>
                    {% endif %}
                {% endif %}
                {% if entryProposed %}
                    {% if runCommand.acceptsEntries %}
                        <twig:Ds:CodeBlock :label="'inbox.run_command.missing.label_add'|trans" :text="runCommand.entryYaml|trim" :copy="false" data-inbox-run-command-proposed />
                    {% else %}
                        <twig:Ds:CodeBlock :label="'inbox.run_command.missing.label'|trans" :text="runCommand.entryYaml|trim" :copyLabel="'inbox.run_command.missing.copy'|trans" :copiedLabel="'inbox.run_command.missing.copied'|trans" data-inbox-run-command-proposed />
                        <twig:Ds:Hint>{{ 'inbox.run_command.missing.hint'|trans({'%command%': 'loupe bridge reload'}) }}</twig:Ds:Hint>
                    {% endif %}
                {% endif %}
                {% if withNote %}
                    {{ form_widget(actionForm.note, {attr: {rows: 2, placeholder: noteLabel, 'aria-label': noteLabel}}) }}
                    <twig:Ds:FieldErrors :fieldView="actionForm.note" />
                {% endif %}
                {% if sessionRow %}
                    <twig:Ds:FormField :fieldView="actionForm.sessionPrompt" :labelText="'inbox.thread.session_prompt_label'|trans" widgetKind="textarea" :widgetAttr="{rows: 4, 'data-inbox-session-prompt': ''}" :hintText="'inbox.thread.session_prompt_hint'|trans" />
                {% endif %}
                <twig:Ds:FieldErrors :fieldView="actionForm" />
                {{ form_widget(actionForm._token) }}
                <div class="lp-comment-composer__actions">
                    <twig:Ds:Hint as="span" class="inbox-split__hint">{{ actions.main and actions.main.action.runCommand ? (runCommand.onSuccess.value == 'resumes-run' ? 'inbox.run_command.dialog.success_run'|trans : '') : (withNote ? 'inbox.thread.note_hint'|trans : '') }}</twig:Ds:Hint>
                    {% if todoButtons %}
                        {% include '@Inbox/_decline_button.html.twig' with {formId: todoButtons.declineFormId, label: todoButtons.declineLabel} only %}
                        <twig:Ds:Button variant="secondary" size="sm" type="submit" form="{{ todoButtons.doneFormId }}" data-inbox-done>{{ 'inbox.done.submit'|trans }}</twig:Ds:Button>
                    {% endif %}
                    {% if not actions.main and not actions.menu and actions.dismiss %}
                        {# Nothing else fits, so Dismiss is the one action and needs no menu. #}
                        <twig:Ds:Button variant="danger-ghost" size="sm" type="submit" form="{{ declineForm.vars.id }}" data-inbox-action="dismiss">{{ actions.dismiss.action.labelKey|trans }}</twig:Ds:Button>
                    {% elseif actions.main or actions.menu %}
                    <twig:Ds:Menu id="inbox-split-menu-{{ item.id }}" class="inbox-split" data-controller="split-button" size="lg" :panel="{role: 'menu', 'data-split-button-target': 'panel'}">
                        <twig:block name="trigger">
                        {% if actions.main and actions.main.isLink %}
                            <twig:Ds:Button variant="primary" size="sm" class="inbox-split__main" :href="actions.main.href" :target="actions.main.external ? '_blank' : null" :rel="actions.main.external ? 'noopener noreferrer' : null" :data-turbo-frame="actions.main.card and cardDrawer ? 'card-drawer-frame' : '_top'" :data-action="actions.main.card and cardDrawer ? 'click->card-drawer#prepare' : null" data-inbox-action="{{ actions.main.action.kind.value }}">{{ actions.main.action.labelKey|trans }}</twig:Ds:Button>
                        {% elseif actions.main and actions.main.action.runCommand and addEntryDialog %}
                            <twig:Ds:Button variant="primary" size="sm" class="inbox-split__main" type="button" data-action="click->modal#open" data-inbox-action="add-entry">{{ 'inbox.action.add-entry.label'|trans }}</twig:Ds:Button>
                        {% elseif actions.main and actions.main.action.runCommand %}
                            <twig:Ds:Button variant="primary" size="sm" class="inbox-split__main" type="button" :disabled="not runCommand.canOpenDialog" :title="runCommand.canOpenDialog ? null : runCommand.disabledReasonKey|trans" data-action="click->modal#open" data-inbox-action="run-command">{{ 'inbox.action.run-command.run'|trans({'%entry%': runCommand.entry, '%branch%': runCommand.branch}) }}</twig:Ds:Button>
                        {% elseif actions.main %}
                            <twig:Ds:Button variant="primary" size="sm" class="inbox-split__main" type="submit" :formaction="path('app_inbox_item_action', actionParams|merge({kind: actions.main.action.kind.value}))" data-inbox-action="{{ actions.main.action.kind.value }}">{{ actions.main.action.labelKey|trans }}</twig:Ds:Button>
                        {% endif %}
                        {% if actions.menu or actions.dismiss %}
                            <twig:Ds:Button variant="primary" size="sm" class="inbox-split__toggle" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="inbox-split-menu-{{ item.id }}" :aria-label="'inbox.thread.other_actions'|trans" data-split-button-target="trigger" data-popover-target="trigger" data-action="click->split-button#toggle"><twig:ux:icon name="lucide:chevron-down" /></twig:Ds:Button>
                        {% endif %}
                        </twig:block>
                        <twig:block name="content">
                            {% for row in actions.menu %}
                                {% include '@Inbox/_inbox_thread_row.html.twig' with {row: row, actionParams: actionParams, declineFormId: declineForm.vars.id, cardDrawer: cardDrawer} only %}
                            {% endfor %}
                            {% if actions.menu and actions.dismiss %}
                                <twig:Ds:MenuDivider />
                            {% endif %}
                            {% if actions.dismiss %}
                                {% include '@Inbox/_inbox_thread_row.html.twig' with {row: actions.dismiss, actionParams: actionParams, declineFormId: declineForm.vars.id, cardDrawer: cardDrawer} only %}
                            {% endif %}
                        </twig:block>
                    </twig:Ds:Menu>
                    {% endif %}
                </div>
            {{ form_end(actionForm, {render_rest: false}) }}

            {# Dismiss ignores the note, so this form carries none. Its button sits in the menu above, through the form attribute. #}
            {% if actions.dismiss %}
            {{ form_start(declineForm, {action: path('app_inbox_item_decline', actionParams), attr: {id: declineForm.vars.id, class: 'lp-inbox-decline__form', 'data-turbo-frame': responseFrame}}) }}
                {{ form_widget(declineForm.closeNote) }}
                <twig:Ds:FieldErrors>{{ form_errors(declineForm) }}{{ form_errors(declineForm.closeNote) }}</twig:Ds:FieldErrors>
            {{ form_end(declineForm) }}
            {% endif %}
        </div>
    {% endif %}

    {% if commandDialog %}
        {% include '@Inbox/_inbox_run_command_dialog.html.twig' with {item: item, command: runCommand, actionParams: actionParams, formId: actionForm.vars.id, fieldName: actionForm.vars.full_name} only %}
    {% elseif addEntryDialog %}
        {% include '@Inbox/_inbox_add_entry_dialog.html.twig' with {item: item, command: runCommand, actionParams: actionParams, formId: actionForm.vars.id} only %}
    {% endif %}
</div>
