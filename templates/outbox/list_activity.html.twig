{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_workshop', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'activity.page.title'|trans }}</span>
{% endblock %}

{% block topbar_meta %}<span class="lp-topbar__meta">{{ 'activity.count'|trans({'%count%': events|length}) }}</span>{% endblock %}

{% block body %}
<div class="lp-workspace lp-orchestration-page lp-redesign-secondary lp-redesign-activity" data-controller="activity-filter">
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'activity.heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'activity.description'|trans }}</p>
        </div>
    </header>
    <div class="lp-activity-toolbar">
        <span><twig:ux:icon name="lucide:activity" />{{ 'activity.description'|trans }}</span>
        <span class="lp-status-chip lp-status-chip--ok"><span class="lp-status-chip__dot"></span>{{ 'activity.status.recorded'|trans }}</span>
    </div>

    {% if events is not empty %}
    <div class="lp-list-filters">
        <div class="lp-filter-form">
            <div class="lp-filter-search">
                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                <label class="sr-only" for="activity-search">{{ 'activity.filter.search_label'|trans }}</label>
                <input type="search" id="activity-search" class="lp-input lp-filter-input" placeholder="{{ 'activity.filter.search_placeholder'|trans }}" data-activity-filter-target="query" data-action="input->activity-filter#filter">
            </div>
            <label class="sr-only" for="activity-family">{{ 'activity.filter.family_label'|trans }}</label>
            <select id="activity-family" class="lp-input lp-select lp-filter-select" data-activity-filter-target="family" data-action="change->activity-filter#filter">
                <option value="all">{{ 'activity.filter.all_families'|trans }}</option>
                {% for family in ['board', 'worker', 'inbox', 'document', 'rule', 'site_review'] %}
                <option value="{{ family }}">{{ ('activity.family.' ~ family)|trans }}</option>
                {% endfor %}
            </select>
        </div>
        <span class="lp-filter-count">{{ 'activity.count'|trans({'%count%': events|length}) }}</span>
    </div>
    <div class="lp-activity-feed">
        {% for event in events %}
        {% set family = event.type|split('.')|first %}
        <article class="lp-activity-row" data-activity-event-id="{{ event.id }}" data-event-family="{{ family }}" data-activity-filter-target="row">
            <div class="lp-activity-row__icon">
                {% if family == 'board' %}
                    <twig:ux:icon name="lucide:square-kanban" />
                {% elseif family == 'document' %}
                    <twig:ux:icon name="lucide:file-text" />
                {% elseif family == 'inbox' %}
                    <twig:ux:icon name="lucide:inbox" />
                {% elseif family == 'site_review' %}
                    <twig:ux:icon name="lucide:globe" />
                {% else %}
                    <twig:ux:icon name="lucide:activity" />
                {% endif %}
            </div>
            <div class="lp-activity-row__body">
                <div class="lp-activity-row__heading">
                    <h2>{{ event.type }}</h2>
                    <time datetime="{{ event.createdAt|date('c') }}">{{ event.createdAt|date('Y-m-d H:i:s') }}</time>
                </div>
                <p>{{ 'activity.event_detail'|trans({'%sequence%': event.sequence ?? '—', '%family%': family}) }}</p>
                <div class="lp-activity-row__meta">
                    <span class="lp-status-chip {{ event.publishedAt ? 'lp-status-chip--ok' : (event.lastPublishError ? 'lp-status-chip--failed' : 'lp-status-chip--pending') }}">
                        <span class="lp-status-chip__dot"></span>
                        {{ (event.publishedAt ? 'activity.delivery.delivered' : (event.lastPublishError ? 'activity.delivery.failed' : 'activity.delivery.pending'))|trans }}
                    </span>
                    {% if event.publishAttempts > 0 %}<span>{{ 'activity.attempts'|trans({'%count%': event.publishAttempts}) }}</span>{% endif %}
                </div>
                {% if event.lastPublishError %}<p class="lp-activity-row__error">{{ event.lastPublishError }}</p>{% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    <div class="lp-empty-state" data-activity-filter-target="empty" hidden>
        <twig:ux:icon name="lucide:search-x" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'activity.filter.empty'|trans }}</h2>
    </div>
    {% else %}
    <div class="lp-empty-state" data-activity-empty>
        <twig:ux:icon name="lucide:activity" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'activity.empty.title'|trans }}</h2>
        <p>{{ 'activity.empty.description'|trans }}</p>
    </div>
    {% endif %}
    <p class="lp-rule-explanation"><twig:ux:icon name="lucide:shield" />{{ 'activity.durable_notice'|trans }}</p>
</div>
{% endblock %}
