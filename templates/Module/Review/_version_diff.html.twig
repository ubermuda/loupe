{#
    Word-level diff of two versions' Markdown source.

    A line's text belongs wholly to one side or both, never to one side in part,
    so every line that is not inserted reads back as the old source and every
    line that is not deleted as the new one. A separator between segments or any
    text of the template's own would break that and nothing else, so it is
    pinned by a rendered round-trip in DiffDocumentVersionsControllerTest. Lines
    use `white-space: pre-wrap`, hence no indentation inside one. The hunk
    wrapper sits outside the line elements for the same reason.

    Added and removed text is `<ins>`/`<del>` at both levels: on the one view
    where added-versus-removed IS the content, colour alone conveys it to
    neither a screen reader nor the commonest colour blindness.

    The jump bar lives in the metadata bar, which both diff views share.

    A heading line carries the anchor the contents rail links to. The index
    answers by loop position, so the ids on the page and the rows in the rail
    come from one walk of the same diff and cannot describe different lines.

    Params:  @comment-budget-ignore
      diff — App\Module\Review\ValueObject\DocumentDiff
      sourceHeadings — App\Module\Review\ValueObject\SourceHeadingIndex
#}
<div class="lp-diff" data-rail-align>
    {%- set hunkNumber = 0 -%}
    {%- for group in diff.groups -%}
        {%- set groupIndex = loop.index0 -%}
        {%- if group.changed -%}
            {%- set hunkNumber = hunkNumber + 1 -%}
            <div class="lp-diff__hunk" id="diff-hunk-{{ hunkNumber }}" tabindex="-1" data-diff-navigation-target="hunk">
        {%- endif -%}
        {%- for line in group.lines -%}
            {%- set tag = {'inserted': 'ins', 'deleted': 'del'}[line.kind.value]|default('div') -%}
            {%- set anchorId = sourceHeadings.idAt(groupIndex, loop.index0) -%}
            <{{ tag }} class="lp-diff__line lp-diff__line--{{ line.kind.value }}{% if anchorId %} lp-diff__line--heading{% endif %}"{% if anchorId %} id="{{ anchorId }}"{% endif %}>
                {%- for segment in line.segments -%}
                    {%- if segment.kind.value == 'unchanged' -%}
                        {{- segment.text -}}
                    {%- elseif segment.kind.value == 'inserted' -%}
                        <ins class="lp-diff__mark lp-diff__mark--inserted">{{- segment.text -}}</ins>
                    {%- else -%}
                        <del class="lp-diff__mark lp-diff__mark--deleted">{{- segment.text -}}</del>
                    {%- endif -%}
                {%- endfor -%}
            </{{ tag }}>
        {%- endfor -%}
        {%- if group.changed -%}
            </div>
        {%- endif -%}
    {%- endfor -%}
</div>
