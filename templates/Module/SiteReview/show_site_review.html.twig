{% extends 'base.html.twig' %}

{% block title %}{{ 'site_review.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'site_review.page.title'|trans }}</span>
{% endblock %}

{% block body %}
{% set pendingCount = comments|filter(comment => comment.status.value == 'pending')|length %}
{% set addressedCount = comments|filter(comment => comment.status.value == 'addressed')|length %}
{% set cardLinks = is_feature_enabled('board.enabled') ? card_site_review_links(project) : [] %}
{% set unlinkedCount = comments|filter(comment => cardLinks[comment.id ~ ''] is not defined)|length %}
{# The drawer sits outside the frame, so a card created in it survives the
   reload that brings the feedback list up to date. #}
<div class="lp-site-review-shell" data-controller="site-review-filter card-drawer frame-refresh" data-action="card-drawer:saved@window->frame-refresh#reload">
<turbo-frame id="site-review-frame" target="_top" data-frame-refresh-target="frame" class="lp-workspace lp-split-page lp-site-feedback-page lp-core-prototype-page lp-core-site-review">
    <header class="lp-page-header">
        <div class="lp-page-header__copy"><h1 class="lp-workspace-title">{{ 'site_review.page.title'|trans }}</h1><p class="lp-workspace-desc">{{ 'site_review.page.description'|trans }}</p></div>
        <a class="lp-btn" href="{{ path('app_project_connect', {id: project.id}) }}"><twig:ux:icon name="lucide:code-xml" class="w-4 h-4" />{{ 'site_review.widget.setup'|trans }}</a>
    </header>

    {% if comments|length > 0 %}
    <section class="lp-feedback-receipt" aria-label="{{ 'site_review.receipt.title'|trans }}">
        <span class="lp-feedback-receipt__icon" aria-hidden="true"><twig:ux:icon name="lucide:message-square" /></span>
        <div><h2>{{ 'site_review.receipt.title'|trans }}</h2><p>{{ 'site_review.receipt.description'|trans }}</p></div>
        {% if unlinkedCount > 0 %}
        <button type="button" class="lp-btn lp-btn--sm" data-site-review-filter-scope-param="unlinked" data-action="site-review-filter#setScope"><twig:ux:icon name="lucide:inbox" class="w-4 h-4" />{{ 'site_review.receipt.needs_card'|trans({'%count%': unlinkedCount}) }}</button>
        {% else %}
        <span class="lp-tag lp-tag--green"><twig:ux:icon name="lucide:check" class="w-3.5 h-3.5" />{{ 'site_review.receipt.organized'|trans }}</span>
        {% endif %}
    </section>

    <div class="lp-tabs" aria-label="{{ 'site_review.filter.scope_label'|trans }}">
        <button type="button" class="lp-tabs__tab" aria-pressed="true" data-site-review-filter-target="scope" data-site-review-filter-scope-param="all" data-action="site-review-filter#setScope">
            {{ 'site_review.filter.all'|trans }} <span class="lp-tabs__count">{{ comments|length }}</span>
        </button>
        <button type="button" class="lp-tabs__tab" aria-pressed="false" data-site-review-filter-target="scope" data-site-review-filter-scope-param="unlinked" data-action="site-review-filter#setScope">
            {{ 'site_review.filter.needs_card'|trans }} <span class="lp-tabs__count">{{ unlinkedCount }}</span>
        </button>
    </div>
    <div class="lp-site-review-toolbar">
        <label class="lp-site-review-search">
            <twig:ux:icon name="lucide:search" />
            <span class="sr-only">{{ 'site_review.filter.search_label'|trans }}</span>
            <input type="search" placeholder="{{ 'site_review.filter.search_placeholder'|trans }}" data-site-review-filter-target="query" data-action="input->site-review-filter#filter">
        </label>
        <label class="sr-only" for="site-review-status">{{ 'site_review.filter.status_label'|trans }}</label>
        <select id="site-review-status" class="lp-input lp-select lp-site-review-status" data-site-review-filter-target="status" data-action="change->site-review-filter#filter">
            <option value="all">{{ 'site_review.filter.status_all'|trans }}</option>
            <option value="pending">{{ 'site_review.comment.status.pending'|trans }}</option>
            <option value="addressed">{{ 'site_review.comment.status.addressed'|trans }}</option>
            <option value="resolved">{{ 'site_review.comment.status.resolved'|trans }}</option>
        </select>
        <span class="lp-site-review-toolbar__summary">{{ 'site_review.filter.summary'|trans({'%pending%': pendingCount, '%addressed%': addressedCount}) }}</span>
    </div>

    <div class="lp-feedback-workspace lp-split-region" data-controller="master-detail" data-master-detail-selected-value="{{ selectedFeedback }}">
        <nav class="lp-feedback-list lp-split-pane" aria-label="{{ 'site_review.feedback.list'|trans }}">
            {% for comment in comments %}
            {% set anchors = comment.anchors|filter(anchor => anchor.selector is not empty) %}
            {% set cardLink = cardLinks[comment.id ~ ''] ?? null %}
            <button type="button" class="lp-feedback-list__item" data-master-detail-target="trigger" data-master-detail-id="feedback-{{ comment.id }}" data-site-review-filter-target="row" data-status="{{ comment.status.value }}" data-linked="{{ cardLink ? 'true' : 'false' }}" data-action="master-detail#select">
                <span class="lp-feedback-list__meta">
                    <span class="lp-feedback-list__number">#{{ loop.index }}</span>
                    <time datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|relative_time }}</time>
                    <span class="lp-status-chip lp-status-chip--{{ comment.status.value }}">{{ ('site_review.comment.status.' ~ comment.status.value)|trans }}</span>
                </span>
                <strong class="lp-feedback-list__title">{{ anchors|length > 1 ? ('site_review.comment.element_count'|trans({'%count%': anchors|length})) : (anchors|length == 1 and anchors|first.text is not empty ? anchors|first.text : ('site_review.comment.general_page'|trans)) }}</strong>
                <span class="lp-feedback-list__body">{{ comment.body }}</span>
                <span class="lp-feedback-list__source"><twig:ux:icon name="lucide:globe" />{{ comment.url|replace({'https://': '', 'http://': ''}) }}</span>
                {% if cardLink %}<span class="lp-feedback-list__card"><twig:ux:icon name="lucide:square-kanban" />{{ 'site_review.feedback.card_label'|trans({'%number%': cardLink.card.number}) }}</span>{% endif %}
            </button>
            {% endfor %}
        </nav>

        <div class="lp-feedback-detail lp-split-pane">
            {% for comment in comments %}
            {% set anchors = comment.anchors|filter(anchor => anchor.selector is not empty) %}
            {% set cardLink = cardLinks[comment.id ~ ''] ?? null %}
            {% set safeUrl = comment.url starts with 'http://' or comment.url starts with 'https://' %}
            <article class="lp-feedback-detail__panel" id="feedback-{{ comment.id }}" aria-labelledby="feedback-title-{{ comment.id }}" data-comment-id="{{ comment.id }}" data-comment-status="{{ comment.status.value }}" data-master-detail-target="panel" data-master-detail-id="feedback-{{ comment.id }}" data-site-review-filter-target="panel" hidden>
                <header class="lp-feedback-detail__header">
                    <h2 class="lp-feedback-detail__eyebrow" id="feedback-title-{{ comment.id }}">{{ 'site_review.feedback.comment_number'|trans({'%number%': loop.index}) }}</h2>
                    <span class="lp-status-chip lp-status-chip--{{ comment.status.value }}">{{ ('site_review.comment.status.' ~ comment.status.value)|trans }}</span>
                </header>
                <p class="lp-feedback-detail__message">{{ comment.body }}</p>

                <section class="lp-feedback-detail__section">
                    <div class="lp-feedback-detail__section-head">
                        <h3>{{ 'site_review.feedback.source_page'|trans }}</h3>
                        {% if safeUrl %}<a class="lp-text-link" href="{{ comment.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ 'site_review.comment.open_source'|trans }}<twig:ux:icon name="lucide:external-link" /></a>{% endif %}
                    </div>
                    <p class="lp-feedback-detail__url">{{ comment.url is not empty ? comment.url : ('site_review.feedback.no_url'|trans) }}</p>
                </section>

                <section class="lp-feedback-detail__section">
                    <h3>{{ (anchors|length > 0 ? 'site_review.feedback.captured_elements' : 'site_review.feedback.page_context')|trans }}</h3>
                    {# The filter yields an iterator, so its length is read once, outside the loop. #}
                    {% set anchorCount = anchors|length %}
                    {% for anchor in anchors %}
                    <div class="lp-feedback-anchor">
                        <span class="lp-feedback-anchor__label"><twig:ux:icon name="lucide:code" />{{ anchorCount > 1 ? ('site_review.feedback.element_numbered'|trans({'%number%': loop.index})) : ('site_review.feedback.selected_element'|trans) }}</span>
                        {% if anchor.text is not empty %}<blockquote class="lp-feedback-anchor__text">{{ anchor.text }}</blockquote>{% endif %}
                        <details class="lp-feedback-anchor__selector"><summary>{{ 'site_review.feedback.element_selector'|trans }}</summary><code>{{ anchor.selector }}</code></details>
                    </div>
                    {% else %}
                    <p class="lp-feedback-detail__muted">{{ 'site_review.feedback.page_note'|trans }}</p>
                    {% endfor %}
                </section>

                {% if cardLink %}
                <section class="lp-feedback-detail__section">
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table">
                            <caption>{{ 'site_review.feedback.linked_work'|trans }}</caption>
                            <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% include '@Board/_linked_card_row.html.twig' with {card: cardLink.card, href: path('app_board_card', {projectId: project.id, cardId: cardLink.card.id, tab: 'feedback'}), drawer: true} only %}
                            </tbody>
                        </table>
                    </div>
                </section>
                {% elseif is_feature_enabled('board.enabled') %}
                {% set attachForm = site_review_attach_form(comment) %}
                <section class="lp-feedback-attach">
                    <h3>{{ 'site_review.attach.title'|trans }}</h3>
                    <p>{{ 'site_review.feedback.attach_hint'|trans }}</p>
                    {{ form_start(attachForm, {action: path('app_site_review_comment_attach', {projectId: project.id, commentId: comment.id}), attr: {class: 'lp-site-review-attach'}}) }}
                        {{ form_label(attachForm.card, null, {label_attr: {class: 'sr-only'}}) }}
                        {{ form_widget(attachForm.card, {attr: {class: 'lp-input lp-select'}}) }}
                        <button type="submit" class="lp-btn lp-btn--primary">
                            <twig:ux:icon name="lucide:link" class="w-4 h-4" />
                            {{ 'site_review.attach.submit'|trans }}
                        </button>
                    {{ form_end(attachForm) }}
                    <a class="lp-btn lp-btn--sm lp-feedback-attach__create" href="{{ path('app_board_card_create', {id: project.id, feedback: comment.id}) }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare">
                        <twig:ux:icon name="lucide:plus" class="w-4 h-4" />
                        {{ 'site_review.create_card.submit'|trans }}
                    </a>
                </section>
                {% endif %}

                <footer class="lp-feedback-detail__actions">
                    {% if cardLink %}
                    <a class="lp-btn" href="{{ path('app_board_card', {projectId: project.id, cardId: cardLink.card.id, tab: 'feedback'}) }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare"><twig:ux:icon name="lucide:square-kanban" />{{ 'site_review.feedback.open_card'|trans({'%number%': cardLink.card.number}) }}</a>
                    {% endif %}
                    {% if comment.status.value != 'pending' %}<form method="POST" action="{{ path('app_site_review_comment_reopen', {id: comment.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('site-review-comment-action') }}"><button type="submit" class="lp-btn lp-btn--ghost"><twig:ux:icon name="lucide:rotate-cw" />{{ 'site_review.comment.action.reopen'|trans }}</button></form>{% endif %}
                    {% if comment.status.value != 'resolved' %}<form method="POST" action="{{ path('app_site_review_comment_resolve', {id: comment.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('site-review-comment-action') }}"><button type="submit" class="lp-btn lp-btn--primary"><twig:ux:icon name="lucide:check" />{{ 'site_review.comment.action.resolve'|trans }}</button></form>{% endif %}
                </footer>
            </article>
            {% endfor %}
            <div class="lp-empty-state lp-feedback-detail__empty" data-site-review-filter-target="empty" hidden>
                <twig:ux:icon name="lucide:search" class="lp-empty-state__icon w-12 h-12" />
                <h2 class="lp-empty-state__title">{{ 'site_review.filter.empty_title'|trans }}</h2>
                <p class="lp-empty-state__body">{{ 'site_review.filter.empty'|trans }}</p>
            </div>
        </div>
    </div>
    {% elseif project.allowedOrigins is empty %}
    <div class="lp-empty-state"><twig:ux:icon name="lucide:code-xml" class="lp-empty-state__icon w-12 h-12" /><h2 class="lp-empty-state__title">{{ 'site_review.site.reviews.setup_title'|trans }}</h2><p class="lp-empty-state__body">{{ 'site_review.site.reviews.setup_body'|trans }}</p><a class="lp-btn" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'site_review.site.reviews.setup_action'|trans }}</a></div>
    {% else %}
    <div class="lp-empty-state"><twig:ux:icon name="lucide:message-square" class="lp-empty-state__icon w-12 h-12" /><h2 class="lp-empty-state__title">{{ 'site_review.site.reviews.empty_title'|trans }}</h2><p class="lp-empty-state__body">{{ 'site_review.site.reviews.empty_body'|trans }}</p></div>
    {% endif %}
</turbo-frame>
{% if is_feature_enabled('board.enabled') %}
    {% include '@Board/_card_drawer.html.twig' with {project: project} only %}
{% endif %}
</div>
{% endblock %}
