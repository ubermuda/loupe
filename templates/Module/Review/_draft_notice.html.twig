<twig:Ds:Hint as="div" hidden data-form-draft-target="notice">
    <p>{{ 'review.draft.retained'|trans }}</p>
    <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="form-draft#discard">{{ 'review.draft.discard'|trans }}</twig:Ds:Button>
</twig:Ds:Hint>
<twig:Ds:FieldErrors as="p" hidden data-form-draft-target="stale" role="status">{{ 'review.draft.stale'|trans }}</twig:Ds:FieldErrors>
