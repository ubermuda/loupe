{#- Project settings sections. Props: project, active (general, columns or connections). -#}
<nav class="lp-settings-nav" aria-label="{{ 'project.edit.nav.label'|trans }}">
    <a class="lp-settings-nav__item{{ active == 'general' ? ' lp-settings-nav__item--active' }}" href="{{ path('app_project_edit', {id: project.id}) }}"{% if active == 'general' %} aria-current="page"{% endif %}>
        <twig:ux:icon name="lucide:settings" />
        {{ 'project.edit.nav.general'|trans }}
    </a>
    {% if is_feature_enabled('board.enabled') %}
    <a class="lp-settings-nav__item{{ active == 'columns' ? ' lp-settings-nav__item--active' }}" href="{{ path('app_board_settings', {id: project.id}) }}"{% if active == 'columns' %} aria-current="page"{% endif %}>
        <twig:ux:icon name="lucide:square-kanban" />
        {{ 'project.edit.nav.columns'|trans }}
    </a>
    {% endif %}
    <a class="lp-settings-nav__item{{ active == 'connections' ? ' lp-settings-nav__item--active' }}" href="{{ path('app_project_connect', {id: project.id}) }}"{% if active == 'connections' %} aria-current="page"{% endif %}>
        <twig:ux:icon name="lucide:link" />
        {{ 'project.edit.nav.connections'|trans }}
    </a>
</nav>
