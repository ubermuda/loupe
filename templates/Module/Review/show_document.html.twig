{% extends 'base.html.twig' %}

{% block title %}{{ 'review.document.page.title'|trans({'%title%': document.title}) }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: document.project.id}) }}">{{ 'nav.link.documents'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ document.title }}</span>
    <span class="lp-version-pill">{{ 'v' ~ version.versionNumber }}</span>
{% endblock %}

{% block topbar_meta %}
    <span class="lp-topbar__meta">{{ 'review.document.threads.summary'|trans({'%open%': signals.openThreadCount, '%resolved%': signals.resolvedThreadCount}) }}</span>
    {# One chip for the two states, because "all answered" already says that
       every thread is addressed or resolved. #}
    {% if signals.allThreadsAnswered %}
    <span class="lp-signal lp-signal--answered">{{ 'review.document.threads.all_answered'|trans }}</span>
    {% elseif signals.hasAddressedThreads %}
    <span class="lp-signal lp-signal--addressed">{{ 'review.document.threads.addressed_count'|trans({'%count%': signals.addressedThreadCount}) }}</span>
    {% endif %}
{% endblock %}

{% block topbar_actions %}
{% endblock %}

{% block body %}
{% set finishReviewAvailable = not diffMode and not readOnly and (document.status.value in ['draft', 'in-review'] or submitReviewForm.vars.submitted) %}
<div class="lp-review" data-site-review-quotes="off" data-controller="card-drawer{{ finishReviewAvailable ? ' modal' : '' }}"
     {% if finishReviewAvailable %}data-modal-reopen-value="{{ submitReviewForm.vars.submitted ? 'true' : 'false' }}"{% endif %}>
    {# Both controllers pass diffMode explicitly: Twig's `default` filter fires
       on any falsy value, so `|default(true)` would send every show-page render
       down the diff branch. A comparison names itself with the chip in the
       metadata bar below, so only an older version still earns a banner. #}
    {% if readOnly and not diffMode %}
    <div class="lp-version-banner">
        <twig:ux:icon name="lucide:history" class="w-4 h-4 shrink-0" />
        <span>
            {{ 'review.document.version.read_only'|trans({'%version%': version.versionNumber}) }}
            {# References belong to the document, not to a version, so this page
               shows the current ones next to an old version's number. #}
            {% if document.references|length > 0 or document.referencedBy|length > 0 %}
                {{ 'review.document.version.references_are_current'|trans }}
            {% endif %}
        </span>
        <a class="lp-btn lp-btn--ghost lp-btn--sm" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">
            {{ 'review.document.version.back_to_latest'|trans }}
        </a>
    </div>
    {% endif %}

    {# Empty unless the inbox is on and an item links to this document. Outside
       the review block, whose change and mouseup listeners would take the
       section's controls for the document's own. #}
    {% if not diffMode %}
    {{ inbox_document_section(document, readOnly ? version.versionNumber : null) }}
    {% endif %}

    {# The comment-anchor controller attaches in diff mode only where the diff
       accepts comments, and its `diff` value tells it the pane holds two
       versions. It is never attached merely to stay quiet: its highlight
       painting runs on every layout, whatever readOnly says. #}
    {% set diffNavigation = diffMode and diffChangeCount is not null %}
    {% set canComment = not readOnly or diffCommenting %}
    {% set reviewControllers = (diffNavigation ? ['diff-navigation'] : [])|merge(diffMode and not diffCommenting ? [] : ['comment-anchor']) %}
    {% set diffUnmarked = diffNavigation and diff.hasChanges and diffView.value != 'source' and diffChangeCount == 0 %}
    {# Two columns use the full reading width; their comments follow below. #}
    {% set diffColumns = diffMode and diffView is not null and diffView.value == 'side-by-side' %}
    <div class="lp-review-block{{ diffColumns ? ' lp-review-block--wide' : '' }}"
        data-controller="{{ (reviewControllers|merge(['review-margin']))|join(' ') }}"
        data-action="review-margin:filter->comment-anchor#filterThreads comment-anchor:resolved-filter->review-margin#resolvedFilter"
        {%- if diffNavigation %} data-diff-navigation-position-value="{{ 'review.document.diff.nav.position'|trans({'%total%': diffChangeCount}) }}"{% endif %}
        {%- if diffCommenting %} data-comment-anchor-diff-value="true"
            data-comment-anchor-deleted-message-value="{{ 'review.document.diff.comment.deleted_refused'|trans }}"
            data-comment-anchor-unanchorable-message-value="{{ 'review.document.diff.comment.unanchorable_refused'|trans }}"{% endif %}>
        {# .lp-review-doc is position:relative: the offset parent the floating
           composer and toolbar are placed against, and the frame the comment
           margin is measured within. The inner [data-comment-anchor-target="doc"]
           is the TreeWalker root and must hold ONLY the rendered HTML, so its
           text === plainText(). #}
        {% set docActions = (canComment ? ['mouseup->comment-anchor#onDocMouseup', 'pointerup->comment-anchor#onDocPointerup', 'mousemove->comment-anchor#onDocMousemove', 'click->comment-anchor#onDocClick'] : [])|merge(readOnly ? [] : ['change->decision#select']) %}
        <div class="lp-review-doc{{ diffColumns ? ' lp-review-doc--wide' : '' }}" data-comment-anchor-target="block" data-controller="decision" data-decision-save-label-value="{{ 'review.decision.save'|trans }}"{% if docActions|length > 0 %} data-action="{{ docActions|join(' ') }}"{% endif %}>

            {% include '@Review/_document_header.html.twig' with {
                document: document,
                version: version,
                versionCount: versions|length,
                activeView: diffMode ? 'diff' : 'document',
                showDocumentActions: not readOnly and not diffMode,
                reviseDocumentForm: not readOnly and not diffMode ? reviseDocumentForm : null,
                approvedSections: diffMode ? 0 : sections.approvedCount,
                totalSections: diffMode ? diffHeadings|length : sections.rows|length,
                showMarginControls: not diffMode,
            } only %}

            {# The way back to a discussion a revision left behind: comments
               resolved on an earlier version stay there, so the thread is
               otherwise unreachable once revised. A single version with a
               description still earns the list, because the description
               appears nowhere else. #}
            {% set hasVersionDescription = versions|filter(meta => meta.description is not empty)|length > 0 %}
            {% set showVersions = versions|length > 1 or hasVersionDescription %}
            {# Contents and section approvals are one panel: both list the same
               headings. A diff is passed no `sections`, hence the lazy ternary,
               and its rows come from the merged render, which is the markup the
               page holds. A diff approves nothing, so its rows carry no state. #}
            {% set sectionRows = diffMode
                ? diffHeadings|map(heading => {level: heading.level, headingId: heading.id, label: heading.text, approved: false})
                : sections.rows %}
            {% set sectionsApprovable = not diffMode %}
            {% set approvedSections = diffMode ? 0 : sections.approvedCount %}
            {# One section is enough, where the old table of contents wanted two:
               the panel now reports approval state, which changes and is worth
               seeing for a single section. An untexted heading keeps a row too,
               labelled by its id, or the tab count would outrun the list. #}
            {% set showContents = sectionRows|length > 0 %}
            {% set referenceCount = document.references|length + document.referencedBy|length %}
            {# Same lazy-ternary guard as the headings above: the diff controller
               passes no `decisions` at all, and naming it outside this branch is
               an undefined-variable 500 on the diff page. #}
            {% set decisionRows = diffMode ? [] : decisions.rows %}
            {% set answeredDecisions = diffMode ? 0 : decisions.answeredCount %}
            {# The pane HTML with an approval control beside each heading. Built
               here rather than in the block below, so the diff branch never
               evaluates `decisionMarkedHtml`, which it is not passed. An older
               version gets no controls: they would post onto the current one. #}
            {% set documentPaneHtml = diffMode ? '' : section_approval_controls(
                decisionMarkedHtml,
                readOnly ? [] : sectionRows,
                document,
                version.versionNumber,
            ) %}

            {# Left of the reading column from 2xl up, where there is room for it
               beside the comment column. Absolutely positioned, so it neither
               moves the prose nor joins the anchor pane's textContent. Not on the
               two-column diff, which already takes the width the rail needs. #}
            {% if diffMode and not diffColumns and (sectionRows|length > 0 or decisionRows|length > 0) %}
            {% include '@Review/_review_rail.html.twig' with {
                document: document,
                sectionRows: sectionRows,
                sectionsApprovable: sectionsApprovable,
                approvedSections: approvedSections,
                decisionRows: decisionRows,
                answeredDecisions: answeredDecisions,
            } only %}
            {% endif %}

            {% if diffMode %}
            <div class="lp-doc-meta-bar" data-controller="metadata-tabs">
                    <div class="lp-doc-meta">
                        {# The chip names the pair and carries the way out of the
                           comparison, so the bar needs no banner above it. It
                           leads the row and survives below lg, where the tabs
                           beside it do not. #}
                        {% if diffMode %}
                        <span class="lp-doc-meta__compare">
                            <twig:ux:icon name="lucide:git-compare" class="w-3.5 h-3.5 shrink-0" />
                            <span>{{ 'review.document.diff.chip'|trans({'%from%': diffFromVersion, '%to%': version.versionNumber}) }}</span>
                            <a class="lp-doc-meta__compare-stop"
                               href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}"
                               aria-label="{{ 'review.document.diff.stop'|trans }}"
                               title="{{ 'review.document.diff.stop'|trans }}">
                                <twig:ux:icon name="lucide:x" class="w-3.5 h-3.5 shrink-0" />
                            </a>
                        </span>
                        {% endif %}
                        {% if showVersions %}
                        <button type="button" class="lp-doc-meta__tab" aria-expanded="false"
                                data-metadata-tabs-target="tab"
                                data-metadata-tabs-panel-param="versions"
                                data-action="click->metadata-tabs#toggle">
                            {{ 'review.document.meta.versions'|trans }}
                            <span class="lp-doc-meta__count">{{ versions|length }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="lp-doc-meta__caret" />
                        </button>
                        {% endif %}
                        {% if showContents %}
                        <button type="button" class="lp-doc-meta__tab lp-doc-meta__tab--railed" aria-expanded="false"
                                data-metadata-tabs-target="tab"
                                data-metadata-tabs-panel-param="contents"
                                data-action="click->metadata-tabs#toggle">
                            {{ 'review.document.contents.label'|trans }}
                            {# Approved-of-total rather than a bare heading count:
                               it carries the same total and the state as well. A
                               diff approves nothing, so it counts headings. #}
                            <span class="lp-doc-meta__count" id="section-summary-count">{{ sectionsApprovable
                                ? 'review.document.sections.count_compact'|trans({
                                    '%approved%': approvedSections,
                                    '%total%': sectionRows|length,
                                })
                                : sectionRows|length }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="lp-doc-meta__caret" />
                        </button>
                        {% endif %}
                        {% if referenceCount > 0 %}
                        <button type="button" class="lp-doc-meta__tab" aria-expanded="false"
                                data-metadata-tabs-target="tab"
                                data-metadata-tabs-panel-param="references"
                                data-action="click->metadata-tabs#toggle">
                            {{ 'review.document.meta.references'|trans }}
                            <span class="lp-doc-meta__count">{{ referenceCount }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="lp-doc-meta__caret" />
                        </button>
                        {% endif %}
                        {% if decisionRows|length > 0 %}
                        <button type="button" class="lp-doc-meta__tab lp-doc-meta__tab--railed" aria-expanded="false"
                                data-metadata-tabs-target="tab"
                                data-metadata-tabs-panel-param="decisions"
                                data-action="click->metadata-tabs#toggle">
                            {{ 'review.document.meta.decisions'|trans }}
                            <span class="lp-doc-meta__count" id="decision-summary-count">{{ 'review.document.decisions.count'|trans({
                                '%answered%': answeredDecisions,
                                '%total%': decisionRows|length,
                            }) }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="lp-doc-meta__caret" />
                        </button>
                        {% endif %}
                        {% if document.tags|length > 0 %}
                        <button type="button" class="lp-doc-meta__tab" aria-expanded="false"
                                data-metadata-tabs-target="tab"
                                data-metadata-tabs-panel-param="tags"
                                data-action="click->metadata-tabs#toggle">
                            {{ 'review.document.meta.tags'|trans }}
                            <span class="lp-doc-meta__count">{{ document.tags|length }}</span>
                            <twig:ux:icon name="lucide:chevron-right" class="lp-doc-meta__caret" />
                        </button>
                        {% endif %}
                        {% if document.series is not null %}
                        <div class="lp-doc-meta__series">
                            <span class="lp-series">{{ 'review.document.series.item'|trans({
                                '%series%': document.series.name,
                                '%ordinal%': document.seriesOrdinal,
                            }) }}</span>
                        </div>
                        {% endif %}
                        {# Below lg the tab and its panel are display:none, so the
                           chips stay in the bar there. Above lg the panel holds
                           them and this group is hidden. #}
                        {% if document.tags|length > 0 %}
                        <div class="lp-doc-meta__tags">
                            {% for tag in document.tags %}
                            <span class="lp-tag">{{ tag.name }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>

                {% if document.tags|length > 0 %}
                <div class="lp-doc-meta__panel lp-doc-tags" data-metadata-tabs-target="panel" data-panel="tags" hidden>
                    <ul class="lp-doc-tags__list" aria-label="{{ 'review.document.meta.tags'|trans }}">
                        {% for tag in document.tags %}
                        <li class="lp-tag">{{ tag.name }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if showVersions %}
                {# The version on screen alone, plus the way to the rest. Every
                   version with its note in full made this panel taller than the
                   fold, so opening it pushed the document's first paragraph off
                   the screen. #}
                <nav class="lp-doc-meta__panel lp-version-switcher" data-metadata-tabs-target="panel" data-panel="versions" hidden
                     aria-label="{{ 'review.document.version.switcher_label'|trans }}">
                    <div class="lp-version-entry" data-version-number="{{ version.versionNumber }}">
                        <div class="lp-version-entry__row">
                            {# A diff is not one of the versions it compares, so in
                               diff mode the pill stays a link — reading the newer
                               version on its own is a click away, and the only
                               element claiming to be the current page is the diff
                               link beside it. #}
                            {% if not diffMode %}
                                <span class="lp-version-pill" aria-current="page">{{ 'v' ~ version.versionNumber }}</span>
                            {% else %}
                                <a class="lp-version-pill lp-version-pill--link"
                                   href="{{ version.versionNumber == versions|first.versionNumber
                                       ? path('app_document_review', {projectId: document.project.id, documentId: document.id})
                                       : path('app_document_review_version', {projectId: document.project.id, documentId: document.id, versionNumber: version.versionNumber}) }}"
                                >{{ 'v' ~ version.versionNumber }}</a>
                            {% endif %}
                            <span class="lp-version-entry__date">{{ version.createdAt|relative_time }}</span>
                            {% if version.versionNumber > 1 %}
                            {# Above the note rather than below it: below, a reader
                               takes it as the heading of the entry that follows. #}
                            <a class="lp-version-entry__diff"
                               href="{{ path('app_document_review_diff', {projectId: document.project.id, documentId: document.id, fromVersionNumber: version.versionNumber - 1, toVersionNumber: version.versionNumber}) }}"
                               {% if diffMode and diffFromVersion == version.versionNumber - 1 %}aria-current="page"{% endif %}
                            >{{ 'review.document.diff.link'|trans({'%from%': version.versionNumber - 1}) }}</a>
                            {% endif %}
                        </div>
                        {% if version.description %}
                        <p class="lp-version-entry__description">{{ version.description }}</p>
                        {% endif %}
                    </div>
                    <a class="lp-version-switcher__all" href="{{ path('app_document_review_history', {projectId: document.project.id, documentId: document.id}) }}">
                        <twig:ux:icon name="lucide:history" class="w-3.5 h-3.5 shrink-0" />
                        <span>{{ 'review.document.version.see_all'|trans({'%count%': versions|length}) }}</span>
                    </a>
                </nav>
                {% endif %}

                {# Never inside [data-comment-anchor-target="doc"]: that element's
                   textContent must stay identical to DocumentVersion::plainText(),
                   which every comment anchor offset is measured against. #}
                {% if showContents %}
                <nav class="lp-doc-meta__panel lp-review-contents" data-metadata-tabs-target="panel" data-panel="contents" hidden
                     aria-label="{{ 'review.document.contents.nav_label'|trans }}">
                    <ul class="lp-review-contents__list" id="section-summary-list">
                        {% include '@Review/_contents_rows.html.twig' with {rows: sectionRows, approvable: sectionsApprovable} only %}
                    </ul>
                </nav>
                {% endif %}

                {# Not gated on diffMode, unlike the contents panel above: a
                   reference is document-level, and its links point at other
                   documents rather than into the markup the diff replaces.
                   `document` is passed in both modes. #}
                {% if referenceCount > 0 %}
                <div class="lp-doc-meta__panel lp-doc-references" data-metadata-tabs-target="panel" data-panel="references" hidden>
                    {% for group in [
                        {label: 'review.document.references.outgoing', documents: document.references},
                        {label: 'review.document.references.incoming', documents: document.referencedBy},
                    ] %}
                        {% if group.documents|length > 0 %}
                        <div class="lp-doc-references__group">
                            <h2 class="lp-doc-references__label" id="references-{{ loop.index }}">{{ group.label|trans }}</h2>
                            <ul class="lp-doc-references__list" aria-labelledby="references-{{ loop.index }}">
                                {% for reference in group.documents %}
                                <li class="lp-doc-references__item">
                                    <a class="lp-doc-references__link" href="{{ path('app_document_review', {projectId: reference.project.id, documentId: reference.id}) }}">
                                        <twig:ux:icon name="lucide:link" class="w-3.5 h-3.5 shrink-0" />
                                        {{ reference.title }}
                                    </a>
                                    {% if reference.archivedAt %}
                                    <span class="lp-doc-references__archived">{{ 'review.document.references.archived'|trans }}</span>
                                    {# Rendered only when there is one to render — a
                                       reason is required of the MCP tool and of
                                       nothing else, so an archived reference
                                       usually has none and must not look as
                                       though its reason was lost. #}
                                    {% if reference.archiveReason %}
                                    <span class="lp-doc-references__archive-reason">{{ 'review.document.references.archive_reason'|trans({'%reason%': reference.archiveReason}) }}</span>
                                    {% endif %}
                                    {% endif %}
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}

                {# The list is streamed back after every answer, so the <ul> is the
                   stream's target and must keep its id here. #}
                {% if decisionRows|length > 0 %}
                <div class="lp-doc-meta__panel lp-decision-summary" data-metadata-tabs-target="panel" data-panel="decisions" hidden>
                    <ul class="lp-decision-summary__list" id="decision-summary-list">
                        {% include '@Review/_decision_summary_rows.html.twig' with {rows: decisionRows} only %}
                    </ul>
                </div>
                {% endif %}

                {# Every panel above, and everything below it belongs to the bar
                   rather than to a tab. A panel opens directly under the row that
                   names it, the way the tags one does, and no control stands
                   between the tab and what it opened. #}
                {% if decisionRows|length > 0 %}
                {# A row of its own in the bar: the longest refusal is a sentence
                   and would squeeze the tabs out of the row above. Rendered
                   empty rather than omitted — a live region must be in the
                   accessibility tree before its text arrives. #}
                <p id="decision-status" class="lp-decision-status" aria-live="polite"></p>
                {% endif %}

                {# The same shape for a refused press. Only where a control is
                   rendered, which is the case the message can arise in. #}
                {% if not diffMode and not readOnly and showContents %}
                <p id="section-status" class="lp-decision-status" aria-live="polite"></p>
                {% endif %}

                {# One row of the sticky bar for both, rather than a bar of its
                   own: two elements stuck to the same edge overlap. The views
                   stay plain links, so each is addressable. The rendered one
                   cannot mark front matter, a link reference definition or a
                   setext underline, hence the Markdown one. #}
                {% if diffMode %}
                {% set viewParams = {projectId: document.project.id, documentId: document.id, fromVersionNumber: diffFromVersion, toVersionNumber: version.versionNumber} %}
                <div class="lp-diff-bar">
                    {% include '@Review/_version_compare_picker.html.twig' with {
                        document: document,
                        versions: versions,
                        fromVersionNumber: diffFromVersion,
                        toVersionNumber: version.versionNumber,
                        viewValue: diffView.value,
                        idPrefix: 'diff',
                    } only %}
                    <nav class="lp-diff-views" aria-label="{{ 'review.document.diff.view.label'|trans }}">
                        <a class="lp-btn lp-btn--ghost lp-diff-views__link"
                           href="{{ path('app_document_review_diff', viewParams|merge({view: 'rendered'})) }}"
                           {% if diffView.value == 'rendered' %}aria-current="page"{% endif %}
                           {% if diffColumns %}aria-describedby="diff-columns-notice"{% endif %}
                        >{{ 'review.document.diff.view.rendered'|trans }}</a>
                        {# describedby rather than a second link: the notice below says
                           why this view is worth opening, and this is the control that
                           opens it. Second of the three: it reads the same document,
                           where the columns rebuild the page. #}
                        <a class="lp-btn lp-btn--ghost lp-diff-views__link"
                           href="{{ path('app_document_review_diff', viewParams|merge({view: 'source'})) }}"
                           {% if diffView.value == 'source' %}aria-current="page"{% endif %}
                           {% if diffUnmarked %}aria-describedby="diff-unmarked-notice"{% endif %}
                        >{{ 'review.document.diff.view.source'|trans }}</a>
                        {# The same rendered blocks in two columns. The notice
                           below says what it gives up, and this link opens it. #}
                        <a class="lp-btn lp-btn--ghost lp-diff-views__link"
                           href="{{ path('app_document_review_diff', viewParams|merge({view: 'side-by-side'})) }}"
                           {% if diffColumns %}aria-current="page"{% endif %}
                        >{{ 'review.document.diff.view.side_by_side'|trans }}</a>
                    </nav>
                    {% if diffNavigation %}
                    <div class="lp-diff-nav">
                        <p class="lp-diff-nav__count" aria-live="polite" data-diff-navigation-target="counter">{{ 'review.document.diff.nav.count'|trans({'%count%': diffChangeCount}) }}</p>
                        <button type="button" class="lp-btn lp-btn--icon" data-diff-navigation-target="previousButton" data-action="diff-navigation#previous"{% if diffChangeCount == 0 %} disabled{% endif %}
                                aria-label="{{ 'review.document.diff.nav.previous'|trans }}"
                                title="{{ 'review.document.diff.nav.previous'|trans }}">
                            <twig:ux:icon name="lucide:arrow-up" class="w-4 h-4 shrink-0" />
                        </button>
                        <button type="button" class="lp-btn lp-btn--icon" data-diff-navigation-target="nextButton" data-action="diff-navigation#next"{% if diffChangeCount == 0 %} disabled{% endif %}
                                aria-label="{{ 'review.document.diff.nav.next'|trans }}"
                                title="{{ 'review.document.diff.nav.next'|trans }}">
                            <twig:ux:icon name="lucide:arrow-down" class="w-4 h-4 shrink-0" />
                        </button>
                    </div>
                    {% endif %}
                </div>
                {% endif %}

                {% if diffColumns %}
                <p id="diff-columns-notice" class="lp-diff-notice">
                    <twig:ux:icon name="lucide:info" class="w-4 h-4 shrink-0 mt-0.5" />
                    <span>{{ (diffCommenting ? 'review.document.diff.side_by_side.commenting' : 'review.document.diff.side_by_side.read_only')|trans }}</span>
                </p>
                {% endif %}

                {% if diffUnmarked %}
                <p id="diff-unmarked-notice" class="lp-diff-notice">
                    <twig:ux:icon name="lucide:info" class="w-4 h-4 shrink-0 mt-0.5" />
                    <span>{{ 'review.document.diff.unmarked_notice'|trans }}</span>
                </p>
                {% endif %}

            </div>
            {% endif %}

            {% if not diffMode and not readOnly and lastSeenVersionNumber is not null and lastSeenVersionNumber < version.versionNumber %}
            <a class="lp-doc-meta__unread"
               href="{{ path('app_document_review_diff', {projectId: document.project.id, documentId: document.id, fromVersionNumber: lastSeenVersionNumber, toVersionNumber: version.versionNumber}) }}">
                <twig:ux:icon name="lucide:git-compare" class="w-3.5 h-3.5 shrink-0" />
                {{ 'review.document.since_last_visit.chip'|trans({'%from%': lastSeenVersionNumber, '%to%': version.versionNumber}) }}
            </a>
            {% endif %}

            {% if not diffMode %}
                {% if decisionRows|length > 0 %}<p id="decision-status" class="lp-decision-status" aria-live="polite"></p>{% endif %}
                {% if not readOnly and showContents %}<p id="section-status" class="lp-decision-status" aria-live="polite"></p>{% endif %}
            {% endif %}

            {% if canComment %}
            <div class="lp-review-actions">
                <button type="button" class="lp-btn lp-btn--sm" data-action="comment-anchor#startUntargeted">
                    {{ 'review.document.comment.untargeted'|trans }}
                </button>
                <span class="lp-review-actions__hint">{{ 'review.document.comment.select_hint'|trans }}</span>
                {# Always rendered, shown by the controller once a resolved thread
                   exists. Resolving replaces #comment-threads alone, and this row
                   sits outside it. Both icons ship and CSS picks one: the
                   controller rewrites the label and would drop a re-rendered
                   child, which is why the label has a span of its own. #}
                <button type="button" class="lp-btn lp-btn--sm lp-btn--ghost lp-review-actions__resolved"
                        data-resolved-toggle
                        data-resolved-hidden="0"
                        data-label-hide="{{ 'review.document.threads.hide_resolved'|trans }}"
                        data-label-show="{{ 'review.document.threads.show_resolved'|trans }}"
                        data-action="comment-anchor#toggleResolved"
                        hidden>
                    <twig:ux:icon name="lucide:eye-off" class="lp-review-actions__resolved-icon lp-review-actions__resolved-icon--hide w-4 h-4 shrink-0" />
                    <twig:ux:icon name="lucide:eye" class="lp-review-actions__resolved-icon lp-review-actions__resolved-icon--show w-4 h-4 shrink-0" />
                    <span data-resolved-toggle-label>{{ 'review.document.threads.hide_resolved'|trans }}</span>
                </button>
            </div>

            {# Hidden until the reader opts in. It sits next to the button because
               an untargeted comment opens in the flow here. A targeted one is
               absolutely positioned at the selection, and .lp-review-doc is the
               offset parent either way. #}
            {{ form_start(addCommentForm, {attr: {
                class: 'lp-comment-composer',
                'data-comment-anchor-target': 'composer',
                'data-controller': 'keyboard-submit',
                'data-action': 'turbo:submit-end->comment-anchor#onSubmitEnd keydown->keyboard-submit#submit',
                hidden: true,
            }}) }}
                {{ form_widget(addCommentForm.quote) }}
                {{ form_widget(addCommentForm.versionNumber, {type: 'hidden'}) }}
                {{ form_widget(addCommentForm.prefix) }}
                {{ form_widget(addCommentForm.suffix) }}
                <blockquote class="lp-composer-quote" data-comment-anchor-target="quotePreview"></blockquote>
                <span class="lp-composer-general">{{ 'review.document.comment.general'|trans }}</span>
                {{ form_widget(addCommentForm.body) }}
                <div class="lp-comment-composer__actions">
                    <span class="lp-composer-hint">{{ 'review.document.comment.hint'|trans }}</span>
                    <span
                        id="composer-error"
                        class="lp-comment-composer__error"
                        data-comment-anchor-target="composerError"
                    ></span>
                    <button
                        type="button"
                        class="lp-btn lp-btn--ghost lp-btn--sm"
                        data-action="comment-anchor#hideComposer"
                    >{{ 'review.document.comment.cancel'|trans }}</button>
                    <button
                        type="submit"
                        class="lp-btn lp-btn--primary lp-btn--sm"
                        data-action="comment-anchor#submitComment"
                    >{{ 'review.document.comment.submit'|trans }}</button>
                </div>
            {{ form_end(addCommentForm) }}
            {% endif %}

            {# Also on a diff that accepts comments: the add-comment stream
               replaces this list, so a comment made there needs it on the page. #}
            {% if not diffMode or diffCommenting %}
            <div data-review-margin-target="panel" data-margin-panel="comments"
                 {% if not diffMode %}id="review-margin-panel-comments" role="tabpanel" aria-labelledby="review-margin-tab-comments" tabindex="0"{% endif %}>
                <div id="comment-recovery" aria-live="polite"></div>
                {% include '@Review/_comment_threads.html.twig' with {comments: comments, readOnly: readOnly and not diffCommenting} only %}
            </div>
            {% if not diffMode %}
            <aside class="lp-review-context-panel" data-review-margin-target="panel" data-margin-panel="outline" data-panel="contents"
                   data-controller="contents-rail" id="review-margin-panel-outline" role="tabpanel" aria-labelledby="review-margin-tab-outline" tabindex="0" hidden>
                <h2>{{ 'review.document.margin.outline'|trans }} <span id="section-summary-count">{{ 'review.document.sections.count_compact'|trans({'%approved%': approvedSections, '%total%': sectionRows|length}) }}</span></h2>
                {% if sectionRows|length > 0 %}
                <ul class="lp-review-contents__list" id="section-summary-list">
                    {% include '@Review/_contents_rows.html.twig' with {rows: sectionRows, approvable: sectionsApprovable} only %}
                </ul>
                {% else %}<p class="lp-empty">{{ 'review.document.margin.outline_empty'|trans }}</p>{% endif %}
            </aside>
            <aside class="lp-review-context-panel" data-review-margin-target="panel" data-margin-panel="decisions"
                   data-controller="contents-rail" id="review-margin-panel-decisions" role="tabpanel" aria-labelledby="review-margin-tab-decisions" tabindex="0" hidden>
                <h2>{{ 'review.document.margin.decisions'|trans }} <span id="decision-summary-count">{{ 'review.document.decisions.count'|trans({'%answered%': answeredDecisions, '%total%': decisionRows|length}) }}</span></h2>
                {% if decisionRows|length > 0 %}
                <ul class="lp-decision-summary__list" id="decision-summary-list">
                    {% include '@Review/_decision_summary_rows.html.twig' with {rows: decisionRows} only %}
                </ul>
                <p class="lp-review-context-panel__hint">{{ 'review.document.margin.decisions_save_hint'|trans }}</p>
                {% else %}<p class="lp-empty">{{ 'review.document.margin.decisions_empty'|trans }}</p>{% endif %}
            </aside>
            <aside class="lp-review-context-panel" data-review-margin-target="panel" data-margin-panel="details"
                   data-controller="contents-rail" id="review-margin-panel-details" role="tabpanel" aria-labelledby="review-margin-tab-details" tabindex="0" hidden>
                <h2>{{ 'review.document.margin.details'|trans }}</h2>
                {% set cardLinks = document_card_links(document) %}
                <dl class="lp-review-details">
                    <div>
                        <dt>{{ 'review.document.margin.linked_card'|trans }}</dt>
                        <dd>
                            {% if cardLinks is empty %}
                                {{ 'review.document.margin.linked_card_unavailable'|trans }}
                            {% else %}
                                {% for link in cardLinks %}
                                <a class="lp-review-details__card"
                                   href="{{ path('app_board_card', {projectId: document.project.id, cardId: link.card.id}) }}"
                                   data-turbo-frame="card-drawer-frame"
                                   data-action="click->card-drawer#prepare">
                                    <span>#{{ link.card.number }} {{ link.card.title }}</span>
                                    {% include '@Board/_column_tag.html.twig' with {column: link.card.column} only %}
                                    <twig:ux:icon name="lucide:chevron-right" class="w-4 h-4" />
                                </a>
                                {% endfor %}
                            {% endif %}
                        </dd>
                    </div>
                    {% for group in [
                        {label: 'review.document.references.outgoing', documents: document.references},
                        {label: 'review.document.references.incoming', documents: document.referencedBy},
                    ] %}
                    <div>
                        <dt>{{ group.label|trans }}</dt>
                        <dd{% if group.documents is not empty %} class="lp-doc-references"{% endif %}>
                            {% if group.documents is empty %}{{ 'review.document.margin.references_empty'|trans }}{% else %}
                            <ul class="lp-doc-references__list">
                                {% for reference in group.documents %}
                                <li class="lp-doc-references__item">
                                    <a class="lp-doc-references__link" href="{{ path('app_document_review', {projectId: reference.project.id, documentId: reference.id}) }}">{{ reference.title }}</a>
                                    {% if reference.archivedAt %}
                                    <span class="lp-doc-references__archived">{{ 'review.document.references.archived'|trans }}</span>
                                    {% if reference.archiveReason %}<span class="lp-doc-references__archive-reason">{{ 'review.document.references.archive_reason'|trans({'%reason%': reference.archiveReason}) }}</span>{% endif %}
                                    {% endif %}
                                </li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </dd>
                    </div>
                    {% endfor %}
                    {% if document.series is not null %}
                    <div><dt>{{ 'review.document.margin.series'|trans }}</dt><dd><span class="lp-series">{{ 'review.document.series.item'|trans({'%series%': document.series.name, '%ordinal%': document.seriesOrdinal}) }}</span></dd></div>
                    {% endif %}
                    {% if version.description %}
                    <div><dt>{{ 'review.document.margin.version_note'|trans }}</dt><dd data-version-note>{{ version.description }}</dd></div>
                    {% endif %}
                    <div>
                        <dt>{{ 'review.document.meta.tags'|trans }}</dt>
                        <dd>
                            {% if document.tags is empty %}{{ 'review.document.margin.references_empty'|trans }}{% else %}
                            <ul class="lp-doc-tags__list">{% for tag in document.tags %}<li class="lp-tag">{{ tag.name }}</li>{% endfor %}</ul>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
                <a class="lp-btn lp-btn--ghost" href="{{ path('app_document_deleted_threads', {projectId: document.project.id, documentId: document.id}) }}">{{ 'review.deleted_threads.title'|trans }}</a>
                <div data-controller="review-summary"
                     data-review-summary-header-value="{{ document.title ~ ' · v' ~ version.versionNumber ~ "\n" ~ 'review.document.summary.status'|trans({'%status%': ('document.status.' ~ document.status.value|replace({'-': '_'}))|trans}) }}"
                     data-review-summary-copied-value="{{ 'review.document.summary.copied'|trans }}"
                     data-review-summary-failed-value="{{ 'review.document.summary.failed'|trans }}">
                    <button type="button" class="lp-btn lp-btn--ghost" data-action="review-summary#copy">
                        <twig:ux:icon name="lucide:copy" class="w-4 h-4" />
                        {{ 'review.document.summary.copy'|trans }}
                    </button>
                    <p class="lp-review-context-panel__hint" data-review-summary-target="status" role="status"></p>
                </div>
            </aside>
            {% endif %}
            {% endif %}

            {# The one part the diff view replaces — see diff_document_versions.html.twig.
               Everything else on this page reads the same in both modes, which is
               why the diff overrides this block instead of being a page of its own. #}
            {% block documentPane %}
            <div class="prose lp-prose lp-review-doc__prose" data-rail-align data-comment-anchor-target="doc" tabindex="-1">{{ documentPaneHtml|raw }}</div>
            {% endblock %}

            {# Outside the prose on purpose: that textContent must stay identical
               to DocumentVersion::plainText(). Gated on diffMode too — the radios
               it serves live in the block the diff replaces, and `decisions` and
               `selectDecisionForm` are not passed there, so the guard is what
               prevents an undefined-variable 500. #}
            {% if not diffMode and decisionRows|length > 0 and not readOnly %}
            {{ form_start(selectDecisionForm, {attr: {
                'data-decision-target': 'form',
                'data-action': 'turbo:submit-end->decision#saved',
                hidden: true,
            }}) }}
                {{ form_widget(selectDecisionForm.decisionId, {attr: {'data-decision-target': 'decisionId'}}) }}
                {{ form_widget(selectDecisionForm.optionIndexes, {attr: {'data-decision-target': 'options', 'data-field-name': selectDecisionForm.optionIndexes.vars.full_name}}) }}
                {{ form_widget(selectDecisionForm.expectedOptionIndexes, {attr: {'data-decision-target': 'expectedOptions', 'data-field-name': selectDecisionForm.expectedOptionIndexes.vars.full_name}}) }}
            {{ form_end(selectDecisionForm) }}
            {% endif %}

            {# The agent's marks: empty anchor carriers, outside the doc element
               whose textContent must stay identical to plainText(). The controller
               re-locates each quote and tints it via the Custom Highlight API.
               Omitted in diff mode, where the pane's text is Markdown source. #}
            {% if not diffMode %}
            {% for highlight in version.highlights %}
            <span
                data-comment-anchor-target="agentHighlight"
                data-anchor-quote="{{ highlight.anchor.quote }}"
                data-anchor-prefix="{{ highlight.anchor.prefix }}"
                data-anchor-suffix="{{ highlight.anchor.suffix }}"
                hidden
            ></span>
            {% endfor %}
            {% endif %}

            {# The composer and its toolbar post onto the CURRENT version, so on an
               earlier one they are omitted entirely rather than shown and ignored.
               A diff whose newer side IS the current version keeps them. #}
            {% if canComment %}
            {# Floating toolbar — appears on text selection so selecting text no
               longer steals focus or blocks copying. Comment and Suggest open a
               composer; Strike posts on the spot, which is why it also carries the
               only keyboard shortcut on this pane. #}
            <div class="lp-anchor-toolbar" data-comment-anchor-target="toolbar" hidden>
                <button type="button" class="lp-anchor-toolbar__btn" data-action="comment-anchor#startComment">
                    <twig:ux:icon name="lucide:message-square-plus" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.comment.add'|trans }}
                </button>
                <button type="button" class="lp-anchor-toolbar__btn" data-action="comment-anchor#startSuggestion">
                    <twig:ux:icon name="lucide:replace" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.suggestion.add'|trans }}
                </button>
                <button type="button" class="lp-anchor-toolbar__btn" data-action="comment-anchor#strike">
                    <twig:ux:icon name="lucide:strikethrough" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.strike.add'|trans }}
                    <kbd class="lp-anchor-toolbar__key">{{ 'review.document.strike.shortcut'|trans }}</kbd>
                </button>
                <button type="button" class="lp-anchor-toolbar__btn" data-action="comment-anchor#dismissSelection"
                        aria-label="{{ 'review.document.selection.dismiss'|trans }}" title="{{ 'review.document.selection.dismiss'|trans }}">
                    <twig:ux:icon name="lucide:x" class="w-3.5 h-3.5 shrink-0" />
                </button>
            </div>

            {# Standing error region: a strike posts with no composer open, so a
               rejected one has nowhere else to report itself. #}
            <p
                id="review-action-error"
                class="lp-review-action-error"
                role="status"
                data-comment-anchor-target="actionError"
            ></p>

            {# Never shown: the controller fills the anchor fields from the
               selection and submits it, and it stays a Symfony form so CSRF and
               validation work as elsewhere. No display class — one in a layered
               component class outranks the UA [hidden] rule and would un-hide it. #}
            {{ form_start(strikePassageForm, {attr: {
                'data-comment-anchor-target': 'strikeForm',
                'data-action': 'turbo:submit-end->comment-anchor#onSubmitEnd',
                hidden: true,
            }}) }}
                {{ form_widget(strikePassageForm.quote) }}
                {{ form_widget(strikePassageForm.versionNumber, {type: 'hidden'}) }}
                {{ form_widget(strikePassageForm.prefix) }}
                {{ form_widget(strikePassageForm.suffix) }}
            {{ form_end(strikePassageForm) }}

            {# Floating rewording composer — the same card as the comment composer,
               but leading with what the passage should become. The struck original
               sits above it so the before/after reads at a glance. #}
            {{ form_start(suggestRewordingForm, {attr: {
                class: 'lp-comment-composer',
                'data-comment-anchor-target': 'suggestComposer',
                'data-controller': 'keyboard-submit',
                'data-action': 'turbo:submit-end->comment-anchor#onSubmitEnd keydown->keyboard-submit#submit',
                hidden: true,
            }}) }}
                {{ form_widget(suggestRewordingForm.quote) }}
                {{ form_widget(suggestRewordingForm.versionNumber, {type: 'hidden'}) }}
                {{ form_widget(suggestRewordingForm.prefix) }}
                {{ form_widget(suggestRewordingForm.suffix) }}
                <blockquote class="lp-composer-quote lp-composer-quote--struck" data-comment-anchor-target="suggestQuotePreview"></blockquote>
                {{ form_widget(suggestRewordingForm.replacement) }}
                {{ form_widget(suggestRewordingForm.body) }}
                <div class="lp-comment-composer__actions">
                    <span class="lp-composer-hint">{{ 'review.document.comment.hint'|trans }}</span>
                    <span
                        id="suggest-composer-error"
                        class="lp-comment-composer__error"
                        data-comment-anchor-target="suggestComposerError"
                    ></span>
                    <button
                        type="button"
                        class="lp-btn lp-btn--ghost lp-btn--sm"
                        data-action="comment-anchor#hideComposer"
                    >{{ 'review.document.comment.cancel'|trans }}</button>
                    <button
                        type="submit"
                        class="lp-btn lp-btn--primary lp-btn--sm"
                        data-action="comment-anchor#submitSuggestion"
                    >{{ 'review.document.suggestion.submit'|trans }}</button>
                </div>
            {{ form_end(suggestRewordingForm) }}
            {% endif %}
        </div>

        {# A sibling of the document pane, so the resolved toggle it carries is
           still inside the comment-anchor controller that drives it. #}
        {% set showVerdict = not readOnly and not diffMode and document.status.value in ['draft', 'in-review'] %}
        {% set showResolvedToggle = not diffMode or diffCommenting %}
        {% if showContents or showVersions or referenceCount > 0 or decisionRows|length > 0 or showResolvedToggle or showVerdict %}
        {% include '@Review/_review_menu.html.twig' with {
            document: document,
            version: version,
            versions: versions,
            showVersions: showVersions,
            showContents: showContents,
            sectionRows: sectionRows,
            sectionsApprovable: sectionsApprovable,
            approvedSections: approvedSections,
            referenceCount: referenceCount,
            decisionRows: decisionRows,
            answeredDecisions: answeredDecisions,
            showResolvedToggle: showResolvedToggle,
            showVerdict: showVerdict,
            diffMode: diffMode,
            diffFromVersion: diffFromVersion,
            diffViewValue: diffView is null ? null : diffView.value,
        } only %}
        {% endif %}
    </div>

    {% if undoVerdictForm is defined %}
        <div class="lp-field-errors" data-review-withdrawal-errors>{{ form_errors(undoVerdictForm) }}{{ form_errors(undoVerdictForm.reviewId) }}</div>
    {% endif %}
    {% if not readOnly and not diffMode and document.status.value in ['approved', 'changes-requested'] %}
    {% set verdict = document.status.value %}
    <div class="lp-verdict-bar lp-verdict-bar--{{ verdict }}">
        <span class="lp-verdict-bar__dot"></span>
        <span class="lp-verdict-bar__text">
            <span class="lp-verdict-bar__title">{{ ('review.document.verdict.' ~ verdict)|trans }}</span>
            <span class="lp-verdict-bar__detail">{{ ('review.document.verdict.' ~ verdict ~ '_detail')|trans }}</span>
            {% if review %}
            <span class="lp-verdict-bar__detail">{{ review.reviewer.fullName }} · {{ review.submittedAt|relative_time }} · {{ 'v' ~ review.version.versionNumber }}</span>
            {% if review.note %}<span class="lp-review-verdict-note">{{ review.note }}</span>{% endif %}
            {% endif %}
        </span>
        {% if review is not null %}
        {{ form_start(undoVerdictForm, {attr: {class: 'lp-verdict-bar__undo'}}) }}
            {{ form_widget(undoVerdictForm.reviewId) }}
            <button type="submit" class="lp-btn lp-btn--ghost lp-btn--sm">{{ 'review.document.verdict.undo'|trans }}</button>
        {{ form_end(undoVerdictForm) }}
        {% endif %}
    </div>
    {% endif %}

    {% if not finishReviewAvailable and not diffMode and not readOnly %}
    {% include '@Review/_review_draft_recovery.html.twig' with {document: document} only %}
    {% endif %}
    {% if finishReviewAvailable %}
    {% include '@Review/_finish_review.html.twig' with {
        document: document,
        submitReviewForm: submitReviewForm,
        sections: sections,
        signals: signals,
    } only %}
    {% endif %}

    <dialog class="lp-card-drawer-overlay"
            aria-label="{{ 'board.card.drawer.label'|trans }}"
            data-card-drawer-target="dialog"
            data-action="cancel->card-drawer#cancel click->card-drawer#backdropClick">
        <div class="lp-card-drawer-overlay__loading" data-card-drawer-target="loading" role="status">
            <twig:ux:icon name="lucide:loader-circle" class="w-5 h-5" />
            {{ 'board.card.drawer.loading'|trans }}
        </div>
        <turbo-frame id="card-drawer-frame"
                     data-card-drawer-target="frame"
                     data-action="turbo:frame-load->card-drawer#loaded"></turbo-frame>
    </dialog>
</div>
{% endblock %}
