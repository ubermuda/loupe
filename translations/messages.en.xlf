            <trans-unit id="account.api_token.action.revoke">
                <source>account.api_token.action.revoke</source>
                <target>Revoke</target>
            </trans-unit>

            <!-- Document dashboard -->
            <trans-unit id="review.dashboard.page.title">
                <source>review.dashboard.page.title</source>
                <target>My Documents</target>
            </trans-unit>
            <trans-unit id="review.dashboard.empty">
