{#
  Still of what an agent sees. Sample data, decorative — hence aria-hidden.
  Props:
    tools — list of MCP tool names, in the order they should read.
#}
<div class="lp-tech-still" aria-hidden="true">
    <div class="lp-tech-tools">
        {% for tool in tools %}
        <span class="lp-tech-tools__name{{ loop.index <= 3 ? ' lp-tech-tools__name--lit' : '' }}">{{ tool }}</span>
        {% endfor %}
    </div>

    <div class="lp-tech-call">
        <p class="lp-tech-call__line">
            <span class="lp-tech-call__arrow">{{ 'landing.tech.still.call_arrow'|trans }}</span>
            <code>{{ 'landing.tech.tools.tool_review'|trans }}</code>
        </p>
        <p class="lp-tech-call__result">
            <span class="lp-tech-call__verdict">{{ 'landing.tech.still.verdict'|trans }}</span>
            {{ 'landing.tech.still.threads'|trans }}
        </p>
    </div>
</div>
