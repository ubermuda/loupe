{#
    System-status check list, shared by the install wizard and the admin area.

    Props:  @comment-budget-ignore
      - checks: list of Ubermuda\HealthCheckBundle\Diagnostic

    A check's label and detail resolve in its own domain, so an application
    check keeps its keys in `messages`; a state carries its own key and domain,
    which are the bundle's whoever contributed the row.

    The icon per state is written out branch by branch rather than looked up
    from a map because `bin/console ux:icons:lock` only imports icon names it
    can read as literals; a computed name ships as a blank space in production.
#}
<ul class="status-check-list">
    {% for check in checks %}
        <li class="status-check" data-system-check="{{ check.key }}" data-system-check-state="{{ check.state.value }}">
            <span class="status-check-badge status-check-badge-{{ check.state.value }}">
                {% if check.state.value == 'ok' %}
                    <twig:UX:Icon name="lucide:circle-check" class="w-3.5 h-3.5 shrink-0" />
                {% elseif check.state.value == 'warning' %}
                    <twig:UX:Icon name="lucide:triangle-alert" class="w-3.5 h-3.5 shrink-0" />
                {% elseif check.state.value == 'failed' %}
                    <twig:UX:Icon name="lucide:circle-x" class="w-3.5 h-3.5 shrink-0" />
                {% else %}
                    <twig:UX:Icon name="lucide:circle-help" class="w-3.5 h-3.5 shrink-0" />
                {% endif %}
                {{ check.state.translationKey|trans({}, check.state.translationDomain) }}
            </span>
            <span class="status-check-text">
                <span class="status-check-label">{{ ('check.' ~ check.key ~ '.label')|trans({}, check.domain) }}</span>
                <span class="status-check-detail">{{ check.detail|trans(check.detailParameters, check.domain) }}</span>
            </span>
        </li>
    {% endfor %}
</ul>
