{% extends 'base.html.twig' %}

{% block title %}{{ 'review.document.history.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: document.project.id}) }}">{{ 'nav.link.documents'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <a class="lp-topbar__crumb" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">{{ document.title }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'review.document.history.page.title'|trans }}</span>
{% endblock %}

{% block topbar_meta %}
    <span class="lp-topbar__meta">{{ 'review.document.history.count'|trans({'%count%': versions|length}) }}</span>
{% endblock %}

{% block body %}
{% set routeParameters = {projectId: document.project.id, documentId: document.id} %}
{% set latestVersion = versions|first.versionNumber %}
{% set earliestVersion = versions|last.versionNumber %}
{% set finishReviewAvailable = document.status.value in ['draft', 'in-review'] %}
<div class="lp-review" data-site-review-quotes="off"{% if finishReviewAvailable %} data-controller="modal"{% endif %}>
<div class="lp-review-block">
    {% include '@Review/_document_header.html.twig' with {
        document: document,
        version: version,
        versionCount: versions|length,
        activeView: 'history',
        showDocumentActions: true,
        reviseDocumentForm: reviseDocumentForm,
        approvedSections: sections.approvedCount,
        totalSections: sections.rows|length,
        showMarginControls: false,
        commentCount: null,
        canComment: false,
        marginTabs: [],
        returnToDocument: false,
    } only %}
    <div class="lp-history-tools">
        <h2 class="lp-history-title">{{ 'review.document.history.page.title'|trans }}</h2>

        {# A plain GET form, so the picker works with no JavaScript. The diff route
           carries its two versions as path segments, which a GET form cannot build,
           so the action is the redirect route that turns the pair into that path. #}
        {% if versions|length > 1 %}
        <section class="lp-history-compare">
            <form class="lp-version-compare" method="GET" action="{{ path('app_document_review_compare', routeParameters) }}">
                <label class="lp-version-compare__label" for="history-compare-from">{{ 'review.document.diff.picker.from'|trans }}</label>
                <select id="history-compare-from" name="from" class="lp-input lp-select lp-filter-select" aria-label="{{ 'review.document.diff.picker.from_label'|trans }}">
                    {% for meta in versions %}
                    <option value="{{ meta.versionNumber }}"{{ meta.versionNumber == latestVersion - 1 ? ' selected' : '' }}>{{ 'v' ~ meta.versionNumber }}</option>
                    {% endfor %}
                </select>
                <twig:ux:icon name="lucide:arrow-right" class="lp-version-compare__arrow" aria-hidden="true" />
                <label class="lp-version-compare__label" for="history-compare-to">{{ 'review.document.diff.picker.to'|trans }}</label>
                <select id="history-compare-to" name="to" class="lp-input lp-select lp-filter-select" aria-label="{{ 'review.document.diff.picker.to_label'|trans }}">
                    {% for meta in versions %}
                    <option value="{{ meta.versionNumber }}"{{ meta.versionNumber == latestVersion ? ' selected' : '' }}>{{ 'v' ~ meta.versionNumber }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="lp-btn">{{ 'review.document.diff.picker.submit'|trans }}</button>
            </form>
        </section>
        {% endif %}
    </div>

    <div class="lp-history-surface">
    <table class="lp-history">
        <thead>
            <tr>
                <th scope="col">{{ 'review.document.history.column.version'|trans }}</th>
                <th scope="col">{{ 'review.document.history.column.revision'|trans }}</th>
                <th scope="col">{{ 'review.document.history.reviews'|trans }}</th>
                <th scope="col">{{ 'review.document.history.column.open'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for meta in versions %}
        {% set isLatest = meta.versionNumber == latestVersion %}
        {% set readPath = isLatest
            ? path('app_document_review', routeParameters)
            : path('app_document_review_version', routeParameters|merge({versionNumber: meta.versionNumber})) %}
        <tr class="lp-history__row{{ isLatest ? ' lp-history__row--current' : '' }}"
            data-version-number="{{ meta.versionNumber }}">
            <td><span class="lp-history__version">{{ 'v' ~ meta.versionNumber }}</span></td>
            <td>
                {% if meta.description %}
                <strong class="lp-history__note">{{ meta.description }}</strong>
                {% else %}
                <strong class="lp-history__note lp-history__note--empty">{{ (isLatest ? 'review.document.history.current' : 'review.document.history.no_note')|trans }}</strong>
                {% endif %}
                <span class="lp-history__date">{{ meta.createdAt|relative_time }}</span>
            </td>
            <td>
                <ol class="lp-history__reviews" aria-label="{{ 'review.document.history.reviews'|trans }}">
                    {% for review in meta.reviews %}
                    <li class="lp-history__review" data-review-sequence="{{ review.sequence }}">
                        <span class="lp-history__verdict lp-history__verdict--{{ review.verdict.value }}">{{ ('review.document.verdict.' ~ review.verdict.value)|trans }}</span>
                        <span>{{ review.reviewer.fullName }}</span>
                        <time class="lp-history__date" datetime="{{ review.submittedAt|date('c') }}" title="{{ review.submittedAt|date('Y-m-d H:i:s T') }}">{{ review.submittedAt|relative_time }}</time>
                        {% if review.note %}<p class="lp-history__review-note">{{ review.note }}</p>{% endif %}
                    </li>
                    {% else %}
                    <li class="lp-history__date">{{ 'review.document.history.no_reviews'|trans }}</li>
                    {% endfor %}
                </ol>
            </td>
            <td>
                <div class="lp-history__actions">
                    <a class="lp-history__action" href="{{ readPath }}">
                        <twig:ux:icon name="lucide:file-text" />
                        {{ 'review.document.history.read'|trans }}
                    </a>
                    {# The oldest version has no predecessor, so it carries no control. #}
                    {% if meta.versionNumber > earliestVersion %}
                    <a class="lp-history__action lp-history__compare"
                       href="{{ path('app_document_review_diff', routeParameters|merge({fromVersionNumber: meta.versionNumber - 1, toVersionNumber: meta.versionNumber})) }}"
                       aria-label="{{ 'review.document.history.compare_with'|trans({'%from%': meta.versionNumber - 1}) }}">
                        <twig:ux:icon name="lucide:git-compare" />
                        {{ 'review.document.history.diff'|trans }}
                    </a>
                    {% endif %}
                </div>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% if finishReviewAvailable %}
{% include '@Review/_finish_review.html.twig' with {
    document: document,
    submitReviewForm: submitReviewForm,
    sections: sections,
    signals: signals,
} only %}
{% endif %}
</div>
{% endblock %}
