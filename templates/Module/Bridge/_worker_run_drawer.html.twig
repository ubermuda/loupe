{% set run = item.run %}
{% embed '_drawer.html.twig' with {
    run: run,
    item: item,
    project: project,
    boardEnabled: boardEnabled,
    class: 'lp-run-drawer',
    attributes: {
        'aria-labelledby': 'run-title-' ~ run.id,
        'data-modal-target': 'dialog',
        'data-action': 'cancel->modal#close',
        'data-controller': 'worker-run-output',
        'data-worker-run-output-copied-value': 'bridge.worker_runs.details.copied'|trans,
        'data-worker-run-output-failed-value': 'bridge.worker_runs.details.copy_failed'|trans,
    },
} only %}
{% block content %}
    <header class="lp-run-drawer__header">
        <div>
            <h2 class="lp-dialog-title" id="run-title-{{ run.id }}">{{ 'bridge.worker_runs.details.title'|trans }}</h2>
            <p class="lp-run-drawer__identifier">{{ run.id }}</p>
            <span class="lp-status-chip lp-status-chip--{{ item.state.chipModifier() }}">{{ item.state.translationKey()|trans }}</span>
            {% if item.interactive %}<span class="lp-tag lp-tag--neutral">{{ 'bridge.worker_runs.interactive'|trans }}</span>{% endif %}
        </div>
        <button type="button" class="lp-btn" data-action="modal#close" autofocus>{{ 'bridge.worker_runs.details.close'|trans }}</button>
    </header>
    <div class="lp-run-drawer__body">
        <dl class="lp-run-drawer__metadata">
            <div><dt>{{ 'bridge.worker_runs.details.card'|trans }}</dt><dd>
                {% if boardEnabled %}<a href="{{ path('app_board_card', {projectId: project.id, cardId: run.cardId}) }}">{{ 'bridge.worker_runs.card_number'|trans({'%number%': run.cardNumber}) }}</a>{% else %}{{ 'bridge.worker_runs.card_number'|trans({'%number%': run.cardNumber}) }}{% endif %}
                <span class="lp-run-drawer__identifier">{{ run.cardId }}</span>
            </dd></div>
            <div><dt>{{ 'bridge.worker_runs.column.rule'|trans }}</dt><dd>{{ run.ruleName }}</dd></div>
            {% if run.bridgeId is not null %}<div><dt>{{ 'bridge.worker_runs.filter.bridge_label'|trans }}</dt><dd>{{ run.bridgeId }}</dd></div>{% endif %}
            {% if run.sessionId is not null %}<div><dt>{{ 'bridge.worker_runs.details.session'|trans }}</dt><dd>{{ run.sessionId }}</dd></div>{% endif %}
            <div><dt>{{ 'bridge.worker_runs.column.duration'|trans }}</dt><dd>{% if item.interactive and item.state.isOpen() and item.duration() is not null %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}{% if run.exitCode is not null %} · {{ 'bridge.worker_runs.exit_code'|trans({'%code%': run.exitCode}) }}{% endif %}</dd></div>
            {% if item.isResume %}<div><dt>{{ 'bridge.worker_runs.details.series'|trans }}</dt><dd>{{ 'bridge.worker_runs.resume'|trans({'%index%': run.resumeIndex, '%cap%': run.resumeCap}) }}</dd></div>{% endif %}
            {% if run.continuesRun is not null %}<div><dt>{{ 'bridge.worker_runs.details.continues'|trans }}</dt><dd><a href="{{ path('app_project_worker_runs', {id: project.id, search: run.continuesRun.id}) }}" data-worker-run-continues>{{ run.continuesRun.id }}</a></dd></div>{% endif %}
            {% if run.resultStatus is not null %}<div data-worker-run-result-status><dt>{{ 'bridge.worker_runs.details.result_status'|trans }}</dt><dd>{{ ('bridge.worker_runs.result_status.' ~ run.resultStatus)|trans }}</dd></div>{% endif %}
            {% if run.resumeSkipped is not null %}<div data-worker-run-resume-skipped><dt>{{ 'bridge.worker_runs.details.resume_skipped'|trans }}</dt><dd><code>{{ run.resumeSkipped }}</code></dd></div>{% endif %}
        </dl>
        {% if item.resultFields is not empty %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.result_fields'|trans }}</h3>
        {# The worker writes these, so they are rendered as text. Never add |raw here. #}
        <dl class="lp-run-drawer__metadata" data-worker-run-result-fields>
            {% for name, value in item.resultFields %}<div><dt>{{ name }}</dt><dd>{{ value }}</dd></div>{% endfor %}
        </dl>
        {% endif %}
        {% if not item.interactive %}<p class="lp-dialog-desc">{{ 'bridge.worker_runs.details.unreported'|trans }}</p>{% endif %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.timeline'|trans }}</h3>
        <ol class="lp-run-drawer__timeline">
            {% for change in item.history %}
            <li>{{ change.state.translationKey()|trans }} <time datetime="{{ change.at|date('c') }}">{{ change.at|date('Y-m-d H:i:s T') }}</time></li>
            {% else %}
            {# A run the previous image wrote during a deploy has no history rows. #}
            {% if run.startedAt %}<li>{{ 'bridge.worker_runs.state.running'|trans }} <time datetime="{{ run.startedAt|date('c') }}">{{ run.startedAt|date('Y-m-d H:i:s T') }}</time></li>{% endif %}
            {% if run.endedAt %}<li>{{ run.state.translationKey()|trans }} <time datetime="{{ run.endedAt|date('c') }}">{{ run.endedAt|date('Y-m-d H:i:s T') }}</time></li>{% endif %}
            {% endfor %}
            <li>{{ 'bridge.worker_runs.details.received'|trans }} <time datetime="{{ run.receivedAt|date('c') }}">{{ run.receivedAt|date('Y-m-d H:i:s T') }}</time></li>
        </ol>
        {% if run.failureReason %}<p class="lp-worker-run__failure">{{ run.failureReason }}</p>{% endif %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.output.toggle'|trans }}</h3>
        {% if run.output is empty %}<p>{{ 'bridge.worker_runs.output.empty'|trans }}</p>{% endif %}
        <pre class="lp-worker-run__output" data-worker-run-output-target="output">{{ run.output }}</pre>
    </div>
    <footer class="lp-run-drawer__footer">
        <p role="status" data-worker-run-output-target="status"></p>
        <button type="button" class="lp-btn" data-action="worker-run-output#copy">{{ 'bridge.worker_runs.details.copy'|trans }}</button>
    </footer>
{% endblock %}
{% endembed %}
