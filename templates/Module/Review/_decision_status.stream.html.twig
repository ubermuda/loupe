{# `data-decision-page` names the page that sent the save; decision_controller.js
   drops the stream on any other page. #}
{# `update`, not `replace`: the status is an aria-live region and the running
   total sits in a tab whose open state the reviewer owns. Swapping either
   element out re-announces unpredictably and would close an open panel. #}
<turbo-stream data-decision-page="{{ page }}" action="update" target="decision-status">
    <template><twig:Ds:Flash severity="{{ failed ? 'error' : 'success' }}" role="none">{{ message }}</twig:Ds:Flash></template>
</turbo-stream>
{% include '@Review/_decision_summary.stream.html.twig' with {page: page, rows: rows, answeredCount: answeredCount} only %}
