{# The board skeleton with no cards, read by the board-structure stream action: the columns or lanes, and one column tag per column for the list rows. Props: board (BoardView). #}
<turbo-stream action="board-structure" target="board" data-structure-digest="{{ board.structureDigest }}">
    <template>
        {% if board.lanes is empty %}
            {% include '@Board/_board_plain_columns.html.twig' with {board: board, runWarnings: {}, withCards: false} only %}
        {% else %}
            {% include '@Board/_board_lanes.html.twig' with {board: board, runWarnings: {}, withCards: false} only %}
        {% endif %}
        <div data-board-structure-tags hidden>
            {% for view in board.columns %}
                <span data-column-tag="{{ view.column.id }}">{% include '@Board/_column_tag.html.twig' with {column: view.column} only %}</span>
            {% endfor %}
        </div>
    </template>
</turbo-stream>
