<section class="lp-inbox-linked lp-inbox-linked--{{ inbox.page.value }}" id="inbox-items" data-inbox-linked="{{ inbox.page.value }}">
    <div class="lp-inbox-linked__head">
        <h2 class="lp-inbox-linked__title">{{ 'inbox.linked.title'|trans }}</h2>
        <a class="lp-inbox-linked__all" href="{{ path('app_project_inbox', {id: inbox.project.id}) }}">{{ 'inbox.linked.all'|trans }}</a>
    </div>

    {% if inbox.openItems|length > 0 %}
    <div class="lp-inbox-linked__items" data-inbox-linked-open>
        {% for item in inbox.openItems %}
            {% include '@Inbox/_linked_inbox_entry.html.twig' with {item: item, inbox: inbox, refusedForm: refusedForm} only %}
        {% endfor %}
    </div>
    {% endif %}

    {% if inbox.closedItems|length > 0 %}
    <div class="lp-inbox-linked__items" data-inbox-linked-closed>
        <h3 class="lp-inbox-linked__subtitle">{{ 'inbox.linked.closed'|trans({'%count%': inbox.closedTotal}) }}</h3>
        {% for item in inbox.closedItems %}
            {% include '@Inbox/_linked_inbox_entry.html.twig' with {item: item, inbox: inbox, refusedForm: refusedForm} only %}
        {% endfor %}
        {% if inbox.hasMoreClosedItems %}
        {# The completed queue of the inbox page, which is where a closed item lives. #}
        <a class="lp-inbox-linked__all" href="{{ path('app_project_inbox', {id: inbox.project.id, queue: 'completed'}) }}" data-inbox-linked-more>{{ 'inbox.linked.closed_more'|trans({'%count%': inbox.closedTotal}) }}</a>
        {% endif %}
    </div>
    {% endif %}
</section>
