{% extends 'base.html.twig' %}

{% block title %}{{ 'review.dashboard.page.title'|trans }}{% endblock %}

{% block body %}
<div class="bp-page">
    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ 'review.dashboard.page.title'|trans }}</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if documents|length > 0 %}
    <div class="bp-doc-list">
        {% for document in documents %}
        <div class="bp-doc-row" data-document-id="{{ document.id }}">
            <div class="bp-doc-row__main">
                <a href="{{ path('app_document_review', {projectId: project.id, documentId: document.id}) }}" class="bp-doc-row__title bp-doc-row__title--stretched">{{ document.title }}</a>
                <div class="bp-doc-row__meta">
                    <span>{{ document.createdAt|date('M j, Y') }}</span>
                    {# tag chips slot — populated when tags ship; intentionally empty for now #}
                    <span class="bp-doc-row__tags"></span>
                </div>
            </div>
            <span class="bp-badge bp-badge--{{ document.status.value }}">
                {{ document.status.translationKey()|trans }}
            </span>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="bp-card flex flex-col items-center text-center gap-3 py-12">
        <twig:ux:icon name="lucide:file-text" class="w-8 h-8 text-fg-dim" />
        <p class="bp-empty not-italic">{{ 'review.dashboard.empty'|trans }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
