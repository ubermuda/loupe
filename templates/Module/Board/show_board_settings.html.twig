{% extends 'base.html.twig' %}

{% block title %}{{ 'board.settings.heading'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ board.project.name }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.project_settings'|trans }}</span>
{% endblock %}

{% block body %}
{% set canManage = is_granted(constant('App\\Module\\Board\\Security\\BoardColumnVoter::MANAGE'), board.project) %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'project.edit.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.edit.page.description'|trans }}</p>
        </div>
    </header>
    <div class="lp-settings-layout lp-settings-layout--columns">
        {% include '@Project/_settings_nav.html.twig' with {project: board.project, active: 'columns'} only %}
        <section class="lp-settings-content lp-settings-panel-card" data-board-column-settings>
            <h2 class="lp-section-title">{{ 'board.settings.heading'|trans }}</h2>
            <p class="lp-connect-hint">{{ 'board.settings.description'|trans }}</p>
            {% set defaultId = (board.columns|filter(other => other.column.isDefault)|first).column.id ~ '' %}
            {% set terminalCount = board.columns|filter(other => other.column.terminal)|length %}
            <ol class="lp-settings-columns">
            {% for view in board.columns %}
                {% set column = view.column %}
                {% set label = column.label|trans %}
                {% set index = loop.index0 %}
                <li class="lp-settings-column" data-column-id="{{ column.id }}">
                    <div class="lp-settings-column__name">
                        <h3>{{ label }}</h3>
                        <code>{{ column.slug }}</code>
                    </div>
                    {% if column.isDefault %}<span class="lp-board__column-flag">{{ 'board.column.flag.default'|trans }}</span>{% endif %}
                    {% if column.terminal %}<span class="lp-board__column-flag">{{ 'board.column.flag.terminal'|trans }}</span>{% endif %}
                    {% if canManage %}
                        {% for move in [{offset: -1, key: 'board.column.move.up'}, {offset: 1, key: 'board.column.move.down'}] %}
                            {% if board.columns[index + move.offset] is defined %}
                                {% set moveForm = board_columns_reorder_form(board_column_order(board.columns, index, move.offset), board_column_order(board.columns, 0, 0)) %}
                                {% set moveId = 'settings-move-' ~ column.id ~ '-' ~ loop.index %}
                                <form method="post" action="{{ path('app_board_columns_reorder', {id: board.project.id, view: 'settings'}) }}">
                                    {{ form_widget(moveForm._token, {id: moveId ~ '-token'}) }}
                                    {{ form_widget(moveForm.expectedOrder, {id: moveId ~ '-expected-order'}) }}
                                    {{ form_widget(moveForm.order, {id: moveId ~ '-order'}) }}
                                    <button class="lp-btn lp-btn--ghost lp-btn--icon" type="submit" aria-label="{{ move.key|trans }}">
                                        {% if move.offset < 0 %}<twig:ux:icon name="lucide:arrow-up" />{% else %}<twig:ux:icon name="lucide:arrow-down" />{% endif %}
                                    </button>
                                </form>
                            {% else %}
                                <span class="lp-settings-column__slot" aria-hidden="true"></span>
                            {% endif %}
                        {% endfor %}
                        {% set configureForm = board_column_configure_form(column, defaultId, configureColumnForm) %}
                        <div data-controller="modal"{% if configureForm.vars.submitted %} data-modal-reopen-value="true"{% endif %}>
                            <button class="lp-btn lp-btn--ghost lp-btn--icon" type="button" aria-label="{{ 'board.column.configure.action'|trans({'%label%': label}) }}" data-action="click->modal#open">
                                <twig:ux:icon name="lucide:settings" />
                            </button>
                            <dialog class="lp-dialog" data-modal-target="dialog" aria-labelledby="configure-column-title-{{ column.id }}">
                                <h3 class="lp-dialog-title" id="configure-column-title-{{ column.id }}">{{ 'board.column.configure.title'|trans({'%label%': label}) }}</h3>
                                <p class="lp-dialog-desc">{{ 'board.column.rename.description'|trans }}</p>
                                {% if column.slug in board.watchedColumnSlugs %}
                                <p class="lp-board__rule-warning">{{ 'board.column.rename.bridge_rule_warning'|trans }}</p>
                                {% endif %}
                                {{ form_start(configureForm, {action: path('app_board_column_configure', {projectId: board.project.id, columnId: column.id}), attr: {
                                    class: 'lp-form',
                                    'data-controller': 'board-column-slug',
                                    'data-board-column-slug-url-value': path('app_board_column_rename_preview', {projectId: board.project.id, columnId: column.id}),
                                }}) }}
                                    <div class="lp-form-field">
                                        {{ form_label(configureForm.label, null, {label_attr: {class: 'lp-label'}}) }}
                                        {{ form_widget(configureForm.label, {attr: {
                                            class: 'lp-input',
                                            maxlength: constant('App\\Module\\Board\\Entity\\BoardColumn::MAX_LABEL_LENGTH'),
                                            'data-board-column-slug-target': 'input',
                                            'data-action': 'input->board-column-slug#change',
                                        }}) }}
                                        <div class="lp-field-errors" data-field-errors="label">{{ form_errors(configureForm.label) }}</div>
                                    </div>
                                    {% include '@Board/_board_column_slug.html.twig' with {column: column, slug: column.slug, refusal: null} only %}
                                    {% for field in [configureForm.isDefault, configureForm.terminal] %}
                                    <div class="lp-form-field">
                                        <label class="lp-choice">
                                            {{ form_widget(field) }}
                                            {{ field.vars.label|trans }}
                                        </label>
                                        <div class="lp-field-errors" data-field-errors="{{ field.vars.name }}">{{ form_errors(field) }}</div>
                                    </div>
                                    {% endfor %}
                                    <div class="lp-settings-form-actions">
                                        <button class="lp-btn" type="button" data-action="click->modal#close">{{ 'board.column.rename.cancel'|trans }}</button>
                                        <button class="lp-btn lp-btn--primary" type="submit">{{ 'board.column.configure.submit'|trans }}</button>
                                    </div>
                                {{ form_end(configureForm) }}
                            </dialog>
                        </div>
                        {% if not column.isDefault and not (column.terminal and terminalCount == 1) %}
                        <div data-controller="modal">
                            <button class="lp-btn lp-btn--ghost lp-btn--icon" type="button" aria-label="{{ 'board.column.delete.named'|trans({'%label%': label}) }}" data-action="click->modal#open">
                                <twig:ux:icon name="lucide:trash-2" />
                            </button>
                            {% include '@Board/_board_column_delete_dialog.html.twig' with {board: board, view: view, returnView: 'settings'} only %}
                        </div>
                        {% else %}
                        <span class="lp-settings-column__slot" aria-hidden="true"></span>
                        {% endif %}
                    {% endif %}
                </li>
            {% endfor %}
            </ol>
            {% if canManage %}
                {% set addForm = board_column_add_form(addColumnForm) %}
                <div data-controller="modal"{% if addForm.vars.submitted %} data-modal-reopen-value="true"{% endif %}>
                    <button class="lp-btn lp-btn--primary" type="button" data-action="click->modal#open">
                        <twig:ux:icon name="lucide:plus" />{{ 'board.column.add.title'|trans }}
                    </button>
                    <dialog class="lp-dialog" data-modal-target="dialog">
                        <h3 class="lp-dialog-title">{{ 'board.column.add.title'|trans }}</h3>
                        {{ form_start(addForm, {action: path('app_board_column_add', {id: board.project.id}), attr: {class: 'lp-form'}}) }}
                            <div class="lp-form-field">
                                {{ form_label(addForm.label, null, {label_attr: {class: 'lp-label'}}) }}
                                {{ form_widget(addForm.label, {attr: {class: 'lp-input'}}) }}
                                <div class="lp-field-errors">{{ form_errors(addForm.label) }}</div>
                            </div>
                            <div class="lp-settings-form-actions">
                                <button class="lp-btn" type="button" data-action="click->modal#close">{{ 'board.column.rename.cancel'|trans }}</button>
                                <button class="lp-btn lp-btn--primary" type="submit">{{ 'board.column.add.submit'|trans }}</button>
                            </div>
                        {{ form_end(addForm) }}
                    </dialog>
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
