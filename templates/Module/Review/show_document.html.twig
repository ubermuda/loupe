{% extends 'base.html.twig' %}

{% block title %}{{ 'review.document.page.title'|trans({'%title%': document.title}) }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="lp-review">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="lp-flash lp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if orphanedCount > 0 %}
    <div class="lp-orphan-banner">
        {{ 'review.document.orphan_banner'|trans({'%count%': orphanedCount}) }}
    </div>
    {% endif %}

    {% if diffMode %}
    <div class="lp-version-banner">
        <twig:ux:icon name="lucide:git-compare" class="w-4 h-4 shrink-0" />
        <span>{{ 'review.document.diff.banner'|trans({'%from%': diffFromVersion, '%to%': version.versionNumber}) }}</span>
        <a class="lp-btn lp-btn--ghost lp-btn--sm" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">
            {{ 'review.document.version.back_to_latest'|trans }}
        </a>
    </div>
    {% elseif readOnly %}
    <div class="lp-version-banner">
        <twig:ux:icon name="lucide:history" class="w-4 h-4 shrink-0" />
        <span>{{ 'review.document.version.read_only'|trans({'%version%': version.versionNumber}) }}</span>
        <a class="lp-btn lp-btn--ghost lp-btn--sm" href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">
            {{ 'review.document.version.back_to_latest'|trans }}
        </a>
    </div>
    {% endif %}

    <header class="lp-review-header">
        <nav class="lp-review-breadcrumb">
            <a href="{{ path('app_project_documents', {id: document.project.id}) }}">{{ document.project.name }}</a>
            <span class="lp-review-breadcrumb__sep">/</span>
            <a href="{{ path('app_project_documents', {id: document.project.id}) }}">{{ 'nav.link.documents'|trans }}</a>
            <span class="lp-review-breadcrumb__sep">/</span>
            <span class="lp-review-breadcrumb__current">{{ document.title }}</span>
        </nav>
    </header>

    {# In diff mode the comment-anchor controller is not attached at all rather
       than told to stay quiet: its highlight painting runs on every layout
       regardless of readOnly, and the pane it walks no longer holds
       DocumentVersion::plainText(). #}
    <div class="lp-review-layout"{% if not diffMode %} data-controller="comment-anchor"{% endif %}>
        {#
            The outer .lp-review-doc provides position:relative + the internal
            scroll for the floating composer/toolbar. The inner
            [data-comment-anchor-target="doc"] is the TreeWalker root — it must
            contain ONLY the rendered HTML with no surrounding template whitespace,
            so that its textContent === DocumentVersion::plainText() and JS
            text-node offsets agree with the PHP anchor basis.
        #}
        <div class="lp-review-doc"{% if not readOnly %} data-action="mouseup->comment-anchor#onDocMouseup"{% endif %}>
            <div class="lp-review-doc__head">
                <h1 class="lp-review-doc__title">
                    {{ document.title }}
                    <span class="lp-version-pill">{{ 'v' ~ version.versionNumber }}</span>
                </h1>
                <p class="lp-review-doc__byline">{{ 'review.document.byline'|trans({'%reviewer%': app.user.fullName}) }}</p>

                {# The way back to a discussion that a revision left behind: comments
                   resolved on an earlier version stay on that version, so without this
                   the whole thread is unreachable once the document is revised. The
                   newest version links to the canonical unnumbered URL.

                   A single version with a description still earns the list, because
                   the description appears nowhere else on the page. A single version
                   with none has nothing to show and nowhere to switch to, so the list
                   is omitted rather than rendered as a lone pill. #}
                {% set hasVersionDescription = versions|filter(meta => meta.description is not empty)|length > 0 %}
                {% if versions|length > 1 or hasVersionDescription %}
                <nav class="lp-version-switcher" aria-label="{{ 'review.document.version.switcher_label'|trans }}">
                    {% for meta in versions %}
                    <div class="lp-version-entry">
                        {# A diff is not one of the versions it compares, so in diff
                           mode every pill stays a link — reading the newer version
                           on its own is a click away, and the only element claiming
                           to be the current page is the diff link below. #}
                        {% if not diffMode and meta.versionNumber == version.versionNumber %}
                            <span class="lp-version-pill" aria-current="page">{{ 'v' ~ meta.versionNumber }}</span>
                        {% else %}
                            <a class="lp-version-pill lp-version-pill--link"
                               href="{{ loop.first
                                   ? path('app_document_review', {projectId: document.project.id, documentId: document.id})
                                   : path('app_document_review_version', {projectId: document.project.id, documentId: document.id, versionNumber: meta.versionNumber}) }}"
                            >{{ 'v' ~ meta.versionNumber }}</a>
                        {% endif %}
                        {% if meta.description %}
                        <p class="lp-version-entry__description">{{ meta.description }}</p>
                        {% endif %}
                        {% if meta.versionNumber > 1 %}
                        <a class="lp-version-entry__diff"
                           href="{{ path('app_document_review_diff', {projectId: document.project.id, documentId: document.id, fromVersionNumber: meta.versionNumber - 1, toVersionNumber: meta.versionNumber}) }}"
                           {% if diffMode and diffFromVersion == meta.versionNumber - 1 and version.versionNumber == meta.versionNumber %}aria-current="page"{% endif %}
                        >{{ 'review.document.diff.link'|trans({'%from%': meta.versionNumber - 1}) }}</a>
                        {% endif %}
                    </div>
                    {% endfor %}
                </nav>
                {% endif %}
            </div>

            {% if diffMode %}
                {# What the author said each revision changed, read next to what it
                   actually changed. Only the versions the diff spans are listed. #}
                {% set changeNotes = versions|filter(meta =>
                    meta.versionNumber > diffFromVersion
                    and meta.versionNumber <= version.versionNumber
                    and meta.description is not empty
                ) %}
                {% if changeNotes|length > 0 %}
                <aside class="lp-diff-notes">
                    <h2 class="lp-diff-notes__title">{{ 'review.document.diff.notes_title'|trans }}</h2>
                    {% for meta in changeNotes %}
                    <p class="lp-diff-notes__entry">
                        <span class="lp-version-pill">{{ 'v' ~ meta.versionNumber }}</span>
                        <span>{{ meta.description }}</span>
                    </p>
                    {% endfor %}
                </aside>
                {% endif %}

                {% if diffRefusal %}
                    {# Declining to compare, rather than showing a comparison that
                       describes neither version. Each version still reads normally,
                       and the switcher above links to every one of them. #}
                    <p class="lp-empty">{{ diffRefusal.translationKey|trans }}</p>
                {% elseif diff.hasChanges %}
                    {% include '@Review/_version_diff.html.twig' with {diff: diff} only %}
                {% else %}
                    <p class="lp-empty">{{ 'review.document.diff.identical'|trans }}</p>
                {% endif %}
            {% else %}
            <div class="prose max-w-2xl lp-prose lp-review-doc__prose" data-comment-anchor-target="doc">{{ version.renderedHtml|raw }}</div>
            {% endif %}

            {# The composer and its toolbar post onto the CURRENT version, so on an
               earlier one they are omitted entirely rather than shown and ignored. #}
            {% if not readOnly %}
            {# Floating toolbar — appears on text selection so selecting text no
               longer steals focus or blocks copying. Clicking it opens the
               composer and highlights the selection. #}
            <div class="lp-anchor-toolbar" data-comment-anchor-target="toolbar" hidden>
                <button type="button" class="lp-anchor-toolbar__btn" data-action="comment-anchor#startComment">
                    <twig:ux:icon name="lucide:message-square-plus" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.comment.add'|trans }}
                </button>
            </div>

            {# Floating composer — a Symfony form, hidden until the user opts in.
               The Stimulus controller positions it and fills the anchor fields;
               Turbo submits it and applies the returned stream. #}
            {{ form_start(addCommentForm, {attr: {
                class: 'lp-comment-composer',
                'data-comment-anchor-target': 'composer',
                'data-controller': 'keyboard-submit',
                'data-action': 'turbo:submit-end->comment-anchor#onSubmitEnd keydown->keyboard-submit#submit',
                hidden: true,
            }}) }}
                {{ form_widget(addCommentForm.quote) }}
                {{ form_widget(addCommentForm.prefix) }}
                {{ form_widget(addCommentForm.suffix) }}
                <blockquote class="lp-composer-quote" data-comment-anchor-target="quotePreview"></blockquote>
                <span class="lp-composer-general">{{ 'review.document.comment.general'|trans }}</span>
                {{ form_widget(addCommentForm.body) }}
                <div class="lp-comment-composer__actions">
                    <span class="lp-composer-hint">{{ 'review.document.comment.hint'|trans }}</span>
                    <span
                        id="composer-error"
                        class="lp-comment-composer__error"
                        data-comment-anchor-target="composerError"
                    ></span>
                    <button
                        type="button"
                        class="lp-btn lp-btn--ghost lp-btn--sm"
                        data-action="comment-anchor#hideComposer"
                    >{{ 'review.document.comment.cancel'|trans }}</button>
                    <button
                        type="submit"
                        class="lp-btn lp-btn--primary lp-btn--sm"
                    >{{ 'review.document.comment.submit'|trans }}</button>
                </div>
            {{ form_end(addCommentForm) }}
            {% endif %}
        </div>

        <div class="lp-review-sidebar">
            {% include '@Review/_comment_threads.html.twig' with {comments: comments, readOnly: readOnly} only %}

            {% if not readOnly %}
            <div class="lp-verdict-bar">
                {% if document.status.value == 'approved' %}
                    <div class="lp-verdict-approved">
                        <span class="lp-verdict-approved__icon"><twig:ux:icon name="lucide:circle-check" class="w-5 h-5" /></span>
                        <span class="lp-verdict-approved__text">
                            <span class="lp-verdict-approved__title">{{ 'review.document.verdict.approved'|trans }}</span>
                            <span class="lp-verdict-approved__detail">{{ 'review.document.verdict.approved_detail'|trans }}</span>
                        </span>
                    </div>
                {% else %}
                    <form method="POST" action="{{ path('app_document_review_submit', {projectId: document.project.id, documentId: document.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit-review') }}">
                        <div class="lp-verdict-bar__actions">
                            <button type="submit" name="submit_review_form[verdict]" value="approved" class="lp-btn lp-btn--primary">
                                <twig:ux:icon name="lucide:check" class="w-4 h-4 shrink-0" />
                                {{ 'review.document.verdict.approve'|trans }}
                            </button>
                            <button type="submit" name="submit_review_form[verdict]" value="changes-requested" class="lp-btn lp-btn--outline-amber">
                                {{ 'review.document.verdict.request_changes'|trans }}
                            </button>
                        </div>
                    </form>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
