# Copy to terraform.tfvars (gitignored) and fill in, or export as TF_VAR_*.
# Secrets and account-specific placement live here; everything structural is in
# the module block in main.tf.
#
#   app_secret         -> openssl rand -hex 16
#   app_encryption_key -> php -r 'echo base64_encode(sodium_crypto_secretbox_keygen()), "\n";'

# --- Required: where this deploys, in YOUR account ---
# Terraform creates a database and user on an existing Postgres cluster; it does
# not create the cluster. If you have none:
#   doctl databases create loupe-db --engine pg --region tor1
#   doctl databases list        # copy the Name column into db_cluster_name
# region must match that cluster's region.

region            = "tor"
db_cluster_name   = "loupe-db"
db_server_version = "18" # the cluster's actual PG major version

# Or let Terraform create and own a dedicated cluster instead: comment out
# db_cluster_name above and uncomment these. Exactly one of the two is
# required — setting neither is rejected at plan time, because an empty
# db_cluster_name would fall through to the upstream project's own cluster.
# db_cluster_region is a DATACENTER slug (tor1), not the App Platform region
# (tor) set above; the wrong one plans cleanly and fails at apply.
# create_db_cluster     = true
# db_cluster_region     = "tor1"
# db_cluster_size       = "db-s-1vcpu-1gb"  # smallest managed plan
# db_cluster_node_count = 1                 # 1 = no standby

# Dedicated mode only. The module declares the cluster's whole trusted-source
# list, so this is authoritative and `doctl databases firewalls append` does not
# survive the next apply. Put your address here for the one-time schema GRANT,
# then empty it again.
# db_cluster_trusted_ips = ["203.0.113.7"]

# --- Migrations ---
# Leave off for the FIRST apply. PostgreSQL 15+ denies CREATE on the public
# schema to a non-owner, so until the one-time GRANT has been issued as the
# cluster admin the PRE_DEPLOY job fails — and it fails the whole deployment
# with it, on every retry. Turn on once migrations have been run by hand.
# enable_predeploy_migrations = true

# --- Health check ---
# Leave unset for the FIRST apply. The module attaches the cluster's trusted
# sources after the app, so the app boots with no database access — and /healthz
# answers 503 when the database is unreachable, which would stall the deploy on a
# condition the next resource in the graph fixes. /login is public, queries
# nothing and returns 200. Switch once migrations have run.
# health_check_path = "/healthz"

# Optional. Lets a post-deploy check read the running build:
#     curl -sH "X-Probe-Token: $TOKEN" https://<host>/healthz | jq -r .version
# Unset, /healthz never reports a version to anyone. Generate with
# `openssl rand -hex 32`.
# health_probe_token = "..."

# --- Site review ---
# Optional. The widget token of the loupe.ac project site-review comments should
# file into — read it from that project's page. Unset serves no widget. It is
# shown to administrators only, so ordinary visitors never see it.
# site_review_widget_token = "..."
# Empty (the default) shows the widget to administrators only. "1" offers it to
# every visitor, whose comments an agent may then act on.
# site_review_widget_public = "1"
# --- Analytics (Umami) ---
# All three, plus the analytics.enabled feature flag, before any tag is emitted.
# analytics_script_url = "https://cloud.umami.is/script.js"
# analytics_website_id = "00000000-0000-0000-0000-000000000000"
# analytics_origin     = "https://cloud.umami.is"

# --- Optional: custom domain ---
# Omit both and the app serves only on its assigned *.ondigitalocean.app
# hostname. domain_zone must be a zone THIS account's DNS serves
# (`doctl compute domain list`), and App Platform then writes the record itself.
# custom_domain = "app.example.com"
# domain_zone   = "example.com"

# Absolute base for URLs built outside a request — password-reset mails, export
# download links. Derives from custom_domain, so set it ONLY when you have no
# custom domain, using the hostname the first apply printed. Wrong here means
# links that point at the wrong host and nothing that says so.
# default_uri = "https://loupe-xxxxx.ondigitalocean.app"

# --- Optional: DigitalOcean project ---
# Files the app, cluster and export bucket under one project. Omit and they land
# in the account's DEFAULT project, which on a multi-app account belongs to
# something else. `doctl projects list` for the UUID.
# project_id = "00000000-0000-0000-0000-000000000000"

# --- Required: credentials ---

do_token             = "dop_v1_..."            # or export DIGITALOCEAN_TOKEN and drop this
registry_credentials = "ubermuda:ghp_xxxxxxxx" # GHCR "username:PAT" (read:packages); empty for DOCR
app_secret           = "GENERATED_HEX_32"
app_encryption_key   = "GENERATED_BASE64_32_BYTE_KEY"

# --- Required: outbound mail ---
# Email verification is mandatory, so an instance without working mail creates
# accounts nobody can ever verify. A no-op transport cannot fail, so nothing is
# raised when this is wrong — hence both are required rather than defaulted.
mailer_dsn          = "smtp://USER:PASS@HOST:PORT"
mailer_from_address = "noreply@loupe.example.com" # a domain you control, with SPF/DKIM/DMARC

# --- Required: the container image ---
# `registry` has no default: this project's own package is not one you can push
# to, and inheriting it fails at image-pull inside App Platform rather than at
# plan time. Export the matching LOUPE_PROD_IMAGE so `just build-prod` and
# `just deploy` push what App Platform pulls:
#   export LOUPE_PROD_IMAGE=ghcr.io/you/loupe:prod
registry = "you"
# registry_type    = "GHCR"
# image_repository = "loupe"
# image_tag        = "prod"

# --- Application configuration (wired into extra_env in main.tf) ---
# Omit any of these and the matching feature stays off rather than half-configured.
# REQUIRED in production: the install wizard fails closed there, so without this
# /install 404s and you cannot create the first administrator.
# install_token = "GENERATE_A_LONG_RANDOM_STRING"

# admin_email       = "you@example.com"       # promoted to ROLE_ADMIN
# mcp_allowed_hosts = "loupe.example.com"     # must list the app's real hostname
# trusted_proxies   = "203.0.113.4"           # only if your own proxy fronts the app

# Where the source of THIS instance can be obtained, linked in the footer of
# every page. Leaving it out keeps the committed default, which points at the
# upstream repository — true only while you run upstream's code unmodified.
# REQUIRED IF YOU MODIFY LOUPE: the AGPL obliges you to offer your own modified
# source to everyone using the instance over the network, and a link to upstream
# hands them code they are not running.
# app_source_url = "https://github.com/you/loupe"

# mailer_from_address is required and set in the outbound-mail section above.
# mailer_from_name    = "Loupe"

# Site-review push. Setting this runs a Mercure hub as a second service in the
# app and wires the URLs automatically; leave it out to keep push disabled.
# mercure_jwt_secret = "GENERATE_A_LONG_RANDOM_STRING"

# --- Data-export archives ---
# The web and worker containers have separate filesystems, so exports need a
# bucket both can reach or every download 404s. Terraform creates a Spaces bucket
# and a bucket-scoped access key for this and wires them into the app, so all you
# choose is the datacenter. That needs Spaces credentials as well as the API
# token — generate a pair under "Spaces Keys" in the control panel and either put
# them here or export SPACES_ACCESS_KEY_ID / SPACES_SECRET_ACCESS_KEY.
#
# Spaces slugs are not App Platform slugs: App Platform's nyc is Spaces' nyc3.

create_export_bucket = true
export_bucket_region = "tor1"
# spaces_access_id  = "..."
# spaces_secret_key = "..."
# export_bucket_name = "loupe-exports"   # names are unique per region across all accounts

# Bringing your own bucket instead — AWS S3, MinIO, Cloudflare R2, anything that
# speaks S3. Set create_export_bucket = false and fill these in; the application
# side is identical, only these values change.
# create_export_bucket = false
# export_storage_bucket         = "loupe-exports"
# export_storage                = "s3"          # local (default) or s3
# export_storage_region         = "eu-west-1"
# export_storage_prefix         = "archives/"   # empty stores at the bucket root
# export_storage_endpoint       = "https://minio.example.com"
# export_storage_key            = "..."
# export_storage_secret         = "..."
# export_storage_use_path_style = "true"   # MinIO and most non-AWS providers
# export_storage_acl            = "bucket-owner-full-control"  # AWS S3 only, see docs/extending/object-storage.md

# stripe_secret_key     = "sk_live_..."
# stripe_webhook_secret = "whsec_..."

# oauth_google_id     = "..."
# oauth_google_secret = "..."
# oauth_github_id     = "..."
# oauth_github_secret = "..."
