<div{% if fallbackNote|default('')|trim is empty %} hidden{% endif %} data-controller="form-draft-recovery" data-form-draft-recovery-owner-value="{{ app.user.id }}" data-form-draft-recovery-key-value="{{ key }}" data-form-draft-recovery-options-value="{{ options|json_encode|e('html_attr') }}"{% if labels|default(null) %} data-form-draft-recovery-labels-value="{{ labels|json_encode|e('html_attr') }}"{% endif %} data-action="form-draft:cleared@document->form-draft-recovery#render">
    <section class="lp-inbox-item__response" hidden data-inbox-draft-kind="{{ kind }}" data-form-draft-recovery-target="panel">
        <twig:Ds:Label as="p">{{ title|trans }}</twig:Ds:Label>
        <p class="lp-inbox-item__note">{{ (hint|default('inbox.answer.unsent_closed'))|trans }}</p>
        <ul class="lp-inbox-item__choices" data-form-draft-recovery-target="options"></ul>
        <p class="lp-inbox-item__answer-text" data-form-draft-recovery-target="text"></p>
        <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="form-draft-recovery#discard">{{ 'inbox.answer.discard_draft'|trans }}</twig:Ds:Button>
    </section>
    {% if fallbackNote|default('')|trim is not empty %}
        <div data-inbox-review-draft data-form-draft-recovery-target="fallback"><twig:Ds:Label as="p">{{ 'inbox.review.unsent_note'|trans }}</twig:Ds:Label><p class="lp-inbox-item__answer-text">{{ fallbackNote }}</p></div>
    {% endif %}
</div>
