{# `inReviewMenu`: the page's review menu holds Finish review below lg, so the bar drops it there. #}
<div class="lp-review-topbar-actions{{ inReviewMenu ? ' lp-review-topbar-actions--finish' : '' }}">
    <button type="button" class="lp-btn lp-btn--primary" data-controller="review-finish" data-action="click->review-finish#open">
        <twig:ux:icon name="lucide:check" />
        {{ 'review.document.finish.title'|trans }}
    </button>
</div>
