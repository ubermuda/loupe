<div data-controller="modal" data-modal-reopen-value="{{ form.vars.submitted ? 'true' : 'false' }}">
    <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="click->modal#open"><twig:ux:icon name="lucide:pencil" />{{ 'review.revise.open'|trans }}</twig:Ds:Button>
    <twig:Ds:Dialog size="document" aria-labelledby="revise-document-title" data-action="cancel->modal#close">
        <h2 class="lp-dialog-title" id="revise-document-title">{{ 'review.revise.title'|trans }}</h2>
        <p class="lp-dialog-desc">{{ 'review.revise.help'|trans }}</p>
        {{ form_start(form, {attr: {class: 'lp-form', 'data-controller': 'form-draft', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': 'document:revise:' ~ document.id, 'data-action': 'input->form-draft#remember change->form-draft#remember submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared'}}) }}
            {% include '@Review/_draft_notice.html.twig' with {} only %}
            <twig:Ds:FieldErrors data-revision-errors>{{ form_errors(form) }}{{ form_errors(form.versionNumber) }}</twig:Ds:FieldErrors>
            {{ form_widget(form.versionNumber, {type: 'hidden', attr: {'data-form-draft-target': 'guard'}}) }}
            {% for field in [form.title, form.markdown, form.description] %}
            <twig:Ds:FormField :fieldView="field" :widgetAttr="{class: field.vars.name == 'markdown' ? 'lp-document-editor' : '', 'data-form-draft-target': field.vars.name == 'markdown' ? 'text' : 'field'}" />
            {% endfor %}
            {% include '@Review/_document_work_links.html.twig' with {form: form} only %}
            {% if not form.versionNumber.vars.valid %}
            <twig:Ds:Button href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">{{ 'review.document.version.back_to_latest'|trans }}</twig:Ds:Button>
            {% endif %}
            <div class="lp-review-verdict-actions">
                <twig:Ds:Button variant="ghost" type="button" data-action="click->modal#close">{{ 'review.revise.cancel'|trans }}</twig:Ds:Button>
                <twig:Ds:Button variant="primary" type="submit">{{ 'review.revise.submit'|trans }}</twig:Ds:Button>
            </div>
        {{ form_end(form) }}
    </twig:Ds:Dialog>
</div>
