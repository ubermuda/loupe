{# The card form, shared by create and edit. Props: form, action, submitLabel,
   cancelUrl, cancelLeavesFrame (Cancel closes the card drawer rather than
   loading cancelUrl inside it). #}
{{ form_start(form, {action: action, attr: {class: 'lp-form', 'data-card-drawer-saves-card': ''}}) }}
    <div class="lp-field-errors">{{ form_errors(form) }}</div>

    <div class="lp-form-field">
        {{ form_label(form.title, null, {label_attr: {class: 'lp-label'}}) }}
        {{ form_widget(form.title, {attr: {class: 'lp-input'}}) }}
        <div class="lp-field-errors">{{ form_errors(form.title) }}</div>
    </div>

    <div class="lp-card-form-row">
        <div class="lp-form-field">
            {{ form_label(form.type, null, {label_attr: {class: 'lp-label'}}) }}
            {{ form_widget(form.type, {attr: {class: 'lp-input lp-select'}}) }}
            <div class="lp-field-errors">{{ form_errors(form.type) }}</div>
        </div>
        <div class="lp-form-field">
            {{ form_label(form.column, null, {label_attr: {class: 'lp-label'}}) }}
            {{ form_widget(form.column, {attr: {class: 'lp-input lp-select'}}) }}
            <div class="lp-field-errors">{{ form_errors(form.column) }}</div>
        </div>
    </div>

    <div class="lp-form-field">
        {{ form_label(form.body, null, {label_attr: {class: 'lp-label'}}) }}
        {{ form_widget(form.body, {attr: {class: 'lp-input lp-card-form-textarea'}}) }}
        {{ form_help(form.body) }}
        <div class="lp-field-errors">{{ form_errors(form.body) }}</div>
    </div>

    <div class="lp-form-field">
        {{ form_label(form.pullRequestUrls, null, {label_attr: {class: 'lp-label'}}) }}
        {{ form_widget(form.pullRequestUrls, {attr: {class: 'lp-input lp-card-form-textarea'}}) }}
        {{ form_help(form.pullRequestUrls) }}
        <div class="lp-field-errors">{{ form_errors(form.pullRequestUrls) }}</div>
    </div>

    {% set linkRows = form.relatedCards %}
    {% set linkPrototype %}{% include '@Board/_card_link_row_fields.html.twig' with {row: linkRows.vars.prototype} only %}{% endset %}
    <fieldset class="lp-form-field" data-card-links data-controller="form-collection" data-form-collection-collection-holder-id-value="{{ linkRows.vars.id }}_rows">
        <legend class="lp-label">{{ linkRows.vars.label|trans }}</legend>
        <p id="{{ linkRows.vars.id }}_help" class="lp-form-hint">{{ linkRows.vars.help|trans }}</p>
        <div id="{{ linkRows.vars.id }}_rows" class="lp-card-link-rows" data-prototype="{{ linkPrototype|e('html_attr') }}" data-index="{{ linkRows|length > 0 ? max(linkRows|keys) + 1 : 0 }}">
            {%- for row in linkRows %}
                <div class="lp-card-link-row" data-form-collection-row data-card-link-row>
                    {% include '@Board/_card_link_row_fields.html.twig' with {row: row} only %}
                    <button type="button" class="lp-btn lp-btn--ghost lp-btn--icon" aria-label="{{ 'board.card.form.linked_cards.remove'|trans }}" data-action="form-collection#removeRow"><twig:ux:icon name="lucide:x" class="w-4 h-4" /></button>
                </div>
            {% endfor -%}
        </div>
        <div class="lp-field-errors">{{ form_errors(linkRows) }}</div>
        <div>
            <button type="button" class="lp-btn lp-btn--ghost lp-btn--sm" data-action="form-collection#addRow"><twig:ux:icon name="lucide:plus" class="w-4 h-4" />{{ 'board.card.form.linked_cards.add'|trans }}</button>
        </div>
        <template data-form-collection-target="removeButtonTemplate">
            <button type="button" class="lp-btn lp-btn--ghost lp-btn--icon" aria-label="{{ 'board.card.form.linked_cards.remove'|trans }}"><twig:ux:icon name="lucide:x" class="w-4 h-4" /></button>
        </template>
    </fieldset>
    {% do linkRows.setRendered %}

    <div class="flex items-center justify-end gap-3 pt-2">
        <a class="lp-btn lp-btn--ghost mr-auto" href="{{ cancelUrl }}"{% if cancelLeavesFrame %} data-turbo-frame="_top" data-action="card-drawer#close"{% endif %}>{{ 'board.card.form.cancel'|trans }}</a>
        <button type="submit" class="lp-btn lp-btn--primary">{{ submitLabel|trans }}</button>
    </div>
{{ form_end(form) }}
