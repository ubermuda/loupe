{# Rows of the sections panel: one section per row, in document order.
   An overview only. The button beside each heading is where a reviewer acts,
   so this panel carries no control of its own. #}
{% for row in rows %}
<li class="lp-section-approvals__item">
    <a class="lp-section-approvals__link" data-level="{{ row.level }}" href="#{{ row.headingId }}"
       data-action="click->metadata-tabs#jump" title="{{ row.label }}">{{ row.label }}</a>
    {% if row.approved %}
    <span class="lp-section-approvals__approved" data-section-approved="{{ row.headingId }}">
        <twig:ux:icon name="lucide:check" class="lp-section-approvals__check" />
        {{ 'review.document.sections.approved'|trans }}
    </span>
    {% else %}
    <span class="lp-section-approvals__pending">{{ 'review.document.sections.pending'|trans }}</span>
    {% endif %}
</li>
{% endfor %}
