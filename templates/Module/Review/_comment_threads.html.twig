{# Every thread's card, as a popover that its row or its highlight opens.
   Outside the Comments panel: a popover under display:none does not render.
   Vars: comments, every comment on the version; readOnly, true on an
   earlier version. #}
{% set readOnly = readOnly ?? false %}
{% set rootComments = comments|filter(c => c.parent is null)|map(c => c) %}
{% set resolvedCount = rootComments|filter(c => c.threadStatus.value == 'resolved')|length %}
<div id="comment-threads" class="lp-comment-threads" data-resolved-count="{{ resolvedCount }}">
    {% for comment in rootComments %}
        {% set replies = comments|filter(c => c.parent is not null and c.parent.id == comment.id) %}
        <twig:CommentThread :comment="comment" :replies="replies|map(c => c)" :readOnly="readOnly" />
    {% endfor %}
</div>
