{# The change count and the two jumps through the comparison.
   Params: changeCount. #}
<div class="lp-diff-nav">
    <p class="lp-diff-nav__count" aria-live="polite" data-diff-navigation-target="counter">{{ 'review.document.diff.nav.count'|trans({'%count%': changeCount}) }}</p>
    <twig:Ds:Button variant="icon" type="button" data-diff-navigation-target="previousButton" data-action="diff-navigation#previous" :disabled="changeCount == 0"
            aria-label="{{ 'review.document.diff.nav.previous'|trans }}"
            title="{{ 'review.document.diff.nav.previous'|trans }}">
        <twig:ux:icon name="lucide:chevron-up" class="w-4 h-4 shrink-0" />
    </twig:Ds:Button>
    <twig:Ds:Button variant="icon" type="button" data-diff-navigation-target="nextButton" data-action="diff-navigation#next" :disabled="changeCount == 0"
            aria-label="{{ 'review.document.diff.nav.next'|trans }}"
            title="{{ 'review.document.diff.nav.next'|trans }}">
        <twig:ux:icon name="lucide:chevron-down" class="w-4 h-4 shrink-0" />
    </twig:Ds:Button>
</div>
