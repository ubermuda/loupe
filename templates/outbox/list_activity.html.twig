{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_workshop', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'activity.page.title'|trans }}</span>
{% endblock %}

{% block topbar_meta %}{% endblock %}

{% block body %}
<div class="lp-workspace lp-orchestration-page lp-redesign-secondary lp-redesign-activity" data-controller="activity-filter"
    data-activity-filter-url-value="{{ path('app_project_activity', {id: project.id}) }}"
    data-activity-filter-project-value="{{ project.id }}"
    data-activity-filter-page-size-value="{{ pageSize }}"
    data-activity-filter-labels-value="{{ {
        connecting: 'activity.feed.connecting'|trans,
        listening: 'activity.feed.listening'|trans,
        listeningTitle: 'activity.feed.listening_title'|trans,
        paused: 'activity.feed.paused'|trans,
        stale: 'activity.feed.stale'|trans,
        failed: 'activity.feed.failed'|trans,
        pause: 'activity.feed.pause'|trans,
        resume: 'activity.feed.resume'|trans
    }|json_encode|e('html_attr') }}">
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'activity.heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'activity.description'|trans }}</p>
        </div>
        <div class="lp-activity-header-actions">
            <span class="lp-status-chip lp-status-chip--pending" data-activity-filter-target="status" role="status">{{ 'activity.status.recorded'|trans }}</span>
            <button type="button" class="lp-btn" data-activity-filter-target="toggle" data-action="activity-filter#toggle" aria-pressed="false" disabled>{{ 'activity.feed.pause'|trans }}</button>
        </div>
    </header>

    <div class="lp-list-filters" data-activity-filter-target="filters" {% if entries is empty %}hidden{% endif %}>
        <div class="lp-filter-form">
            <div class="lp-filter-search">
                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                <label class="sr-only" for="activity-search">{{ 'activity.filter.search_label'|trans }}</label>
                <input type="search" id="activity-search" class="lp-input lp-filter-input" placeholder="{{ 'activity.filter.search_placeholder'|trans }}" data-activity-filter-target="query" data-action="input->activity-filter#filter">
            </div>
            <label class="sr-only" for="activity-family">{{ 'activity.filter.family_label'|trans }}</label>
            <select id="activity-family" class="lp-input lp-select lp-filter-select" data-activity-filter-target="family" data-action="change->activity-filter#filter">
                <option value="all">{{ 'activity.filter.all_families'|trans }}</option>
                {% for family in ['board', 'worker', 'inbox', 'document', 'rule', 'site_review'] %}
                <option value="{{ family }}">{{ ('activity.family.' ~ family)|trans }}</option>
                {% endfor %}
            </select>
        </div>
        <span class="lp-filter-count" data-activity-filter-target="count">{{ 'activity.count'|trans({'%count%': entries|length}) }}</span>
    </div>
    <p class="lp-rule-explanation" data-activity-filter-target="gap" role="status" hidden>{{ 'activity.feed.gap'|trans({'%count%': pageSize}) }}</p>
    <div class="lp-activity-feed" data-activity-filter-target="feed">
        {% include 'outbox/_activity_entries.html.twig' with {entries: entries} only %}
    </div>
    <div class="lp-empty-state" data-activity-filter-target="empty" hidden>
        <twig:ux:icon name="lucide:search-x" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'activity.filter.empty'|trans }}</h2>
    </div>
    <div class="lp-empty-state" data-activity-empty data-activity-filter-target="noEvents" {% if entries is not empty %}hidden{% endif %}>
        <twig:ux:icon name="lucide:activity" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'activity.empty.title'|trans }}</h2>
        <p>{{ 'activity.empty.description'|trans }}</p>
    </div>
</div>
{% endblock %}
