{# The admin area renders the bundle's layout, so it would otherwise be the one
   part of the UI with no AGPL source offer. Overridden here rather than per page
   so bundle-shipped admin templates are covered too. `@!UbermudaAdmin` is the
   bundle's own copy — the plain name would resolve back to this file. #}
{% extends '@!UbermudaAdmin/base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{# The bundle renders its importmap without a nonce, so every inline script it
   emits is blocked by the enforcing prod CSP and the admin area boots no
   JavaScript at all. Mirrors layout_base.html.twig. #}
{% block importmap %}{{ importmap(admin_importmap_entry, {nonce: csp_nonce('script')}) }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if site_review_widget_token and (site_review_widget_public or is_granted('ROLE_ADMIN')) %}
    <script src="{{ site_review_widget_backend|trim('/', 'right') }}/site-review/widget.js" data-token="{{ site_review_widget_token }}"></script>
    {% endif %}
{% endblock %}

{% block sidebar_footer %}
    {{ parent() }}
    <div class="px-3 pb-4">
        {% include '_source_link.html.twig' with {class: 'flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-white/50 transition hover:bg-white/15 hover:text-white'} only %}
    </div>
{% endblock %}
