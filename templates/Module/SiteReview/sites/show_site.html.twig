{% extends 'base.html.twig' %}

{% block title %}{{ site.name }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="bp-page">
    <nav class="flex items-center gap-1.5 text-xs text-fg-dim mb-4">
        <a href="{{ path('app_site_review_sites') }}" class="hover:text-fg no-underline">{{ 'site_review.sites.page.title'|trans }}</a>
        <twig:ux:icon name="lucide:chevron-right" class="w-3 h-3" />
        <span class="text-fg-mute">{{ site.name }}</span>
    </nav>

    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ site.name }}</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="bp-card mb-6" id="site-token">
        <h2 class="bp-section-title">{{ 'site_review.site.token.heading'|trans }}</h2>
        <p class="bp-form-hint">{{ 'account.api_token.scope.site_review_warning'|trans }}</p>

        {% if site.token %}
        <div class="bp-doc-row">
            <div class="bp-doc-row__main">
                <span class="bp-doc-row__title">{{ site.token.label }}</span>
                <div class="bp-doc-row__meta">
                    <span>{{ site.token.createdAt|date('M j, Y') }}</span>
                </div>
            </div>
            <form method="POST" action="{{ path('app_api_token_revoke', {tokenId: site.token.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-api-token') }}">
                <input type="hidden" name="returnTo" value="{{ path('app_site_review_site', {id: site.id}) }}">
                <button type="submit" class="bp-btn bp-btn--danger">{{ 'account.api_token.action.revoke'|trans }}</button>
            </form>
        </div>
        {% set widgetSnippet %}<script src="{{ absolute_url('/site-review/widget.js') }}" data-token="YOUR_TOKEN"></script>{% endset %}
        <div class="bp-code-block mt-4">
            <div class="bp-code-block__header">
                <span class="bp-code-block__label">{{ 'site_review.site.token.snippet_heading'|trans }}</span>
            </div>
            <pre class="bp-pre"><code>{{ widgetSnippet }}</code></pre>
        </div>
        {% else %}
        <form method="POST" action="{{ path('app_site_review_site_token_mint', {id: site.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('mint-site-token') }}">
            <button type="submit" class="bp-btn bp-btn--primary">{{ 'site_review.site.token.mint'|trans }}</button>
        </form>
        {% endif %}
    </div>

    <div class="flex flex-col gap-4 mt-2">
        {% for review in reviews %}
        <div class="bp-card" data-review-id="{{ review.id }}">
            <div class="flex items-center gap-2 mb-3">
                {% if review.status.value == 'in-progress' %}
                <span class="bp-tag">{{ 'site_review.review.status.draft'|trans }}</span>
                <span class="text-xs text-fg-dim">{{ review.createdAt|date('M j, Y H:i') }}</span>
                {% else %}
                <span class="bp-tag">{{ 'site_review.review.status.submitted'|trans }}</span>
                <span class="text-xs text-fg-dim">{{ review.submittedAt|date('M j, Y H:i') }}</span>
                {% endif %}
                <span class="text-xs text-fg-dim">· {{ review.comments|length }} {{ 'site_review.review.comments_label'|trans }}</span>
            </div>

            {% for comment in review.comments %}
            <div class="bp-review-comment" data-comment-id="{{ comment.id }}" data-comment-status="{{ comment.status.value }}">
                {% if comment.text is not empty %}
                <blockquote class="bp-review-comment__quote">{{ comment.text }}</blockquote>
                {% endif %}

                <div class="bp-review-comment__head">
                    <span class="bp-tag shrink-0">{{ ('site_review.comment.status.' ~ comment.status.value)|trans }}</span>
                    {% if comment.selector is empty %}
                    <span class="bp-tag shrink-0">{{ 'site_review.comment.general'|trans }}</span>
                    {% endif %}
                </div>

                <p class="bp-review-comment__body">{{ comment.body }}</p>

                <a class="bp-review-comment__url" href="{{ comment.url }}" target="_blank" rel="noopener noreferrer">
                    <twig:ux:icon name="lucide:external-link" class="w-3.5 h-3.5 shrink-0" />
                    <span class="truncate">{{ comment.url }}</span>
                </a>

                {% if review.status.value == 'submitted' %}
                <div class="flex items-center gap-2 mt-2">
                    {% if comment.status.value != 'resolved' %}
                    <form method="POST" action="{{ path('app_site_review_comment_resolve', {id: comment.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('site-review-comment-action') }}">
                        <button type="submit" class="bp-btn bp-btn--sm">{{ 'site_review.comment.action.resolve'|trans }}</button>
                    </form>
                    {% endif %}
                    {% if comment.status.value != 'pending' %}
                    <form method="POST" action="{{ path('app_site_review_comment_reopen', {id: comment.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('site-review-comment-action') }}">
                        <button type="submit" class="bp-btn bp-btn--ghost bp-btn--sm">{{ 'site_review.comment.action.reopen'|trans }}</button>
                    </form>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="bp-card flex flex-col items-center text-center gap-3 py-12">
            <twig:ux:icon name="lucide:message-square" class="w-8 h-8 text-fg-dim" />
            <p class="bp-empty not-italic">{{ 'site_review.site.reviews.empty'|trans }}</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
