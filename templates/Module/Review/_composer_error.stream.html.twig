{#
  Turbo Stream returned when an anchored write fails validation: show the message
  where the reviewer is looking. The comment and rewording composers stay open on
  a non-2xx response and carry their own error span; a strike has no composer, so
  it targets the standing error region beside the document.

  Vars:  @comment-budget-ignore
    target   string   DOM id of the element to fill.
    message  string   The error to display.
#}
<turbo-stream action="update" target="{{ target }}">
    <template>{{ message }}</template>
</turbo-stream>
