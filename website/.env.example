# Site-review widget on the docs site. Both optional: with no token the widget
# is not injected at all, which is the default and what CI-less clones get.
#
# Use a token from a project of its own, not the one Loupe's own pages use —
# otherwise docs feedback lands in the same stream as feedback on the app.
# Mint one at <instance>/projects/<id>/widget-token.
#
# The token is visible in page source. That is inherent to the widget, so use
# a SiteReview-scoped token and never an MCP or production credential.
PUBLIC_SITE_REVIEW_TOKEN=
PUBLIC_SITE_REVIEW_HOST=https://loupe.dev.localhost
