{#- Decline, beside the response it replaces. It submits the item's decline form, which holds the note the reader typed. Props: formId (the decline form's id), label (translation key). -#}
<twig:Ds:Button variant="danger-ghost" size="sm" type="submit" form="{{ formId }}" data-action="inbox-decline#carryNote">{{ label|trans }}</twig:Ds:Button>
