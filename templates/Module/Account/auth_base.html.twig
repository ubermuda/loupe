{% extends 'base.html.twig' %}

{% block body %}
<div class="auth-page">

    {# Background effects #}
    <div class="auth-grid-mask"></div>
    <div class="auth-bg-glow"></div>

    {# Topbar #}
    <div class="relative z-10 flex items-center gap-2.5 px-7 py-6">
        <a href="/" class="inline-flex items-center gap-2.5 text-fg font-semibold tracking-tight text-lg no-underline">
            <span class="w-7 h-7 rounded-lg bg-accent shrink-0"></span>
            {{ 'nav.brand'|trans }}
        </a>
        <span class="flex-1"></span>
        {% block topbar_nav %}{% endblock %}
    </div>

    {# Card #}
    <div class="relative z-10 flex items-start justify-center px-7 pt-8 pb-12">
        <div class="w-full max-w-sm bg-surface-1 border border-line rounded-xl shadow-md px-8 pt-8 pb-7 flex flex-col gap-6">
            {% block auth_body %}{% endblock %}
        </div>
    </div>

    {# Footer #}
    <div class="relative z-10 flex items-center gap-3.5 px-7 py-5 text-xs text-fg-dim">
        <span>{{ 'account.auth.footer.copyright'|trans }}</span>
        <span class="flex-1"></span>
        {# Only when signed out: the app shell's sidebar already carries this
           link, and these pages (account deletion, social account linking) are
           reachable from inside it. #}
        {% if not app.user %}
            {% include '_source_link.html.twig' with {class: 'inline-flex items-center gap-1.5 text-fg-mute hover:text-fg'} only %}
        {% endif %}
        <a href="{{ app_docs_url }}/" class="text-fg-mute hover:text-fg">{{ 'account.auth.footer.docs'|trans }}</a>
        <a href="{{ path('app_privacy') }}" class="text-fg-mute hover:text-fg">{{ 'account.auth.footer.privacy'|trans }}</a>
        <a href="{{ path('app_terms') }}" class="text-fg-mute hover:text-fg">{{ 'account.auth.footer.terms'|trans }}</a>
        <a href="{{ path('app_ai_policy') }}" class="text-fg-mute hover:text-fg">{{ 'account.auth.footer.ai_policy'|trans }}</a>
    </div>

</div>
{% endblock %}
