{% extends 'base.html.twig' %}

{% block title %}{{ 'project.edit.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.project_settings'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'project.edit.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.edit.page.description'|trans }}</p>
        </div>
    </header>

    <div class="lp-settings-layout">
        {% include '@Project/_settings_nav.html.twig' with {project: project, active: 'general'} only %}

        <div class="lp-settings-content" id="general">
        <section class="lp-settings-section lp-settings-panel-card">
            <h2 class="lp-section-title">{{ 'project.edit.general.title'|trans }}</h2>
        {{ form_start(form, {'attr': {'class': 'lp-form'}}) }}
            <twig:Ds:FormField>
                {{ form_label(form.name, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.name, {attr: {class: ds_input_class()}}) }}
                <twig:Ds:FieldErrors :fieldView="form.name" />
            </twig:Ds:FormField>
            {% if project.slug is not null %}
            <twig:Ds:FormField>
                <twig:Ds:Label for="project-slug">{{ 'project.edit.slug.label'|trans }}</twig:Ds:Label>
                <div class="lp-input-with-action" data-controller="clipboard" data-clipboard-text-value="{{ project.slug }}"
                     data-clipboard-copied-label-value="{{ 'project.connect.copied'|trans }}">
                    <twig:Ds:Input type="text" id="project-slug" value="{{ project.slug }}" disabled data-project-slug />
                    <twig:Ds:Button type="button" data-clipboard-target="button" data-action="clipboard#copy">{{ 'project.connect.copy'|trans }}</twig:Ds:Button>
                </div>
                <twig:Ds:Hint>{{ 'project.edit.slug.hint'|trans }}</twig:Ds:Hint>
            </twig:Ds:FormField>
            {% endif %}
            <twig:Ds:FormField>
                {{ form_label(form.description, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.description, {attr: {class: ds_input_class('textarea')}}) }}
                <twig:Ds:FieldErrors :fieldView="form.description" />
            </twig:Ds:FormField>
            <twig:Ds:FormField>
                {{ form_label(form.domain, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.domain, {attr: {class: ds_input_class()}}) }}
                <twig:Ds:FieldErrors :fieldView="form.domain" />
                <twig:Ds:Hint>{{ 'project.edit.form.domain.hint'|trans }}</twig:Ds:Hint>
            </twig:Ds:FormField>
            <twig:Ds:FormField>
                {{ form_label(form.searchLanguage, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.searchLanguage, {attr: {class: ds_input_class('select')}}) }}
                <twig:Ds:FieldErrors :fieldView="form.searchLanguage" />
                <twig:Ds:Hint>{{ 'project.form.create_project_form.search_language.hint'|trans }}</twig:Ds:Hint>
            </twig:Ds:FormField>
            <div class="lp-settings-form-actions">
                <twig:Ds:Button href="{{ path('app_projects') }}">{{ 'project.edit.form.cancel'|trans }}</twig:Ds:Button>
                <twig:Ds:Button variant="primary" type="submit">{{ 'project.edit.form.submit'|trans }}</twig:Ds:Button>
            </div>
        {{ form_end(form) }}
        </section>

        <section class="lp-danger-zone lp-settings-panel-card" data-controller="modal"{% if deleteForm.vars.submitted %} data-modal-reopen-value="true"{% endif %}>
            <h2 class="lp-danger-zone-title">{{ 'project.delete.title'|trans }}</h2>
            <p class="lp-danger-zone-desc">{{ 'project.delete.warning'|trans }}</p>
            <twig:Ds:Button variant="danger" type="button" data-action="click->modal#open">
                {{ 'project.delete.button'|trans }}
            </twig:Ds:Button>

            <twig:Ds:Dialog>
                <div data-controller="confirm-input" data-confirm-input-expected-value="{{ project.name }}">
                    {{ form_start(deleteForm, {'action': path('app_project_delete', {id: project.id}), 'attr': {'class': 'lp-form'}}) }}
                        <h3 class="lp-dialog-title">{{ 'project.delete.modal.title'|trans({'%name%': project.name}) }}</h3>
                        <p class="lp-dialog-desc">{{ 'project.delete.modal.warning'|trans }}</p>
                        <twig:Ds:FormField>
                            {{ form_label(deleteForm.confirmName, null, {'label_attr': {'class': ds_label_class()}}) }}
                            {{ form_widget(deleteForm.confirmName, {'attr': {
                                'class': ds_input_class(),
                                'data-confirm-input-target': 'input',
                                'data-action': 'input->confirm-input#check',
                            }}) }}
                            <twig:Ds:FieldErrors :fieldView="deleteForm.confirmName" />
                        </twig:Ds:FormField>
                        <div class="flex items-center justify-end gap-3 pt-2">
                            <twig:Ds:Button type="button" data-action="click->modal#close">{{ 'project.delete.modal.cancel'|trans }}</twig:Ds:Button>
                            <twig:Ds:Button variant="danger" type="submit" data-confirm-input-target="submit" disabled>
                                {{ 'project.delete.modal.confirm'|trans }}
                            </twig:Ds:Button>
                        </div>
                    {{ form_end(deleteForm) }}
                </div>
            </twig:Ds:Dialog>
        </section>
        </div>
    </div>
</div>
{% endblock %}
