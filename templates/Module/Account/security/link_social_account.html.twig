{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.social.link.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.social.link.title'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.social.link.subheading'|trans({'%email%': email, '%provider%': providerLabel}) }}</p>
</div>

{% if error %}
    <div class="auth-error" role="alert">
        <twig:UX:Icon name="lucide:x" class="w-3.5 h-3.5 shrink-0 mt-px" aria-hidden="true" />
        {{ error|trans }}
    </div>
{% endif %}

{{ form_start(form, {'attr': {'class': 'form-stack', 'novalidate': 'novalidate'}}) }}
    <div class="form-field">
        {{ form_label(form.password, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.password, {'attr': {'class': 'auth-input', 'placeholder': 'account.form.link_social_account_form.password.placeholder'}}) }}
        <div class="field-errors">{{ form_errors(form.password) }}</div>
    </div>
    <button type="submit" class="auth-submit mt-1.5">{{ 'account.social.link.form.submit.label'|trans }}</button>
{{ form_end(form) }}

<div class="text-center text-sm text-fg-mute">
    <a href="{{ path('app_login') }}" class="text-accent hover:underline">{{ 'account.social.link.cancel'|trans }}</a>
</div>
{% endblock %}
