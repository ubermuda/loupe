{% set threads = comments|filter(comment => comment.parent is null) %}
{% set summaries = [] %}
{% for comment in threads %}
    {% set kind = comment.isStrike ? 'review.document.summary.strike' : (comment.isSuggestion ? 'review.document.summary.suggestion' : 'review.document.summary.comment') %}
    {% set lines = ['[' ~ ('review.document.status.' ~ comment.threadStatus.value)|trans ~ '] ' ~ kind|trans ~ ' · ' ~ comment.author.fullName] %}
    {% if comment.orphaned %}{% set lines = lines|merge(['review.document.summary.unanchored'|trans]) %}{% endif %}
    {% if comment.anchor.quote != '' %}{% set lines = lines|merge(['> ' ~ comment.anchor.quote]) %}{% endif %}
    {% if comment.isSuggestion and not comment.isStrike %}
        {% set lines = lines|merge(['review.document.summary.replacement'|trans({'%replacement%': comment.replacement})]) %}
    {% endif %}
    {% if comment.body != '' %}{% set lines = lines|merge([comment.body]) %}{% endif %}
    {% for reply in comments|filter(reply => reply.parent is not null and reply.parent.id == comment.id) %}
        {% set lines = lines|merge([reply.author.fullName ~ ': ' ~ reply.body]) %}
    {% endfor %}
    {% set summaries = summaries|merge([lines|join("\n")]) %}
{% endfor %}
<pre id="review-summary-comments" hidden>{{ summaries is empty ? 'review.document.summary.empty'|trans : summaries|join("\n\n") }}</pre>
