{% extends 'base.html.twig' %}

{% block title %}{{ 'review.document.page.title'|trans({'%title%': document.title}) }}{% endblock %}

{% block body %}
<div class="px-6 py-8">
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
    {% endfor %}
{% endfor %}

{% if orphanedCount > 0 %}
<div class="bp-orphan-banner">
    {{ 'review.document.orphan_banner'|trans({'%count%': orphanedCount}) }}
</div>
{% endif %}

<nav class="flex items-center gap-1.5 text-xs text-fg-dim mb-4">
    <a href="{{ path('app_project_documents', {id: document.project.id}) }}" class="hover:text-fg no-underline">{{ 'nav.link.documents'|trans }}</a>
    <twig:ux:icon name="lucide:chevron-right" class="w-3 h-3" />
    <span class="text-fg-mute">{{ document.title }}</span>
</nav>

<div class="bp-page-header">
    <h1 class="bp-page-title">{{ document.title }}</h1>
</div>

<div data-controller="comment-anchor">
    <div class="bp-review-layout">
        {#
            The outer .bp-review-doc provides position:relative for the floating composer.
            The inner [data-comment-anchor-target="doc"] is the TreeWalker root — it must
            contain ONLY the rendered HTML with no surrounding template whitespace, so that
            its textContent === DocumentVersion::plainText() and JS text-node offsets agree
            with the PHP anchor basis.
        #}
        <div class="bp-review-doc" data-action="mouseup->comment-anchor#onDocMouseup">
            <div class="prose max-w-none bp-prose" data-comment-anchor-target="doc">{{ version.renderedHtml|raw }}</div>

            {# Floating toolbar — appears on text selection so selecting text no
               longer steals focus or blocks copying. Clicking it opens the
               composer and highlights the selection. #}
            <div class="bp-anchor-toolbar" data-comment-anchor-target="toolbar" hidden>
                <button type="button" class="bp-btn bp-btn--primary bp-btn--sm" data-action="comment-anchor#startComment">
                    <twig:ux:icon name="lucide:message-square-plus" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.comment.add'|trans }}
                </button>
            </div>

            {# Floating composer — a Symfony form, hidden until the user opts in.
               The Stimulus controller positions it and fills the anchor fields;
               Turbo submits it and applies the returned stream. #}
            {{ form_start(addCommentForm, {attr: {
                class: 'bp-comment-composer',
                'data-comment-anchor-target': 'composer',
                'data-action': 'turbo:submit-end->comment-anchor#onSubmitEnd',
                hidden: true,
            }}) }}
                {{ form_widget(addCommentForm.quote) }}
                {{ form_widget(addCommentForm.prefix) }}
                {{ form_widget(addCommentForm.suffix) }}
                {{ form_widget(addCommentForm.body) }}
                <div class="bp-comment-composer__actions">
                    <span
                        id="composer-error"
                        class="bp-comment-composer__error"
                        data-comment-anchor-target="composerError"
                    ></span>
                    <button
                        type="button"
                        class="bp-btn bp-btn--ghost bp-btn--sm"
                        data-action="comment-anchor#hideComposer"
                    >{{ 'review.document.comment.cancel'|trans }}</button>
                    <button
                        type="submit"
                        class="bp-btn bp-btn--primary bp-btn--sm"
                    >{{ 'review.document.comment.submit'|trans }}</button>
                </div>
            {{ form_end(addCommentForm) }}
        </div>

        <div class="bp-review-sidebar">
            <div class="bp-review-sidebar__header">
                <h2 class="bp-review-sidebar__title">{{ 'review.document.sidebar.title'|trans }}</h2>
                <button type="button" class="bp-btn bp-btn--ghost bp-btn--sm" data-action="comment-anchor#startUntargeted">
                    <twig:ux:icon name="lucide:plus" class="w-3.5 h-3.5 shrink-0" />
                    {{ 'review.document.comment.untargeted'|trans }}
                </button>
            </div>

            {% include 'review/_comment_threads.html.twig' with {comments: comments} only %}

            <div class="bp-verdict-bar">
                <h3 class="bp-verdict-bar__title">{{ 'review.document.verdict.title'|trans }}</h3>
                <form method="POST" action="{{ path('app_document_review_submit', {projectId: document.project.id, documentId: document.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit-review') }}">
                    <div class="bp-verdict-bar__actions">
                        <button type="submit" name="verdict" value="approved" class="bp-btn bp-btn--success">
                            {{ 'review.document.verdict.approve'|trans }}
                        </button>
                        <button type="submit" name="verdict" value="changes-requested" class="bp-btn bp-btn--warning">
                            {{ 'review.document.verdict.request_changes'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}
