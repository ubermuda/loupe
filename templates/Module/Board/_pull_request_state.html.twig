{# A merged or closed pull request shows its state alone, because its checks and review no longer matter. #}
{% set open = state.state.value == 'open' %}
<span class="lp-pull-request-state" data-pull-request-state="{{ state.state.value }}">
    {% if open and state.draft %}
        <twig:StatusChip modifier="neutral" :label="'board.card.link.state.draft'|trans" />
    {% else %}
        {% set chip = {open: ['neutral', 'board.card.link.state.open'], merged: ['ok', 'board.card.link.state.merged'], closed: ['resolved', 'board.card.link.state.closed']}[state.state.value] %}
        <twig:StatusChip :modifier="chip[0]" :label="chip[1]|trans" />
    {% endif %}
    {% if open %}
        {% set checks = {pending: ['pending', 'board.card.link.checks.pending'], passed: ['ok', 'board.card.link.checks.passed'], failed: ['failed', 'board.card.link.checks.failed']}[state.checks.value] %}
        {% set failedNames = state.checks.value == 'failed' and state.failedChecks|length > 0 ? 'board.card.link.checks.failed_names'|trans({'%checks%': state.failedChecks|join(', ')}) : null %}
        <twig:StatusChip :modifier="checks[0]" :label="checks[1]|trans" />
        {% set mergeability = {conflicting: ['failed', 'board.card.link.mergeability.conflicting'], behind: ['pending', 'board.card.link.mergeability.behind'], blocked: ['failed', 'board.card.link.mergeability.blocked']}[state.mergeability.value] ?? null %}
        {% if mergeability %}<twig:StatusChip :modifier="mergeability[0]" :label="mergeability[1]|trans" />{% endif %}
        {% set review = {approved: ['ok', 'board.card.link.review.approved'], 'approval-outdated': ['pending', 'board.card.link.review.approval_outdated'], 'changes-requested': ['failed', 'board.card.link.review.changes_requested'], required: ['pending', 'board.card.link.review.required']}[state.review.value] ?? null %}
        {% if review %}<twig:StatusChip :modifier="review[0]" :label="review[1]|trans" />{% endif %}
        {% if failedNames %}<span class="lp-pull-request-state__failed">{{ failedNames }}</span>{% endif %}
    {% endif %}
</span>
