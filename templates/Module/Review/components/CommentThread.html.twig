{#
  Props:  @comment-budget-ignore
    comment    Comment           The root comment (parent === null).
    replies    list<Comment>     Direct replies to this comment.
    replyForm  FormView|null     Pre-bound reply form (with errors) or null.
    readOnly   bool              True on an earlier version of the document, where
                                 reply/resolve/delete would act on a version the
                                 reviewer has navigated away from. Defaults false.

  The card itself is <twig:CommentCard>; this maps the entity onto its scalar
  props and supplies the write controls. Reply is a Symfony form; resolve is a
  fieldless plain form submitted by the Resolve button via form=. Both post
  through Turbo; the controllers return a Turbo Stream that replaces this thread
  (targeted by the id CommentCard renders).

  A card with an anchor is positioned by comment_anchor_controller so it sits
  level with the passage it points at; a general comment carries
  data-comment-general and stays in normal flow at the head of the column.
#}
{% set status = comment.threadStatus.value %}
{% set kind = comment.isStrike ? 'strike' : (comment.isSuggestion ? 'suggestion' : 'comment') %}
<twig:CommentCard
    domId="{{ comment.id }}"
    author="{{ comment.author.fullName }}"
    status="{{ status }}"
    kind="{{ kind }}"
    quote="{{ comment.anchor.quote }}"
    prefix="{{ comment.anchor.prefix }}"
    suffix="{{ comment.anchor.suffix }}"
    :replacement="comment.replacement ?? ''"
    body="{{ comment.body }}"
    :orphaned="comment.orphaned"
    :replies="replies|map(reply => {author: reply.author.fullName, body: reply.body})"
>
    {# On an earlier version there is nothing to act on: every one of these posts
       resolves its target through the comment's own id, but the reviewer is
       looking at a record of a past discussion, not the live one. #}
    {% if not readOnly %}
    {# Fieldless delete form — available on any thread (resolved or not),
       submitted by a Delete button via form=. Confirmed before submit. #}
    <form id="delete-form-{{ comment.id }}" action="{{ path('app_comment_delete', {id: comment.id}) }}" method="post" hidden
          data-turbo-confirm="{{ 'review.document.comment.delete_confirm'|trans }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('comment-action') }}">
    </form>

    {% if status != 'resolved' %}
    <div class="lp-comment-reply-form">
        {% set replyForm = replyForm ?? comment_reply_form(comment) %}

        {# Fieldless resolve form — submitted by the Resolve button below via form=. #}
        <form id="resolve-form-{{ comment.id }}" action="{{ path('app_comment_resolve', {id: comment.id}) }}" method="post" hidden>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('comment-action') }}">
        </form>

        {{ form_start(replyForm, {attr: {
            class: 'contents',
            'data-controller': 'keyboard-submit',
            'data-action': 'keydown->keyboard-submit#submit',
        }}) }}
            {{ form_widget(replyForm.body) }}
            <div class="lp-comment-error">{{ form_errors(replyForm.body) }}</div>
            <div class="lp-comment-actions">
                <button type="submit" class="lp-btn lp-btn--on-card lp-btn--sm">{{ 'review.document.comment.reply'|trans }}</button>
                <button type="submit" form="resolve-form-{{ comment.id }}" class="lp-btn lp-btn--inverse lp-btn--sm">{{ 'review.document.comment.resolve'|trans }}</button>
                <button type="submit" form="delete-form-{{ comment.id }}" class="lp-btn lp-btn--danger-ghost lp-btn--sm lp-comment-actions__delete">{{ 'review.document.comment.delete'|trans }}</button>
            </div>
        {{ form_end(replyForm) }}
    </div>
    {% else %}
    <div class="lp-comment-actions">
        <button type="submit" form="delete-form-{{ comment.id }}" class="lp-btn lp-btn--danger-ghost lp-btn--sm lp-comment-actions__delete">{{ 'review.document.comment.delete'|trans }}</button>
    </div>
    {% endif %}
    {% endif %}
</twig:CommentCard>
