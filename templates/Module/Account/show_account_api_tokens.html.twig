{% extends '@Account/_settings_layout.html.twig' %}

{% block settings_section 'api-tokens' %}

{% block settings_content %}
{% set mintedApiToken = app.flashes('minted_api_token')|first %}
<section class="lp-connect-block lp-settings-section lp-settings-panel-card" data-testid="api-tokens-section">
    <h2 class="lp-section-title">{{ 'account.settings.api_tokens.heading'|trans }}</h2>
    <p class="lp-connect-hint">{{ 'account.settings.api_tokens.intro'|trans }}</p>

    {# The raw value arrives through a dedicated flash key, which base.html.twig
       excludes from the flash strip. It is never stored, so this is the only
       render: a reload shows the masked tail below instead. #}
    {% if mintedApiToken %}
    <div class="lp-connect-secret" data-testid="minted-api-token">
        <div class="lp-connect-alert">
            <twig:ux:icon name="lucide:triangle-alert" class="lp-connect-alert__icon w-4 h-4" />
            <p class="lp-connect-alert__text">{{ 'account.api_token.one_time_warning'|trans }}</p>
        </div>
        <div class="lp-connect-field" data-controller="clipboard" data-clipboard-text-value="{{ mintedApiToken }}"
             data-clipboard-copied-label-value="{{ 'account.api_token.copied'|trans }}">
            <twig:ux:icon name="lucide:key-round" class="lp-connect-field__glyph w-4 h-4" />
            <code class="lp-connect-field__value" data-testid="minted-api-token-value">{{ mintedApiToken }}</code>
            <button type="button" class="lp-btn lp-btn--ghost lp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.api_token.copy'|trans }}</button>
        </div>

        {%- set loginCommand = 'loupe login --url ' ~ app.request.schemeAndHttpHost ~ ' --token ' ~ mintedApiToken -%}
        <p class="lp-eyebrow">{{ 'account.api_token.cli.label'|trans }}</p>
        <div class="lp-connect-field" data-controller="clipboard" data-clipboard-text-value="{{ loginCommand }}"
             data-clipboard-copied-label-value="{{ 'account.api_token.copied'|trans }}">
            <twig:ux:icon name="lucide:code" class="lp-connect-field__glyph w-4 h-4" />
            <code class="lp-connect-field__value" data-testid="minted-api-token-command">{{ loginCommand }}</code>
            <button type="button" class="lp-btn lp-btn--ghost lp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.api_token.copy'|trans }}</button>
        </div>
        <p class="lp-connect-hint">{{ 'account.api_token.cli.hint'|trans }}</p>
    </div>
    {% endif %}

    {% for token in view.apiTokens %}
    <div class="lp-identity-row" data-token-id="{{ token.id }}">
        <twig:ux:icon name="lucide:key-round" class="lp-identity-row__glyph w-4 h-4" />
        <span class="lp-identity-row__text">
            <span class="lp-identity-row__name lp-identity-row__name--mono">
                {%- if token.tokenTail -%}
                    {{ 'account.api_token.mask'|trans({'%tail%': token.tokenTail}) }}
                {%- else -%}
                    {{ token.label }}
                {%- endif -%}
            </span>
            <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                {{ token.label }} ·
                {{ ('account.api_token.scope.choice.' ~ token.scope.value|replace({'-': '_'}))|trans }} ·
                {{ 'account.api_token.created'|trans({'%date%': token.createdAt|date('M j, Y')}) }}
            </span>
        </span>
        <div data-controller="modal">
            <button type="button" class="lp-btn lp-btn--danger-ghost lp-btn--sm" data-action="click->modal#open">{{ 'account.api_token.action.revoke'|trans }}</button>
            <dialog class="lp-dialog" data-modal-target="dialog" aria-labelledby="revoke-token-title-{{ token.id }}" data-action="cancel->modal#close">
                <h2 class="lp-dialog-title" id="revoke-token-title-{{ token.id }}">{{ 'account.api_token.revoke.title'|trans }}</h2>
                <p class="lp-dialog-desc">{{ 'account.api_token.revoke.description'|trans({'%label%': token.label}) }}</p>
                <form method="post" action="{{ path('app_api_token_revoke', {tokenId: token.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-api-token') }}">
                    <input type="hidden" name="returnTo" value="{{ path('app_account_api_tokens') }}">
                    <div class="lp-dialog-actions">
                        <button type="button" class="lp-btn lp-btn--ghost" data-action="click->modal#close">{{ 'account.api_token.revoke.cancel'|trans }}</button>
                        <button type="submit" class="lp-btn lp-btn--danger">{{ 'account.api_token.revoke.confirm'|trans }}</button>
                    </div>
                </form>
            </dialog>
        </div>
    </div>
    {% else %}
    <p class="lp-connect-hint" data-testid="api-tokens-empty">{{ 'account.settings.api_tokens.empty'|trans }}</p>
    {% endfor %}

    {# The action is set here rather than left to default: a FormView carries
       no action, and the page it renders on is GET-only. #}
    {{ form_start(mintForm, {action: path('app_api_token_mint'), method: 'post', attr: {'class': 'lp-form', 'data-testid': 'mint-api-token-form'}}) }}
        {{ form_errors(mintForm) }}
        <div class="lp-form-field">
            {{ form_label(mintForm.label, null, {'label_attr': {'class': 'lp-label'}}) }}
            {{ form_widget(mintForm.label, {'attr': {'class': 'lp-input'}}) }}
            <div class="lp-field-errors">{{ form_errors(mintForm.label) }}</div>
        </div>
        <div class="flex items-center justify-end pt-2">
            <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.settings.api_tokens.mint_button'|trans }}</button>
        </div>
    {{ form_end(mintForm) }}
    <p class="lp-connect-hint">{{ 'account.settings.api_tokens.mint_hint'|trans }}</p>
</section>
{% endblock %}
