{# The card form, shared by create and edit. Props: form, action, submitLabel,
   busyLabel, cancelUrl, cancelLeavesFrame (Cancel closes the card drawer rather
   than loading cancelUrl inside it), card (the card edited, or null), saved. #}
{% set formAttributes = {
    class: 'lp-form',
    'data-card-drawer-saves-card': '',
    'data-controller': 'submit-feedback',
    'data-submit-feedback-saved-label-value': 'board.card.form.saved'|trans,
} %}
{% set formAttributes = formAttributes|merge(card ? {'data-card-drawer-card-id': card.id} : {'data-card-drawer-creates-card': ''}) %}
{% if saved %}{% set formAttributes = formAttributes|merge({'data-submit-feedback-saved-value': 'true'}) %}{% endif %}
{{ form_start(form, {action: action, attr: formAttributes}) }}
    <twig:Ds:FieldErrors :fieldView="form" />

    <twig:Ds:FormField :fieldView="form.title" />

    <div class="lp-card-form-row">
        <twig:Ds:FormField :fieldView="form.type" widgetKind="select" />
        <twig:Ds:FormField :fieldView="form.column" widgetKind="select" />
    </div>

    <twig:Ds:FormField data-card-parent>
        {{ form_label(form.parent, null, {label_attr: {class: ds_label_class()}}) }}
        {{ form_widget(form.parent, {attr: {class: ds_input_class()}}) }}
        {{ form_help(form.parent) }}
        <twig:Ds:FieldErrors :fieldView="form.parent" />
    </twig:Ds:FormField>

    <twig:Ds:FormField>
        {{ form_label(form.body, null, {label_attr: {class: ds_label_class()}}) }}
        {{ form_widget(form.body, {attr: {class: ds_input_class('textarea') ~ ' lp-card-form-textarea'}}) }}
        {{ form_help(form.body) }}
        <twig:Ds:FieldErrors :fieldView="form.body" />
    </twig:Ds:FormField>

    <twig:Ds:FormField>
        {{ form_label(form.pullRequestUrls, null, {label_attr: {class: ds_label_class()}}) }}
        {{ form_widget(form.pullRequestUrls, {attr: {class: ds_input_class('textarea') ~ ' lp-card-form-textarea'}}) }}
        {{ form_help(form.pullRequestUrls) }}
        <twig:Ds:FieldErrors :fieldView="form.pullRequestUrls" />
    </twig:Ds:FormField>

    {% set linkRows = form.relatedCards %}
    {% set linkPrototype %}{% include '@Board/_card_link_row_fields.html.twig' with {row: linkRows.vars.prototype} only %}{% endset %}
    <twig:Ds:FormField as="fieldset" data-card-links data-controller="form-collection" data-form-collection-collection-holder-id-value="{{ linkRows.vars.id }}_rows">
        <twig:Ds:Label as="legend">{{ linkRows.vars.label|trans }}</twig:Ds:Label>
        <twig:Ds:Hint id="{{ linkRows.vars.id }}_help">{{ linkRows.vars.help|trans }}</twig:Ds:Hint>
        <div id="{{ linkRows.vars.id }}_rows" class="lp-card-link-rows" data-prototype="{{ linkPrototype|e('html_attr') }}" data-index="{{ linkRows|length > 0 ? max(linkRows|keys) + 1 : 0 }}">
            {%- for row in linkRows %}
                <div class="lp-card-link-row" data-form-collection-row data-card-link-row>
                    {% include '@Board/_card_link_row_fields.html.twig' with {row: row} only %}
                    <twig:Ds:Button variant="ghost icon" type="button" aria-label="{{ 'board.card.form.linked_cards.remove'|trans }}" data-action="form-collection#removeRow"><twig:ux:icon name="lucide:x" class="w-4 h-4" /></twig:Ds:Button>
                </div>
            {% endfor -%}
        </div>
        <twig:Ds:FieldErrors :fieldView="linkRows" />
        <div>
            <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="form-collection#addRow"><twig:ux:icon name="lucide:plus" class="w-4 h-4" />{{ 'board.card.form.linked_cards.add'|trans }}</twig:Ds:Button>
        </div>
        <template data-form-collection-target="removeButtonTemplate">
            <twig:Ds:Button variant="ghost icon" type="button" aria-label="{{ 'board.card.form.linked_cards.remove'|trans }}"><twig:ux:icon name="lucide:x" class="w-4 h-4" /></twig:Ds:Button>
        </template>
    </twig:Ds:FormField>
    {% do linkRows.setRendered %}

    <div class="flex items-center justify-end gap-3 pt-2">
        <twig:Ds:Button variant="ghost" class="mr-auto" href="{{ cancelUrl }}" :data-turbo-frame="cancelLeavesFrame ? '_top' : null" :data-action="cancelLeavesFrame ? 'card-drawer#close' : null">{{ 'board.card.form.cancel'|trans }}</twig:Ds:Button>
        <twig:Ds:Button variant="primary" type="submit" data-turbo-submits-with="{{ busyLabel|trans }}" data-submit-feedback-target="button">{{ submitLabel|trans }}</twig:Ds:Button>
    </div>
    <p class="sr-only" role="status" data-submit-feedback-target="status"></p>

    {% if card %}
        {{ form_widget(form.contentFingerprint) }}
        {# After the Save button, so Enter in a field never submits Save anyway.
           The server shows it for a refused save, and the drawer for a change it hears of. #}
        <div class="lp-card-clash" role="alert" data-card-drawer-target="clash"{% if form.contentFingerprint.vars.errors is empty %} hidden{% endif %}>
            <span class="lp-card-clash__message">{{ 'board.card.error.changed_since_opened'|trans }}</span>
            <twig:Ds:Button variant="ghost" size="sm" href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}">{{ 'board.card.form.view_latest'|trans }}</twig:Ds:Button>
            {{ form_widget(form.confirmOverwrite, {attr: {class: ds_button_class(null, 'sm'), 'data-turbo-submits-with': busyLabel|trans}}) }}
        </div>
    {% endif %}
{{ form_end(form) }}
