{# One card placed on the board page, read by the board-place stream action.
   Props: cardId (string), placement (CardPlacementView). #}
{% set card = placement.card %}
{% set history = {} %}
{% for columnId, total in placement.terminalTotals %}
    {% set history = history|merge({(columnId): 'board.terminal.history_link'|trans({'%count%': total})}) %}
{% endfor %}
<turbo-stream action="board-place" target="board-card-{{ cardId }}"
              data-counts="{{ placement.counts|json_encode }}"
              data-history="{{ history|json_encode }}"
              data-history-totals="{{ placement.terminalTotals|json_encode }}"
              {% if placement.laneCounts is not empty %}data-lane-counts="{{ placement.laneCounts|json_encode }}"{% endif %}
              {% if placement.laneEpic %}data-lane-epic="1"{% elseif placement.lane is not null %}data-lane="{{ placement.lane }}"{% endif %}
              {% if card is null %}data-removed="1"{% else %}data-column-id="{{ placement.column.id }}"
              data-after="{{ placement.after }}"
              data-row-after="{{ placement.rowAfter }}"{% endif %}>
    <template>
        {% if card is not null %}
            {% set runWarning = card_run_warnings(card.project)[card.id ~ '']|default(null) %}
            {% include '@Board/_card.html.twig' with {card: card, pendingComments: placement.pendingComments, documentCount: placement.documentCount, progress: placement.progress, inLane: placement.lane is not null and placement.lane != 'other', runWarning: runWarning} only %}
            {% include '@Board/_card_row.html.twig' with {card: card, column: placement.column, feedbackCount: placement.pendingComments, documentCount: placement.documentCount, progress: placement.progress, runWarning: runWarning} only %}
        {% endif %}
    </template>
</turbo-stream>
