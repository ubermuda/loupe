{% extends 'base.html.twig' %}

{% block title %}{{ 'account.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ 'nav.link.account'|trans }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'account.settings.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-account">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'account.settings.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'account.settings.page.description'|trans }}</p>
        </div>
    </header>

    <div class="lp-account-settings-layout" data-controller="panel-tabs" data-panel-tabs-active-value="profile">
    <nav class="lp-section-tabs" aria-label="{{ 'account.settings.nav.label'|trans }}" role="tablist">
        <button type="button" class="lp-section-tabs__item" id="account-tab-profile" role="tab" aria-controls="profile" data-panel-tabs-target="tab" data-panel-tab="profile" data-action="click->panel-tabs#select keydown->panel-tabs#keydown"><twig:ux:icon name="lucide:users" />{{ 'account.settings.nav.profile'|trans }}</button>
        <button type="button" class="lp-section-tabs__item" id="account-tab-api-tokens" role="tab" aria-controls="api-tokens" data-panel-tabs-target="tab" data-panel-tab="api-tokens" data-action="click->panel-tabs#select keydown->panel-tabs#keydown"><twig:ux:icon name="lucide:key-round" />{{ 'account.settings.nav.tokens'|trans }}</button>
        <button type="button" class="lp-section-tabs__item" id="account-tab-data" role="tab" aria-controls="data" data-panel-tabs-target="tab" data-panel-tab="data" data-action="click->panel-tabs#select keydown->panel-tabs#keydown"><twig:ux:icon name="lucide:archive" />{{ 'account.settings.nav.data'|trans }}</button>
    </nav>

    <div class="lp-account-settings-content">
    <twig:BillingSummary />

    <section class="lp-connect-block" id="profile" role="tabpanel" aria-labelledby="account-tab-profile" data-panel-tabs-target="panel" data-panel-panel="profile" data-testid="profile-section">
        <h2 class="lp-section-title">{{ 'account.settings.profile.heading'|trans }}</h2>
        <p class="lp-connect-hint">{{ 'account.settings.profile.description'|trans }}</p>
        {{ form_start(profileForm, {'action': path('app_account_profile'), 'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
            <div class="lp-form-field">
                {{ form_label(profileForm.fullName, null, {'label_attr': {'class': 'lp-label'}}) }}
                {{ form_widget(profileForm.fullName, {'attr': {'class': 'lp-input'}}) }}
                <div class="lp-field-errors">{{ form_errors(profileForm.fullName) }}</div>
            </div>
            <div class="lp-form-field">
                <label class="lp-label" for="account-profile-email">{{ 'account.settings.profile.email_label'|trans }}</label>
                <input class="lp-input" id="account-profile-email" type="email" value="{{ view.user.email }}" readonly>
                <p class="lp-form-hint">{{ 'account.settings.profile.email_hint'|trans }}</p>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.profile.save_button'|trans }}</button>
            </div>
        {{ form_end(profileForm) }}
    </section>

    <section class="lp-connect-block" id="data" role="tabpanel" aria-labelledby="account-tab-data" data-panel-tabs-target="panel" data-panel-panel="data" data-testid="export-section" hidden>
        <p class="lp-eyebrow">{{ 'account.settings.export.heading'|trans }}</p>
        {# Panelled like the profile block above it: loose on the page the export
           controls read as a leftover rather than a section of the settings. #}
        <div class="lp-settings-panel">
        <p class="lp-connect-hint">{{ 'account.settings.export.intro'|trans }}</p>

        {% for export in view.exports %}
        <div class="lp-identity-row">
            <twig:ux:icon name="lucide:package" class="lp-identity-row__glyph w-4 h-4" />
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name lp-identity-row__name--mono">{{ export.requestedAt|date('Y-m-d H:i') }}</span>
                <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                    {% if export.isExpired %}
                        {{ 'account.settings.export.status.expired'|trans }}
                    {% else %}
                        {{ ('account.settings.export.status.' ~ export.status.value)|trans }}
                    {% endif %}
                </span>
            </span>
            {# Same gate the controller applies, so a rendered link never 404s.
               Turbo off: the response is a streamed ZIP, and a prefetch on hover
               would pull the whole archive down. #}
            {% if export.isDownloadable %}
            <a href="{{ path('app_account_export_download', {id: export.id}) }}"
               class="lp-btn lp-btn--ghost"
               data-turbo="false" data-turbo-prefetch="false">{{ 'account.settings.export.download_link'|trans }}</a>
            {% endif %}
        </div>
        {% endfor %}

        <form method="post" action="{{ path('app_account_export_request') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request-data-export') }}">
            <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.settings.export.request_button'|trans }}</button>
        </form>
        <p class="lp-connect-hint">{{ 'account.settings.export.link_hint'|trans }}</p>
        </div>
    </section>

    <section class="lp-connect-block" id="api-tokens" role="tabpanel" aria-labelledby="account-tab-api-tokens" data-panel-tabs-target="panel" data-panel-panel="api-tokens" data-testid="api-tokens-section" hidden>
        <p class="lp-eyebrow">{{ 'account.settings.api_tokens.heading'|trans }}</p>
        <div class="lp-settings-panel">
        <p class="lp-connect-hint">{{ 'account.settings.api_tokens.intro'|trans }}</p>

        {# The raw value arrives through a dedicated flash key, which base.html.twig
           excludes from the flash strip. It is never stored, so this is the only
           render: a reload shows the masked tail below instead. #}
        {%- set mintedApiToken = app.flashes('minted_api_token')|first -%}
        {% if mintedApiToken %}
        <div class="lp-connect-secret" data-testid="minted-api-token">
            <div class="lp-connect-alert">
                <twig:ux:icon name="lucide:triangle-alert" class="lp-connect-alert__icon w-4 h-4" />
                <p class="lp-connect-alert__text">{{ 'account.api_token.one_time_warning'|trans }}</p>
            </div>
            <div class="lp-connect-field" data-controller="clipboard" data-clipboard-text-value="{{ mintedApiToken }}"
                 data-clipboard-copied-label-value="{{ 'account.api_token.copied'|trans }}">
                <twig:ux:icon name="lucide:key-round" class="lp-connect-field__glyph w-4 h-4" />
                <code class="lp-connect-field__value" data-testid="minted-api-token-value">{{ mintedApiToken }}</code>
                <button type="button" class="lp-btn lp-btn--ghost lp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.api_token.copy'|trans }}</button>
            </div>

            {%- set loginCommand = 'loupe login --url ' ~ app.request.schemeAndHttpHost ~ ' --token ' ~ mintedApiToken -%}
            <p class="lp-eyebrow">{{ 'account.api_token.cli.label'|trans }}</p>
            <div class="lp-connect-field" data-controller="clipboard" data-clipboard-text-value="{{ loginCommand }}"
                 data-clipboard-copied-label-value="{{ 'account.api_token.copied'|trans }}">
                <twig:ux:icon name="lucide:code" class="lp-connect-field__glyph w-4 h-4" />
                <code class="lp-connect-field__value" data-testid="minted-api-token-command">{{ loginCommand }}</code>
                <button type="button" class="lp-btn lp-btn--ghost lp-btn--sm" data-clipboard-target="button" data-action="clipboard#copy">{{ 'account.api_token.copy'|trans }}</button>
            </div>
            <p class="lp-connect-hint">{{ 'account.api_token.cli.hint'|trans }}</p>
        </div>
        {% endif %}

        {% for token in view.apiTokens %}
        <div class="lp-identity-row" data-token-id="{{ token.id }}">
            <twig:ux:icon name="lucide:key-round" class="lp-identity-row__glyph w-4 h-4" />
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name lp-identity-row__name--mono">
                    {%- if token.tokenTail -%}
                        {{ 'account.api_token.mask'|trans({'%tail%': token.tokenTail}) }}
                    {%- else -%}
                        {{ token.label }}
                    {%- endif -%}
                </span>
                <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                    {{ token.label }} ·
                    {{ ('account.api_token.scope.choice.' ~ token.scope.value|replace({'-': '_'}))|trans }} ·
                    {{ 'account.api_token.created'|trans({'%date%': token.createdAt|date('M j, Y')}) }}
                </span>
            </span>
            <form method="post" action="{{ path('app_api_token_revoke', {tokenId: token.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-api-token') }}">
                <input type="hidden" name="returnTo" value="{{ path('app_account_settings') }}">
                <button type="submit" class="lp-btn lp-btn--danger-ghost lp-btn--sm">{{ 'account.api_token.action.revoke'|trans }}</button>
            </form>
        </div>
        {% else %}
        <p class="lp-connect-hint" data-testid="api-tokens-empty">{{ 'account.settings.api_tokens.empty'|trans }}</p>
        {% endfor %}

        {# The action is set here rather than left to default: a FormView carries
           no action, and the page it renders on is GET-only. #}
        {{ form_start(mintForm, {action: path('app_api_token_mint'), method: 'post', attr: {'class': 'lp-form', 'data-testid': 'mint-api-token-form'}}) }}
            {{ form_errors(mintForm) }}
            <div class="lp-form-field">
                {{ form_label(mintForm.label, null, {'label_attr': {'class': 'lp-label'}}) }}
                {{ form_widget(mintForm.label, {'attr': {'class': 'lp-input'}}) }}
                <div class="lp-field-errors">{{ form_errors(mintForm.label) }}</div>
            </div>
            <div class="flex items-center justify-end pt-2">
                <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.settings.api_tokens.mint_button'|trans }}</button>
            </div>
        {{ form_end(mintForm) }}
        <p class="lp-connect-hint">{{ 'account.settings.api_tokens.mint_hint'|trans }}</p>
        </div>
    </section>

    <section class="lp-danger-zone" role="tabpanel" aria-labelledby="account-tab-data" data-panel-tabs-target="panel" data-panel-panel="data" data-testid="delete-account-section" hidden>
        <h2 class="lp-danger-zone-title">{{ 'account.delete.danger.heading'|trans }}</h2>
        <p class="lp-danger-zone-desc">{{ 'account.delete.danger.body'|trans }}</p>
        <form method="post" action="{{ path('app_account_delete_request') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request-account-deletion') }}">
            <button type="submit" class="lp-btn lp-btn--danger">{{ 'account.delete.danger.cta'|trans }}</button>
        </form>
    </section>
    </div>
    </div>
</div>
{% endblock %}
