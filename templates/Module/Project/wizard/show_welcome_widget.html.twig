{% extends 'base.html.twig' %}

{% block title %}{{ 'project.wizard.widget.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="lp-workspace">
    {% include '@Project/wizard/_wizard_progress.html.twig' with {step: 3} only %}

    <h1 class="lp-workspace-title">{{ 'project.wizard.widget.heading'|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'project.wizard.widget.lead'|trans }}</p>

    <div class="flex flex-col gap-5">
        <section class="lp-connect-step">
            <div class="lp-connect-step__header">
                <span class="lp-connect-step__badge">1</span>
                <div>
                    <h2 class="lp-connect-step__heading">{{ 'project.wizard.widget.step.embed.heading'|trans }}</h2>
                    <p class="lp-connect-step__purpose">
                        {%- if wizardProject.domain -%}
                            {{ 'project.connect.step.widget.purpose'|trans({'%domain%': wizardProject.domain}) }}
                        {%- else -%}
                            {{ 'project.connect.step.widget.purpose_no_domain'|trans }}
                        {%- endif -%}
                    </p>
                </div>
            </div>

            {%- set widgetSnippet = '<script src="' ~ absolute_url('/site-review/widget.js') ~ '" data-project="' ~ wizardProject.id ~ '"></script>' -%}
            <div class="lp-connect-block">
                <p class="lp-eyebrow">{{ 'project.connect.widget.eyebrow'|trans }}</p>
                <div class="lp-code-dark" data-controller="clipboard" data-clipboard-text-value="{{ widgetSnippet }}"
                     data-clipboard-copied-label-value="{{ 'project.connect.copied'|trans }}">
                    <div class="lp-code-dark__header">
                        <span class="lp-code-dark__label">{{ 'project.token.snippet_heading'|trans }}</span>
                        <button type="button" class="lp-code-dark__copy" data-clipboard-target="button" data-action="clipboard#copy">{{ 'project.connect.copy'|trans }}</button>
                    </div>
                    <pre class="lp-code-dark__body"><code data-testid="wizard-widget-snippet">{{ widgetSnippet }}</code></pre>
                </div>
            </div>
        </section>
    </div>

    <div class="flex items-center justify-end gap-3 pt-2">
        <form method="POST" action="{{ path('app_welcome_skip') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('wizard-skip') }}">
            <button type="submit" class="lp-btn lp-btn--ghost">{{ 'project.wizard.skip'|trans }}</button>
        </form>
        <a class="lp-btn lp-btn--primary" href="{{ path('app_welcome_done') }}">{{ 'project.wizard.connect.continue'|trans }}</a>
    </div>
</div>
{% endblock %}
