{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.reset_password.request.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.reset_password.request.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.reset_password.request.subheading'|trans }}</p>
</div>

{{ form_start(form, {'attr': {'class': 'form-stack', 'novalidate': 'novalidate'}}) }}
    <div class="form-field">
        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.email, {'attr': {
            'class': 'auth-input',
            'autofocus': 'autofocus',
            'placeholder': 'account.form.reset_password_request_form.email.placeholder',
        }}) }}
        <div class="field-errors">{{ form_errors(form.email) }}</div>
    </div>
    <button type="submit" class="auth-submit">{{ 'account.form.reset_password_request_form.submit'|trans }}</button>
{{ form_end(form) }}

<div class="text-center">
    <a href="{{ path('app_login') }}" class="text-xs text-accent hover:underline">{{ 'account.reset_password.request.back'|trans }}</a>
</div>
{% endblock %}
