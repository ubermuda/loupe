{#
  The review screen, cropped: the centred text column with its byline, and a
  comment thread opened over its passage. Sample data, decorative — hence
  aria-hidden.
#}
<div class="lp-tech-still" aria-hidden="true">
    <div class="lp-tech-panel">
        <div class="lp-review-doc__head">
            <h1 class="lp-review-doc__title">{{ 'landing.tech.still.doc_title'|trans }}</h1>
            <div class="lp-review-doc__byline">
                <span class="lp-review-doc__author">
                    <span class="lp-review-doc__avatar">{{ 'landing.mock.reviewer'|trans|slice(0, 1)|upper }}</span>
                    {{ 'landing.mock.reviewer'|trans }}
                </span>
                <span class="lp-review-doc__middot">·</span>
                <span>{{ 'review.document.byline_updated'|trans({'%updated%': 'landing.mock.document.updated'|trans}) }}</span>
                <span class="lp-review-doc__middot">·</span>
                <span class="lp-review-doc__version">{{ 'landing.tech.still.version'|trans }}</span>
            </div>
        </div>

        <div class="lp-tech-panel__body">
            <div class="lp-review-doc__prose">
                <h3>{{ 'landing.tech.still.doc_heading'|trans }}</h3>
                <p>
                    {{ 'landing.tech.still.doc_before'|trans }}
                    <span class="lp-anchor">{{ 'landing.tech.still.doc_quote'|trans }}</span>{{ 'landing.tech.still.doc_after'|trans }}
                </p>
            </div>

            <div class="lp-comment-thread lp-tech-panel__thread">
                <div class="lp-comment-thread__top">
                    <div class="lp-comment-thread__header">
                        <span class="lp-comment-avatar">{{ 'landing.mock.reviewer'|trans|slice(0, 1)|upper }}</span>
                        <span class="lp-comment-author">{{ 'landing.mock.reviewer'|trans }}</span>
                        <span class="lp-comment-status">{{ 'landing.tech.still.reanchored'|trans }}</span>
                    </div>
                </div>
                <div class="lp-comment-body">{{ 'landing.tech.still.comment_body'|trans }}</div>
            </div>
        </div>
    </div>
</div>
