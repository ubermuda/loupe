{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: inbox.project.id}) }}">{{ inbox.project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'inbox.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-needs-you lp-core-prototype-page lp-core-inbox">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'inbox.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'inbox.page.description'|trans }}</p>
        </div>
        <div class="lp-needs-you__header-actions">
            {% if not inbox.isSearch %}
            <span class="lp-needs-you__summary">{{ 'inbox.page.open_summary'|trans({'%count%': inbox.openAsks|length + inbox.looseItems|length}) }}</span>
            {% endif %}
            <a class="lp-btn" href="{{ path('app_project_activity', {id: inbox.project.id}) }}">
                <twig:ux:icon name="lucide:activity" class="w-4 h-4" />
                {{ 'inbox.activity'|trans }}
            </a>
        </div>
    </header>

    {% if not inbox.isEmpty and not inbox.isSearch %}
    <nav class="lp-section-tabs" aria-label="{{ 'inbox.tabs.label'|trans }}">
        <a class="lp-section-tabs__item{{ inbox.openAsks|length > 0 or inbox.looseItems|length > 0 ? ' lp-section-tabs__item--active' }}" href="#inbox-open">{{ 'inbox.tabs.open'|trans }} <span>{{ inbox.openAsks|length + inbox.looseItems|length }}</span></a>
        <a class="lp-section-tabs__item{{ inbox.openAsks|length == 0 and inbox.looseItems|length == 0 ? ' lp-section-tabs__item--active' }}" href="#inbox-completed">{{ 'inbox.tabs.completed'|trans }} <span>{{ inbox.closedAskTotal }}</span></a>
    </nav>
    {% endif %}

    {% if not inbox.isEmpty %}
    <div class="lp-list-filters">
        {# A GET form, so the search lands in the URL. A new search starts at page one. #}
        <form method="get"
              action="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
              data-controller="autosearch"
              class="lp-filter-form">
            <div class="lp-filter-search">
                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                <label class="sr-only" for="inbox-search">{{ 'inbox.search.label'|trans }}</label>
                <input type="search"
                       id="inbox-search"
                       name="q"
                       class="lp-input lp-filter-input"
                       value="{{ inbox.query }}"
                       placeholder="{{ 'inbox.search.placeholder'|trans }}"
                       data-autosearch-target="field"
                       data-action="input->autosearch#search">
            </div>
            <a href="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
               data-autosearch-target="clearButton"
               class="lp-filter-clear">{{ 'inbox.search.clear'|trans }}</a>
        </form>
        {% if inbox.isSearch %}
        <span class="lp-filter-count">{{ 'inbox.search.count'|trans({'%count%': inbox.searchTotal}) }}</span>
        {% endif %}
    </div>
    {% endif %}

    {% if inbox.isSearch %}
        {% if inbox.searchResults|length > 0 %}
        <section class="lp-inbox-section" data-inbox-section="search-results">
            <div class="lp-inbox-ask__items">
                {% for item in inbox.searchResults %}
                    {% include '@Inbox/_inbox_item.html.twig' with {item: item, ask: null, inbox: inbox, refusedForm: refusedForm, showLinkedItems: true} only %}
                {% endfor %}
            </div>
            <twig:Pagination route="app_project_inbox" :page="inbox.page" :totalPages="inbox.totalPages" :pageList="inbox.pageList" :routeParams="{id: inbox.project.id, q: inbox.query}" />
        </section>
        {% else %}
        <div class="lp-empty-state" data-inbox-search-empty>
            <twig:ux:icon name="lucide:search" class="lp-empty-state__icon text-accent w-12 h-12" />
            <h2 class="lp-empty-state__title">{{ 'inbox.search.empty'|trans }}</h2>
        </div>
        {% endif %}
    {% elseif inbox.isEmpty %}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:inbox" class="lp-empty-state__icon text-accent w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'inbox.page.empty'|trans }}</h2>
    </div>
    {% else %}
        {% if inbox.openAsks|length > 0 %}
        <section class="lp-inbox-section lp-inbox-section--open" id="inbox-open" data-inbox-section="open-asks">
            <h2 class="lp-inbox-section__title">{{ 'inbox.section.open_asks'|trans({'%count%': inbox.openAsks|length}) }}</h2>
            <div class="lp-inbox-split" data-controller="panel-tabs" data-panel-tabs-active-value="{{ inbox.openAsks|first.id }}">
                <div class="lp-inbox-request-list" role="tablist" aria-label="{{ 'inbox.section.open_asks'|trans({'%count%': inbox.openAsks|length}) }}">
                    {% for ask in inbox.openAsks %}
                        {% set firstItem = ask.items|first.item %}
                        <button type="button"
                                class="lp-inbox-request"
                                role="tab"
                                id="inbox-request-{{ ask.id }}"
                                aria-controls="inbox-ask-{{ ask.id }}"
                                data-panel-tabs-target="tab"
                                data-panel-tab="{{ ask.id }}"
                                data-action="click->panel-tabs#select keydown->panel-tabs#keydown">
                            <span class="lp-inbox-request__byline">
                                <span class="lp-source-avatar" aria-hidden="true"><twig:ux:icon name="lucide:bot" class="w-4 h-4" /></span>
                                <strong>{{ 'inbox.source.agent'|trans }}</strong>
                                <time datetime="{{ ask.createdAt|date('c') }}">{{ ask.createdAt|relative_time }}</time>
                            </span>
                            <span class="lp-inbox-request__title">{{ firstItem.title }}</span>
                            {% if firstItem.body %}<span class="lp-inbox-request__body">{{ firstItem.body }}</span>{% endif %}
                            <span class="lp-inbox-request__badges">
                                <span class="lp-inbox-item__kind">{{ ('inbox.item.kind.' ~ firstItem.kind.value)|trans }}</span>
                                {% if firstItem.blocking %}<span class="lp-inbox-item__blocking">{{ 'inbox.item.blocking'|trans }}</span>{% endif %}
                            </span>
                        </button>
                    {% endfor %}
                </div>
                <div class="lp-inbox-request-detail">
                    {% for ask in inbox.openAsks %}
                        {% include '@Inbox/_inbox_ask.html.twig' with {ask: ask, inbox: inbox, refusedForm: refusedForm, showLinkedItems: true, tabPanel: true, hidden: not loop.first} only %}
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if inbox.looseItems|length > 0 %}
        <section class="lp-inbox-section lp-inbox-section--open"{% if inbox.openAsks|length == 0 %} id="inbox-open"{% endif %} data-inbox-section="loose-items">
            <h2 class="lp-inbox-section__title">{{ 'inbox.section.loose_items'|trans({'%count%': inbox.looseItems|length}) }}</h2>
            <p class="lp-inbox-section__note">{{ 'inbox.section.loose_items_note'|trans }}</p>
            <div class="lp-inbox-ask__items">
                {% for item in inbox.looseItems %}
                    {% include '@Inbox/_inbox_item.html.twig' with {item: item, ask: null, inbox: inbox, refusedForm: refusedForm, showLinkedItems: true} only %}
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% if inbox.closedAskTotal > 0 %}
        <section class="lp-inbox-section lp-inbox-section--completed" id="inbox-completed" data-inbox-section="closed-asks">
            <h2 class="lp-inbox-section__title">{{ 'inbox.section.closed_asks'|trans({'%count%': inbox.closedAskTotal}) }}</h2>
            {% for ask in inbox.closedAsks %}
                {% include '@Inbox/_inbox_ask.html.twig' with {ask: ask, inbox: inbox, refusedForm: refusedForm, showLinkedItems: true} only %}
            {% endfor %}
            <twig:Pagination route="app_project_inbox" :page="inbox.page" :totalPages="inbox.totalPages" :pageList="inbox.pageList" :routeParams="{id: inbox.project.id}" />
        </section>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
