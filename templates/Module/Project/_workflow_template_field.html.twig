<twig:Ds:FormField as="fieldset" data-workflow-template-field>
    <twig:Ds:Label as="legend">{{ field.vars.label|trans }}</twig:Ds:Label>
    {% for choice in field %}
    <twig:Ds:FormField>
        <label class="lp-choice">
            {{ form_widget(choice) }}
            {{ choice.vars.label|trans }}
        </label>
        <twig:Ds:Hint data-workflow-template-description="{{ choice.vars.value }}">{{ choice.vars.description|trans }}</twig:Ds:Hint>
    </twig:Ds:FormField>
    {% endfor %}
    <twig:Ds:FieldErrors :fieldView="field" />
</twig:Ds:FormField>
