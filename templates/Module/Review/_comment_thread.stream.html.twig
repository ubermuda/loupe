{#
  Turbo Stream that replaces one thread's card and its Comments panel row
  after a reply. Rendered by ReplyToCommentController.

  Vars:  @comment-budget-ignore
    comment    Comment            The root comment of the thread to replace.
    replies    list<Comment>      Its direct replies (re-fetched after the mutation).
    replyForm  FormView|null      A reply form with validation errors, or null.
#}
<turbo-stream action="replace" target="comment-thread-{{ comment.id }}">
    <template>
        <twig:CommentThread :comment="comment" :replies="replies" :replyForm="replyForm ?? null" />
    </template>
</turbo-stream>
<turbo-stream action="replace" target="comment-row-{{ comment.id }}">
    <template>
        {% include '@Review/_comment_row.html.twig' with {comment: comment} only %}
    </template>
</turbo-stream>
