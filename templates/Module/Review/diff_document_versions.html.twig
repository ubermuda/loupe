{#
    What changed between two versions, as a page of its own rather than the
    review page with its pane swapped: the diff reads at a wider measure than
    the document, and none of the review page's apparatus — comment margin,
    composer, verdict — applies to it.

    Params: document, version, versions, diff (?DocumentDiff), diffRefusal
    (?DiffRefusal) and diffFromVersion (int).
#}
{% extends 'base.html.twig' %}

{% set documentPath = path('app_document_review', {projectId: document.project.id, documentId: document.id}) %}

{% block title %}{{ 'review.document.diff.page.title'|trans({'%from%': diffFromVersion}) }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: document.project.id}) }}">{{ 'nav.link.documents'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <a class="lp-topbar__crumb" href="{{ documentPath }}">{{ document.title }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'review.document.diff.crumb'|trans }}</span>
    <span class="lp-version-pill">{{ 'v' ~ version.versionNumber }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-workspace--wide">
    <div class="flex items-start justify-between gap-4 mb-8">
        <h1 class="lp-workspace-title">{{ 'review.document.diff.page.title'|trans({'%from%': diffFromVersion}) }}</h1>
        <a class="lp-btn" href="{{ documentPath }}">{{ 'review.document.diff.back'|trans }}</a>
    </div>

    {# What the author said each revision changed, read next to what it actually
       changed. Only the versions the diff spans are listed. #}
    {% set changeNotes = versions|filter(meta =>
        meta.versionNumber > diffFromVersion
        and meta.versionNumber <= version.versionNumber
        and meta.description is not empty
    ) %}
    {% if changeNotes|length > 0 %}
    <aside class="lp-diff-notes">
        <h2 class="lp-diff-notes__title">{{ 'review.document.diff.notes_title'|trans }}</h2>
        {% for meta in changeNotes %}
        <p class="lp-diff-notes__entry">
            <span class="lp-version-pill">{{ 'v' ~ meta.versionNumber }}</span>
            <span>{{ meta.description }}</span>
        </p>
        {% endfor %}
    </aside>
    {% endif %}

    {% if diffRefusal %}
        {# Declining to compare, rather than showing a comparison that describes
           neither version. Each version still reads normally, which is what the
           list above the message points at. #}
        <nav class="lp-version-switcher" aria-label="{{ 'review.document.version.switcher_label'|trans }}">
            {% for meta in versions %}
            <a class="lp-version-pill lp-version-pill--link"
               href="{{ loop.first
                   ? documentPath
                   : path('app_document_review_version', {projectId: document.project.id, documentId: document.id, versionNumber: meta.versionNumber}) }}"
            >{{ 'v' ~ meta.versionNumber }}</a>
            {% endfor %}
        </nav>
        <p class="lp-empty">{{ diffRefusal.translationKey|trans }}</p>
    {% elseif diff.hasChanges %}
        {% include '@Review/_version_diff.html.twig' with {diff: diff} only %}
    {% else %}
        <p class="lp-empty">{{ 'review.document.diff.identical'|trans }}</p>
    {% endif %}
</div>
{% endblock %}
