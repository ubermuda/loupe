{# The toolbar and the panels it switches, in a fixed order. review_panels_controller.js
   applies the reader's stored choice, as `mode` says. Params: mode, showComments,
   decisionsReason and decisionsHint (translation keys), decisionsUrl (null links
   the rows in this page), decisionRows, answeredDecisions, sectionRows, comments,
   canComment, openCommentCount. #}
{% set panelNames = ['decisions']|merge(showComments ? ['comments'] : [])|merge(['outline']) %}
{% set openPanels = {document: ['decisions'], compare: ['decisions', 'outline'], columns: []}[mode] %}
<aside class="lp-review-panels lp-review-panels--{{ mode }}" aria-label="{{ 'review.document.panels.label'|trans }}">
    <div class="lp-review-panels__inner">
        <div class="lp-review-toolbar">
            {% for name in panelNames %}
            {% set reason = name == 'decisions' ? decisionsReason : null %}
            {% set open = name in openPanels and reason is null %}
            <button type="button" class="lp-review-toolbar__button"
                    aria-controls="review-panel-{{ name }}"
                    aria-pressed="{{ open ? 'true' : 'false' }}"
                    {% if reason %}aria-disabled="true"{% endif %}
                    title="{{ reason ? reason|trans : ('review.document.panels.' ~ name)|trans }}"
                    aria-label="{{ name == 'comments' ? 'review.document.panels.comments_label'|trans({'%count%': openCommentCount}) : ('review.document.panels.' ~ name)|trans }}"
                    {% if name == 'comments' %}data-label-template="{{ 'review.document.panels.comments_label'|trans }}"{% endif %}
                    data-review-panels-target="button"
                    data-review-panels-name-param="{{ name }}"
                    data-action="review-panels#toggle">
                {% if name == 'decisions' %}<twig:ux:icon name="lucide:list-checks" />{% endif %}
                {% if name == 'comments' %}<twig:ux:icon name="lucide:message-square" />{% endif %}
                {% if name == 'outline' %}<twig:ux:icon name="lucide:list" />{% endif %}
                {% if name == 'comments' %}<span data-review-panels-target="openCount">{{ openCommentCount }}</span>{% endif %}
            </button>
            {% endfor %}
        </div>

        <section class="lp-review-panel" id="review-panel-decisions" data-review-panels-target="panel" data-review-panel="decisions"
                 data-controller="contents-rail" aria-labelledby="review-panel-decisions-title"{{ decisionsReason is not null or 'decisions' not in openPanels ? ' hidden' }}>
            <div class="lp-review-panel__head">
                <h2 id="review-panel-decisions-title">{{ 'review.document.panels.decisions'|trans }}</h2>
                <span class="lp-review-panel__count" id="decision-summary-count">{{ 'review.document.panels.decisions_count'|trans({'%answered%': answeredDecisions, '%total%': decisionRows|length}) }}</span>
            </div>
            {% if decisionRows|length > 0 %}
            <ul class="lp-decision-summary__list" id="decision-summary-list">
                {% include '@Review/_decision_summary_rows.html.twig' with {rows: decisionRows, documentUrl: decisionsUrl} only %}
            </ul>
            {% if decisionsHint is not null %}<p class="lp-review-panel__hint">{{ decisionsHint|trans }}</p>{% endif %}
            {% elseif decisionsReason is not null %}<p class="lp-review-panel__hint">{{ decisionsReason|trans }}</p>
            {% else %}<p class="lp-review-panel__hint">{{ 'review.document.margin.decisions_empty'|trans }}</p>{% endif %}
        </section>

        {% if showComments %}
        <section class="lp-review-panel" id="review-panel-comments" data-review-panels-target="panel" data-review-panel="comments"
                 aria-labelledby="review-panel-comments-title" hidden>
            <div class="lp-review-panel__head">
                <h2 id="review-panel-comments-title">{{ 'review.document.panels.comments'|trans }}</h2>
                <details class="lp-review-filter" data-review-panels-target="filter" data-action="keydown.esc->review-panels#closeFilter toggle->review-panels#placeFilter">
                    <summary class="lp-review-filter__toggle"
                             aria-label="{{ 'review.document.margin.filter'|trans }}"
                             title="{{ 'review.document.margin.filter'|trans }}">
                        <twig:ux:icon name="lucide:list-filter" />
                        <span data-review-panels-target="filterLabel">{{ 'review.document.margin.filter_open'|trans }} · {{ openCommentCount }}</span>
                    </summary>
                    <div class="lp-review-filter__menu" data-review-panels-target="filterMenu">
                        {% for filterName in ['open', 'resolved', 'unanchored', 'all'] %}
                        <button type="button" data-review-panels-target="option" data-review-panels-filter-param="{{ filterName }}" data-filter-label="{{ ('review.document.margin.filter_' ~ filterName)|trans }}" data-action="review-panels#filter" aria-pressed="{{ filterName == 'open' ? 'true' : 'false' }}">{{ ('review.document.margin.filter_' ~ filterName)|trans }} <span data-filter-count>0</span></button>
                        {% endfor %}
                    </div>
                </details>
            </div>
            <div id="comment-recovery" aria-live="polite"></div>
            {% include '@Review/_comment_rows.html.twig' with {comments: comments} only %}
            {% if canComment %}
            <twig:Ds:Button variant="ghost" type="button" class="lp-comment-whole-document" data-action="comment-anchor#startUntargeted">
                <twig:ux:icon name="lucide:message-square-plus" />
                {{ 'review.document.comment.whole_document'|trans }}
            </twig:Ds:Button>
            {% endif %}
        </section>
        {% endif %}

        <section class="lp-review-panel" id="review-panel-outline" data-review-panels-target="panel" data-review-panel="outline"
                 data-panel="contents" data-controller="contents-rail" aria-labelledby="review-panel-outline-title"{{ 'outline' not in openPanels ? ' hidden' }}>
            <div class="lp-review-panel__head">
                <h2 id="review-panel-outline-title">{{ 'review.document.panels.outline_heading'|trans }}</h2>
            </div>
            {% if sectionRows|length > 0 %}
            <ul class="lp-review-contents__list" id="section-summary-list">
                {% include '@Review/_contents_rows.html.twig' with {rows: sectionRows} only %}
            </ul>
            {% else %}<p class="lp-review-panel__hint">{{ 'review.document.margin.outline_empty'|trans }}</p>{% endif %}
        </section>
    </div>
</aside>
