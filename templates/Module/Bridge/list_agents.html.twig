{% extends 'base.html.twig' %}

{% block title %}{{ 'bridge.agents.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_workshop', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'bridge.agents.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-orchestration-page lp-redesign-secondary lp-redesign-agents">
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'bridge.agents.page_heading'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'bridge.agents.description'|trans }}</p>
        </div>
        <twig:Ds:Button href="{{ path('app_project_connect', {id: project.id}) }}">
            <twig:ux:icon name="lucide:cable" />
            {{ 'bridge.agents.connection'|trans }}
        </twig:Ds:Button>
    </header>

    {% set pauseFlashes = app.flashes('bridge-pause') %}
    {% if pauseFlashes is not empty %}
    <div class="lp-agent-flashes" data-bridge-pause-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: pauseFlashes}} only %}
    </div>
    {% endif %}

    {% do mercure_subscribe(worker_runs_topic(project)) %}
    {% set canManage = is_granted('project.manage', project) %}
    <div class="lp-live-frame" data-controller="worker-run-refresh">
    <turbo-frame id="agents-frame" class="lp-live-frame" target="_top" data-worker-run-refresh-target="frame">
    {% if connections is not empty %}
    <div class="lp-agent-grid">
        {% for connection in connections %}
        {% set bridge = connection.bridge %}
        <article class="lp-agent-card" id="agent-connection-{{ bridge.id }}" data-agent-connection-id="{{ bridge.id }}" tabindex="-1">
            <div class="lp-agent-card__art">
                <span data-agent-health data-agent-health-state="{{ connection.healthChip.state }}" class="lp-status-chip lp-status-chip--{{ connection.healthChip.tone }}">
                    <span class="lp-status-chip__dot"></span>
                    {{ connection.healthChip.label|trans }}
                </span>
                <twig:ux:icon name="lucide:bot" />
            </div>
            <div class="lp-agent-card__body"{% if connection.updateChip and connection.updateChip.command %} data-controller="disclosure"{% endif %}>
                <div class="lp-agent-card__heading">
                    <div>
                        <p class="lp-agent-card__eyebrow">{{ 'bridge.agents.connection_label'|trans }}</p>
                        <h2 class="lp-agent-card__name"><span title="{{ bridge.id }}" data-bridge-label>{{ bridge.label }}</span></h2>
                    </div>
                    {% if canManage %}
                    <div class="lp-agent-card__menu" data-agent-menu data-controller="popover">
                        <twig:Ds:Button type="button" variant="icon"
                                aria-label="{{ 'bridge.agents.menu'|trans }}"
                                aria-expanded="false"
                                aria-controls="agent-menu-{{ bridge.id }}"
                                data-popover-target="trigger"
                                data-action="click->popover#toggle">
                            <twig:ux:icon name="lucide:ellipsis" class="size-4" />
                        </twig:Ds:Button>
                        <div id="agent-menu-{{ bridge.id }}" class="lp-backlog-menu" data-popover-target="panel" hidden>
                            {% if bridge.pauseRequested or bridge.takesCommands() %}
                            {% set action = bridge.pauseRequested ? 'unpause' : 'pause' %}
                            <form method="post" action="{{ path(action == 'pause' ? 'app_project_bridge_pause' : 'app_project_bridge_unpause', {id: project.id, bridgeId: bridge.id}) }}" data-turbo-frame="_top" data-agent-pause-control="{{ action }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('bridge-pause') }}">
                                <button type="submit" class="lp-backlog-menu__item">
                                    {% if action == 'pause' %}<twig:ux:icon name="lucide:circle-pause" class="size-4" />{% else %}<twig:ux:icon name="lucide:circle-play" class="size-4" />{% endif %}
                                    {{ (action == 'pause' ? 'bridge.agents.pause' : 'bridge.agents.unpause')|trans }}
                                </button>
                            </form>
                            {% else %}
                            {% set reason = 'bridge.agents.pause_outdated'|trans({'%version%': constant('App\\Module\\Bridge\\View\\WorkerRunControls::COMMANDS_SINCE_VERSION')}) %}
                            <button type="button" class="lp-backlog-menu__item" title="{{ reason }}" data-agent-pause-control="pause" disabled>
                                <twig:ux:icon name="lucide:circle-pause" class="size-4" />
                                {{ 'bridge.agents.pause'|trans }}
                                <span class="sr-only">{{ reason }}</span>
                            </button>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                </div>
                <p class="lp-agent-card__purpose">{{ 'bridge.agents.project_connection'|trans({'%project%': project.name}) }}</p>
                <div class="lp-agent-card__current">
                    <span>{{ 'bridge.agents.last_seen'|trans }}</span>
                    <strong>{{ connection.status.lastSeenAt ? connection.status.lastSeenAt|date('M j, H:i') : 'bridge.agents.never'|trans }}</strong>
                </div>
                {% if bridge.nameClashes() %}
                <div class="lp-agent-card__current lp-agent-card__name-clash" data-agent-name-clash>
                    <span>{{ 'bridge.agents.name_clash.label'|trans }}</span>
                    <strong>{{ bridge.requestedName }}</strong>
                    <p class="lp-agent-card__name-clash-hint">{{ 'bridge.agents.name_clash.description'|trans }}</p>
                </div>
                {% endif %}
                {% if bridge.pauseRequested %}
                <div class="lp-agent-card__current lp-agent-card__paused" data-agent-paused>
                    <span>{{ (bridge.pausedReported ? 'bridge.agents.paused' : 'bridge.agents.pause_requested')|trans }}</span>
                    {% if bridge.pauseRequestedAt %}
                    {% set pausedAt = bridge.pauseRequestedAt|date('M j, H:i') %}
                    <strong>{{ bridge.pauseRequestedBy ? 'bridge.agents.paused_by'|trans({'%time%': pausedAt, '%person%': bridge.pauseRequestedBy.fullName ?: bridge.pauseRequestedBy.email}) : pausedAt }}</strong>
                    {% endif %}
                </div>
                {% endif %}
                {% if connection.bridge.workerPools is not empty %}
                <div class="lp-agent-card__current lp-agent-card__pools" data-agent-worker-pools>
                    <span>{{ 'bridge.agents.worker_pools.heading'|trans }}{% if connection.bridge.workerPoolsReportedAt %} · {{ 'bridge.agents.worker_pools.as_of'|trans({'%time%': connection.bridge.workerPoolsReportedAt|date('M j, H:i')}) }}{% endif %}</span>
                    {% for pool in connection.bridge.workerPools %}
                    <p class="lp-agent-card__pool" data-agent-worker-pool>
                        <strong>{{ pool.name }}</strong>
                        <span>{{ 'bridge.agents.worker_pools.in_use'|trans({'%inUse%': pool.inUse, '%size%': pool.size}) }} · {{ 'bridge.agents.worker_pools.queued'|trans({'%queued%': pool.queued}) }}</span>
                    </p>
                    {% endfor %}
                </div>
                {% endif %}
                <footer>
                    <span>{{ connection.bridge.cliVersion|short_sha }}</span>
                    {% if connection.updateChip and connection.updateChip.command %}
                    <button type="button" data-agent-update class="lp-status-chip lp-status-chip--{{ connection.updateChip.tone }} lp-agent-update-toggle"
                            data-action="disclosure#toggle" data-disclosure-target="trigger" aria-controls="agent-update-{{ connection.bridge.id }}">
                        <span class="lp-status-chip__dot"></span>
                        {{ connection.updateChip.label|trans(connection.updateChip.parameters) }}
                        <twig:ux:icon name="lucide:chevron-down" class="lp-agent-update-toggle__caret" />
                    </button>
                    {% elseif connection.updateChip %}
                    <span data-agent-update class="lp-status-chip lp-status-chip--{{ connection.updateChip.tone }}">
                        <span class="lp-status-chip__dot"></span>
                        {{ connection.updateChip.label|trans(connection.updateChip.parameters) }}
                    </span>
                    {% endif %}
                    <span>{{ 'bridge.agents.runtime'|trans }}</span>
                </footer>
                {% if connection.updateChip and connection.updateChip.command %}
                <div id="agent-update-{{ connection.bridge.id }}" class="lp-connect-field lp-agent-update-command" data-disclosure-target="content" data-controller="clipboard" data-clipboard-text-value="{{ connection.updateChip.command }}"
                     data-clipboard-copied-label-value="{{ 'project.connect.copied'|trans }}">
                    <twig:ux:icon name="lucide:terminal" class="lp-connect-field__glyph w-4 h-4" />
                    <code class="lp-connect-field__value" data-agent-update-command>{{ connection.updateChip.command }}</code>
                    <twig:Ds:Button variant="ghost" size="sm" type="button"  data-clipboard-target="button" data-action="clipboard#copy">{{ 'project.connect.copy'|trans }}</twig:Ds:Button>
                </div>
                {% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="lp-empty-state" data-agent-empty>
        <twig:ux:icon name="lucide:unplug" class="lp-empty-state__icon w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'bridge.agents.empty.title'|trans }}</h2>
        <p>{{ 'bridge.agents.empty.description'|trans }}</p>
        <twig:Ds:Button variant="primary" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'bridge.agents.empty.action'|trans }}</twig:Ds:Button>
    </div>
    {% endif %}
    </turbo-frame>
    {% include '@Bridge/_bridge_hooks.html.twig' with {project: project} only %}
    </div>
</div>
{% endblock %}
