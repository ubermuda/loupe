<dialog class="lp-dialog lp-dialog--document" data-modal-target="dialog" aria-labelledby="create-document-title" data-action="cancel->modal#close">
    <h2 class="lp-dialog-title" id="create-document-title">{{ 'review.create.title'|trans }}</h2>
    <p class="lp-dialog-desc">{{ 'review.create.help'|trans }}</p>
    {{ form_start(form, {attr: {class: 'lp-form', 'data-controller': 'form-draft', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': 'document:create:' ~ projectId, 'data-action': 'input->form-draft#remember change->form-draft#remember submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared'}}) }}
        {% include '@Review/_draft_notice.html.twig' with {} only %}
        <div class="lp-field-errors">{{ form_errors(form) }}</div>
        {% for field in [form.title, form.markdown] %}
        <div class="lp-form-field">
            {{ form_label(field, null, {label_attr: {class: 'lp-label'}}) }}
            {{ form_widget(field, {attr: {class: field.vars.name == 'markdown' ? 'lp-input lp-document-editor' : 'lp-input', 'data-form-draft-target': field.vars.name == 'markdown' ? 'text' : 'field'}}) }}
            <div class="lp-field-errors">{{ form_errors(field) }}</div>
        </div>
        {% endfor %}
        {% include '@Review/_document_work_links.html.twig' with {form: form} only %}
        <div class="lp-review-verdict-actions">
            <button type="button" class="lp-btn lp-btn--ghost" data-action="click->modal#close">{{ 'review.create.cancel'|trans }}</button>
            <button type="submit" class="lp-btn lp-btn--primary">{{ 'review.create.submit'|trans }}</button>
        </div>
    {{ form_end(form) }}
</dialog>
