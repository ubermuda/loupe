{% extends 'base.html.twig' %}

{% block title %}{{ 'bridge.worker_run_cost.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: project.id}) }}">{{ project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <a class="lp-topbar__crumb" href="{{ path('app_project_worker_runs', {id: project.id}) }}">{{ 'bridge.worker_runs.page.title'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'bridge.worker_run_cost.page.title'|trans }}</span>
{% endblock %}

{% block body %}
{% set boardEnabled = is_feature_enabled('board.enabled') %}
{% set query = cost.query %}
{% set costRoute = 'app_project_worker_run_cost' %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-runs">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'bridge.worker_runs.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'bridge.worker_runs.page.description'|trans }}</p>
        </div>
    </header>

    {% include '@Bridge/_worker_runs_tabs.html.twig' with {project: project, active: 'cost'} only %}

    <p class="lp-cost-basis" data-cost-basis>{{ 'bridge.worker_run_cost.price_basis'|trans }}</p>

    <div class="lp-list-filters lp-cost-controls">
        <nav class="lp-cost-toggle" aria-label="{{ 'bridge.worker_run_cost.range.label'|trans }}">
            {% for range in ranges %}
                <a class="lp-cost-toggle__option"
                   href="{{ path(costRoute, {id: project.id}|merge(query.withRange(range).routeParams)) }}"
                   {% if query.range == range %}aria-current="true"{% endif %}>{{ range.translationKey()|trans }}</a>
            {% endfor %}
        </nav>
        <nav class="lp-cost-toggle" aria-label="{{ 'bridge.worker_run_cost.split.label'|trans }}">
            {% for split in splits %}
                <a class="lp-cost-toggle__option"
                   href="{{ path(costRoute, {id: project.id}|merge(query.withSplit(split).routeParams)) }}"
                   {% if query.split == split %}aria-current="true"{% endif %}>{{ split.translationKey()|trans }}</a>
            {% endfor %}
        </nav>
        <nav class="lp-cost-toggle" aria-label="{{ 'bridge.worker_run_cost.group.label'|trans }}" data-cost-group-toggle>
            {% for group in groups %}
                <a class="lp-cost-toggle__option"
                   href="{{ path(costRoute, {id: project.id}|merge(query.withGroup(group).routeParams)) }}"
                   {% if query.effectiveGroup == group %}aria-current="true"{% endif %}>{{ group.translationKey()|trans }}</a>
            {% endfor %}
        </nav>

        {# A GET form, so the filters land in the URL. The range, the split and the group ride along as hidden fields. #}
        <form method="get" action="{{ path(costRoute, {id: project.id}) }}" data-controller="autosearch" class="lp-filter-form">
            {% if query.range.value != 'ninety-days' %}<input type="hidden" name="range" value="{{ query.range.value }}">{% endif %}
            {% if query.split.value != 'none' %}<input type="hidden" name="split" value="{{ query.split.value }}">{% endif %}
            {% if query.routeParams.group is defined %}<input type="hidden" name="group" value="{{ query.routeParams.group }}">{% endif %}
            <label class="sr-only" for="worker-run-cost-rule">{{ 'bridge.worker_run_cost.filter.rule_label'|trans }}</label>
            <select id="worker-run-cost-rule" name="rule" class="lp-input lp-select lp-filter-select" data-action="change->autosearch#search">
                <option value="">{{ 'bridge.worker_run_cost.filter.all_rules'|trans }}</option>
                {% for rule in cost.rules %}
                    <option value="{{ rule }}"{{ query.rule == rule ? ' selected' : '' }}>{{ rule }}</option>
                {% endfor %}
            </select>
            <label class="sr-only" for="worker-run-cost-model">{{ 'bridge.worker_run_cost.filter.model_label'|trans }}</label>
            <select id="worker-run-cost-model" name="model" class="lp-input lp-select lp-filter-select" data-action="change->autosearch#search">
                <option value="">{{ 'bridge.worker_run_cost.filter.all_models'|trans }}</option>
                {% for model in cost.models %}
                    <option value="{{ model }}"{{ query.model == model ? ' selected' : '' }}>{{ model }}</option>
                {% endfor %}
            </select>
            <noscript><button type="submit" class="lp-btn">{{ 'bridge.worker_run_cost.filter.apply'|trans }}</button></noscript>
            {% if query.isFiltered %}
                <a href="{{ path(costRoute, {id: project.id}|merge(query.routeParams|filter((value, key) => key in ['range', 'split', 'group']))) }}"
                   class="lp-filter-clear">{{ 'bridge.worker_runs.filter.clear'|trans }}</a>
            {% endif %}
        </form>
    </div>

    <dl class="lp-cost-summary" data-cost-summary>
        <div class="lp-cost-summary__figure">
            <dt class="lp-cost-summary__label">{{ 'bridge.worker_run_cost.summary.median'|trans }}</dt>
            <dd class="lp-cost-summary__value" data-cost-median>{{ (cost.medianMicros / 1000000)|format_currency('USD') }}</dd>
        </div>
        <div class="lp-cost-summary__figure">
            <dt class="lp-cost-summary__label">{{ 'bridge.worker_run_cost.summary.total'|trans }}</dt>
            <dd class="lp-cost-summary__value" data-cost-total>{{ (cost.totalMicros / 1000000)|format_currency('USD') }}</dd>
        </div>
        <div class="lp-cost-summary__figure">
            <dt class="lp-cost-summary__label">{{ 'bridge.worker_run_cost.summary.cards'|trans }}</dt>
            <dd class="lp-cost-summary__value" data-cost-cards>{{ cost.cards|length }}</dd>
        </div>
    </dl>

    {% set chart = cost.chart %}
    {% if chart is not null %}
    {% set split = query.split.value != 'none' %}
    {% set dayFormat = chart.longSpan ? 'M j, Y' : 'M j' %}
    {% set plotLeft = constant('App\\Module\\Bridge\\View\\CostChart::PLOT_LEFT') %}
    {% set plotRight = constant('App\\Module\\Bridge\\View\\CostChart::PLOT_RIGHT') %}
    {% set plotTop = constant('App\\Module\\Bridge\\View\\CostChart::PLOT_TOP') %}
    {% set baseline = constant('App\\Module\\Bridge\\View\\CostChart::BASELINE') %}
    <figure class="lp-cost-chart" data-controller="cost-chart" data-action="keydown.esc->cost-chart#hide">
        {% if (split and chart.series|length > 1) or chart.hasEstimate or chart.hasPartial or chart.hasCountMark %}
        <ul class="lp-cost-legend" data-cost-legend>
            {% if split and chart.series|length > 1 %}
                {% for series in chart.series %}
                    <li class="lp-cost-legend__item"><span class="lp-cost-legend__swatch lp-cost-legend__swatch--{{ series.slot }}"></span>{{ series.key ?? 'bridge.worker_run_cost.legend.other'|trans }}</li>
                {% endfor %}
            {% endif %}
            {% if chart.hasEstimate %}<li class="lp-cost-legend__item"><span class="lp-cost-legend__swatch lp-cost-legend__swatch--estimated"></span>{{ 'bridge.worker_run_cost.legend.estimated'|trans }}</li>{% endif %}
            {% if chart.hasPartial %}<li class="lp-cost-legend__item" data-cost-legend-partial><span class="lp-cost-legend__mark">+</span>{{ 'bridge.worker_run_cost.legend.partial'|trans }}</li>{% endif %}
            {% if chart.hasCountMark %}<li class="lp-cost-legend__item" data-cost-legend-count><span class="lp-cost-legend__mark">{{ 'bridge.worker_run_cost.legend.count_mark'|trans }}</span>{{ 'bridge.worker_run_cost.legend.count'|trans }}</li>{% endif %}
        </ul>
        {% endif %}

        <div class="lp-cost-chart__plot">
            {# A chart drawn from data, not an icon. #}
            {# twig-cs-fixer-disable-line InlineSvg #}<svg class="lp-cost-chart__svg" viewBox="0 0 {{ constant('App\\Module\\Bridge\\View\\CostChart::WIDTH') }} {{ constant('App\\Module\\Bridge\\View\\CostChart::HEIGHT') }}" role="group" aria-label="{{ ('bridge.worker_run_cost.chart.label_' ~ chart.group.value)|trans }}">
                <defs>
                    <pattern id="lp-cost-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line class="lp-cost-chart__hatch" x1="0" y1="0" x2="0" y2="6" />
                    </pattern>
                </defs>
                {% for tick in chart.yTicks %}
                    <line class="lp-cost-chart__grid" x1="{{ plotLeft }}" x2="{{ plotRight }}" y1="{{ tick.position }}" y2="{{ tick.position }}" />
                    <text class="lp-cost-chart__tick" x="{{ plotLeft - 8 }}" y="{{ tick.position }}" text-anchor="end" dominant-baseline="middle">{{ tick.amount|format_currency('USD', {fraction_digit: chart.yTickDecimals}) }}</text>
                {% endfor %}
                {% for tick in chart.xTicks %}
                    <text class="lp-cost-chart__tick" x="{{ tick.position }}" y="{{ constant('App\\Module\\Bridge\\View\\CostChart::HEIGHT') - 6 }}" text-anchor="middle">{{ tick.day|date(chart.group.value == 'month' ? (chart.longSpan ? 'M Y' : 'M') : dayFormat) }}</text>
                {% endfor %}
                <g data-cost-median-line="{{ chart.medianMicros }}">
                    <line class="lp-cost-chart__median" stroke-dasharray="4 4" x1="{{ plotLeft }}" x2="{{ plotRight }}" y1="{{ chart.medianY }}" y2="{{ chart.medianY }}" />
                    <text class="lp-cost-chart__median-label" x="{{ plotRight + 8 }}" y="{{ chart.medianY - 3 }}">{{ 'bridge.worker_run_cost.chart.median'|trans }}</text>
                    <text class="lp-cost-chart__median-value" x="{{ plotRight + 8 }}" y="{{ chart.medianY + 12 }}">{{ chart.median|format_currency('USD') }}</text>
                </g>
                {% for bar in chart.bars %}
                    {% set count = bar.cardCount %}
                    {% set countLabel = 'bridge.worker_run_cost.chart.card_count'|trans({'%count%': count}) %}
                    {% set average = bar.average|format_currency('USD') %}
                    {% set periodLabel = chart.group.value == 'week' ? 'bridge.worker_run_cost.period.week'|trans({'%date%': bar.periodStart|date(dayFormat)}) : bar.periodStart|date(chart.group.value == 'month' ? 'F Y' : dayFormat) %}
                    {% set onlyCard = count == 1 ? bar.cards[0].card : null %}
                    <a class="lp-cost-chart__bar"
                       {% if boardEnabled and onlyCard is not null %}href="{{ path('app_board_card', {projectId: project.id, cardId: onlyCard.id}) }}"{% else %}tabindex="0"{% endif %}
                       aria-label="{{ onlyCard is not null
                           ? 'bridge.worker_run_cost.chart.bar_card'|trans({'%period%': periodLabel, '%number%': onlyCard.number, '%title%': onlyCard.title, '%cost%': average})
                           : 'bridge.worker_run_cost.chart.bar'|trans({'%period%': periodLabel, '%cards%': countLabel, '%cost%': average}) }}"
                       aria-describedby="cost-card-{{ loop.index0 }}"
                       data-cost-bar="{{ bar.periodStart|date('Y-m-d') }}"
                       data-cost-chart-target="bar"
                       data-cost-chart-index-param="{{ loop.index0 }}"
                       data-action="mouseenter->cost-chart#show focus->cost-chart#show mouseleave->cost-chart#hide blur->cost-chart#hide">
                        <rect class="lp-cost-chart__hit" x="{{ bar.hitX }}" y="{{ plotTop }}" width="{{ bar.hitWidth }}" height="{{ baseline - plotTop }}" />
                        {% if bar.stub %}<path class="lp-cost-chart__segment lp-cost-chart__segment--stub" d="{{ bar.outline }}" />{% endif %}
                        {% for segment in bar.segments %}
                            <path class="lp-cost-chart__segment lp-cost-chart__segment--{{ segment.slot }}" d="{{ segment.path }}" />
                        {% endfor %}
                        {% if bar.estimated %}<path fill="url(#lp-cost-hatch)" d="{{ bar.outline }}" data-cost-estimated />{% endif %}
                        {% if bar.wide %}
                            <text class="lp-cost-chart__count" x="{{ bar.centre }}" y="{{ bar.top - 24 }}" text-anchor="middle" data-cost-count>{{ countLabel }}</text>
                            <text class="lp-cost-chart__average" x="{{ bar.centre }}" y="{{ bar.top - 8 }}" text-anchor="middle" data-cost-average>{{ average }}{% if bar.partial %}<tspan data-cost-partial>+</tspan>{% endif %}</text>
                        {% else %}
                            {% if count > 1 %}<text class="lp-cost-chart__mark" x="{{ bar.centre }}" y="{{ bar.top - 7 }}" text-anchor="middle" data-cost-count>{{ 'bridge.worker_run_cost.chart.count_mark'|trans({'%count%': count}) }}</text>{% endif %}
                            {% if bar.partial %}<text class="lp-cost-chart__mark" x="{{ bar.centre }}" y="{{ bar.top - (count > 1 ? 20 : 7) }}" text-anchor="middle" data-cost-partial>+</text>{% endif %}
                        {% endif %}
                    </a>
                {% endfor %}
                <line class="lp-cost-chart__baseline" x1="{{ plotLeft }}" x2="{{ plotRight }}" y1="{{ baseline }}" y2="{{ baseline }}" />
            </svg>

            {% for bar in chart.bars %}
                {% set count = bar.cardCount %}
                {% set periodLabel = chart.group.value == 'week' ? 'bridge.worker_run_cost.period.week'|trans({'%date%': bar.periodStart|date(dayFormat)}) : bar.periodStart|date(chart.group.value == 'month' ? 'F Y' : dayFormat) %}
                <div class="lp-cost-card" id="cost-card-{{ loop.index0 }}" role="tooltip" hidden data-cost-chart-target="card">
                    <p class="lp-cost-card__date"><time datetime="{{ bar.periodStart|date('Y-m-d') }}">{{ periodLabel }}</time> · {{ 'bridge.worker_run_cost.chart.card_count'|trans({'%count%': count}) }}</p>
                    <p class="lp-cost-card__cost">{{ bar.average|format_currency('USD') }}{% if count > 1 %} <span class="lp-cost-card__per">{{ 'bridge.worker_run_cost.chart.average_per_card'|trans }}</span>{% endif %}</p>
                    {% if split %}
                        <ul class="lp-cost-card__parts">
                            {% for key, micros in bar.partAverages %}
                                <li class="lp-cost-card__part"><span class="lp-cost-legend__key lp-cost-legend__key--{{ chart.slotOf(key) }}"></span><span class="lp-cost-card__part-name">{{ key }}</span><span>{{ (micros / 1000000)|format_currency('USD') }}</span></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    <ul class="lp-cost-card__cards" data-cost-card-list>
                        {% for item in bar.cards|slice(0, 10) %}
                            <li class="lp-cost-card__card">
                                <span class="lp-cost-card__card-name">{{ 'bridge.worker_runs.card_number'|trans({'%number%': item.card.number}) }} {{ item.card.title }}</span>
                                <span class="lp-cost-card__card-cost">{{ item.cost|format_currency('USD') }}</span>
                                {% if item.estimated %}<span class="lp-cost-card__note">{{ 'bridge.worker_run_cost.estimated'|trans }}</span>{% endif %}
                                {% if item.partialRuns > 0 %}<span class="lp-cost-card__note">{{ 'bridge.worker_run_cost.partial'|trans({'%count%': item.partialRuns}) }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if count > 10 %}<p class="lp-cost-card__more">{{ 'bridge.worker_run_cost.chart.more_cards'|trans({'%count%': count - 10}) }}</p>{% endif %}
                </div>
            {% endfor %}
        </div>

        <details class="lp-cost-table">
            <summary class="lp-cost-table__toggle">{{ 'bridge.worker_run_cost.table.toggle'|trans }}</summary>
            <p class="lp-cost-table__note" data-cost-group="{{ chart.group.value }}">{{ ('bridge.worker_run_cost.table.grouped_' ~ chart.group.value)|trans }}</p>
            <table class="lp-cost-table__table" data-cost-table>
                <thead>
                    <tr>
                        <th scope="col">{{ 'bridge.worker_run_cost.table.card'|trans }}</th>
                        <th scope="col">{{ 'bridge.worker_run_cost.table.finished'|trans }}</th>
                        <th scope="col" class="lp-cost-table__number">{{ 'bridge.worker_run_cost.table.cost'|trans }}</th>
                        <th scope="col">{{ 'bridge.worker_run_cost.table.notes'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in cost.cards %}
                        <tr data-cost-row="{{ item.card.id }}">
                            <td>{{ 'bridge.worker_runs.card_number'|trans({'%number%': item.card.number}) }} {{ item.card.title }}</td>
                            <td><time datetime="{{ item.card.completedAt|date('c') }}">{{ item.card.completedAt|date('M j, Y') }}</time></td>
                            <td class="lp-cost-table__number">{{ item.cost|format_currency('USD') }}</td>
                            <td>
                                {% if item.estimated %}{{ 'bridge.worker_run_cost.estimated'|trans }}{% endif %}
                                {% if item.partialRuns > 0 %}{{ 'bridge.worker_run_cost.partial'|trans({'%count%': item.partialRuns}) }}{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </details>
    </figure>
    {% else %}
    <div class="lp-empty-state" data-cost-empty>
        <twig:ux:icon name="lucide:chart-column" class="lp-empty-state__icon text-accent w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'bridge.worker_run_cost.empty'|trans }}</h2>
    </div>
    {% endif %}
</div>
{% endblock %}
