<section class="lp-inbox-item__response" aria-label="{{ 'site_review.reply.conversation'|trans }}" data-site-review-replies>
    {% for reply in replies %}
        <div data-site-review-reply="{{ reply.id }}">
            <p class="lp-inbox-item__note"><strong>{{ reply.author.fullName }}</strong> · <time datetime="{{ reply.createdAt|date('c') }}">{{ reply.createdAt|date('Y-m-d H:i') }}</time></p>
            <p class="lp-inbox-item__answer-text">{{ reply.body }}</p>
        </div>
    {% endfor %}
    {% if is_granted(constant('App\\Module\\SiteReview\\Security\\SiteReviewCommentVoter::REPLY'), comment) %}
        {% set form = site_review_reply_form(comment, surface, refusedForm) %}
        {{ form_start(form, {action: action, attr: {class: 'lp-form', 'data-turbo-frame': responseFrame, 'data-controller': 'reply-submission', 'data-action': 'turbo:submit-start->reply-submission#start turbo:fetch-request-error->reply-submission#failed turbo:before-fetch-response->reply-submission#response'}}) }}
            <p class="lp-field-errors" role="alert" data-reply-submission-target="error" hidden>{{ 'site_review.reply.failed'|trans }}</p>
            <div class="lp-field-errors">{{ form_errors(form) }}</div>
            {{ form_widget(form.submissionId) }}
            <div class="lp-field-errors">{{ form_errors(form.submissionId) }}</div>
            <div class="lp-form-field">
                {{ form_label(form.body, null, {label_attr: {class: 'lp-label'}}) }}
                {{ form_widget(form.body, {attr: {class: 'lp-input', rows: 2, maxlength: 2000}}) }}
                <div class="lp-field-errors">{{ form_errors(form.body) }}</div>
            </div>
            <div class="lp-inbox-item__buttons"><button type="submit" class="lp-btn lp-btn--primary lp-btn--sm">{{ 'site_review.reply.submit'|trans }}</button></div>
        {{ form_end(form) }}
    {% endif %}
</section>
