{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'oauth.consent.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{# One frame only: the shell's card holds the rows, which draw no frame. #}
{% block auth_shell_class 'auth-shell--wide' %}

{% block auth_body %}
{% if refusal is defined %}
<div class="lp-consent" data-testid="oauth-widget-refused">
    <div class="auth-icon-badge">
        <twig:UX:Icon name="lucide:triangle-alert" class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
        <h1 class="lp-consent__title">{{ 'oauth.widget.refused.title'|trans }}</h1>
        <p class="lp-consent__lead">{{ refusal|trans }}</p>
    </div>
</div>
{% else %}
<div class="lp-consent lp-consent--rows" data-testid="oauth-consent">
    <h1 class="lp-consent__question">{{ 'oauth.consent.question'|trans({'%client%': view.clientHost ?? view.clientName}) }}</h1>

    <div class="lp-consent__rows">
        <div class="lp-consent__row">
            <span class="lp-consent__badge" aria-hidden="true">
                {% if view.clientIconUrl %}
                <img src="{{ view.clientIconUrl }}" alt="" width="16" height="16" loading="lazy" decoding="async" class="lp-consent__icon">
                {% else %}
                <twig:UX:Icon name="lucide:app-window" class="lp-consent__row-icon" />
                {% endif %}
            </span>
            <div class="lp-consent__row-body">
                {% if view.clientTrusted %}
                <p class="lp-consent__row-primary" data-testid="oauth-consent-client-host">{{ 'oauth.consent.row.publisher'|trans({'%host%': '<span class="lp-consent__row-strong">' ~ view.clientHost|e ~ '</span>'})|raw }}</p>
                <p class="lp-consent__row-second" data-testid="oauth-consent-client-name">{{ 'oauth.consent.row.publisher_name'|trans({'%client%': view.clientName}) }}</p>
                {% elseif view.clientIdUrl is not null %}
                <p class="lp-consent__row-primary" data-testid="oauth-consent-client-host" title="{{ view.clientIdUrl }}">{{ 'oauth.consent.row.publisher'|trans({'%host%': '<span class="lp-consent__row-strong">' ~ view.clientHost|e ~ '</span><span class="lp-consent__row-muted">' ~ view.clientIdPath|e ~ '</span>'})|raw }}</p>
                <p class="lp-consent__row-second" data-testid="oauth-consent-client-name">{{ 'oauth.consent.row.publisher_unverified'|trans({'%client%': view.clientName}) }}</p>
                {% else %}
                <p class="lp-consent__row-primary" data-testid="oauth-consent-client-name">{{ 'oauth.consent.row.publisher_registered'|trans({'%client%': view.clientName}) }}</p>
                <p class="lp-consent__row-second">{{ 'oauth.consent.row.publisher_registered_hint'|trans }}</p>
                {% endif %}
            </div>
        </div>

        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:lock" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary" data-testid="oauth-consent-scope">{{ ('oauth.consent.row.scope.' ~ view.scope.value|replace({'-': '_'}))|trans }}</p>
                <p class="lp-consent__row-second">{{ ('oauth.consent.row.scope_bounds.' ~ view.scope.value|replace({'-': '_'}))|trans }}</p>
            </div>
        </div>

        {% if widget is defined and widget %}
        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:folder" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary">{{ 'oauth.consent.row.widget_project'|trans({'%project%': '<span class="lp-consent__row-strong" data-testid="oauth-consent-project">' ~ widget.project.name|e ~ '</span>'})|raw }}</p>
                <p class="lp-consent__row-second">{{ 'oauth.consent.row.widget_project_hint'|trans }}</p>
            </div>
        </div>

        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:arrow-right" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary">{{ 'oauth.consent.row.widget_site'|trans({'%origin%': '<span class="lp-consent__row-mono" data-testid="oauth-consent-site">' ~ widget.origin|e ~ '</span>'})|raw }}</p>
                <p class="lp-consent__row-second">{{ 'oauth.consent.row.widget_site_hint'|trans }}</p>
            </div>
        </div>
        {% else %}
        <div class="lp-consent__row">
            <twig:UX:Icon name="lucide:arrow-right" class="lp-consent__row-icon" aria-hidden="true" />
            <div class="lp-consent__row-body">
                <p class="lp-consent__row-primary">{{ 'oauth.consent.row.return'|trans({'%origin%': '<span class="lp-consent__row-mono" data-testid="oauth-consent-redirect">' ~ view.redirectOrigin|e ~ '</span>'})|raw }}</p>
                {% if view.loopbackOnly %}
                <p class="lp-consent__row-second" data-testid="oauth-consent-loopback-warning">{{ 'oauth.consent.loopback_warning'|trans }}</p>
                {% else %}
                <p class="lp-consent__row-second">{{ 'oauth.consent.row.return_remote'|trans }}</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

    {# A native submit: the answer redirects to the app, which can be another origin or a custom scheme that Turbo cannot fetch. #}
    {{ form_start(form, {'attr': {'class': 'lp-form lp-consent__form', 'novalidate': 'novalidate', 'data-turbo': 'false', 'data-controller': 'require-choice'}}) }}
        {{ form_errors(form) }}
        {% if form.project is defined %}
        <div class="lp-form-field">
            {{ form_label(form.project, null, {'label_attr': {'class': 'lp-consent__picker-label'}}) }}
            {{ form_widget(form.project, {'attr': {
                'class': 'lp-input lp-select',
                'data-require-choice-target': 'choice',
                'data-action': 'change->require-choice#check',
            }}) }}
            <div class="lp-field-errors">{{ form_errors(form.project) }}</div>
            {% if view.projects is empty %}
            <p class="lp-connect-hint">{{ 'oauth.consent.no_projects'|trans }}</p>
            {% endif %}
        </div>
        {% endif %}
        <div class="lp-consent__actions">
            {{ form_widget(form.deny, {'attr': {'class': 'lp-btn lp-btn--ghost'}}) }}
            {{ form_widget(form.approve, {'attr': {'class': 'lp-btn lp-btn--primary', 'data-require-choice-target': 'submit'}}) }}
        </div>
    {{ form_end(form) }}

    <p class="lp-consent__footnote">
        {{ 'oauth.consent.footnote'|trans({'%email%': app.user.userIdentifier}) }}
        <a href="{{ path('app_account_connected_apps') }}" class="auth-link">{{ 'oauth.consent.footnote_link'|trans }}</a>
    </p>
</div>
{% endif %}
{% endblock %}
