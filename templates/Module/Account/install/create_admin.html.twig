{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.install.admin.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.install.admin.heading'|trans }}</h1>
</div>

{{ form_start(form, {'attr': {'class': 'form-stack', 'novalidate': 'novalidate'}}) }}

    {{ form_errors(form) }}



    <div class="form-field">
        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'auth-input'}}) }}
        <div class="field-errors">{{ form_errors(form.email) }}</div>
    </div>

    <div class="form-field">
        {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'auth-input'}}) }}
        <div class="field-errors">{{ form_errors(form.plainPassword) }}</div>
    </div>

    <button type="submit" class="auth-submit mt-1.5">{{ 'account.install.admin.submit'|trans }}</button>

{{ form_end(form) }}
{% endblock %}
