{#
  The review margin's grouped ladder of comment threads, plus the live-updating
  threads header (resolved count) and progress bar. Rendered both on initial page
  load and by the whole-list Turbo Stream (add / delete / resolve all replace
  #comment-threads), so everything that must refresh on a mutation — the count,
  the progress bar, and the pending/resolved grouping — lives inside this element.

  Threads are grouped into a status ladder: PENDING (unresolved) and RESOLVED.
  An ADDRESSED-BY-AGENT group also exists in the design but has no data signal in
  this codebase yet (no agent-reply concept), so it renders only when populated.

  Vars:
    comments  list<Comment>   All comments for the version (roots and replies).
#}
{% set rootComments = comments|filter(c => c.parent is null)|map(c => c) %}
{% set totalCount = rootComments|length %}
{% set resolvedCount = rootComments|filter(c => c.resolved)|length %}
{% set progressPct = totalCount > 0 ? (resolvedCount / totalCount * 100)|round : 0 %}
<div id="comment-threads" class="bp-comment-threads">
    <div class="bp-review-sidebar__header">
        <div class="bp-review-sidebar__heading">
            <h2 class="bp-review-sidebar__title">{{ 'review.document.sidebar.title'|trans }}</h2>
            <span class="bp-review-sidebar__count">{{ 'review.document.threads.resolved_count'|trans({'%resolved%': resolvedCount, '%total%': totalCount}) }}</span>
        </div>
        <button type="button" class="bp-btn bp-btn--sm" data-action="comment-anchor#startUntargeted">
            <twig:ux:icon name="lucide:plus" class="w-3.5 h-3.5 shrink-0" />
            {{ 'review.document.comment.untargeted'|trans }}
        </button>
    </div>

    <div class="bp-progress" role="presentation">
        <div class="bp-progress__fill" style="width: {{ progressPct }}%"></div>
    </div>

    <div class="bp-review-sidebar__scroll">
        {% if rootComments|length > 0 %}
            {% set groups = [
                {key: 'pending', items: rootComments|filter(c => not c.resolved)|map(c => c)},
                {key: 'resolved', items: rootComments|filter(c => c.resolved)|map(c => c)},
            ] %}
            {% for group in groups %}
                {% if group.items|length > 0 %}
                <section class="bp-ladder-group">
                    <div class="bp-ladder-group__eyebrow bp-ladder-group__eyebrow--{{ group.key }}">
                        <span class="bp-ladder-dot"></span>
                        <span>{{ ('review.document.group.' ~ group.key)|trans }} · {{ group.items|length }}</span>
                    </div>
                    {% for comment in group.items %}
                        {% set replies = comments|filter(c => c.parent is not null and c.parent.id == comment.id) %}
                        <twig:CommentThread :comment="comment" :replies="replies|map(c => c)" />
                    {% endfor %}
                </section>
                {% endif %}
            {% endfor %}
        {% else %}
            <p class="bp-empty">{{ 'review.document.sidebar.empty'|trans }}</p>
        {% endif %}
    </div>
</div>
