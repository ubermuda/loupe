{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.login.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_nav %}
{% if registration_open %}
<span class="text-sm text-fg-mute">
    {{ 'account.login.topbar.prompt'|trans }}
    <a href="{{ path('app_register') }}" class="ml-1.5 text-xs text-accent hover:underline">{{ 'account.login.topbar.link'|trans }}</a>
</span>
{% endif %}
{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.login.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.login.subheading'|trans }}</p>
</div>

{% set social_error = app.request.query.get('social_error') %}
{% if social_error %}
    <div class="auth-error" role="alert">
        <twig:UX:Icon name="lucide:x" class="w-3.5 h-3.5 shrink-0 mt-px" aria-hidden="true" />
        {% if social_error == 'unverified' %}
            {{ 'account.social.error.unverified_email'|trans }}
        {% elseif social_error == 'closed' %}
            {{ 'account.social.error.registration_closed'|trans }}
        {% else %}
            {{ 'account.social.error.generic'|trans }}
        {% endif %}
    </div>
{% endif %}

{% include '@Account/security/_social_buttons.html.twig' with {} only %}

<form method="post" action="{{ path('app_login') }}" class="form-stack" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    {% if error %}
        <div class="auth-error">
            <twig:UX:Icon name="lucide:x" class="w-3.5 h-3.5 shrink-0 mt-px" aria-hidden="true" />
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <div class="form-field">
        <label class="form-label" for="email">{{ 'account.login.form.email.label'|trans }}</label>
        <input id="email" type="email" name="email" value="{{ last_username }}"
               autocomplete="email" autofocus placeholder="{{ 'account.login.form.email.placeholder'|trans }}" class="auth-input">
    </div>

    {#
      The forgot-password link follows the input in the DOM and is placed back
      beside the label with CSS. Written in reading order it sits between the two
      fields, so tabbing out of the email box lands on the link rather than on
      the password box.
    #}
    <div class="form-field form-field--with-action">
        <label class="form-label" for="password">{{ 'account.login.form.password.label'|trans }}</label>
        <input id="password" type="password" name="password"
               autocomplete="current-password" placeholder="{{ 'account.login.form.password.placeholder'|trans }}" class="auth-input">
        <a href="{{ path('app_forgot_password_request') }}" class="form-field__action">{{ 'account.login.form.forgot_password'|trans }}</a>
    </div>

    <label class="flex items-center gap-2 text-sm text-fg-mute cursor-pointer select-none mt-0.5">
        <input type="checkbox" name="_remember_me" class="w-3.5 h-3.5 cursor-pointer accent-accent">
        {{ 'account.login.form.remember_me'|trans }}
    </label>

    <button type="submit" class="auth-submit mt-1.5">{{ 'account.login.form.submit'|trans }}</button>
</form>

{% if registration_open %}
<div class="text-center text-sm text-fg-mute">
    {{ 'account.login.footer.prompt'|trans }}
    <a href="{{ path('app_register') }}" class="pl-1 text-accent font-medium hover:underline">{{ 'account.login.footer.link'|trans }}</a>
</div>
{% endif %}
{% endblock %}
