{% extends '@Account/_settings_layout.html.twig' %}

{% block settings_section 'profile' %}

{% block settings_content %}
<section class="lp-connect-block lp-settings-section lp-settings-panel-card" data-testid="profile-section">
    <h2 class="lp-section-title">{{ 'account.settings.profile.heading'|trans }}</h2>
    <p class="lp-connect-hint">{{ 'account.settings.profile.description'|trans }}</p>
    {{ form_start(form, {'action': path('app_account_profile'), 'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
        <div class="lp-form-field">
            {{ form_label(form.fullName, null, {'label_attr': {'class': 'lp-label'}}) }}
            {{ form_widget(form.fullName, {'attr': {'class': 'lp-input'}}) }}
            <div class="lp-field-errors">{{ form_errors(form.fullName) }}</div>
        </div>
        <div class="lp-form-field">
            <label class="lp-label" for="account-profile-email">{{ 'account.settings.profile.email_label'|trans }}</label>
            <input class="lp-input" id="account-profile-email" type="email" value="{{ app.user.email }}" readonly>
            <p class="lp-form-hint">{{ 'account.settings.profile.email_hint'|trans }}</p>
        </div>
        <div class="flex items-center justify-end gap-3 pt-2">
            <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.profile.save_button'|trans }}</button>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
