<section class="lp-thread" aria-label="{{ 'inbox.reply.conversation'|trans }}" data-inbox-replies>
    {% for reply in replies %}
        {% include '_thread_reply.html.twig' with {reply: reply, marker: 'data-inbox-reply'} only %}
    {% endfor %}
    {% if is_granted(constant('App\\Module\\Inbox\\Security\\InboxItemVoter::REPLY'), item) %}
        {% set form = inbox_reply_form(item, refusedForm) %}
        {{ form_start(form, {action: path('app_inbox_item_reply', actionParams), attr: {class: 'lp-form', 'data-turbo-frame': responseFrame, 'data-controller': 'reply-submission', 'data-reply-submission-owner-value': app.user.id, 'data-reply-submission-key-value': 'inbox:' ~ item.id, 'data-action': 'input->reply-submission#remember turbo:submit-start->reply-submission#start turbo:fetch-request-error->reply-submission#failed turbo:before-fetch-response->reply-submission#response'}}) }}
            <p class="lp-field-errors" role="alert" data-reply-submission-target="error" hidden>{{ 'inbox.reply.failed'|trans }}</p>
            <div class="lp-field-errors">{{ form_errors(form) }}</div>
            {{ form_widget(form.submissionId, {attr: {'data-reply-submission-target': 'submission'}}) }}
            <div class="lp-field-errors">{{ form_errors(form.submissionId) }}</div>
            <div class="lp-reply-composer">
                {{ form_label(form.body, null, {label_attr: {class: 'sr-only'}}) }}
                {{ form_widget(form.body, {attr: {class: 'lp-input', rows: 1, maxlength: 2000, placeholder: 'inbox.reply.placeholder'|trans, 'data-reply-submission-target': 'body'}}) }}
                <button type="submit" class="lp-btn lp-btn--icon lp-reply-composer__send" aria-label="{{ 'inbox.reply.submit'|trans }}" title="{{ 'inbox.reply.submit'|trans }}"><twig:ux:icon name="lucide:send" /></button>
            </div>
            <div class="lp-field-errors">{{ form_errors(form.body) }}</div>
        {{ form_end(form) }}
    {% endif %}
</section>
