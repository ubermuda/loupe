{% extends 'base.html.twig' %}

{% block title %}{{ 'account.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ 'nav.link.account'|trans }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'account.settings.page.title'|trans }}</span>
{% endblock %}

{# Each section names itself, because a forwarded 422 render carries no _route. #}
{% block settings_section '' %}

{% block body %}
{% set section = block('settings_section') %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'account.settings.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'account.settings.page.description'|trans }}</p>
        </div>
    </header>

    <div class="lp-settings-layout">
        <nav class="lp-settings-nav" aria-label="{{ 'account.settings.nav.label'|trans }}">
            <a class="lp-settings-nav__item{% if section == 'profile' %} lp-settings-nav__item--active{% endif %}" href="{{ path('app_account_profile') }}"{% if section == 'profile' %} aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:users" />
                {{ 'account.settings.nav.profile'|trans }}
            </a>
            <a class="lp-settings-nav__item{% if section == 'api-tokens' %} lp-settings-nav__item--active{% endif %}" href="{{ path('app_account_api_tokens') }}"{% if section == 'api-tokens' %} aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:key-round" />
                {{ 'account.settings.nav.tokens'|trans }}
            </a>
            <a class="lp-settings-nav__item{% if section == 'data' %} lp-settings-nav__item--active{% endif %}" href="{{ path('app_account_data') }}"{% if section == 'data' %} aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:archive" />
                {{ 'account.settings.nav.data'|trans }}
            </a>
        </nav>

        <div class="lp-settings-content">
            <twig:BillingSummary />
            {% block settings_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
