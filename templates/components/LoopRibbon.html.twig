{#
  Props:
    stage   App\LoopStage   The document's current loop stage.

  Renders the 4-step loop ribbon (Proposed → In review → Revise → Approved).
  Each step is classified against stage.ordinal(): completed (< current),
  current (=), upcoming (>). Connector bars take the state of the step they
  lead into, so the filled track runs up to and including the current circle.
#}
{% set steps = ['loop.step.proposed', 'loop.step.in_review', 'loop.step.revise', 'loop.step.approved'] %}
<div class="bp-ribbon">
    {% for key in steps %}
        {% set state = loop.index0 < stage.ordinal() ? 'completed' : (loop.index0 == stage.ordinal() ? 'current' : 'upcoming') %}
        {% if not loop.first %}
            <span class="bp-ribbon__bar bp-ribbon__bar--{{ state }}"></span>
        {% endif %}
        <div class="bp-ribbon__step">
            <span class="bp-ribbon__circle bp-ribbon__circle--{{ state }}">{{ loop.index }}</span>
            <span class="bp-ribbon__label bp-ribbon__label--{{ state }}">{{ key|trans }}</span>
        </div>
    {% endfor %}
</div>
