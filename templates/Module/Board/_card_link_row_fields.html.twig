{# The fields of one linked card row. The prototype uses this too, so a row the
   add button makes looks like one the server renders. Props: row. #}
<div class="lp-card-link-row__fields">
    <div class="lp-card-link-row__card">
        {{ form_label(row.card, null, {label_attr: {class: 'sr-only'}}) }}
        {{ form_widget(row.card) }}
        <div class="lp-field-errors">{{ form_errors(row.card) }}</div>
    </div>
    <div class="lp-card-link-row__kind">
        {{ form_label(row.kind, null, {label_attr: {class: 'sr-only'}}) }}
        {{ form_widget(row.kind, {attr: {class: 'lp-input lp-select'}}) }}
        <div class="lp-field-errors">{{ form_errors(row.kind) }}</div>
    </div>
</div>
