{# The selected request: its source byline, the agent's context and its items. #}
{% set ask = entry.ask %}
{% set items = ask ? ask.items|map(link => link.item) : [entry.item] %}
{% set asked = ask ? ask.createdAt : entry.item.createdAt %}
<section class="lp-inbox-ask{{ ask and ask.closedAt ? ' lp-inbox-ask--closed' }}"
         id="{{ entry.panelId }}"
         {% if ask %}data-inbox-ask-id="{{ ask.id }}"{% endif %}
         role="tabpanel"
         aria-labelledby="inbox-request-{{ entry.key }}"
         data-panel-tabs-target="panel"
         data-panel-panel="{{ entry.key }}"
         {%- if hidden %} hidden{% endif %}>
    <div class="lp-inbox-ask__summary">
        <header class="lp-inbox-ask__head">
            {% set origin = ask ? ask.origin : entry.item.origin %}
            {% include '@Inbox/_agent_presence.html.twig' with {ask: ask, bridge: ask ? inbox.bridgeStatus(ask) : null, origin: origin} only %}
            <span class="lp-inbox-ask__source" data-inbox-source="{{ origin.value }}">{{ ('inbox.source.' ~ origin.value)|trans }}</span>
            <span class="lp-inbox-ask__time">{{ asked|relative_time }}</span>
            {% if ask and ask.closedAt %}
                <twig:Ds:StatusChip modifier="resolved">{{ 'inbox.ask.closed'|trans({'%time%': ask.closedAt|relative_time}) }}</twig:Ds:StatusChip>
            {% endif %}
        </header>
        {# An ask stores no title. Its first item names it, as the request list does. #}
        <h2 class="lp-inbox-ask__title">{{ (items|first).title }}</h2>
        {% if ask and ask.context|trim is not empty %}
            {# Agent Markdown, rendered and sanitized the way a card body is. #}
            <div class="prose lp-prose lp-inbox-ask__context">{{ ask.context|inbox_markdown }}</div>
        {% endif %}
    </div>
    <div class="lp-inbox-ask__items">
        {% for item in items %}
            {% include '@Inbox/_inbox_item.html.twig' with {item: item, ask: ask, inbox: inbox, refusedForm: refusedForm, showLinkedItems: true, showHead: items|length > 1, showTitle: items|length > 1} only %}
        {% endfor %}
    </div>
</section>
