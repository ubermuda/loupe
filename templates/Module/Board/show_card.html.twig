{% extends 'base.html.twig' %}

{% block title %}{{ card.title }} — {{ 'app.name'|trans }}{% endblock %}

{% block flash_messages %}
    {% if app.request.headers.get('Turbo-Frame') != 'card-drawer-frame' %}{{ parent() }}{% endif %}
{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_board', {id: card.project.id}) }}">{{ 'nav.link.board'|trans }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">#{{ card.number }}</span>
{% endblock %}

{% block body %}
<turbo-frame id="card-drawer-frame">
<div class="lp-card-drawer" data-controller="panel-tabs" data-panel-tabs-active-value="{{ app.request.query.get('tab', 'overview') }}">
    {% if app.request.headers.get('Turbo-Frame') == 'card-drawer-frame' %}
        {% include '_flash_messages.html.twig' with {flashes: app.flashes(['success', 'error', 'warning', 'info'])} only %}
    {% endif %}
    <header class="lp-card-drawer__header">
        <div class="lp-card-drawer__identity">
            <span class="lp-card-drawer__icon"><twig:ux:icon name="lucide:layout-list" class="w-4 h-4" /></span>
            <span class="lp-card-number">#{{ card.number }}</span>
            <span class="lp-tag">{{ ('board.card.type.' ~ card.type.value)|trans }}</span>
        </div>
        <div class="lp-card-drawer__header-actions">
            <a class="lp-btn lp-btn--ghost" href="{{ path('app_board_card_edit', {projectId: card.project.id, cardId: card.id}) }}" data-turbo-frame="_top"><twig:ux:icon name="lucide:pencil" class="w-4 h-4" />{{ 'board.card.edit.action'|trans }}</a>
            <a class="lp-btn lp-btn--ghost lp-btn--icon" href="{{ path('app_project_board', {id: card.project.id}) }}" aria-label="{{ 'board.card.drawer.close'|trans }}" data-action="card-drawer#close"><twig:ux:icon name="lucide:x" class="w-4 h-4" /></a>
        </div>
    </header>

    <div class="lp-card-drawer__body">
        <h1 class="lp-card-drawer__title">{{ card.title }}</h1>
        <div class="lp-card-tabs" role="tablist" aria-label="{{ 'board.card.drawer.sections'|trans }}">
            {% for tab in ['overview', 'conversation', 'feedback'] %}
            <button type="button" class="lp-card-tabs__tab" role="tab" id="card-tab-{{ tab }}" aria-controls="card-panel-{{ tab }}" data-panel-tabs-target="tab" data-panel-tab="{{ tab }}" data-action="click->panel-tabs#select keydown->panel-tabs#keydown">{{ ('board.card.tab.' ~ tab)|trans }}</button>
            {% endfor %}
        </div>

        <section class="lp-card-panel" id="card-panel-overview" role="tabpanel" aria-labelledby="card-tab-overview" data-panel-tabs-target="panel" data-panel-panel="overview">
            <div class="lp-card-overview-grid">
                <div class="lp-card-overview-grid__main">
                    <h2 class="lp-card-panel__title">{{ 'board.card.overview.description'|trans }}</h2>
                    {% if card.body|trim is not empty %}<div class="prose lp-prose lp-card-detail__body">{{ card.body|card_body }}</div>{% else %}<p class="lp-card-detail__empty">{{ 'board.card.body.empty'|trans }}</p>{% endif %}
                    <section class="lp-card-docs lp-card-pulls">
                        {% if card.documents|length > 0 or card.pullRequests|length > 0 %}
                        <div class="lp-inbox-linked-table-wrap">
                            <table class="lp-inbox-linked-table">
                                <caption>{{ 'board.list.linked_work'|trans }}</caption>
                                <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                                <tbody>
                                    {% for link in card.documents %}
                                    <tr>
                                        <td><span class="lp-inbox-linked-table__type"><twig:ux:icon name="lucide:file-text" class="w-4 h-4" />{{ 'inbox.linked_items.document'|trans }}</span><strong>{{ link.document.title }}</strong></td>
                                        <td><span class="lp-tag">{{ link.document.status.translationKey()|trans }}</span></td>
                                        <td><a class="lp-btn lp-btn--ghost lp-btn--icon" href="{{ path('app_document_review', {projectId: card.project.id, documentId: link.document.id}) }}" data-turbo-frame="_top" aria-label="{{ 'inbox.linked_items.open_document'|trans({'%title%': link.document.title}) }}"><twig:ux:icon name="lucide:arrow-up-right" class="w-4 h-4" /></a></td>
                                    </tr>
                                    {% endfor %}
                                    {% for link in card.pullRequests %}
                                        {% include '@Board/_linked_pull_request.html.twig' with {link: link} only %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}<h2 class="lp-card-panel__title">{{ 'board.list.linked_work'|trans }}</h2><p class="lp-card-detail__empty">{{ 'board.card.linked_work.empty'|trans }}</p>{% endif %}
                    </section>
                </div>
                <aside class="lp-card-overview-grid__facts" aria-label="{{ 'board.card.overview.details'|trans }}">
                    <dl class="lp-card-fact-list">
                        <div><dt>{{ 'board.card.overview.status'|trans }}</dt><dd>{{ card.column.label|trans }}</dd></div>
                        <div><dt>{{ 'board.card.overview.priority'|trans }}</dt><dd>{{ ('board.card.priority.' ~ card.priority.label())|trans }}</dd></div>
                        <div><dt>{{ 'board.card.overview.reporter'|trans }}</dt><dd>{{ ('board.card.reporter.' ~ card.reporter.value)|trans }}</dd></div>
                        <div><dt>{{ 'board.card.overview.type'|trans }}</dt><dd>{{ ('board.card.type.' ~ card.type.value)|trans }}</dd></div>
                    </dl>
                    <section class="lp-card-move">
                        <h2 class="lp-card-panel__title">{{ 'board.card.move.title'|trans }}</h2>
                        {% set moveForm = card_move_form(card) %}
                        <form method="post" data-turbo="false" action="{{ path('app_board_card_move', {projectId: card.project.id, cardId: card.id}) }}" class="lp-card-move__form">
                            {{ form_widget(moveForm._token) }}
                            <div class="lp-form-field">{{ form_label(moveForm.column, null, {label_attr: {class: 'lp-label'}}) }}{{ form_widget(moveForm.column, {attr: {class: 'lp-input lp-select'}}) }}</div>
                            <div class="lp-form-field">{{ form_label(moveForm.priority, null, {label_attr: {class: 'lp-label'}}) }}{{ form_widget(moveForm.priority, {attr: {class: 'lp-input lp-select'}}) }}</div>
                            {{ form_widget(moveForm.position, {attr: {hidden: 'hidden'}}) }}
                            <button type="submit" class="lp-btn lp-btn--primary">{{ 'board.card.move.submit'|trans }}</button>
                        </form>
                    </section>
                </aside>
            </div>
        </section>

        <section class="lp-card-panel" id="card-panel-conversation" role="tabpanel" aria-labelledby="card-tab-conversation" data-panel-tabs-target="panel" data-panel-panel="conversation" hidden>
            <div class="lp-card-conversation-intro"><span class="lp-source-avatar"><twig:ux:icon name="lucide:messages-square" class="w-4 h-4" /></span><div><h2 class="lp-card-panel__title">{{ 'board.card.conversation.title'|trans }}</h2><p>{{ 'board.card.conversation.description'|trans }}</p></div></div>
            {{ inbox_card_section(card) }}
            {% for link in siteReviewLinks %}<article class="lp-conversation-entry"><span class="lp-source-avatar"><twig:ux:icon name="lucide:globe-2" class="w-4 h-4" /></span><div><p class="lp-conversation-entry__source">{{ 'site_review.source.widget'|trans }}</p><p>{{ link.comment.body }}</p></div></article>{% endfor %}
        </section>

        <section class="lp-card-panel" id="card-panel-feedback" role="tabpanel" aria-labelledby="card-tab-feedback" data-panel-tabs-target="panel" data-panel-panel="feedback" hidden>
            <div class="lp-card-conversation-intro"><span class="lp-source-avatar"><twig:ux:icon name="lucide:globe-2" class="w-4 h-4" /></span><div><h2 class="lp-card-panel__title">{{ 'board.card.site_review.title'|trans }}</h2><p>{{ 'board.card.feedback.description'|trans }}</p></div></div>
            {% if siteReviewLinks|length > 0 %}
            <ul class="lp-card-feedback-list">
                {% for link in siteReviewLinks %}<li><div class="lp-card-feedback-list__head"><span>{{ 'site_review.source.widget'|trans }}</span><span class="lp-status-chip lp-status-chip--{{ link.comment.status.value }}">{{ ('site_review.comment.status.' ~ link.comment.status.value)|trans }}</span></div><p>{{ link.comment.body }}</p>{% if link.comment.url starts with 'https://' or link.comment.url starts with 'http://' %}<a href="{{ link.comment.url }}" rel="noopener noreferrer nofollow" target="_blank">{{ 'site_review.comment.open_source'|trans }}</a>{% endif %}</li>{% endfor %}
            </ul>
            <a class="lp-btn lp-btn--ghost" href="{{ path('app_project_site_review', {id: card.project.id}) }}" data-turbo-frame="_top">{{ 'board.card.site_review.all'|trans }}</a>
            {% else %}<p class="lp-card-detail__empty">{{ 'board.card.site_review.empty'|trans }}</p>{% endif %}
        </section>
    </div>

    <footer class="lp-card-drawer__footer">
        <div data-controller="modal">
            <button type="button" class="lp-btn lp-btn--danger" data-action="click->modal#open">{{ 'board.card.delete.action'|trans }}</button>
            <dialog data-modal-target="dialog" class="lp-dialog"><h3 class="lp-dialog-title">{{ 'board.card.delete.confirm.title'|trans }}</h3><p class="lp-dialog-desc">{{ 'board.card.delete.confirm.body'|trans({'%title%': card.title}) }}</p><form method="post" action="{{ path('app_board_card_delete', {projectId: card.project.id, cardId: card.id}) }}" class="flex items-center justify-end gap-3 pt-2" data-turbo-frame="_top"><input type="hidden" name="_csrf_token" value="{{ csrf_token('board-card-delete') }}"><button type="button" class="lp-btn" data-action="click->modal#close">{{ 'board.card.delete.confirm.cancel'|trans }}</button><button type="submit" class="lp-btn lp-btn--danger">{{ 'board.card.delete.confirm.submit'|trans }}</button></form></dialog>
        </div>
    </footer>
</div>
</turbo-frame>
{% endblock %}
