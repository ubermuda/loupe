{#
  Props:
    comment    Comment           The root comment (parent === null).
    replies    list<Comment>     Direct replies to this comment.
    replyForm  FormView|null     Pre-bound reply form (with errors) or null.

  Reply is a Symfony form; resolve is a fieldless plain form submitted by the
  Resolve button via form=. Both post through Turbo; the controllers return a
  Turbo Stream that replaces this thread (targeted by the id below).

  Reply avatars are green (human): document threads are owner-only, so every
  reply is authored by the reviewer. The design's accent-soft "C" agent avatar
  awaits a real agent-reply signal (address_comment MCP tool), not wired yet.
#}
{% set status = comment.resolved ? 'resolved' : 'pending' %}
<div
    id="comment-thread-{{ comment.id }}"
    class="lp-comment-thread{% if comment.resolved %} lp-comment-thread--resolved{% endif %}{% if comment.orphaned %} lp-comment-thread--orphaned{% endif %}"
    data-comment-anchor-target="thread"
    data-anchor-quote="{{ comment.anchor.quote }}"
    data-anchor-prefix="{{ comment.anchor.prefix }}"
    data-anchor-suffix="{{ comment.anchor.suffix }}"
    data-anchor-status="{{ status }}"
>
    <div class="lp-comment-thread__header">
        <span class="avatar">{{ comment.author.fullName|slice(0, 1)|upper }}</span>
        <span class="lp-comment-author lp-comment-thread__author">{{ comment.author.fullName }}</span>
        <span class="lp-status-chip lp-status-chip--{{ status }}">
            <span class="lp-status-chip__dot"></span>
            {{ ('review.document.group.' ~ status)|trans }}
        </span>
    </div>

    {% if comment.anchor.quote %}
    <blockquote class="lp-comment-quote">{{ comment.anchor.quote }}</blockquote>
    {% endif %}

    <div class="lp-comment-body">{{ comment.body }}</div>

    {% if replies|length > 0 %}
    <div class="lp-comment-replies">
        {% for reply in replies %}
        <div class="lp-comment--reply">
            <div class="lp-comment-reply__head">
                <span class="avatar ok">{{ reply.author.fullName|slice(0, 1)|upper }}</span>
                <span class="lp-comment-author">{{ reply.author.fullName }}</span>
            </div>
            <div class="lp-comment-body">{{ reply.body }}</div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# Fieldless delete form — available on any thread (resolved or not),
       submitted by a Delete button via form=. Confirmed before submit. #}
    <form id="delete-form-{{ comment.id }}" action="{{ path('app_comment_delete', {id: comment.id}) }}" method="post" hidden
          data-turbo-confirm="{{ 'review.document.comment.delete_confirm'|trans }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('comment-action') }}">
    </form>

    {% if not comment.resolved %}
    <div class="lp-comment-reply-form">
        {% set replyForm = replyForm ?? comment_reply_form(comment) %}

        {# Fieldless resolve form — submitted by the Resolve button below via form=. #}
        <form id="resolve-form-{{ comment.id }}" action="{{ path('app_comment_resolve', {id: comment.id}) }}" method="post" hidden>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('comment-action') }}">
        </form>

        {{ form_start(replyForm, {attr: {class: 'contents'}}) }}
            {{ form_widget(replyForm.body) }}
            <div class="lp-comment-error">{{ form_errors(replyForm.body) }}</div>
            <div class="lp-comment-actions">
                <button type="submit" class="lp-btn lp-btn--ghost lp-btn--sm">{{ 'review.document.comment.reply'|trans }}</button>
                <button type="submit" form="resolve-form-{{ comment.id }}" class="lp-btn lp-btn--success lp-btn--sm">{{ 'review.document.comment.resolve'|trans }}</button>
                <button type="submit" form="delete-form-{{ comment.id }}" class="lp-btn lp-btn--danger-ghost lp-btn--sm">{{ 'review.document.comment.delete'|trans }}</button>
            </div>
        {{ form_end(replyForm) }}
    </div>
    {% else %}
    <div class="lp-comment-actions">
        <button type="submit" form="delete-form-{{ comment.id }}" class="lp-btn lp-btn--danger-ghost lp-btn--sm">{{ 'review.document.comment.delete'|trans }}</button>
    </div>
    {% endif %}
</div>
