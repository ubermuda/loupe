{# The review page with the document pane holding a comparison of two versions.
   Everything around that pane is the same apparatus, so the diff overrides one
   block rather than rebuilding the page.
   Params: document, version, versions, diffFromVersion, diffView, diff,
   renderedDiff, diffSideBySide, diffRefusal, diffCommenting. #}
{% extends '@Review/show_document.html.twig' %}

{% block title %}{{ 'review.document.diff.page.title'|trans({'%from%': diffFromVersion}) }} — {{ 'app.name'|trans }}{% endblock %}

{# topbar_crumbs is inherited, so the bar names the document here as it does on
   the review page. Below lg the crumbs are hidden and the here slot is all that
   survives, and the chip in the metadata bar carries the version range. #}

{% block documentPane %}
    {# What the author said each revision changed, read next to what it actually
       changed. Only the versions the diff spans are listed. #}
    {% set changeNotes = versions|filter(meta =>
        meta.versionNumber > diffFromVersion
        and meta.versionNumber <= version.versionNumber
        and meta.description is not empty
    ) %}
    {% if changeNotes|length > 0 %}
    <aside class="lp-diff-notes">
        <h2 class="lp-diff-notes__title">{{ 'review.document.diff.notes_title'|trans }}</h2>
        {% for meta in changeNotes %}
        <p class="lp-diff-notes__entry">
            <span class="lp-version-pill">{{ 'v' ~ meta.versionNumber }}</span>
            <span>{{ meta.description }}</span>
        </p>
        {% endfor %}
    </aside>
    {% endif %}

    {% if diffRefusal %}
        {# Declining to compare, rather than showing a comparison that describes
           neither version. Each version still reads normally, which is what the
           version list in the bar above points at. #}
        <p class="lp-empty">{{ diffRefusal.translationKey|trans }}</p>
    {% elseif not diff.hasChanges %}
        <p class="lp-empty">{{ 'review.document.diff.identical'|trans }}</p>
    {% elseif diffView.value == 'source' %}
        {% include '@Review/_version_diff.html.twig' with {diff: diff} only %}
    {% elseif diffView.value == 'side-by-side' %}
        {# What each block said before, beside what it says now. The pairing is a
           walk of the rendered pane's top-level blocks, so it holds the same
           marks and the same jump targets. #}
        {% include '@Review/_side_by_side_diff.html.twig' with {
            rows: diffSideBySide.rows,
            fromVersion: diffFromVersion,
            toVersion: version.versionNumber,
        } only %}
    {% else %}
        {# The document as the newer version reads it, with what the revision
           added and removed marked in place. Its text belongs to two versions at
           once, so RenderedDiffBuilder marks the runs the newer version also
           holds and the controller anchors to those alone. #}
        <div class="prose lp-prose lp-review-doc__prose lp-diff-doc" data-rail-align{% if diffCommenting %} data-comment-anchor-target="doc"{% endif %}>{{ renderedDiff.html|raw }}</div>
    {% endif %}
{% endblock %}
