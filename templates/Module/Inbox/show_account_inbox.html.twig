{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.account.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__here">{{ 'inbox.account.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-account-inbox">
    <header class="lp-page-header">
        <div class="lp-page-header__copy">
            <h1 class="lp-workspace-title">{{ 'inbox.account.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'inbox.account.page.description'|trans }}</p>
        </div>
    </header>

    {% if inbox.isEmpty %}
    <div class="lp-empty-state">
        <twig:ux:icon name="lucide:inbox" class="lp-empty-state__icon text-accent w-12 h-12" />
        <h2 class="lp-empty-state__title">{{ 'inbox.account.page.empty'|trans }}</h2>
    </div>
    {% else %}
    <div class="lp-account-inbox__grid">
        {# One card per project: what it is, how much waits, how long, and the way in. #}
        {% for group in inbox.groups %}
        {% set waiting = [] %}
        {% for ask in group.openAsks %}{% set waiting = waiting|merge([ask.createdAt]) %}{% endfor %}
        {% for item in group.looseItems %}{% set waiting = waiting|merge([item.createdAt]) %}{% endfor %}
        {% set blocking = group.looseItems|filter(item => item.blocking)|length > 0 %}
        <a class="lp-account-inbox-card" href="{{ path('app_project_inbox', {id: group.project.id}) }}" data-account-inbox-project="{{ group.project.id }}">
            <span class="lp-account-inbox-card__avatar" aria-hidden="true">{{ group.project.name|slice(0, 1)|upper }}</span>
            <span class="lp-account-inbox-card__name">{{ group.project.name }}</span>
            <span class="lp-account-inbox-card__count" data-account-inbox-open-count>{{ 'inbox.account.project.open_items'|trans({'%count%': group.openItemCount}) }}</span>
            {% if waiting|length > 0 %}
            <span class="lp-account-inbox-card__wait">{{ 'inbox.account.project.oldest'|trans({'%time%': min(waiting)|relative_time}) }}</span>
            {% endif %}
            {% if blocking %}<span class="lp-inbox-item__blocking">{{ 'inbox.item.blocking'|trans }}</span>{% endif %}
            <twig:ux:icon name="lucide:arrow-right" class="lp-account-inbox-card__go" />
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
