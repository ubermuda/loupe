parameters:
    level: 8
    paths:
        - bin/
        - config/
        - migrations/
        - public/
        - src/
        - tests/

    excludePaths:
        - config/reference.php (?)

    treatPhpDocTypesAsCertain: false

    gamache:
        controllerBaseClass: 'App\Controller\AppController'
        # Migrations older than this are deployed everywhere and no rollback will
        # ever land before them, so their schema shape is settled and unenforced.
        migrationsEnforcedFrom: '20260827014419'
        controllerTemplates:
            namespacePattern: '#^App\\Module\\([^\\]+)\\Controller\\#'
            templateDirectory: 'templates/Module'
            # Without renderFormResponse the rule sees only render(), and every
            # controller that answers with a form is skipped.
            renderMethods: ['render', 'renderFormResponse']
        templateNamespaces:
            forbiddenPathPrefix: 'Module/'
        auditOperations:
            auditorClass: 'App\Module\Audit\Auditor'
        translationCallSites:
            - { class: App\Controller\AppController, method: addFlash, argumentIndex: 1 }
            - { class: Symfony\Component\Mime\Email, method: subject, argumentIndex: 0 }
        translationAttributeSites:
            - { class: Symfony\Component\Validator\Constraint, argumentNames: [message, minMessage, maxMessage, exactMessage] }

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/ubermuda/gamache/extension.neon
