{% set runs = card_worker_runs(project, cardId) %}
{% set usage = card_usage_total(project, cardId) %}
{% set held = card_held(project, cardId) %}
{% set canManage = is_granted('project.manage', project) %}
<turbo-frame id="card-worker-runs" class="lp-live-frame" target="_top">
{# A manager always sees the section, because the pause control shows on a card with no runs. #}
{% if canManage or runs is not empty or usage.known or held or commandErrors|default([]) is not empty %}
<section class="lp-card-overview__section" data-card-runs>
    <div class="lp-section-heading">
        <h2 class="lp-card-panel__title">{{ (runs is not empty ? 'board.card.runs.open_title' : 'board.card.runs.title')|trans }}</h2>
        <a class="lp-workshop-text-link" href="{{ path('app_project_worker_runs', {id: project.id}) }}" data-turbo-frame="_top" data-card-runs-all>{{ 'board.card.runs.all'|trans }}</a>
    </div>
    {% if commandErrors|default([]) is not empty %}
    <div class="lp-worker-run-flashes" data-worker-run-command-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: commandErrors}} only %}
    </div>
    {% endif %}
    {% if held %}
    <p class="lp-card-held" data-card-held><twig:ux:icon name="lucide:circle-pause" class="lp-card-held__icon" />{{ 'board.card.runs.held'|trans }}</p>
    {% endif %}
    {% if canManage %}
    <form method="post" action="{{ path(held ? 'app_project_card_agents_release' : 'app_project_card_agents_pause', {id: project.id, cardId: cardId}) }}" data-turbo-frame="card-worker-runs" {{ held ? 'data-card-agents-release' : 'data-card-agents-pause' }}>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('card-agents') }}">
        <button type="submit" class="lp-btn lp-btn--outline lp-btn--sm">{% if held %}<twig:ux:icon name="lucide:circle-play" class="size-4" />{% else %}<twig:ux:icon name="lucide:circle-pause" class="size-4" />{% endif %}{{ (held ? 'board.card.runs.release' : 'board.card.runs.pause')|trans }}</button>
    </form>
    {% endif %}
    {% for item in runs %}
    {% set control = item.control %}
    <div class="lp-card-run-row" data-card-run-row="{{ item.run.id }}">
        <div class="lp-card-run__main">
            <a class="lp-card-run" href="{{ path('app_project_worker_runs', {id: project.id, search: item.run.id}) }}" data-turbo-frame="_top" data-card-run="{{ item.run.id }}">
                <span class="lp-card-run__rule">{{ item.run.ruleName }}</span>
                {% if item.interactive %}<span class="lp-tag lp-tag--neutral lp-card-run__kind">{{ 'bridge.worker_runs.interactive'|trans }}</span>{% endif %}
                {% if item.command %}<span class="lp-tag lp-tag--neutral lp-card-run__kind" data-worker-run-command>{{ 'bridge.worker_runs.command'|trans }}</span>{% endif %}
                {% set shownAt = item.run.startedAt ?? item.run.receivedAt %}
                <span class="lp-card-run__meta"><time datetime="{{ shownAt|date('c') }}">{{ shownAt|relative_time }}</time>{% if item.duration() is not null %} · {% if item.interactive and item.state.isOpen() %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}{% endif %}{% if item.isResume %} · <span data-worker-run-resume>{{ 'bridge.worker_runs.resume'|trans({'%index%': item.run.resumeIndex, '%cap%': item.run.resumeCap}) }}</span>{% endif %}</span>
                {% if control and control.label %}{% set controlLabel = control.label|trans(control.labelParameters) %}<span class="lp-worker-run-control-label{{ control.labelWarns ? ' lp-worker-run-control-label--warns' : '' }}" title="{{ controlLabel }}" data-worker-run-control-label>{{ controlLabel }}</span>{% endif %}
            </a>
            {% if canManage and control and control.action %}
            {% include '@Bridge/_worker_run_control_form.html.twig' with {project: project, run: item.run, control: control, frame: 'card-worker-runs', compact: true} only %}
            {% elseif canManage and item.closable %}
            <form method="post" action="{{ path('app_project_worker_run_close', {id: project.id, runId: item.run.id}) }}" class="lp-card-run__action" data-turbo-frame="card-worker-runs" data-card-run-close>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('worker-run-close') }}">
                <button type="submit" class="lp-btn lp-btn--icon lp-btn--compact" title="{{ 'bridge.worker_runs.close_session'|trans }}" aria-label="{{ 'bridge.worker_runs.close_session'|trans }}"><twig:ux:icon name="lucide:x" class="size-3.5" /></button>
            </form>
            {% endif %}
        </div>
        <span class="lp-status-chip lp-status-chip--{{ item.state.chipModifier() }}">{{ item.state.translationKey()|trans }}</span>
        <twig:ux:icon name="lucide:chevron-right" class="lp-card-run__chevron" />
    </div>
    {% endfor %}
    <p class="lp-card-usage-total" data-card-usage-total>
        <span class="lp-card-usage-total__label">{{ 'board.card.runs.usage.total'|trans }}</span>
        {% if usage.known %}
        {% if usage.costUsd is not null %}<span class="lp-card-usage-total__cost" data-card-usage-cost>{{ usage.costUsd|format_currency('USD') }}</span>{% endif %}
        <span data-card-usage-tokens>{{ 'board.card.runs.usage.tokens'|trans({'%input%': usage.compact(usage.inputTokens), '%output%': usage.compact(usage.outputTokens), '%cacheRead%': usage.compact(usage.cacheReadTokens), '%cacheWrite%': usage.compact(usage.cacheWriteTokens)}) }}</span>
        {% if usage.estimated %}<span class="lp-tag lp-tag--neutral" data-card-usage-estimated>{{ 'board.card.runs.usage.estimated'|trans }}</span>{% endif %}
        {% if usage.partialRuns > 0 %}<span class="lp-tag lp-tag--amber" data-card-usage-partial>{{ 'board.card.runs.usage.partial'|trans({'%count%': usage.partialRuns}) }}</span>{% endif %}
        {% else %}
        <span data-card-usage-unknown>{{ 'board.card.runs.usage.unknown'|trans }}</span>
        {% endif %}
    </p>
</section>
{% endif %}
</turbo-frame>
