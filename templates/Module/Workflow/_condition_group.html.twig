<div data-condition-source="{{ group.sourceKey }}">{{ group.sourceKey|trans }}:
    {% for condition in group.conditions %}{{ condition.negated ? 'workflow.settings.rules.not'|trans ~ ' ' }}<code>{{ condition.key }}</code>{{ condition.params is not same as('') ? ' (' ~ condition.params ~ ')' }}{{ not loop.last ? ', ' }}{% endfor %}
</div>
