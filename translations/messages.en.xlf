            </trans-unit>
            <trans-unit id="review.document.verdict.title">
                <source>review.document.verdict.title</source>
                <target>Submit verdict</target>
            </trans-unit>
            <trans-unit id="review.document.verdict.approve">
                <source>review.document.verdict.approve</source>
                <target>Approve</target>
            </trans-unit>
            <trans-unit id="review.document.verdict.request_changes">
                <source>review.document.verdict.request_changes</source>
                <target>Request changes</target>
            </trans-unit>
            <trans-unit id="review.document.orphan_banner">
                <source>review.document.orphan_banner</source>
                <target>%count% comment(s) refer to text that has been removed or changed.</target>
            </trans-unit>

            <!-- Document status labels -->
            <trans-unit id="document.status.in_review">
                <source>document.status.in_review</source>
                <target>In review</target>
            </trans-unit>
            <trans-unit id="document.status.approved">
                <source>document.status.approved</source>
                <target>Approved</target>
            </trans-unit>
            <trans-unit id="document.status.changes_requested">
                <source>document.status.changes_requested</source>
                <target>Changes requested</target>
            </trans-unit>

