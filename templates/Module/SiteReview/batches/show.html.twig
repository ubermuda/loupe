{% extends 'base.html.twig' %}

{% block title %}{{ 'site_review.batch.page.title'|trans }}{% endblock %}

{% block body %}
<div class="bp-page">
    <nav class="flex items-center gap-1.5 text-xs text-fg-dim mb-4">
        <a href="{{ path('app_site_review_batches') }}" class="hover:text-fg no-underline">{{ 'nav.link.site_reviews'|trans }}</a>
        <twig:ux:icon name="lucide:chevron-right" class="w-3 h-3" />
        <span class="text-fg-mute">{{ batch.createdAt|date('M j, Y') }}</span>
    </nav>

    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ 'site_review.batch.page.title'|trans }}</h1>
        <a class="bp-btn" href="{{ path('app_site_review_batches') }}">
            <twig:ux:icon name="lucide:arrow-left" />
            {{ 'site_review.batch.action.back'|trans }}
        </a>
    </div>

    <div class="bp-card">
        <p>
            <strong>{{ 'site_review.batch.field.created'|trans }}:</strong>
            {{ batch.createdAt|date('Y-m-d H:i') }}
        </p>
        <p>
            <strong>{{ 'site_review.batch.field.id'|trans }}:</strong>
            <code class="bp-code">{{ batch.id }}</code>
        </p>
    </div>

    <div class="flex flex-col gap-3 mt-4">
        {% for comment in batch.comments %}
        <div class="bp-review-comment">
            {% if comment.text is not empty %}
            <blockquote class="bp-review-comment__quote">{{ comment.text }}</blockquote>
            {% endif %}

            <div class="bp-review-comment__head">
                <span class="bp-review-comment__author">{{ batch.owner.fullName }}</span>
                {% if comment.selector is empty %}
                <span class="bp-tag shrink-0">{{ 'site_review.batch.comment.general'|trans }}</span>
                {% endif %}
            </div>

            <p class="bp-review-comment__body">{{ comment.body }}</p>

            <a class="bp-review-comment__url" href="{{ comment.url }}" target="_blank" rel="noopener noreferrer">
                <twig:ux:icon name="lucide:external-link" class="w-3.5 h-3.5 shrink-0" />
                <span class="truncate">{{ comment.url }}</span>
            </a>

            {% if comment.selector is not empty %}
            <details class="bp-review-comment__selector">
                <summary>{{ 'site_review.batch.comment.show_selector'|trans }}</summary>
                <code class="bp-code">{{ comment.selector }}</code>
            </details>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
