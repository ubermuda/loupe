{# The Workflow panel of a card page and its drawer. Props: panel (CardWorkflowPanel), card (CardSnapshot), project (Project). #}
<section class="lp-card-overview__section" data-workflow-panel>
    <h2 class="lp-card-panel__title">{{ 'workflow.panel.title'|trans }}</h2>
    {% if panel.pause %}
    <div class="lp-workflow-panel__pause" data-workflow-pause="{{ panel.pause.code }}">
        <p class="lp-workflow-panel__pause-title"><twig:ux:icon name="lucide:circle-pause" class="lp-card-held__icon" />{{ 'workflow.panel.paused'|trans({'%kind%': panel.pause.kind}) }} <time datetime="{{ panel.pause.since|date('c') }}">{{ panel.pause.since|relative_time }}</time></p>
        <p class="lp-workflow-panel__line">{{ panel.pause.reason }}</p>
        <p class="lp-workflow-panel__line" data-workflow-release>{{ panel.pause.release }}</p>
        {% if panel.pause.releasable and is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) %}
        <form method="post" action="{{ path('app_workflow_card_pause_release', {projectId: project.id, cardId: card.id, pauseId: panel.pause.id}) }}" data-turbo-frame="_top">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('workflow-pause-release') }}">
            <twig:Ds:Button variant="outline" size="sm" type="submit" data-workflow-retry><twig:ux:icon name="lucide:circle-play" class="size-4" />{{ 'workflow.panel.retry'|trans }}</twig:Ds:Button>
        </form>
        {% endif %}
    </div>
    {% endif %}
    {% if panel.progress %}
    {% set progress = panel.progress %}
    <dl class="lp-card-fields">
        <div class="lp-card-field" data-workflow-slot><dt>{{ 'workflow.panel.slot.label'|trans }}</dt><dd>{{ progress.slot }}</dd></div>
        {% if progress.nextAction %}<div class="lp-card-field lp-card-field--prose" data-workflow-next-action><dt>{{ 'workflow.panel.next_action'|trans }}</dt><dd>{{ progress.nextAction }}</dd></div>{% endif %}
        {% if progress.waiting %}<div class="lp-card-field lp-card-field--wide lp-card-field--prose" data-workflow-waiting><dt>{{ 'workflow.panel.waiting'|trans }}</dt><dd>{{ progress.waiting }}</dd></div>{% endif %}
        {% if progress.lastRefusal %}
        {% set refusal = progress.lastRefusal %}
        <div class="lp-card-field lp-card-field--wide lp-card-field--prose" data-workflow-last-refusal="{{ refusal.code }}"><dt>{{ 'workflow.panel.last_refusal'|trans }}</dt><dd>{{ refusal.reason }} · <time datetime="{{ refusal.at|date('c') }}">{{ refusal.at|relative_time }}</time> · {{ 'workflow.panel.attempts'|trans({'%count%': refusal.attempts}) }}</dd></div>
        {% endif %}
    </dl>
    {% endif %}
</section>
