<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% if app.user %}
        <div class="bp-app" data-controller="sidebar"
             data-sidebar-collapse-label-value="{{ 'nav.toggle_sidebar'|trans }}"
             data-sidebar-expand-label-value="{{ 'nav.expand_sidebar'|trans }}">
            <aside class="bp-sidebar">
                <a href="{{ path('app_home') }}" class="bp-sidebar__brand">
                    <span class="bp-sidebar__brand-mark"><twig:ux:icon name="lucide:clipboard-check" /></span>
                    <span class="bp-sidebar__brand-name">{{ 'nav.brand'|trans }}</span>
                </a>
                <nav class="bp-sidebar__nav">
                    <a href="{{ path('app_projects') }}" data-tooltip="{{ 'nav.link.projects'|trans }}"
                       class="bp-sidebar__link{% if app.request.attributes.get('_route') starts with 'app_project' %} bp-sidebar__link--active{% endif %}">
                        <twig:ux:icon name="lucide:folder" />
                        <span class="bp-sidebar__link-label">{{ 'nav.link.projects'|trans }}</span>
                    </a>
                    <a href="{{ path('app_api_tokens') }}" data-tooltip="{{ 'nav.link.api_tokens'|trans }}"
                       class="bp-sidebar__link{% if app.request.attributes.get('_route') == 'app_api_tokens' %} bp-sidebar__link--active{% endif %}">
                        <twig:ux:icon name="lucide:key-round" />
                        <span class="bp-sidebar__link-label">{{ 'nav.link.api_tokens'|trans }}</span>
                    </a>
                </nav>
                <div class="bp-sidebar__spacer"></div>
                <a href="{{ path('app_logout') }}" data-tooltip="{{ 'nav.link.logout'|trans }}" class="bp-sidebar__link" data-turbo-prefetch="false">
                    <twig:ux:icon name="lucide:log-out" />
                    <span class="bp-sidebar__link-label">{{ 'nav.link.logout'|trans }}</span>
                </a>
                <div class="bp-sidebar__account">
                    <span class="avatar">{{ app.user.userIdentifier|slice(0, 1)|upper }}</span>
                    <span class="bp-sidebar__account-name">{{ app.user.userIdentifier }}</span>
                    <button type="button" class="bp-sidebar__toggle"
                            data-sidebar-target="toggleButton"
                            data-action="click->sidebar#toggle"
                            data-tooltip="{{ 'nav.toggle_sidebar'|trans }}"
                            aria-label="{{ 'nav.toggle_sidebar'|trans }}">
                        <twig:ux:icon name="lucide:panel-left-close" class="bp-sidebar__toggle-icon bp-sidebar__toggle-icon--collapse" />
                        <twig:ux:icon name="lucide:panel-left-open" class="bp-sidebar__toggle-icon bp-sidebar__toggle-icon--expand" />
                    </button>
                </div>
            </aside>
            <main class="bp-main">
                {% block body %}{% endblock %}
            </main>
        </div>
        {% else %}
        {% block body_unauthenticated %}{{ block('body') }}{% endblock %}
        {% endif %}
        {% if app.user and site_review_widget_token %}
        <script src="/site-review/widget.js" data-token="{{ site_review_widget_token }}"></script>
        {% endif %}
    </body>
</html>
