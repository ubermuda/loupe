# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> docker/compose ###
COMPOSE_PROJECT_NAME=loupe
# Reserved tunnel domain for this checkout (ngrok), used by `just tunnel`. Like
# COMPOSE_PROJECT_NAME above, this is per-checkout config: unique per stack
# sharing the local traefik network, and a domain is reserved to exactly one
# ngrok account. Ships commented out so no fork registers a traefik router for
# someone else's domain — while unset, the never-matching tunnel.invalid
# sentinel applies and no router exists. Uncomment with your own reserved
# domain to use the tunnel.
# TUNNEL_HOST=your-app.ngrok.dev
###< docker/compose ###

###> app/mcp ###
# Hostnames (comma-separated, without port) allowed past the MCP endpoint's
# DNS-rebinding protection. Set this to your real host(s) per environment: an
# agent reaching /mcp on a hostname that is not listed here gets a 403 that
# names this variable and echoes the rejected host.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],loupe.dev.localhost
###< app/mcp ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> app/source ###
# Where the source code of THIS instance can be obtained. Rendered as a footer
# link on every page so network users can reach it, which is what the AGPL
# requires of anyone running Loupe as a network service. The default points at
# upstream because an unmodified instance runs upstream's code; if you modify
# Loupe, point this at your own repository — a link to upstream would not
# offer users the source they are actually interacting with.
APP_SOURCE_URL=https://github.com/ubermuda/loupe
###< app/source ###

###> symfony/routing ###
# The instance's own public URL, scheme included. It is the single host-shaped
# setting this app needs: it generates URLs in non-HTTP contexts (CLI commands,
# the messenger worker), pins the host of links embedded in security-sensitive
# email so a forged Host header cannot redirect them, and is the base of the
# Mercure topic identifiers the site-review bridge subscribes to. Set it to the
# URL your users actually type; the localhost default is a placeholder.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/proxy ###
# Proxies whose X-Forwarded-* headers Symfony trusts, as a comma-separated list
# of IPs or CIDR ranges. Empty falls back to PRIVATE_SUBNETS, which covers
# Docker and any load balancer on a private network. Set it when your balancer
# reaches the app from a public IP: until you do, X-Forwarded-Proto and
# X-Forwarded-Host are ignored (generated URLs get the wrong scheme and host)
# and every visitor shares the balancer's IP, so the per-IP registration and
# password-reset limiters throttle all your users collectively.
TRUSTED_PROXIES=
###< app/proxy ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/mailer ###
# Sender of every transactional email — verification, password reset, waitlist
# invite, data export, account deletion, billing surveys. The default is
# deliberately unusable in production: it must be an address on a domain you
# control and have published SPF/DKIM/DMARC for, or your mail is rejected or
# spam-foldered. Email verification is mandatory, so an unset value breaks
# registration for your users.
MAILER_FROM_ADDRESS=noreply@localhost
MAILER_FROM_NAME=Loupe
###< app/mailer ###

###> symfony/mercure-bundle ###
# URL the app POSTs updates to — internal Docker network, the `mercure` service.
MERCURE_URL=http://mercure/.well-known/mercure
# URL clients (the bridge CLI) subscribe to. It is a genuinely separate host —
# the hub is its own service, usually on its own name — so it cannot be derived
# from DEFAULT_URI. Empty here on purpose: the dev and test values live in
# .env.dev / .env.test, so the production image does not bake a localhost
# hostname that every self-hosted instance would then hand to its bridge CLI.
MERCURE_PUBLIC_URL=
# Shared HS256 secret (min 32 chars) — MUST equal the hub's publisher and
# subscriber keys. Deliberately NOT given a default here: dev/test values live
# in .env.dev / .env.test, and PRODUCTION MUST set MERCURE_JWT_SECRET via real
# environment variables. If it is unset, Mercure operations fail loudly instead
# of silently trusting a publicly-known key.
###< symfony/mercure-bundle ###

###> app/site-review ###
# Raw SiteReview-scoped API token used to embed the annotation widget on this
# app's own pages (dogfooding). Empty by default — the widget is not rendered
# unless this is set. It appears in page source, so use a dedicated SiteReview
# token (never an MCP or production credential). Set it in .env.local.
SITE_REVIEW_WIDGET_TOKEN=
###< app/site-review ###

###> app/encryption ###
# Key for Ubermuda\DoctrineExtra\Type\EncryptedStringType (libsodium secret-box).
# Left empty by default — the encrypted_string column type is unused out of the
# box, so the key is only required once a column actually uses it. Generate a
# real one per environment (set it in .env.local, never commit it):
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=
###< app/encryption ###

###> ubermuda/admin-bundle ###
# Email of the user auto-promoted to ROLE_ADMIN on login. Empty = promotion
# disabled. The default must stay present: the container references
# %env(ADMIN_EMAIL)% at compile time.
ADMIN_EMAIL=
###< ubermuda/admin-bundle ###

###> stripe/stripe-php ###
# Stripe API credentials. Empty by default — billing stays dark until the
# `billing.enabled` feature flag is on, and nothing instantiates the Stripe
# client before then. Set real values in .env.local (dev) / the environment
# (prod): a secret key from the Stripe dashboard (sk_test_… / sk_live_…) and
# the signing secret of the /webhooks/stripe endpoint (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< stripe/stripe-php ###

###> app/install ###
# Deploy-time secret gating the first-run install wizard (/install). Empty by
# default so dev, test, and worktree provisioning keep today's "first visitor
# wins" behaviour (the wizard is gated only by the users table being empty).
# PRODUCTION MUST set this to a real random value in the environment — an
# unset token leaves /install open to whoever reaches it first on a fresh
# deploy. Append it once as ?token=<value> to the /install URL; the app
# remembers it for the rest of that session.
#
# In prod this fails CLOSED: with APP_ENV=prod and no token configured the
# wizard 404s outright, so a forgotten variable locks the wizard rather than
# exposing it. Set this before the first deploy or you cannot install.
INSTALL_TOKEN=
###< app/install ###

###> app/export-storage ###
# Where generated data-export archives are stored. `local` writes them under
# var/exports/; `s3` uploads them to any S3-compatible bucket (AWS S3, MinIO,
# Cloudflare R2, DigitalOcean Spaces, …).
#
# `local` is only correct when the process that GENERATES an export and the
# process that SERVES its download share a filesystem — i.e. development, tests,
# and a single-container install with a persistent volume. The production
# topology docker/prod ships runs the web and the messenger worker as separate
# containers from the same image with no shared volume, so there `local` means
# the worker writes an archive the web container cannot see and every download
# 404s. Set EXPORT_STORAGE=s3 for that deployment.
EXPORT_STORAGE=local
# Everything below is read only when EXPORT_STORAGE=s3.
EXPORT_STORAGE_BUCKET=
# Key prefix inside the bucket. Empty stores archives at the bucket root, which
# is what a dedicated bucket wants; set it when sharing a bucket.
EXPORT_STORAGE_PREFIX=
# Empty falls back to AWS's own defaults (us-east-1,
# https://s3.<region>.amazonaws.com). Point ENDPOINT at your provider otherwise.
EXPORT_STORAGE_REGION=
EXPORT_STORAGE_ENDPOINT=
# Empty credentials fall back to the ambient AWS credential chain
# (AWS_ACCESS_KEY_ID / an instance role) — leave them unset when running on AWS
# with an attached role, and set them for every other provider.
EXPORT_STORAGE_KEY=
EXPORT_STORAGE_SECRET=
# MinIO and most non-AWS providers address buckets as https://host/bucket/key
# rather than https://bucket.host/key. Set this to true for them.
EXPORT_STORAGE_USE_PATH_STYLE=false
# Canned ACL sent with every upload. The Flysystem S3 adapter always sends one
# and offers no way to send none, and no single value is accepted everywhere:
# MinIO and DigitalOcean Spaces take only `private`, while an AWS S3 bucket
# created since 2023 defaults to "Bucket owner enforced" and rejects everything
# except `bucket-owner-full-control` with a 400 AccessControlListNotSupported.
# So leave this alone for MinIO and Spaces, and set it to
# bucket-owner-full-control for a default AWS S3 bucket.
EXPORT_STORAGE_ACL=private
###< app/export-storage ###

###> social login ###
# OAuth app credentials for the "Continue with …" buttons. Empty by default so
# the kernel boots without them; a provider only becomes reachable once its
# credentials are set in .env.local AND its feature flag (auth.google.enabled /
# auth.github.enabled) is switched on in the admin area.
#
# Google: create an OAuth 2.0 Client ID (Web application) in Google Cloud
# Console, configure the OAuth consent screen, and add
# https://<host>/oauth/google/check as an authorised redirect URI.
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
# GitHub: register an OAuth App with callback https://<host>/oauth/github/check.
# The app must be able to request the `user:email` scope — the verified primary
# email is read from GET /user/emails and is required to sign in.
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
###< social login ###
