{% set home = inbox.isHome(item, ask) %}
{% set open = item.state.value == 'open' %}
{% set review = item.kind.value == 'review' ? inbox_review(item) : null %}
{% set reviewFormShown = false %}
{% set actionParams = {projectId: item.project.id, itemId: item.id}|merge(inbox.actionQuery) %}
{% set responseFrame = app.request.headers.get('Turbo-Frame') == 'card-drawer-frame' ? 'card-drawer-frame' : '_top' %}
<article data-controller="inbox-decline" class="lp-inbox-item"{% if home %} id="inbox-item-{{ item.number }}"{% endif %} data-inbox-item="{{ item.number }}">
    {# A request with one item wears its state on the list row beside it. #}
    {% if showHead ?? true %}
    <div class="lp-inbox-item__head">
        <span class="lp-inbox-item__number" aria-hidden="true">{{ position ?? item.number }}</span>
        <h3 class="lp-inbox-item__title">{{ item.title }}</h3>
        <span class="lp-inbox-item__kind">{{ ('inbox.item.kind.' ~ item.kind.value)|trans }}</span>
        {% if item.blocking and (showBlocking ?? true) %}<span class="lp-inbox-item__blocking">{{ 'inbox.item.blocking'|trans }}</span>{% endif %}
        {% if not open %}{% include '@Inbox/_inbox_state_chip.html.twig' with {state: item.state} only %}{% endif %}
    </div>
    {% endif %}
    {# The waits below say what the body of a wait item says, with links. #}
    {% if item.kind.value != 'wait' and item.body|trim is not empty %}
        <div class="prose lp-prose lp-inbox-item__body">{{ item.body|inbox_markdown }}</div>
    {% endif %}
    {% set watch = item.kind.value == 'wait' ? inbox_card_watch(item) : null %}
    {% if watch %}
        {% set threadReply = home and inbox.acceptsResponse(item) and is_granted(constant('App\\Module\\Inbox\\Security\\InboxItemVoter::ANSWER'), item) %}
        {% include '@Inbox/_inbox_thread.html.twig' with {item: item, watch: watch, inbox: inbox, refusedForm: refusedForm ?? null, actionParams: actionParams, responseFrame: responseFrame, hostCardId: hostCardId ?? null, cardDrawer: cardDrawer ?? false, reply: threadReply} only %}
    {% endif %}

    {% if not open %}
    <div class="lp-inbox-item__response" data-inbox-response>
        {% if review and review.verdict %}
            <p class="lp-inbox-item__note">{{ review.targetLabel }}</p>
            <p data-inbox-review-verdict>{{ ('inbox.review.verdict.' ~ review.verdict.value)|trans }}</p>
            {% if review.note %}<p class="lp-inbox-item__answer-text">{{ review.note }}</p>{% endif %}
            <p class="lp-inbox-item__note">{{ review.reviewer.fullName }} · {{ review.submittedAt|date('j M Y, H:i') }}{% if review.reviewedVersionNumber %} · {{ 'inbox.review.version'|trans({'%version%': review.reviewedVersionNumber}) }}{% endif %}</p>
            {% set withdrawal = inbox_review_withdrawal(review) %}
            {% if withdrawal %}
                <p class="lp-inbox-item__note" data-inbox-review-withdrawal>{{ 'inbox.review.withdrawn'|trans({'%name%': withdrawal.reviewer.fullName, '%time%': withdrawal.submittedAt|date('j M Y, H:i')}) }}</p>
                {% if review.document %}<a class="lp-inbox-item__jump" href="{{ path('app_document_review', {projectId: item.project.id, documentId: review.document.id}) }}" data-turbo-frame="_top">{{ 'inbox.review.open_document'|trans }}</a>{% endif %}
            {% endif %}
        {% endif %}
        {% if item.selectedOptions|length > 0 or item.answerText is not null %}
            <h4 class="lp-inbox-item__response-title">{{ 'inbox.answer.legend'|trans }}</h4>
        {% endif %}
        {% if item.selectedOptions|length > 0 %}
            <ul class="lp-inbox-item__choices" data-inbox-choices>
                {% for index in item.selectedOptions %}
                    <li><twig:ux:icon name="lucide:check" class="lp-inbox-item__choice-icon" />{{ item.options[index] ?? index }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if item.answerText is not null %}<p class="lp-inbox-item__answer-text">{{ item.answerText }}</p>{% endif %}
        {% if item.closeNote is not null %}<p class="lp-inbox-item__note">{{ item.closeNote }}</p>{% endif %}
        <p class="lp-inbox-item__editable" data-inbox-editable="{{ inbox.acceptsResponse(item) ? 'yes' : 'no' }}">
            {%- if item.origin.value == 'loupe' and item.state.value in ['done', 'obsolete'] -%}
                {{ 'inbox.item.closed_by_loupe'|trans }}
            {%- elseif item.state.value in ['withdrawn', 'obsolete'] -%}
                {{ 'inbox.item.closed_by_agent'|trans }}
            {%- elseif inbox.acceptsResponse(item) -%}
                {{ 'inbox.item.editable'|trans }}
            {%- else -%}
                {{ 'inbox.item.final'|trans }}
            {%- endif -%}
        </p>
    </div>
    {% endif %}

    {% if home and not inbox.acceptsResponse(item) %}
        {% if item.kind.value in ['question', 'workflow'] %}
            {% include '@Inbox/_response_draft.html.twig' with {kind: 'answer', key: item.id, options: item.options, title: 'inbox.answer.unsent'} only %}
        {% endif %}
        {% set refusals = inbox_refusals(item, refusedForm) %}
        {% if refusals|length > 0 %}
        <div class="lp-inbox-item__refusal" role="alert" data-inbox-refusal>
            {% for message in refusals %}<p>{{ message }}</p>{% endfor %}
        </div>
        {% endif %}
    {% endif %}

    {# The forms of an item live at one place, which another page or another
       queue can hold. A copy shows the way there, whether or not the item
       still takes a response. #}
    {% if not home %}
        <a class="lp-inbox-item__jump" href="{{ path('app_project_inbox', {id: item.project.id, item: item.number}) }}" data-turbo-frame="_top">{{ (inbox.acceptsResponse(item) ? 'inbox.item.respond_elsewhere' : 'inbox.item.thread_elsewhere')|trans({'%number%': item.number}) }}</a>
    {% elseif item.kind.value != 'wait' and inbox.acceptsResponse(item) and is_granted(constant('App\\Module\\Inbox\\Security\\InboxItemVoter::ANSWER'), item) %}
        {% set declineForm = inbox_decline_form(item, refusedForm) %}
        {% set declineLabel = item.state.value == 'declined' ? 'inbox.decline.change' : 'inbox.decline.submit' %}
        {# A to-do with suggested actions puts Decline and Mark done beside its split button, in one reply card. #}
        {% set todoSplit = item.kind.value == 'todo' and (open or item.state.value != 'done') and not inbox_actions(item, hostCardId ?? null).isEmpty %}
        {# A question that its agent gave suggestions offers its actions in a reply card below the answer form. The answer carries the owner's words, so the card takes no note. #}
        {% set questionSplit = item.kind.value == 'question' and open and item.suggestedActions and not inbox_actions(item, hostCardId ?? null).isEmpty %}
        {% if todoSplit %}
            {% set doneForm = inbox_done_form(item, refusedForm) %}
            {% include '@Inbox/_inbox_thread.html.twig' with {item: item, watch: null, inbox: inbox, refusedForm: refusedForm ?? null, actionParams: actionParams, responseFrame: responseFrame, hostCardId: hostCardId ?? null, cardDrawer: cardDrawer ?? false, reply: true, todoButtons: {declineFormId: declineForm.vars.id, declineLabel: declineLabel, doneFormId: doneForm.vars.id}} only %}
        {% endif %}
        <div class="lp-inbox-item__actions">
            {% if item.kind.value in ['question', 'workflow'] %}
                {% set answerForm = inbox_answer_form(item, refusedForm) %}
                {% set selectedErrorsId = answerForm.selectedOptions.vars.id ~ '_errors' %}
                {% set textErrorsId = answerForm.answerText.vars.id ~ '_errors' %}
                {{ form_start(answerForm, {action: path('app_inbox_item_answer', actionParams), attr: {class: 'lp-form lp-inbox-answer', 'data-controller': 'form-draft', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': item.id, 'data-action': 'submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared', 'data-turbo-frame': responseFrame}}) }}
                    {% set noteAttr = {class: 'lp-decision__note-field', rows: 2, placeholder: 'inbox.answer.placeholder'|trans, 'aria-label': 'inbox.answer.placeholder'|trans, 'data-form-draft-target': 'text', 'data-inbox-decline-target': 'note', 'data-action': 'input->form-draft#remember'} %}
                    {% if answerForm.answerText.vars.errors|length > 0 %}{% set noteAttr = noteAttr|merge({'aria-describedby': textErrorsId}) %}{% endif %}
                    {% set written = item.options|length == 0 %}
                    {% if not written or item.freeText %}
                        {% set selected = (answerForm.selectedOptions.vars.value ?? '')|split(',') %}
                        {% if written %}
                            {% set noteAttr = noteAttr|merge({placeholder: 'inbox.answer.write_placeholder'|trans, 'aria-label': 'inbox.answer.legend'|trans}) %}
                        {% endif %}
                        {# The controls post under a name outside the form, so the form reads the ticked indexes from selectedOptions, which the controller fills. #}
                        <fieldset class="lp-decision lp-decision--inbox" data-decision-type="{{ written ? 'text' : (item.multiple ? 'multiple' : 'single') }}"{% if not written %} data-action="change->form-draft#select"{% endif %}{% if answerForm.selectedOptions.vars.errors|length > 0 %} aria-describedby="{{ selectedErrorsId }}"{% endif %}>
                            <legend class="lp-decision__prompt">{{ 'inbox.answer.legend'|trans }}<span class="lp-decision__kind">{{ (written ? 'inbox.answer.write' : (item.multiple ? 'inbox.answer.pick_any' : 'inbox.answer.pick_one'))|trans }}</span></legend>
                            {% if not written %}
                            <button type="button" class="lp-decision__clear" data-action="form-draft#clear">{{ 'inbox.answer.clear'|trans }}</button>
                            <div class="lp-decision__options">
                                {% for option in item.options %}
                                    {% set optionId = 'inbox_option_' ~ item.id ~ '_' ~ loop.index0 %}
                                    <div class="lp-decision__option">
                                        <input type="{{ item.multiple ? 'checkbox' : 'radio' }}" name="lp-inbox-{{ item.id }}" value="{{ loop.index0 }}" id="{{ optionId }}" data-form-draft-target="option"{{ (loop.index0 ~ '') in selected ? ' checked' }}>
                                        <label for="{{ optionId }}">{{ option }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                            {% endif %}
                            {% if item.freeText %}
                                <div class="lp-decision__note">{{ form_widget(answerForm.answerText, {attr: noteAttr}) }}</div>
                            {% endif %}
                        </fieldset>
                    {% endif %}
                    {{ form_widget(answerForm.selectedOptions) }}
                    <twig:Ds:FieldErrors :fieldView="answerForm.selectedOptions" :id="selectedErrorsId" />
                    {% if item.freeText %}
                        <twig:Ds:FieldErrors :fieldView="answerForm.answerText" :id="textErrorsId" />
                    {% endif %}
                    <twig:Ds:FieldErrors :fieldView="answerForm" />
                    {{ form_widget(answerForm._token) }}
                    <div class="lp-inbox-item__buttons">
                        {% if item.kind.value != 'workflow' %}
                            {% include '@Inbox/_decline_button.html.twig' with {formId: declineForm.vars.id, label: declineLabel} only %}
                        {% endif %}
                        <twig:Ds:Button variant="primary" size="sm" type="submit">
                            {{ (open ? 'inbox.answer.submit' : 'inbox.answer.change')|trans }}
                        </twig:Ds:Button>
                    </div>
                {{ form_end(answerForm, {render_rest: false}) }}
            {% elseif item.kind.value == 'review' %}
                {% if review and review.targetKind.value == 'pull-request' and review.pullRequest and safe_pull_request_url(review.pullRequest.url) %}
                    {% set reviewFormShown = true %}
                    {% include '@Inbox/_pull_request_review_form.html.twig' with {review: review, refusedForm: refusedForm, actionParams: actionParams, responseFrame: responseFrame, declineFormId: declineForm.vars.id, declineLabel: declineLabel} only %}
                {% elseif review and review.document %}
                    {% if is_granted(constant('App\\Module\\Inbox\\Security\\InboxItemVoter::REVIEW_DOCUMENT'), item) %}
                        {% set reviewFormShown = true %}
                        {% include '@Inbox/_document_review_form.html.twig' with {review: review, refusedForm: refusedForm, actionParams: actionParams, responseFrame: responseFrame, declineFormId: declineForm.vars.id, declineLabel: declineLabel, documentCard: app.request.attributes.get('_route') != 'app_document_review'} only %}
                    {% else %}
                        <p role="status">{{ 'inbox.review.error.target_unavailable'|trans }}</p>
                    {% endif %}
                {% else %}
                    {% if review %}<p class="lp-inbox-item__note">{{ review.targetLabel }}</p>{% endif %}
                    <p role="status">{{ 'inbox.review.error.target_unavailable'|trans }}</p>
                    {% set reviewRefusals = inbox_refusals(item, refusedForm) %}
                    {% if reviewRefusals|length > 0 %}
                        <div class="lp-inbox-item__refusal" role="alert">{% for message in reviewRefusals %}<p>{{ message }}</p>{% endfor %}</div>
                    {% endif %}
                {% endif %}
            {% elseif todoSplit %}
                {# The buttons of this form sit in the reply card above, through the form attribute. #}
                {{ form_start(doneForm, {action: path('app_inbox_item_done', actionParams), attr: {id: doneForm.vars.id, class: 'lp-inbox-done', 'data-turbo-frame': responseFrame}}) }}
                    <twig:Ds:FieldErrors :fieldView="doneForm" />
                {{ form_end(doneForm) }}
            {% elseif open or item.state.value != 'done' %}
                {% set doneForm = inbox_done_form(item, refusedForm) %}
                {{ form_start(doneForm, {action: path('app_inbox_item_done', actionParams), attr: {class: 'lp-inbox-done', 'data-turbo-frame': responseFrame}}) }}
                    <twig:Ds:FieldErrors :fieldView="doneForm" />
                    <div class="lp-inbox-item__buttons">
                        {% include '@Inbox/_decline_button.html.twig' with {formId: declineForm.vars.id, label: declineLabel} only %}
                        <twig:Ds:Button variant="primary" size="sm" type="submit">
                            {{ 'inbox.done.submit'|trans }}
                        </twig:Ds:Button>
                    </div>
                {{ form_end(doneForm) }}
            {% endif %}

            {# The decline form carries the hidden note only. Its button sits in
               the response row above, through the form attribute. #}
            {{ form_start(declineForm, {action: path('app_inbox_item_decline', actionParams), attr: {id: declineForm.vars.id, class: 'lp-inbox-decline__form', 'data-turbo-frame': responseFrame}}) }}
                {{ form_widget(declineForm.closeNote, {attr: {'data-inbox-decline-target': 'value'}}) }}
                <twig:Ds:FieldErrors>{{ form_errors(declineForm) }}{{ form_errors(declineForm.closeNote) }}</twig:Ds:FieldErrors>
            {{ form_end(declineForm) }}
        </div>
        {% if questionSplit %}
            {% include '@Inbox/_inbox_thread.html.twig' with {item: item, watch: null, inbox: inbox, refusedForm: refusedForm ?? null, actionParams: actionParams, responseFrame: responseFrame, hostCardId: hostCardId ?? null, cardDrawer: cardDrawer ?? false, reply: true, withNote: false} only %}
        {% endif %}
    {% endif %}
    {% if home %}
        {% if item.kind.value == 'review' and not reviewFormShown %}
            {% include '@Inbox/_response_draft.html.twig' with {
                kind: 'review', key: item.id ~ ':review', options: [], title: 'inbox.review.unsent', hint: 'inbox.review.unsent_unavailable',
                labels: {approved: 'inbox.review.verdict.approved'|trans, 'changes-requested': 'inbox.review.verdict.changes-requested'|trans},
                fallbackNote: refusedForm.note is defined and inbox_refusals(item, refusedForm)|length > 0 ? refusedForm.note.vars.value : ''
            } only %}
        {% endif %}
    {% endif %}
</article>
