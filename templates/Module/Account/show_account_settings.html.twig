{% extends 'base.html.twig' %}

{% block title %}{{ 'account.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ 'nav.link.account'|trans }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'account.settings.page.title'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-connect">
    <h1 class="lp-workspace-title lp-workspace-title--doc">{{ 'account.settings.page.title'|trans }}</h1>

    <twig:BillingSummary />

    <section class="lp-connect-block" data-testid="profile-section">
        <p class="lp-eyebrow">{{ 'account.settings.profile.heading'|trans }}</p>
        <div class="lp-identity-row">
            <span class="lp-identity-row__avatar">{{ view.user.fullName|slice(0, 1)|upper }}</span>
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name">{{ view.user.fullName }}</span>
                <span class="lp-identity-row__meta">{{ view.user.email }}</span>
            </span>
            <a href="{{ path('app_account_profile') }}" class="lp-btn lp-btn--ghost">{{ 'account.settings.profile.edit_link'|trans }}</a>
        </div>
    </section>

    <section class="lp-connect-block" data-testid="export-section">
        <p class="lp-eyebrow">{{ 'account.settings.export.heading'|trans }}</p>
        {# Panelled like the profile block above it: loose on the page the export
           controls read as a leftover rather than a section of the settings. #}
        <div class="lp-settings-panel">
        <p class="lp-connect-hint">{{ 'account.settings.export.intro'|trans }}</p>

        {% for export in view.exports %}
        <div class="lp-identity-row">
            <twig:ux:icon name="lucide:package" class="lp-identity-row__glyph w-4 h-4" />
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name lp-identity-row__name--mono">{{ export.requestedAt|date('Y-m-d H:i') }}</span>
                <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                    {% if export.isExpired %}
                        {{ 'account.settings.export.status.expired'|trans }}
                    {% else %}
                        {{ ('account.settings.export.status.' ~ export.status.value)|trans }}
                    {% endif %}
                </span>
            </span>
            {# Same gate the controller applies, so a rendered link never 404s.
               Turbo off: the response is a streamed ZIP, and a prefetch on hover
               would pull the whole archive down. #}
            {% if export.isDownloadable %}
            <a href="{{ path('app_account_export_download', {id: export.id}) }}"
               class="lp-btn lp-btn--ghost"
               data-turbo="false" data-turbo-prefetch="false">{{ 'account.settings.export.download_link'|trans }}</a>
            {% endif %}
        </div>
        {% endfor %}

        <form method="post" action="{{ path('app_account_export_request') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request-data-export') }}">
            <button type="submit" class="lp-btn lp-btn--primary">{{ 'account.settings.export.request_button'|trans }}</button>
        </form>
        <p class="lp-connect-hint">{{ 'account.settings.export.link_hint'|trans }}</p>
        </div>
    </section>

    <section class="lp-danger-zone" data-testid="delete-account-section">
        <h2 class="lp-danger-zone-title">{{ 'account.delete.danger.heading'|trans }}</h2>
        <p class="lp-danger-zone-desc">{{ 'account.delete.danger.body'|trans }}</p>
        <form method="post" action="{{ path('app_account_delete_request') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request-account-deletion') }}">
            <button type="submit" class="lp-btn lp-btn--danger">{{ 'account.delete.danger.cta'|trans }}</button>
        </form>
    </section>
</div>
{% endblock %}
