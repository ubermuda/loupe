{# One card face. The whole card is the drag handle, and the grip says so.
   Props: card (Card), pendingComments (int), static (bool, optional): a card
   shown outside the board, which does not drag and names its column instead.
   A static card also skips the prefetch, because it opens no drawer.
   runWarning (CardRunWarning, optional) holds until the card leaves its column. #}
{% set static = static ?? false %}
{% set runWarning = runWarning ?? null %}
<article class="lp-board-card{{ static ? ' lp-board-card--static' }}"
         {% if not static %}data-controller="card-prefetch"
         data-board-drag-target="card"
         data-board-filter-target="card"
         data-action="pointerdown->board-drag#press mouseenter->card-prefetch#enter mouseleave->card-prefetch#leave focusin->card-prefetch#enter"{% endif %}
         data-card-id="{{ card.id }}"
         data-card-title="{{ card.title }}">
    {% if not static %}
    <span class="lp-board-card__grip" aria-hidden="true">
        <twig:ux:icon name="lucide:grip-vertical" class="w-4 h-4" />
    </span>
    {% endif %}
    {# The identifier and the card's type lead the card face, as the design draws
       them. The number is the handle a person quotes. #}
    <div class="lp-board-card__identity">
        <span class="lp-board-card__number">#{{ card.number }}</span>
        {% include '@Board/_card_type_tag.html.twig' with {type: card.type} only %}
    </div>
    {# draggable="false" stops the browser's own link drag taking the gesture. #}
    <a class="lp-board-card__title"
       data-card-prefetch-target="link"
       draggable="false"
       href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}"
       data-turbo-frame="card-drawer-frame"
       data-action="click->card-drawer#prepare">
        {{ card.title }}
    </a>
    {% if static %}
    <span class="lp-status-chip lp-board-card__status">{{ card.column.label|trans }}</span>
    {% endif %}
    {% if card.body|trim is not empty %}
    <p class="lp-board-card__excerpt">{{ card.body|striptags|slice(0, 110) }}{% if card.body|length > 110 %}…{% endif %}</p>
    {% endif %}
    {% if runWarning is not null and runWarning.appliesTo(card.column.slug) %}
    <a class="lp-board-card__warning"
       draggable="false"
       href="{{ path('app_project_worker_runs', {id: card.project.id, search: runWarning.runId}) }}"
       data-card-run-warning="{{ runWarning.runId }}">
        <span class="lp-status-chip lp-status-chip--{{ runWarning.state.chipModifier }}">
            <twig:ux:icon name="lucide:triangle-alert" class="w-3.5 h-3.5 shrink-0" />
            {{ runWarning.state.translationKey|trans }}
        </span>
        <span class="lp-board-card__excerpt">{{ runWarning.summary|slice(0, 140) }}{% if runWarning.summary|length > 140 %}…{% endif %}</span>
    </a>
    {% endif %}
    {% if pendingComments > 0 or card.pullRequests|length > 0 or card.documents|length > 0 %}
    <div class="lp-board-card__meta">
        {% if pendingComments > 0 %}
        <span class="lp-board-card__reviews" title="{{ 'board.card.site_review.count'|trans({'%count%': pendingComments}) }}">
            <twig:ux:icon name="lucide:message-square" class="w-3.5 h-3.5 shrink-0" />
            {{ pendingComments }}
        </span>
        {% endif %}
        {% if card.pullRequests|length > 0 %}
        <span class="lp-board-card__pulls" title="{{ 'board.card.pull_requests.count'|trans({'%count%': card.pullRequests|length}) }}">
            <twig:ux:icon name="lucide:git-pull-request" class="w-3.5 h-3.5 shrink-0" />
            {{ card.pullRequests|length }}
        </span>
        {% endif %}
        {% if card.documents|length > 0 %}
        <span class="lp-board-card__documents" title="{{ 'board.card.documents.count'|trans({'%count%': card.documents|length}) }}">
            <twig:ux:icon name="lucide:file-text" class="w-3.5 h-3.5 shrink-0" />
            {{ card.documents|length }}
        </span>
        {% endif %}
    </div>
    {% endif %}
    {# Dragging is the only interaction a card face offers. These fields carry
       no controls: the drag controller fills them and submits, which keeps
       Turbo and the CSRF controller in the path. The same form is on the card
       page with its labels, where a keyboard reaches it. #}
    {% if not static %}
    {% set moveForm = card_move_form(card) %}
    <form hidden
          method="post"
          action="{{ path('app_board_card_move', {projectId: card.project.id, cardId: card.id}) }}"
          data-board-drag-target="moveForm">
        {{ form_widget(moveForm._token) }}
        {{ form_widget(moveForm.column) }}
        {{ form_widget(moveForm.position) }}
    </form>
    {% endif %}
</article>
