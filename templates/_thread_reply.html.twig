{#- One reply in a thread: the author's initial, name, time and text.
    Props: reply (author, createdAt, body, id, submissionId), marker (the data
    attribute that names the reply for the page's scripts and tests). -#}
<div class="lp-thread-reply" {{ marker }}="{{ reply.id }}" data-reply-submission-id="{{ reply.submissionId }}">
    <span class="lp-thread-reply__avatar" aria-hidden="true">{{ reply.author.fullName|first|upper }}</span>
    <div class="lp-thread-reply__main">
        <p class="lp-thread-reply__meta"><strong>{{ reply.author.fullName }}</strong><time datetime="{{ reply.createdAt|date('c') }}" title="{{ reply.createdAt|date('Y-m-d H:i') }}">{{ reply.createdAt|relative_time }}</time></p>
        <p class="lp-thread-reply__body">{{ reply.body }}</p>
    </div>
</div>
