{% extends 'base.html.twig' %}

{% block title %}{{ site.name }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="bp-page">
    <nav class="flex items-center gap-1.5 text-xs text-fg-dim mb-4">
        <a href="{{ path('app_site_review_sites') }}" class="hover:text-fg no-underline">{{ 'site_review.sites.page.title'|trans }}</a>
        <twig:ux:icon name="lucide:chevron-right" class="w-3 h-3" />
        <span class="text-fg-mute">{{ site.name }}</span>
    </nav>

    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ site.name }}</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="bp-card mb-6" id="site-token">
        <h2 class="bp-section-title">{{ 'site_review.site.token.heading'|trans }}</h2>
        <p class="bp-form-hint">{{ 'account.api_token.scope.site_review_warning'|trans }}</p>

        {% if site.token %}
        <div class="bp-doc-row">
            <div class="bp-doc-row__main">
                <span class="bp-doc-row__title">{{ site.token.label }}</span>
                <div class="bp-doc-row__meta">
                    <span>{{ site.token.createdAt|date('M j, Y') }}</span>
                </div>
            </div>
            <form method="POST" action="{{ path('app_api_token_revoke', {tokenId: site.token.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-api-token') }}">
                <button type="submit" class="bp-btn bp-btn--danger">{{ 'account.api_token.action.revoke'|trans }}</button>
            </form>
        </div>
        <div class="bp-code-block mt-4">
            <div class="bp-code-block__header">
                <span class="bp-code-block__label">{{ 'site_review.site.token.snippet_heading'|trans }}</span>
            </div>
            <pre class="bp-pre"><code>&lt;script src="{{ absolute_url('/site-review/widget.js') }}" data-token="YOUR_TOKEN"&gt;&lt;/script&gt;</code></pre> {# twig-cs-fixer-disable-line #}
        </div>
        {% else %}
        <form method="POST" action="{{ path('app_site_review_site_token_mint', {id: site.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('mint-site-token') }}">
            <button type="submit" class="bp-btn bp-btn--primary">{{ 'site_review.site.token.mint'|trans }}</button>
        </form>
        {% endif %}
    </div>
</div>
{% endblock %}
