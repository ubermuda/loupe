{# The board itself. Props: board (BoardView), renameColumnForm (a refused
   FormView, or null). A frame reload keeps the toolbar, so the filter and
   the view come back from it after each render. #}
{% set canManage = is_granted(constant('App\\Module\\Board\\Security\\BoardColumnVoter::MANAGE'), board.project) %}
<div id="board" class="lp-board"
     data-controller="board-drag board-filter board-view{{ canManage ? ' board-columns' }}"
     data-action="turbo:frame-render@document->board-filter#filter board:placed@document->board-filter#filter turbo:frame-render@document->board-view#restore turbo:frame-render@document->board-drag#markReady">
    {% set cardCount = 0 %}
    {% for view in board.columns %}{% set cardCount = cardCount + view.count %}{% endfor %}
    <div class="lp-board-toolbar" id="board-toolbar-{{ board.project.id }}" data-turbo-permanent>
        <div class="lp-board-toolbar__filters" data-action="focusin->board-filter#revealField">
            <label class="lp-board-toolbar__search">
                <span class="sr-only">{{ 'board.filter.search.label'|trans }}</span>
                <twig:ux:icon name="lucide:search" class="lp-board-toolbar__search-icon" />
                <input type="search"
                       class="lp-board-toolbar__input"
                       placeholder="{{ 'board.filter.search.placeholder'|trans }}"
                       data-board-filter-target="query"
                       data-action="input->board-filter#filter">
            </label>
        </div>
        <span class="lp-board-toolbar__count"
              data-board-filter-target="count"
              data-one="{{ 'board.card.count'|trans({'%count%': 1}) }}"
              data-many="{{ 'board.card.count'|trans({'%count%': 2})|replace({'2': '%count%'}) }}">{{ 'board.card.count'|trans({'%count%': cardCount}) }}</span>
        <p class="lp-board-toolbar__paused" role="status" data-board-live-target="paused" hidden>{{ 'board.live.paused'|trans }}</p>
        <div class="lp-board-toolbar__mode" aria-label="{{ 'board.view.label'|trans }}">
            <button type="button"
                    class="lp-board-toolbar__mode-button"
                    aria-pressed="true"
                    data-board-view-target="boardButton"
                    data-action="board-view#showBoard">
                <twig:ux:icon name="lucide:square-kanban" class="w-4 h-4 shrink-0" />
                {{ 'board.view.board'|trans }}
            </button>
            <button type="button"
                    class="lp-board-toolbar__mode-button"
                    aria-pressed="false"
                    data-board-view-target="listButton"
                    data-action="board-view#showList">
                <twig:ux:icon name="lucide:list" class="w-4 h-4 shrink-0" />
                {{ 'board.view.list'|trans }}
            </button>
        </div>
    </div>
    <p class="lp-board-filter-empty" data-board-filter-target="empty" hidden>{{ 'board.filter.empty'|trans }}</p>
    {# A drop moves the card at once. This says so when the server refuses. #}
    <p class="lp-board__message"
       data-board-drag-target="message"
       data-message="{{ 'board.drag.failed'|trans }}"
       role="status"
       aria-live="polite"></p>
    {% if canManage %}
    {# A header drop fills this form with the new order and submits it. #}
    {% set reorderForm = board_columns_reorder_form('', board_column_order(board.columns, 0, 0)) %}
    <form hidden
          method="post"
          action="{{ path('app_board_columns_reorder', {id: board.project.id}) }}"
          data-board-columns-target="form">
        {{ form_widget(reorderForm._token) }}
        {{ form_widget(reorderForm.expectedOrder) }}
        {{ form_widget(reorderForm.order, {attr: {'data-board-columns-target': 'order'}}) }}
    </form>
    {% endif %}
    <div class="lp-board__columns"
         data-board-view-target="board"
         {% if canManage %}data-action="dragover->board-columns#over drop->board-columns#drop"{% endif %}>
    {% for view in board.columns %}
    {% set label = view.column.label|trans %}
    <section class="lp-board__column"
             id="board-column-{{ view.column.id }}"
             aria-label="{{ label }}"
             data-column-slug="{{ view.column.slug }}"
             data-column-id="{{ view.column.id }}"
             data-board-columns-target="column">
        <header class="lp-board__column-head">
            {% if canManage %}
            <span class="lp-board__column-grip"
                  draggable="true"
                  title="{{ 'board.column.drag'|trans }}"
                  data-action="dragstart->board-columns#start dragend->board-columns#end">
                <twig:ux:icon name="lucide:grip-vertical" class="w-4 h-4" />
            </span>
            {% endif %}
            <span class="lp-tone-dot lp-tone-dot--{{ view.column.tone.value }}" aria-hidden="true"></span>
            <h2 class="lp-board__column-title">{{ label }}</h2>
            <span class="lp-board__column-count" id="board-count-{{ view.column.id }}">{{ view.count }}</span>
            {% if canManage %}
                {% include '@Board/_board_column_menu.html.twig' with {board: board, view: view, index: loop.index0, renameColumnForm: renameColumnForm} only %}
            {% endif %}
        </header>

        <div class="lp-board__group"
             id="board-group-{{ view.column.id }}"
             data-board-drag-target="group"
             data-column="{{ view.column.id }}"
             data-rankable="{{ view.column.terminal ? '0' : '1' }}">
            {% for card in view.cards %}
                {# `~ ''` casts the Uuid, which cannot itself be an array key. #}
                {% include '@Board/_card.html.twig' with {card: card, pendingComments: board.pendingComments[card.id ~ '']|default(0)} only %}
            {% endfor %}
        </div>

        {% if view.column.terminal %}
        <p class="lp-board__column-note">{{ 'board.terminal.window'|trans({'%days%': board.terminalWindowDays}) }}</p>
        <a class="lp-board__column-link" id="board-history-{{ view.column.id }}" href="{{ path('app_project_board_terminal_column', {projectId: board.project.id, columnId: view.column.id}) }}">
            {{ 'board.terminal.history_link'|trans({'%count%': view.terminalTotal}) }}
        </a>
        {% endif %}
        <a class="lp-board__add-card" href="{{ path('app_board_card_create', {id: board.project.id, column: view.column.id}) }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare">
            <twig:ux:icon name="lucide:plus" class="w-4 h-4" />
            {{ 'board.column.add_card'|trans }}
        </a>
    </section>
    {% endfor %}
    </div>
    <div class="lp-board-list" data-board-view-target="list" hidden>
        <div class="lp-board-list__header" aria-hidden="true">
            <span>{{ 'board.list.work'|trans }}</span>
            <span>{{ 'board.list.type'|trans }}</span>
            <span>{{ 'board.list.status'|trans }}</span>
            <span>{{ 'board.list.agent'|trans }}</span>
            <span>{{ 'board.list.feedback'|trans }}</span>
        </div>
        {% for view in board.columns %}
            {% for card in view.cards %}
                {% include '@Board/_card_row.html.twig' with {card: card, column: view.column, feedbackCount: board.pendingComments[card.id ~ '']|default(0)} only %}
            {% endfor %}
        {% endfor %}
    </div>
</div>
