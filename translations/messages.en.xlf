            <trans-unit id="account.reset_password.check_email.page.title">
                <source>account.reset_password.check_email.page.title</source>
                <target>Check your email — App</target>
            </trans-unit>
            <trans-unit id="account.reset_password.check_email.heading">
                <source>account.reset_password.check_email.heading</source>
                <target>Reset link sent</target>
            </trans-unit>
            <trans-unit id="account.reset_password.check_email.body_line1">
                <source>account.reset_password.check_email.body_line1</source>
                <target>If an account exists for that email, you'll get a reset link within a minute.</target>
            </trans-unit>
            <trans-unit id="account.reset_password.check_email.body_line2">
                <source>account.reset_password.check_email.body_line2</source>
                <target>It expires in 1 hour.</target>
            </trans-unit>
            <trans-unit id="account.reset_password.check_email.back">
                <source>account.reset_password.check_email.back</source>
                <target>Back to sign in</target>
            </trans-unit>

            <!-- Reset password reset page -->
            <trans-unit id="account.reset_password.reset.page.title">
                <source>account.reset_password.reset.page.title</source>
                <target>Set new password — App</target>
            </trans-unit>
            <trans-unit id="account.reset_password.reset.heading">
                <source>account.reset_password.reset.heading</source>
                <target>Set new password</target>
            </trans-unit>
