{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src/Module/Account/Security",
            "src/Module/Account/EventListener",
        ],
    },
    // The whole suite covers these classes, because the listeners run on every
    // request. Infection reruns every covering test per mutant, so a full-suite
    // scope costs hours. The `mutation` suite in phpunit.dist.xml holds the
    // tests written for these classes, and `--testsuite` applies to the initial
    // run only. Infection filters it out of each mutant process.
    testFrameworkExtraArgs: "--testsuite=mutation",
    tmpDir: "var/infection",
    // One php-fpm container serves every worktree. A 30-second timeout turned
    // four mutants into false kills when a sibling ran its tests at the same
    // time. Four threads and 90 seconds hold up under that load.
    timeout: 90,
    threads: 4,
    logs: {
        text: "var/infection/infection.log",
        summary: "var/infection/summary.log",
    },
    mutators: {
        "@default": true,
    },
}
