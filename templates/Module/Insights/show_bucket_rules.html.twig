{% extends 'base.html.twig' %}

{% block title %}{{ 'analytics.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    {% include '@Insights/_crumbs.html.twig' with {project: project} only %}
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'time-buckets'} only %}

    <section class="lp-reports-panel" data-bucket-rule-form>
        <h2 class="lp-section-title">{{ 'insights.bucket_rules.add.title'|trans }}</h2>
        <twig:Ds:Hint>{{ 'insights.bucket_rules.intro'|trans }}</twig:Ds:Hint>
        {{ form_start(ruleForm, {action: path('app_project_analytics_bucket_rule_create', {id: project.id}), attr: {class: 'lp-form'}}) }}
            <twig:Ds:FieldErrors :fieldView="ruleForm" />
            <div class="lp-reports-form__fields">
                {% for formItem in [ruleForm.pattern, ruleForm.bucket] %}
                <twig:Ds:FormField>
                    {{ form_label(formItem, null, {label_attr: {class: ds_label_class()}}) }}
                    {{ form_widget(formItem, {attr: {class: ds_input_class()}}) }}
                    {% if formItem.vars.help %}<twig:Ds:Hint as="div" id="{{ formItem.vars.id }}_help">{{ formItem.vars.help|trans(formItem.vars.help_translation_parameters, formItem.vars.translation_domain) }}</twig:Ds:Hint>{% endif %}
                    <twig:Ds:FieldErrors :fieldView="formItem" data-field-errors="{{ formItem.vars.name }}" />
                </twig:Ds:FormField>
                {% endfor %}
            </div>
            <div class="lp-settings-form-actions">
                <twig:Ds:Button variant="primary" type="submit" :disabled="atLimit">{{ 'insights.bucket_rules.add.submit'|trans }}</twig:Ds:Button>
            </div>
            {% if atLimit %}
            <twig:Ds:Hint data-bucket-rule-limit>{{ 'insights.bucket_rules.limit'|trans({'%max%': constant('App\\Module\\Insights\\Entity\\InsightsBucketRule::MAX_PER_PROJECT')}) }}</twig:Ds:Hint>
            {% endif %}
        {{ form_end(ruleForm) }}
    </section>

    {% if rules is not empty %}
    <ol class="lp-reports-list" data-bucket-rules>
        {% for rule in rules %}
        <li class="lp-reports-analysis" data-bucket-rule="{{ rule.id }}">
            <div class="lp-reports-analysis__head">
                <h3 class="lp-reports-analysis__title">
                    <code data-bucket-rule-pattern>{{ rule.pattern }}</code>
                    <span class="lp-reports-analysis__range">{{ 'insights.bucket_rules.goes_to'|trans }}</span>
                    <twig:Ds:Tag tone="sky" data-bucket-rule-bucket>{{ rule.bucket }}</twig:Ds:Tag>
                </h3>
            </div>
            <div class="lp-reports-proposal__actions">
                {% for direction in ['up', 'down'] %}
                <form method="post" action="{{ path('app_project_analytics_bucket_rule_move', {id: project.id, ruleId: rule.id, direction: direction}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('insights-bucket-rule-move') }}">
                    <twig:Ds:Button variant="outline" size="sm" type="submit" :disabled="(direction == 'up' and loop.parent.loop.first) or (direction == 'down' and loop.parent.loop.last)" data-bucket-rule-move="{{ direction }}">{{ ('insights.bucket_rules.move.' ~ direction)|trans }}</twig:Ds:Button>
                </form>
                {% endfor %}
                <form method="post" action="{{ path('app_project_analytics_bucket_rule_delete', {id: project.id, ruleId: rule.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('insights-bucket-rule-delete') }}">
                    <twig:Ds:Button variant="outline" size="sm" type="submit" data-bucket-rule-delete>{{ 'insights.bucket_rules.delete'|trans }}</twig:Ds:Button>
                </form>
            </div>
        </li>
        {% endfor %}
    </ol>
    {% else %}
    <twig:Ds:EmptyState icon="lucide:list-filter" :title="'insights.bucket_rules.empty.title'|trans" :body="'insights.bucket_rules.empty.description'|trans({'%fallback%': constant('App\\Module\\Bridge\\Service\\BucketRule::FALLBACK')})" data-bucket-rules-empty />
    {% endif %}

    <section class="lp-reports-panel" data-bucket-summary>
        <h2 class="lp-section-title">{{ 'insights.bucket_rules.summary.title'|trans }}</h2>
        <twig:Ds:Hint>{{ 'insights.bucket_rules.summary.intro'|trans }}</twig:Ds:Hint>
        <form method="get" action="{{ path('app_project_analytics_time_buckets', {id: project.id}) }}" data-controller="autosearch" class="lp-list-filters lp-filter-form">
            <label class="sr-only" for="bucket-summary-range">{{ 'insights.bucket_rules.summary.range'|trans }}</label>
            <twig:Ds:Select id="bucket-summary-range" name="range" class="lp-filter-select" data-action="change->autosearch#search">
                {% for option in ranges %}
                    <option value="{{ option.value }}"{{ option == summary.range ? ' selected' : '' }}>{{ ('analytics.metrics.range.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <noscript><twig:Ds:Button type="submit">{{ 'analytics.metrics.form.apply'|trans }}</twig:Ds:Button></noscript>
        </form>
        <div class="lp-metric-table">
            <table class="lp-metric-table__table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'insights.bucket_rules.summary.column.bucket'|trans }}</th>
                        <th scope="col" class="lp-metric-table__number">{{ 'insights.bucket_rules.summary.column.total'|trans }}</th>
                        <th scope="col" class="lp-metric-table__number">{{ 'insights.bucket_rules.summary.column.median'|trans }}</th>
                        <th scope="col">{{ 'insights.bucket_rules.summary.column.runs'|trans }}</th>
                        <th scope="col" class="lp-metric-table__number">{{ 'insights.bucket_rules.summary.column.share'|trans }}</th>
                        <th scope="col"><span class="sr-only">{{ 'insights.bucket_rules.summary.column.link'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in summary.rows %}
                    {# A bucket name comes from the project rules or the bridge, so it is rendered as text. Never add |raw here. #}
                    <tr data-bucket-summary-row="{{ row.name }}">
                        <td>{{ row.name }}</td>
                        {% if row.metricsParams is null %}
                        <td colspan="5" data-bucket-summary-no-time>{{ 'insights.bucket_rules.summary.no_time'|trans }}</td>
                        {% else %}
                        <td class="lp-metric-table__number" data-bucket-summary-total>{{ row.total|metric_value(metric, constant('App\\Module\\Bridge\\Metric\\MetricStatistic::Sum')) }}</td>
                        <td class="lp-metric-table__number" data-bucket-summary-median>{{ row.median|metric_value(metric, constant('App\\Module\\Bridge\\Metric\\MetricStatistic::Median')) }}</td>
                        <td data-bucket-summary-runs>{{ 'insights.bucket_rules.summary.runs'|trans({'%known%': summary.knownRuns, '%count%': summary.runs}) }}</td>
                        <td class="lp-metric-table__number" data-bucket-summary-share>{{ row.share|format_percent_number }}</td>
                        <td><a href="{{ path('app_project_analytics_metrics', {id: project.id}|merge(row.metricsParams)) }}" data-bucket-summary-open>{{ 'insights.bucket_rules.summary.open'|trans }}</a></td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
