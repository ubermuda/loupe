{# Billing section of the account settings page. Draws nothing at all while the
   billing flag is off, so the page is unchanged for a free deployment. #}
{% if view and view.billingEnabled %}
<section class="lp-connect-block" data-testid="billing-section">
    <p class="lp-eyebrow">{{ 'account.settings.billing.heading'|trans }}</p>

    <div class="lp-card flex items-start gap-3">
        {% if view.subscribed %}
        <span class="lp-billing-status lp-billing-status--ok">{{ 'billing.subscribe.status.chip.subscribed'|trans }}</span>
        <p class="lp-connect-hint">{{ 'billing.subscribe.status.subscribed'|trans }}</p>
        {% elseif view.hasLiveSubscription %}
        <span class="lp-billing-status lp-billing-status--expired">{{ 'billing.subscribe.status.chip.payment_problem'|trans }}</span>
        <p class="lp-connect-hint">{{ 'billing.subscribe.status.payment_problem'|trans }}</p>
        {% elseif view.trialing %}
        <span class="lp-billing-status lp-billing-status--trial">{{ 'billing.subscribe.status.chip.trial'|trans }}</span>
        <p class="lp-connect-hint">{{ 'billing.subscribe.status.trial_active'|trans({'%count%': view.trialDaysLeft}) }}</p>
        {% else %}
        <span class="lp-billing-status lp-billing-status--expired">{{ 'billing.subscribe.status.chip.expired'|trans }}</span>
        <p class="lp-connect-hint">{{ 'billing.subscribe.status.trial_expired'|trans }}</p>
        {% endif %}
    </div>

    {# The actions themselves live on the subscribe page, which owns the CSRF
       tokens and the Stripe redirects. #}
    <a href="{{ path('app_billing_subscribe') }}" class="lp-btn lp-btn--primary">
        {{ (view.hasLiveSubscription ? 'billing.subscribe.portal.button' : 'billing.subscribe.checkout.button')|trans }}
    </a>
</section>
{% endif %}
