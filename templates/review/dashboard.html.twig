{% extends 'base.html.twig' %}

{% block title %}{{ 'review.dashboard.page.title'|trans }}{% endblock %}

{% block body %}
<div class="bp-page">
    <div class="bp-page-header">
        <h1 class="bp-page-title">{{ 'review.dashboard.page.title'|trans }}</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="bp-flash bp-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if documents|length > 0 %}
    <div class="bp-card">
        <table class="bp-table">
            <thead>
                <tr>
                    <th>{{ 'review.dashboard.table.column.title'|trans }}</th>
                    <th>{{ 'review.dashboard.table.column.status'|trans }}</th>
                    <th>{{ 'review.dashboard.table.column.created'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for document in documents %}
                <tr data-document-id="{{ document.id }}">
                    <td>{{ document.title }}</td>
                    <td>
                        <span class="bp-badge bp-badge--{{ document.status.value }}">
                            {{ document.status.translationKey()|trans }}
                        </span>
                    </td>
                    <td>{{ document.createdAt|date('Y-m-d H:i') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="bp-card">
        <p class="bp-empty">{{ 'review.dashboard.empty'|trans }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
