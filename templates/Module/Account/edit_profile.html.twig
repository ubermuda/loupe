{% extends '@Account/_settings_layout.html.twig' %}

{% block settings_section 'profile' %}

{% block settings_content %}
<section class="lp-connect-block lp-settings-section lp-settings-panel-card" data-testid="profile-section">
    <h2 class="lp-section-title">{{ 'account.settings.profile.heading'|trans }}</h2>
    <p class="lp-connect-hint">{{ 'account.settings.profile.description'|trans }}</p>
    {{ form_start(form, {'action': path('app_account_profile'), 'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
        <twig:Ds:FormField :fieldView="form.fullName" />
        <twig:Ds:FormField>
            <twig:Ds:Label for="account-profile-email">{{ 'account.settings.profile.email_label'|trans }}</twig:Ds:Label>
            <twig:Ds:Input id="account-profile-email" type="email" value="{{ app.user.email }}" readonly />
            <twig:Ds:Hint>{{ 'account.settings.profile.email_hint'|trans }}</twig:Ds:Hint>
        </twig:Ds:FormField>
        <div class="flex items-center justify-end gap-3 pt-2">
            <twig:Ds:Button variant="primary" type="submit">{{ 'account.profile.save_button'|trans }}</twig:Ds:Button>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
