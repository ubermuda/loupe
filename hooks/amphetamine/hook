#!/bin/sh
set -u

quiet="${LOUPE_HOOK_SETTING_QUIET_HOURS-23:00-06:00}"
away="${LOUPE_HOOK_SETTING_AWAY_MINUTES-30}"

amph() {
    osascript -e "tell application \"Amphetamine\" to $1"
}

# minutes HH:MM prints the minute of the day, or fails on a bad time.
minutes() {
    case $1 in
        [01][0-9]:[0-5][0-9] | 2[0-3]:[0-5][0-9]) ;;
        *) return 1 ;;
    esac
    h=${1%%:*} m=${1#*:}
    echo $((${h#0} * 60 + ${m#0}))
}

if [ -n "$quiet" ]; then
    from=$(minutes "${quiet%-*}") && to=$(minutes "${quiet#*-}") || {
        echo "quiet_hours must be HH:MM-HH:MM, not $quiet" >&2
        exit 5
    }
fi
case $away in
    '' | *[!0-9]*)
        echo "away_minutes must be a whole number, not '$away'" >&2
        exit 5
        ;;
esac
while [ "${away#0}" != "$away" ] && [ -n "${away#0}" ]; do away=${away#0}; done

stamp=$(date '+%Y-%m-%d %H:%M %s') || exit $?
today=${stamp%% *} epoch=${stamp##* } clock=${stamp#* }
now=$(minutes "${clock% *}") || exit $?

in_quiet_hours() {
    [ -n "$quiet" ] || return 1
    if [ "$from" -le "$to" ]; then
        [ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]
    else
        [ "$now" -ge "$from" ] || [ "$now" -lt "$to" ]
    fi
}

person_away() {
    [ "$away" -gt 0 ] || return 1
    idle=$(ioreg -c IOHIDSystem -d 4 | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }')
    [ -n "$idle" ] && [ "$idle" -ge $((away * 60)) ]
}

# The bridge has no work. The session ends in quiet hours or when nobody uses
# the Mac. Otherwise it becomes a timed session that ends when quiet hours start.
release() {
    active=$(amph 'session is active') || exit $?
    [ "$active" = true ] || return 0
    if in_quiet_hours || person_away || [ -z "$quiet" ]; then
        amph 'end session' >/dev/null || exit $?
        return 0
    fi
    # A timestamp, not clock minutes, so a daylight saving change counts.
    start="$today ${quiet%-*}:00"
    at=$(date -j -f '%Y-%m-%d %H:%M:%S' "$start" +%s) || exit $?
    if [ "$at" -le "$epoch" ]; then
        at=$(date -j -v+1d -f '%Y-%m-%d %H:%M:%S' "$start" +%s) || exit $?
    fi
    left=$(((at - epoch) / 60))
    [ "$left" -gt 0 ] || left=1
    amph "start new session with options {duration:$left, interval:minutes, displaySleepAllowed:true}" >/dev/null || exit $?
}

hold() {
    amph 'start new session with options {duration:0, interval:0, displaySleepAllowed:true}' >/dev/null || exit $?
    amph 'enable closed display mode' >/dev/null || exit $?
    closed=$(amph 'closed display mode enabled') || exit $?
    if [ "$closed" != true ]; then
        echo 'closed-display mode is off' >&2
        exit 3
    fi
}

case "${1:-}" in
    busy) hold ;;
    idle | stop | start) release ;;
    *)
        echo "unknown event: ${1:-}" >&2
        exit 2
        ;;
esac
