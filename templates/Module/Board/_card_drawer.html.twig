{% embed '_drawer.html.twig' with {
    class: 'lp-card-drawer-overlay',
    attributes: {
        'aria-label': 'board.card.drawer.label'|trans,
        'data-card-drawer-target': 'dialog',
        'data-action': 'cancel->card-drawer#close',
    },
} only %}
    {% block content %}
    {# Escape and the backdrop close a drawer that is still loading. The error
       state below keeps its buttons, where a reader needs a way out. #}
    <div class="lp-card-drawer-overlay__loading" data-card-drawer-target="loading" role="status" tabindex="-1">
        <twig:ux:icon name="lucide:loader-circle" class="w-5 h-5" />
        {{ 'board.card.drawer.loading'|trans }}
    </div>
    <div class="lp-card-drawer-overlay__error" data-card-drawer-target="error" hidden>
        <p class="lp-dialog-desc" role="alert">{{ 'board.card.drawer.failed'|trans }}</p>
        <div class="lp-dialog-actions">
            <button type="button" class="lp-btn lp-btn--primary" data-action="card-drawer#retry">{{ 'board.card.drawer.retry'|trans }}</button>
            <button type="button" class="lp-btn" data-action="card-drawer#close">{{ 'board.card.drawer.close'|trans }}</button>
        </div>
    </div>
    <turbo-frame id="card-drawer-frame"
                 data-card-drawer-target="frame"
                 data-action="turbo:frame-load->card-drawer#loaded turbo:before-fetch-response->card-drawer#received turbo:fetch-request-error->card-drawer#failed turbo:frame-missing->card-drawer#failed turbo:submit-end->card-drawer#submitted"></turbo-frame>
    {% endblock %}
{% endembed %}
