{% extends 'base.html.twig' %}

{% block title %}{{ 'board.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: board.project.id}) }}">{{ board.project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.board'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-split-page lp-core-prototype-page lp-core-board" data-controller="card-drawer">
    {# A column change or a worker run elsewhere reloads this frame, and a card change places that card. #}
    {% do mercure_subscribe(boardTopic) %}
    {% do mercure_subscribe(worker_runs_topic(board.project)) %}
    {% set placeholderCardId = '00000000-0000-7000-8000-000000000000' %}
    <div class="lp-split-region"
         data-controller="board-refresh board-live"
         data-board-refresh-board-value="{{ path('app_project_board', {id: board.project.id}) }}"
         data-board-live-placement-value="{{ path('app_board_card_placement', {projectId: board.project.id, cardId: placeholderCardId}) }}"
         data-board-live-placeholder-value="{{ placeholderCardId }}"
         data-board-live-stale-value="{{ 'board.live.stale'|trans }}">
        {# No src here: board-refresh sets it without a load, so the first reload morphs. #}
        <turbo-frame id="board-frame" target="_top" refresh="morph" data-board-refresh-target="frame">
            {% include '@Board/_board_columns.html.twig' with {board: board} only %}
        </turbo-frame>
    </div>

    {% include '@Board/_card_drawer.html.twig' with {project: board.project} only %}
</div>
{% endblock %}
